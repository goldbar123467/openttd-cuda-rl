{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/oracle/manifests/schema/source.schema.json",
  "title": "OpenTTD P0 frozen source profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "schema_sha256",
    "manifest_kind",
    "profile",
    "status",
    "identity",
    "materials",
    "expected_outputs",
    "commands",
    "environment_allowlist"
  ],
  "properties": {
    "$schema": { "const": "../schema/source.schema.json" },
    "schema_version": { "const": 1 },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_kind": { "const": "frozen-profile" },
    "profile": { "const": "local-release" },
    "status": { "$ref": "#/$defs/status" },
    "status_reason": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer_repository", "submodule"],
      "properties": {
        "outer_repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_url", "basis_commit", "required_work_branch"],
          "properties": {
            "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
            "basis_commit": { "$ref": "#/$defs/git_commit" },
            "required_work_branch": { "const": "port/p0-oracle-contract" }
          }
        },
        "submodule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "canonical_url", "commit", "gitlink_mode", "clean_required", "gitmodules_sha256"],
          "properties": {
            "path": { "const": "openttd-upstream" },
            "canonical_url": { "const": "https://github.com/OpenTTD/OpenTTD.git" },
            "commit": { "const": "29f808ef0022064e6d9a83c8476d1e0f4686af86" },
            "gitlink_mode": { "const": 160000 },
            "clean_required": { "const": true },
            "gitmodules_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/material" }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schema", "digest_required_at_run"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "schema": { "$ref": "#/$defs/relative_path" },
          "digest_required_at_run": { "const": true }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/command" }
    },
    "environment_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/env_name" }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authored_from_outer_commit": { "$ref": "#/$defs/git_commit" },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["FAIL", "SKIP"] } }, "required": ["status"] },
      "then": { "required": ["status_reason"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
    "relative_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "env_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["git-commit", "file"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "argv"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
