{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/oracle/manifests/schema/evidence.schema.json",
  "title": "OpenTTD P0 generated run evidence statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "schema_sha256",
    "statement_kind",
    "profile",
    "subject",
    "status",
    "materials",
    "invocation",
    "outputs",
    "source_identity",
    "diagnostics"
  ],
  "properties": {
    "$schema": { "const": "../schema/evidence.schema.json" },
    "schema_version": { "const": 1 },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "statement_kind": { "const": "p0-run-evidence" },
    "profile": { "type": "string", "enum": ["local-release", "ci-smoke"] },
    "subject": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "status": { "$ref": "#/$defs/status" },
    "status_reason": { "type": "string", "minLength": 1 },
    "materials": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder_profile", "parameters", "commands", "environment"],
      "properties": {
        "builder_profile": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name_value" }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose", "argv", "return_code"],
            "properties": {
              "purpose": { "type": "string", "minLength": 1 },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "return_code": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        },
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name_value" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer_commit", "submodule_commit", "submodule_clean", "schemas"],
      "properties": {
        "outer_commit": { "$ref": "#/$defs/git_commit" },
        "submodule_commit": { "const": "29f808ef0022064e6d9a83c8476d1e0f4686af86" },
        "submodule_clean": { "const": true },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": "integer", "minimum": 0 },
        "artifact_root": { "type": "string", "minLength": 1 },
        "host_note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["FAIL", "SKIP"] } }, "required": ["status"] },
      "then": { "required": ["status_reason"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
    "name_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "value": { "type": ["string", "integer", "boolean"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
      }
    }
  }
}
