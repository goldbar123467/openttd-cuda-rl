+/** @file p0_trace_journal.h Partial tape-v1 framing for the external P0 oracle. */
+
+#ifndef P0_TRACE_JOURNAL_H
+#define P0_TRACE_JOURNAL_H
+
+#include "p0_trace_sink.h"
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <span>
+#include <string_view>
+#include <system_error>
+
+namespace P0Trace {
+
+static constexpr uint32_t MAX_HEADER_BYTES = 1U << 20;
+static constexpr uint32_t MAX_RECORD_PAYLOAD_BYTES = 64U << 20;
+static constexpr uint64_t MAX_RECORD_COUNT = 50'000'000;
+static constexpr uint64_t MAX_TAPE_BYTES = 1ULL << 40;
+
+struct Record {
+	uint16_t type;
+	uint16_t version;
+	uint32_t flags;
+	uint64_t public_step;
+	uint64_t native_tick;
+	std::span<const uint8_t> payload;
+};
+
+/**
+ * Streaming writer for the C++ producer's PARTIAL tape journal.
+ *
+ * FinishJournal() leaves FINAL_PATH.partial for validation and publication by
+ * the independent C17 `tape finalize` command. It never creates FINAL_PATH.
+ */
+class Journal {
+public:
+	static std::unique_ptr<Journal> Open(const std::filesystem::path &final_path, std::string_view canonical_header, std::error_code &error);
+
+	Journal(const Journal &) = delete;
+	Journal(Journal &&) = delete;
+	Journal &operator=(const Journal &) = delete;
+	Journal &operator=(Journal &&) = delete;
+
+	bool AddRecord(const Record &record);
+	bool FinishJournal(std::error_code &error);
+
+	uint64_t RecordCount() const { return this->record_count; }
+	std::error_code Error() const { return this->error ? this->error : this->sink->Error(); }
+
+private:
+	explicit Journal(std::unique_ptr<Sink> sink) : sink(std::move(sink)) {}
+
+	bool Fail(int error_value);
+	bool WritePrefix(std::string_view canonical_header);
+
+	std::unique_ptr<Sink> sink;
+	uint64_t record_count = 0;
+	uint64_t prior_public_step = 0;
+	uint64_t prior_native_tick = 0;
+	std::error_code error;
+	bool saw_terminal = false;
+};
+
+bool ValidateCanonicalTapeHeader(std::string_view header);
+
+} // namespace P0Trace
+
+#endif /* P0_TRACE_JOURNAL_H */
