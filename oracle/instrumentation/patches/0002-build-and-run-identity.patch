+/** @file p0_trace_journal.cpp Partial tape-v1 framing for the external P0 oracle. */
+
+#include "stdafx.h"
+#include "p0_trace_journal.h"
+
+#include "3rdparty/nlohmann/json.hpp"
+
+#include <array>
+#include <cerrno>
+#include <initializer_list>
+#include <string>
+
+#include "safeguards.h"
+
+namespace P0Trace {
+
+using nlohmann::json;
+
+static bool HasExactKeys(const json &value, std::initializer_list<std::string_view> keys)
+{
+	if (!value.is_object() || value.size() != keys.size()) return false;
+	for (std::string_view key : keys) {
+		if (!value.contains(key)) return false;
+	}
+	return true;
+}
+
+static bool IsLowerHex(const json &value, size_t size)
+{
+	if (!value.is_string()) return false;
+	const std::string &text = value.get_ref<const std::string &>();
+	if (text.size() != size) return false;
+	return std::ranges::all_of(text, [](char character) {
+		return (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f');
+	});
+}
+
+static bool IsSafeCounter(const json &value)
+{
+	return value.is_number_unsigned() && value.get<uint64_t>() <= 9'007'199'254'740'991ULL;
+}
+
+bool ValidateCanonicalTapeHeader(std::string_view header)
+{
+	if (header.empty() || header.size() > MAX_HEADER_BYTES || header.starts_with("\xEF\xBB\xBF")) return false;
+	json value = json::parse(header, nullptr, false, true);
+	if (value.is_discarded() || value.dump() != header) return false;
+	if (!HasExactKeys(value, {"backend_label", "diagnostic_features", "format", "identity", "initial", "limits", "projection_policy"})) return false;
+	if (!value["backend_label"].is_string() || value["backend_label"].get_ref<const std::string &>().empty() || value["backend_label"].get_ref<const std::string &>().size() > 128) return false;
+	if (!value["diagnostic_features"].is_array() || !value["diagnostic_features"].empty()) return false;
+	if (!HasExactKeys(value["format"], {"major", "minor"}) || value["format"]["major"] != 1 || value["format"]["minor"] != 0) return false;
+
+	const json &identity = value["identity"];
+	if (!HasExactKeys(identity, {"build_sha256", "command_input_sha256", "command_schema_sha256", "content_sha256", "executable_sha256", "field_schema_sha256", "fixture_sha256", "instrumentation_sha256", "newgrfs", "settings_sha256", "source_commit"})) return false;
+	for (std::string_view key : {"build_sha256", "command_input_sha256", "command_schema_sha256", "content_sha256", "executable_sha256", "field_schema_sha256", "fixture_sha256", "instrumentation_sha256", "settings_sha256"}) {
+		if (!IsLowerHex(identity[key], 64)) return false;
+	}
+	if (!identity["newgrfs"].is_array() || !identity["newgrfs"].empty()) return false;
+	if (!identity["source_commit"].is_string() || identity["source_commit"] != "29f808ef0022064e6d9a83c8476d1e0f4686af86") return false;
+
+	const json &initial = value["initial"];
+	if (!HasExactKeys(initial, {"calendar_date", "calendar_fraction", "economy_date", "economy_fraction", "gameplay_rng_state", "interactive_rng_state", "native_tick", "public_step", "timers"})) return false;
+	for (std::string_view key : {"calendar_date", "calendar_fraction", "economy_date", "economy_fraction"}) {
+		if (!initial[key].is_number_unsigned() || initial[key].get<uint64_t>() > UINT32_MAX) return false;
+	}
+	if (!IsLowerHex(initial["gameplay_rng_state"], 16) || !IsLowerHex(initial["interactive_rng_state"], 16)) return false;
+	if (!IsSafeCounter(initial["native_tick"]) || !IsSafeCounter(initial["public_step"])) return false;
+	if (!initial["timers"].is_object() || initial["timers"].empty() || initial["timers"].size() > 64) return false;
+	for (const auto &[key, timer] : initial["timers"].items()) {
+		if (key.empty() || key.size() > 64 || key.front() < 'a' || key.front() > 'z' || !std::ranges::all_of(key, [](char character) { return (character >= 'a' && character <= 'z') || (character >= '0' && character <= '9') || character == '_'; }) || !IsSafeCounter(timer)) return false;
+	}
+
+	const json &limits = value["limits"];
+	if (!HasExactKeys(limits, {"command_count", "field_bytes", "field_count", "header_bytes", "record_count", "record_payload_bytes", "tape_bytes"})) return false;
+	if (limits["command_count"] != 1'000'000 || limits["field_bytes"] != 67'108'864 || limits["field_count"] != 10'000'000 || limits["header_bytes"] != 1'048'576 || limits["record_count"] != 50'000'000 || limits["record_payload_bytes"] != 67'108'864 || limits["tape_bytes"] != 1'099'511'627'776ULL) return false;
+	return value["projection_policy"] == "complete";
+}
+
+/* static */ std::unique_ptr<Journal> Journal::Open(const std::filesystem::path &final_path, std::string_view canonical_header, std::error_code &error)
+{
+	error.clear();
+	if (!ValidateCanonicalTapeHeader(canonical_header)) {
+		error = std::error_code(EINVAL, std::generic_category());
+		return nullptr;
+	}
+	auto sink = Sink::Open(final_path, MAX_TAPE_BYTES, error);
+	if (sink == nullptr) return nullptr;
+	auto journal = std::unique_ptr<Journal>(new Journal(std::move(sink)));
+	if (!journal->WritePrefix(canonical_header)) {
+		error = journal->Error();
+		return nullptr;
+	}
+	return journal;
+}
+
+bool Journal::Fail(int error_value)
+{
+	if (!this->error) this->error = std::error_code(error_value, std::generic_category());
+	return false;
+}
+
+bool Journal::WritePrefix(std::string_view canonical_header)
+{
+	static constexpr std::array<uint8_t, 8> MAGIC{'O', 'T', 'R', 'L', 'T', 'A', 'P', 0};
+	return this->sink->WriteBytes(MAGIC) &&
+		this->sink->WriteU16(1) && this->sink->WriteU16(0) &&
+		this->sink->WriteU8(1) && this->sink->WriteU8(1) &&
+		this->sink->WriteU16(64) &&
+		this->sink->WriteU32(static_cast<uint32_t>(canonical_header.size())) &&
+		this->sink->WriteU32(1) &&
+		this->sink->WriteU64(0) && this->sink->WriteU64(0) &&
+		this->sink->WriteU64(0) && this->sink->WriteU64(0) && this->sink->WriteU64(0) &&
+		this->sink->WriteBytes(std::span<const uint8_t>(reinterpret_cast<const uint8_t *>(canonical_header.data()), canonical_header.size()));
+}
+
+bool Journal::AddRecord(const Record &record)
+{
+	if (this->error || this->sink->Error()) return false;
+	if (this->saw_terminal) return this->Fail(EINVAL);
+	if (record.type < 1 || record.type > 11 || record.version != 1 || record.flags != 1) return this->Fail(EINVAL);
+	if (record.payload.size() > MAX_RECORD_PAYLOAD_BYTES || this->record_count >= MAX_RECORD_COUNT) return this->Fail(EFBIG);
+	if (this->record_count == 0 && record.type != 1) return this->Fail(EINVAL);
+	if (record.public_step < this->prior_public_step || record.native_tick < this->prior_native_tick) return this->Fail(EINVAL);
+	if (!this->sink->WriteU16(record.type) || !this->sink->WriteU16(record.version) ||
+			!this->sink->WriteU32(record.flags) || !this->sink->WriteU64(this->record_count) ||
+			!this->sink->WriteU64(record.public_step) || !this->sink->WriteU64(record.native_tick) ||
+			!this->sink->WriteU32(static_cast<uint32_t>(record.payload.size())) || !this->sink->WriteU32(0) ||
+			!this->sink->WriteBytes(record.payload) || !this->sink->WriteZeroes((-record.payload.size()) & 7)) return false;
+	this->record_count++;
+	this->prior_public_step = record.public_step;
+	this->prior_native_tick = record.native_tick;
+	this->saw_terminal = record.type == 11;
+	return true;
+}
+
+bool Journal::FinishJournal(std::error_code &error)
+{
+	error.clear();
+	if (this->error || this->sink->Error() || !this->saw_terminal) {
+		if (!this->error && !this->sink->Error()) this->Fail(EINVAL);
+		error = this->Error();
+		return false;
+	}
+	return this->sink->FinishJournal(error);
+}
+
+} // namespace P0Trace
