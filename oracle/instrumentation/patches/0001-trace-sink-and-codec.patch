+
+/** @file p0_trace_sink.h Strict binary sink for external P0 oracle tapes. */
+
+#ifndef P0_TRACE_SINK_H
+#define P0_TRACE_SINK_H
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <span>
+#include <system_error>
+
+namespace P0Trace {
+
+/**
+ * Fail-closed writer for a single P0 trace file.
+ *
+ * The sink writes only to FINAL_PATH.partial. FinishJournal() durably closes
+ * that journal but never publishes FINAL_PATH; the independent C17 finalizer
+ * owns validation, trailer creation, and no-overwrite publication. A failed or
+ * interrupted writer deliberately retains the partial file.
+ */
+class Sink {
+public:
+	static std::unique_ptr<Sink> Open(const std::filesystem::path &final_path, uint64_t maximum_bytes, std::error_code &error);
+
+	~Sink();
+
+	Sink(const Sink &) = delete;
+	Sink(Sink &&) = delete;
+	Sink &operator=(const Sink &) = delete;
+	Sink &operator=(Sink &&) = delete;
+
+	bool WriteU8(uint8_t value);
+	bool WriteU16(uint16_t value);
+	bool WriteU32(uint32_t value);
+	bool WriteU64(uint64_t value);
+	bool WriteBytes(std::span<const uint8_t> bytes);
+	bool WriteZeroes(size_t count);
+	bool FinishJournal(std::error_code &error);
+
+	uint64_t BytesWritten() const { return this->bytes_written; }
+	std::error_code Error() const { return this->error; }
+
+private:
+	Sink(int descriptor, std::filesystem::path partial_path, uint64_t maximum_bytes);
+
+	bool Fail(int error_value);
+	bool WriteAll(std::span<const uint8_t> bytes);
+
+	int descriptor;
+	std::filesystem::path partial_path;
+	uint64_t maximum_bytes;
+	uint64_t bytes_written = 0;
+	std::error_code error;
+	bool closed = false;
+};
+
+} // namespace P0Trace
+
+#endif /* P0_TRACE_SINK_H */
