+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file p0_trace_sink.cpp Tests for the external P0 oracle trace sink. */
+
+#include "../stdafx.h"
+#include "../3rdparty/catch2/catch.hpp"
+#include "../p0_trace_sink.h"
+
+#include <cerrno>
+#include <fstream>
+#include <unistd.h>
+
+#include "../safeguards.h"
+
+class P0TraceTemporaryDirectory {
+public:
+	P0TraceTemporaryDirectory()
+	{
+		std::filesystem::path pattern = std::filesystem::temp_directory_path() / "openttd-p0-trace-test.XXXXXXXX";
+		std::string storage = pattern.string();
+		storage.push_back('\0');
+		char *created = mkdtemp(storage.data());
+		REQUIRE(created != nullptr);
+		this->path = created;
+	}
+
+	~P0TraceTemporaryDirectory()
+	{
+		std::error_code error;
+		std::filesystem::remove_all(this->path, error);
+	}
+
+	std::filesystem::path path;
+};
+
+TEST_CASE("P0 trace sink writes canonical little-endian primitives and closes a durable journal")
+{
+	P0TraceTemporaryDirectory temporary;
+	std::filesystem::path final_path = temporary.path / "trace.tape";
+	std::error_code error;
+	auto sink = P0Trace::Sink::Open(final_path, 64, error);
+	REQUIRE(sink != nullptr);
+	CHECK(!std::filesystem::exists(final_path));
+	CHECK(std::filesystem::exists(final_path.string() + ".partial"));
+
+	REQUIRE(sink->WriteU8(0x12));
+	REQUIRE(sink->WriteU16(0x3456));
+	REQUIRE(sink->WriteU32(0x789ABCDE));
+	REQUIRE(sink->WriteU64(0x0123456789ABCDEF));
+	REQUIRE(sink->WriteZeroes(1));
+	CHECK(sink->BytesWritten() == 16);
+	REQUIRE(sink->FinishJournal(error));
+	CHECK(!error);
+	CHECK(!std::filesystem::exists(final_path));
+	CHECK(std::filesystem::exists(final_path.string() + ".partial"));
+
+	std::ifstream input(final_path.string() + ".partial", std::ios::binary);
+	std::vector<uint8_t> bytes(std::istreambuf_iterator<char>(input), {});
+	CHECK(bytes == std::vector<uint8_t>{
+		0x12, 0x56, 0x34, 0xDE, 0xBC, 0x9A, 0x78, 0xEF,
+		0xCD, 0xAB, 0x89, 0x67, 0x45, 0x23, 0x01, 0x00,
+	});
+}
+
+TEST_CASE("P0 trace sink rejects existing output and retains bounded failures")
+{
+	P0TraceTemporaryDirectory temporary;
+	std::filesystem::path existing = temporary.path / "existing.tape";
+	std::ofstream(existing).put('x');
+	std::error_code error;
+	CHECK(P0Trace::Sink::Open(existing, 64, error) == nullptr);
+	CHECK(error.value() == EEXIST);
+
+	std::filesystem::path bounded = temporary.path / "bounded.tape";
+	auto sink = P0Trace::Sink::Open(bounded, 2, error);
+	REQUIRE(sink != nullptr);
+	CHECK(!sink->WriteU32(1));
+	CHECK(sink->Error().value() == EFBIG);
+	CHECK(!sink->FinishJournal(error));
+	CHECK(error.value() == EFBIG);
+	CHECK(!std::filesystem::exists(bounded));
+	CHECK(std::filesystem::exists(bounded.string() + ".partial"));
+}
