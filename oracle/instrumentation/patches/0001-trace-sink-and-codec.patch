--- /dev/null
+++ b/src/p0_trace_sink.cpp
@@ -0,0 +1,190 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file p0_trace_sink.cpp Strict binary sink for external P0 oracle tapes. */
+
+#include "stdafx.h"
+#include "p0_trace_sink.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <climits>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "safeguards.h"
+
+namespace P0Trace {
+
+Sink::Sink(int descriptor, std::filesystem::path partial_path, uint64_t maximum_bytes) :
+	descriptor(descriptor), partial_path(std::move(partial_path)), maximum_bytes(maximum_bytes)
+{
+}
+
+/* static */ std::unique_ptr<Sink> Sink::Open(const std::filesystem::path &final_path, uint64_t maximum_bytes, std::error_code &error)
+{
+	error.clear();
+	if (final_path.empty() || maximum_bytes == 0) {
+		error = std::error_code(EINVAL, std::generic_category());
+		return nullptr;
+	}
+
+	struct stat status;
+	if (lstat(final_path.c_str(), &status) == 0) {
+		error = std::error_code(EEXIST, std::generic_category());
+		return nullptr;
+	}
+	if (errno != ENOENT) {
+		error = std::error_code(errno, std::generic_category());
+		return nullptr;
+	}
+
+	std::filesystem::path partial_path = final_path;
+	partial_path += ".partial";
+	int descriptor = open(partial_path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, S_IRUSR | S_IWUSR);
+	if (descriptor < 0) {
+		error = std::error_code(errno, std::generic_category());
+		return nullptr;
+	}
+	return std::unique_ptr<Sink>(new Sink(descriptor, partial_path, maximum_bytes));
+}
+
+Sink::~Sink()
+{
+	if (this->descriptor >= 0) close(this->descriptor);
+}
+
+bool Sink::Fail(int error_value)
+{
+	if (!this->error) this->error = std::error_code(error_value, std::generic_category());
+	return false;
+}
+
+bool Sink::WriteAll(std::span<const uint8_t> bytes)
+{
+	if (this->error) return false;
+	if (this->descriptor < 0 || this->closed) return this->Fail(EINVAL);
+	if (bytes.size() > this->maximum_bytes || this->bytes_written > this->maximum_bytes - bytes.size()) return this->Fail(EFBIG);
+
+	size_t offset = 0;
+	while (offset < bytes.size()) {
+		size_t chunk = std::min(bytes.size() - offset, static_cast<size_t>(SSIZE_MAX));
+		ssize_t written = write(this->descriptor, bytes.data() + offset, chunk);
+		if (written < 0) {
+			if (errno == EINTR) continue;
+			return this->Fail(errno);
+		}
+		if (written == 0) return this->Fail(EIO);
+		offset += static_cast<size_t>(written);
+		this->bytes_written += static_cast<uint64_t>(written);
+	}
+	return true;
+}
+
+bool Sink::WriteU8(uint8_t value)
+{
+	return this->WriteAll(std::span<const uint8_t>(&value, 1));
+}
+
+bool Sink::WriteU16(uint16_t value)
+{
+	std::array<uint8_t, 2> bytes{
+		static_cast<uint8_t>(value),
+		static_cast<uint8_t>(value >> 8),
+	};
+	return this->WriteAll(bytes);
+}
+
+bool Sink::WriteU32(uint32_t value)
+{
+	std::array<uint8_t, 4> bytes{
+		static_cast<uint8_t>(value),
+		static_cast<uint8_t>(value >> 8),
+		static_cast<uint8_t>(value >> 16),
+		static_cast<uint8_t>(value >> 24),
+	};
+	return this->WriteAll(bytes);
+}
+
+bool Sink::WriteU64(uint64_t value)
+{
+	std::array<uint8_t, 8> bytes{
+		static_cast<uint8_t>(value),
+		static_cast<uint8_t>(value >> 8),
+		static_cast<uint8_t>(value >> 16),
+		static_cast<uint8_t>(value >> 24),
+		static_cast<uint8_t>(value >> 32),
+		static_cast<uint8_t>(value >> 40),
+		static_cast<uint8_t>(value >> 48),
+		static_cast<uint8_t>(value >> 56),
+	};
+	return this->WriteAll(bytes);
+}
+
+bool Sink::WriteBytes(std::span<const uint8_t> bytes)
+{
+	return this->WriteAll(bytes);
+}
+
+bool Sink::WriteZeroes(size_t count)
+{
+	static constexpr std::array<uint8_t, 8> ZERO{};
+	if (count > 7) return this->Fail(EINVAL);
+	return this->WriteAll(std::span<const uint8_t>(ZERO.data(), count));
+}
+
+bool Sink::FinishJournal(std::error_code &error)
+{
+	error.clear();
+	if (this->error) {
+		error = this->error;
+		return false;
+	}
+	if (this->descriptor < 0 || this->closed) {
+		error = std::error_code(EINVAL, std::generic_category());
+		return false;
+	}
+	if (fsync(this->descriptor) != 0) {
+		this->Fail(errno);
+		error = this->error;
+		return false;
+	}
+	if (close(this->descriptor) != 0) {
+		this->descriptor = -1;
+		this->Fail(errno);
+		error = this->error;
+		return false;
+	}
+	this->descriptor = -1;
+
+	std::filesystem::path directory = this->partial_path.parent_path();
+	if (directory.empty()) directory = ".";
+	int directory_descriptor = open(directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (directory_descriptor < 0) {
+		this->Fail(errno);
+		error = this->error;
+		return false;
+	}
+	if (fsync(directory_descriptor) != 0) {
+		int fsync_error = errno;
+		close(directory_descriptor);
+		this->Fail(fsync_error);
+		error = this->error;
+		return false;
+	}
+	if (close(directory_descriptor) != 0) {
+		this->Fail(errno);
+		error = this->error;
+		return false;
+	}
+
+	this->closed = true;
+	return true;
+}
+
+} // namespace P0Trace
