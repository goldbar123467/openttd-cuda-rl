{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/oracle/manifests/schema/requirements-traceability.schema.json",
  "title": "OpenTTD P0 requirements traceability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "schema_sha256",
    "registry_kind",
    "scope",
    "requirements",
    "tests",
    "implementation_ownership",
    "defect_mappings"
  ],
  "properties": {
    "$schema": { "const": "../../oracle/manifests/schema/requirements-traceability.schema.json" },
    "schema_version": { "const": 1 },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "registry_kind": { "const": "p0-requirements-traceability" },
    "scope": { "const": "PORT-001-through-PORT-005" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    },
    "implementation_ownership": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ownership" }
    },
    "defect_mappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/defect_mapping" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requirement_id": {
      "type": "string",
      "pattern": "^(SAFE|BUILD|FIX|CMD|TRACE|TAPE|CMP|MIN|FIELD|CACHE|TEST|EVID)-[A-Z0-9][A-Z0-9-]*$"
    },
    "test_id": { "type": "string", "pattern": "^TEST-[A-Z0-9][A-Z0-9-]*$" },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mandatory",
        "summary",
        "source",
        "implementation",
        "test_ids",
        "evidence",
        "gate",
        "status",
        "reviewer_note"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/requirement_id" },
        "mandatory": { "const": true },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "implementation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/test_id" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "gate": {
          "type": "string",
          "enum": ["GATE-0", "PORT-001", "PORT-002", "PORT-003", "PORT-004", "PORT-005", "P0-FINAL"]
        },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "IN_PROGRESS", "BLOCKED"] },
        "reviewer_note": { "type": "string", "minLength": 1 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runner", "requirement_ids", "mandatory"],
      "properties": {
        "id": { "$ref": "#/$defs/test_id" },
        "runner": { "$ref": "#/$defs/relative_path" },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement_id" }
        },
        "mandatory": { "const": true }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glob", "requirement_ids"],
      "properties": {
        "glob": { "$ref": "#/$defs/relative_path" },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement_id" }
        }
      }
    },
    "defect_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defect_id", "requirement_ids"],
      "properties": {
        "defect_id": { "type": "string", "pattern": "^(DEF|DIV)-P0-[0-9]{4}$" },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement_id" }
        },
        "passing_exception": { "type": "string", "minLength": 1 }
      }
    }
  }
}
