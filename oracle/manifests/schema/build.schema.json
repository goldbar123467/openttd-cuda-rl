{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/oracle/manifests/schema/build.schema.json",
  "title": "OpenTTD P0 frozen reference build profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "schema_sha256",
    "manifest_kind",
    "profile",
    "status",
    "source_commit",
    "toolchain_profile",
    "dependency_profile",
    "configuration",
    "feature_policy",
    "invocations",
    "environment",
    "materials",
    "expected_outputs",
    "reproduction_policy"
  ],
  "properties": {
    "$schema": { "const": "../schema/build.schema.json" },
    "schema_version": { "const": 1 },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_kind": { "const": "frozen-profile" },
    "profile": { "const": "build-relwithdebinfo" },
    "status": { "$ref": "#/$defs/status" },
    "status_reason": { "type": "string", "minLength": 1 },
    "source_commit": { "const": "29f808ef0022064e6d9a83c8476d1e0f4686af86" },
    "toolchain_profile": { "const": "toolchain-linux-x86_64" },
    "dependency_profile": { "const": "dependencies-ubuntu-24.04" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "build_type", "install_layout", "options", "feature_definitions"],
      "properties": {
        "generator": { "const": "Ninja" },
        "build_type": { "const": "RelWithDebInfo" },
        "install_layout": { "const": "FHS" },
        "options": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "behavior_affecting"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "value": { "type": ["string", "boolean", "integer"] },
              "behavior_affecting": { "type": "boolean" }
            }
          }
        },
        "feature_definitions": {
          "type": "array",
          "minItems": 15,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^WITH_[A-Z0-9_]+$" }
        }
      }
    },
    "feature_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "forbidden", "base_content"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 13,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "base_content": { "const": "OpenGFX 8.0" }
      }
    },
    "invocations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configure", "build", "install", "test_inventory", "test", "smoke"],
      "properties": {
        "configure": { "$ref": "#/$defs/command" },
        "build": { "$ref": "#/$defs/command" },
        "install": { "$ref": "#/$defs/command" },
        "test_inventory": { "$ref": "#/$defs/command" },
        "test": { "$ref": "#/$defs/command" },
        "smoke": { "$ref": "#/$defs/command" }
      }
    },
    "environment": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/environment_entry" }
    },
    "materials": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/material" }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/expected_output" }
    },
    "reproduction_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_build_roots",
        "required_equalities",
        "binary_byte_identity_required",
        "binary_difference_analysis_required"
      ],
      "properties": {
        "clean_build_roots": { "const": 2 },
        "required_equalities": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "binary_byte_identity_required": { "const": false },
        "binary_difference_analysis_required": { "const": true }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surviving_build_observation": { "type": "string", "minLength": 1 },
        "surviving_executable_sha256": { "$ref": "#/$defs/sha256" },
        "surviving_executable_size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["FAIL", "SKIP"] } }, "required": ["status"] },
      "then": { "required": ["status_reason"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "environment_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "identity_affecting"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "value": { "type": "string" },
        "identity_affecting": { "type": "boolean" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity", "manifest_path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$" }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "digest_required_at_run"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["executable", "installed-tree", "test-result", "smoke-result", "build-evidence"] },
        "digest_required_at_run": { "const": true }
      }
    }
  }
}
