From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: P0 Oracle Contract <p0-oracle@example.invalid>
Date: Thu, 30 Jul 2026 00:00:00 +0000
Subject: [PATCH] P0 fixture builder: create deterministic road freight save

---
 src/openttd.cpp | 214 +++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 213 insertions(+), 1 deletion(-)

diff --git a/src/openttd.cpp b/src/openttd.cpp
index 7325b4c..e7ca4d9 100644
--- a/src/openttd.cpp
+++ b/src/openttd.cpp
@@ -71,6 +71,11 @@
 #include "viewport_sprite_sorter.h"
 #include "framerate_type.h"
 #include "industry.h"
+#include "industry_cmd.h"
+#include "landscape_cmd.h"
+#include "map_func.h"
+#include "tile_map.h"
+#include "town_cmd.h"
 #include "network/network_gui.h"
 #include "network/network_survey.h"
 #include "misc_cmd.h"
@@ -85,6 +90,7 @@
 #include "linkgraph/linkgraphschedule.h"
 
 #include <system_error>
+#include <fstream>
 
 #include "table/strings.h"
 
@@ -111,6 +117,202 @@ bool _save_config = false;
 bool _request_newgrf_scan = false;
 NewGRFScanCallback *_request_newgrf_scan_callback = nullptr;
 
+static std::string _p0_fixture_output;
+void MakeNewgameSettingsLive();
+
+/**
+ * Construct the frozen P0 fixture in a disposable, patched reference build.
+ * This entry point is intentionally absent from replay/reference binaries.
+ */
+static void BuildP0Fixture()
+{
+	_settings_newgame.game_creation.generation_seed = 0x52465631;
+	_settings_newgame.game_creation.starting_year = TimerGameCalendar::Year{1950};
+	_settings_newgame.game_creation.map_x = 6;
+	_settings_newgame.game_creation.map_y = 6;
+	_settings_newgame.game_creation.landscape = LandscapeType::Temperate;
+	_settings_newgame.game_creation.se_flat_world_height = 1;
+	_settings_newgame.ai.ai_in_multiplayer = false;
+	_settings_newgame.difficulty.max_no_competitors = 0;
+	_settings_newgame.difficulty.competitors_interval = 0;
+	_settings_newgame.difficulty.industry_density = IndustryDensity::FundedOnly;
+	_settings_newgame.difficulty.max_loan = 300'000;
+	_settings_newgame.difficulty.initial_interest = 2;
+	_settings_newgame.difficulty.vehicle_costs = 0;
+	_settings_newgame.difficulty.vehicle_breakdowns = VehicleBreakdowns::None;
+	_settings_newgame.difficulty.subsidy_multiplier = 2;
+	_settings_newgame.difficulty.subsidy_duration = 0;
+	_settings_newgame.difficulty.construction_cost = 0;
+	_settings_newgame.difficulty.disasters = false;
+	_settings_newgame.difficulty.infinite_money = false;
+	_settings_newgame.economy.inflation = false;
+	_settings_newgame.economy.type = EconomyType::Frozen;
+	_settings_newgame.economy.feeder_payment_share = 75;
+	_settings_newgame.economy.town_growth_rate = 0;
+	_settings_newgame.economy.allow_town_roads = false;
+	_settings_newgame.economy.infrastructure_maintenance = false;
+	_settings_newgame.economy.timekeeping_units = TimekeepingUnits::Calendar;
+	_settings_newgame.economy.minutes_per_calendar_year = 12;
+	_settings_newgame.economy.industry_cargo_scale = 100;
+	_settings_newgame.economy.cargo_aging_rate = 100;
+	_settings_newgame.linkgraph.distribution_default = DistributionType::Manual;
+	_settings_newgame.order.gradual_loading = true;
+	_settings_newgame.order.improved_load = true;
+	_settings_newgame.order.no_servicing_if_no_breakdowns = true;
+	_settings_newgame.order.selectgoods = true;
+	_settings_newgame.vehicle.roadveh_acceleration_model = AccelerationModel::Original;
+	_settings_newgame.vehicle.roadveh_slope_steepness = 7;
+	_settings_newgame.vehicle.road_side = RoadVehicleDrivingSide::Right;
+	_settings_newgame.vehicle.max_roadveh = 1;
+	_settings_newgame.vehicle.never_expire_vehicles = false;
+	_settings_newgame.station.modified_catchment = false;
+	_settings_newgame.station.serve_neutral_industries = true;
+	_settings_newgame.station.station_spread = 12;
+	_settings_client.gui.autosave_interval = 0;
+	_settings_client.gui.autosave_on_exit = false;
+	_settings_client.gui.pause_on_newgame = false;
+
+	MakeNewgameSettingsLive();
+	_game_mode = GameMode::Editor;
+	ResetGRFConfig(true);
+	GenerateWorldSetCallback(nullptr);
+	GenerateWorld(GWM_EMPTY, 64, 64);
+
+	_current_company = OWNER_DEITY;
+	fmt::print(stderr, "P0 fixture: pre-town pools towns={} industries={} companies={}\n",
+		Town::GetNumItems(), Industry::GetNumItems(), Company::GetNumItems());
+	for (const Town *existing : Town::Iterate()) {
+		fmt::print(stderr, "P0 fixture: unexpected town id={} tile={} x={} y={}\n", existing->index.base(),
+			existing->xy.base(), TileX(existing->xy), TileY(existing->xy));
+	}
+	auto [town_cost, town_money, town_id] = Command<Commands::FoundTown>::Do(
+		DoCommandFlag::Execute, TileXY(32, 16), TownSize::Small, false,
+		TownLayout::Original, false, 0, "P0 Fixture Town");
+	if (town_cost.Failed() || town_id != TownID::Begin()) {
+		fmt::print(stderr, "P0 fixture: town creation failed (id={}, money={}, error={}, extra={}, mode={}, tile_type={}, tile_z={})\n",
+			town_id.base(), town_money, town_cost.GetErrorMessage().base(), town_cost.GetExtraErrorMessage().base(),
+			static_cast<uint>(_game_mode), static_cast<uint>(GetTileType(TileXY(32, 16))), GetTileZ(TileXY(32, 16)));
+		std::exit(2);
+	}
+
+	/* FoundTown lawfully initializes the pool object. Remove its generated map
+	 * footprint through the native landscape command so the frozen route begins
+	 * with no roads or houses and the town cannot perturb it. */
+	for (TileIndex tile{}; tile < Map::Size(); tile++) {
+		if (!IsTileType(tile, TileType::House) && !IsTileType(tile, TileType::Road)) continue;
+		CommandCost clear = Command<Commands::LandscapeClear>::Do(DoCommandFlag::Execute, tile);
+		if (clear.Failed()) {
+			fmt::print(stderr, "P0 fixture: clearing generated town tile {} failed\n", tile.base());
+			std::exit(2);
+		}
+	}
+	Town *town = Town::Get(town_id);
+	town->flags.Reset(TownFlag::IsGrowing);
+	town->flags.Set(TownFlag::CustomGrowth);
+	town->growth_rate = TOWN_GROWTH_RATE_NONE;
+
+	CommandCost coal = Command<Commands::BuildIndustry>::Do(
+		DoCommandFlag::Execute, TileXY(8, 27), static_cast<IndustryType>(0), 0, true, 0x434f414c);
+	CommandCost power = Command<Commands::BuildIndustry>::Do(
+		DoCommandFlag::Execute, TileXY(49, 27), static_cast<IndustryType>(1), 0, true, 0x504f5752);
+	if (coal.Failed() || power.Failed() || Industry::GetNumItems() != 2) {
+		fmt::print(stderr, "P0 fixture: industry creation failed (coal={}, power={}, count={})\n",
+			coal.Failed(), power.Failed(), Industry::GetNumItems());
+		std::exit(2);
+	}
+
+	_game_mode = GameMode::Normal;
+	Company *company = DoStartupNewCompany(false, CompanyID::Begin());
+	if (company == nullptr) {
+		fmt::print(stderr, "P0 fixture: company creation failed\n");
+		std::exit(2);
+	}
+	company->money = 10'000'000;
+	company->current_loan = 0;
+	company->settings.vehicle.servint_ispercent = false;
+	company->settings.vehicle.servint_roadveh = 0;
+	_current_company = _local_company;
+	SetLocalCompany(company->index, true);
+	CheckEngines();
+	CheckIndustries();
+	_interactive_random.SetSeed(0x49524631);
+	_game_session_stats.savegame_id = "50304649585455524553415645494431";
+
+	uint road_tiles = 0;
+	uint house_tiles = 0;
+	for (TileIndex tile{}; tile < Map::Size(); tile++) {
+		road_tiles += IsTileType(tile, TileType::Road);
+		house_tiles += IsTileType(tile, TileType::House);
+	}
+	if (Map::SizeX() != 64 || Map::SizeY() != 64 || Town::GetNumItems() != 1 ||
+		Company::GetNumItems() != 1 || road_tiles != 0 || house_tiles != 0 ||
+		town->cache.num_houses != 0 || town->cache.population != 0) {
+		fmt::print(stderr,
+			"P0 fixture: frozen-state invariant failed (map={}x{}, towns={}, companies={}, roads={}, houses={}, town_houses={}, population={})\n",
+			Map::SizeX(), Map::SizeY(), Town::GetNumItems(), Company::GetNumItems(),
+			road_tiles, house_tiles, town->cache.num_houses, town->cache.population);
+		std::exit(2);
+	}
+
+	for (const Industry *industry : Industry::Iterate()) {
+		fmt::print(stderr,
+			"P0 fixture: industry id={} type={} tile={} x={} y={} w={} h={} produced={} accepted={} layout={}\n",
+			industry->index.base(), industry->type, industry->location.tile.base(),
+			TileX(industry->location.tile), TileY(industry->location.tile),
+			industry->location.w, industry->location.h,
+			industry->produced.empty() ? 255 : industry->produced.front().cargo,
+			industry->accepted.empty() ? 255 : industry->accepted.front().cargo,
+			industry->selected_layout);
+		fmt::print(stderr, "P0 fixture: industry id={} occupied_tiles=", industry->index.base());
+		bool first = true;
+		for (TileIndex tile : industry->location) {
+			if (!industry->TileBelongsToIndustry(tile)) continue;
+			fmt::print(stderr, "{}{}", first ? "" : ",", tile.base());
+			first = false;
+		}
+		fmt::print(stderr, "\n");
+	}
+	fmt::print(stderr,
+		"P0 fixture: map={}x{} company={} money={} engine123={} tick={} calendar_date={} calendar_fract={} economy_date={} economy_fract={} random={:08x}:{:08x} interactive={:08x}:{:08x}\n",
+		Map::SizeX(), Map::SizeY(), company->index.base(), company->money,
+		IsEngineBuildable(EngineID{123}, VehicleType::Road, company->index),
+		TimerGameTick::counter, TimerGameCalendar::date.base(), TimerGameCalendar::date_fract,
+		TimerGameEconomy::date.base(), TimerGameEconomy::date_fract,
+		_random.state[0], _random.state[1], _interactive_random.state[0], _interactive_random.state[1]);
+
+	SaveLoadResult result = SaveOrLoad(_p0_fixture_output, SaveLoadOperation::Save,
+		DetailedFileType::GameFile, Subdirectory::None, false);
+	if (result != SaveLoadResult::Ok) {
+		fmt::print(stderr, "P0 fixture: save failed: {}\n", _p0_fixture_output);
+		std::exit(2);
+	}
+
+	std::ofstream map_planes(_p0_fixture_output + ".mapplanes.bin", std::ios::binary | std::ios::trunc);
+	if (!map_planes) {
+		fmt::print(stderr, "P0 fixture: map-plane sidecar open failed\n");
+		std::exit(2);
+	}
+	for (TileIndex tile{}; tile < Map::Size(); tile++) {
+		Tile data(tile);
+		const std::array<uint8_t, 12> bytes{
+			data.type(), data.height(), data.m1(),
+			static_cast<uint8_t>(data.m2()), static_cast<uint8_t>(data.m2() >> 8),
+			data.m3(), data.m4(), data.m5(), data.m6(), data.m7(),
+			static_cast<uint8_t>(data.m8()), static_cast<uint8_t>(data.m8() >> 8),
+		};
+		map_planes.write(reinterpret_cast<const char *>(bytes.data()), bytes.size());
+	}
+	map_planes.close();
+	if (!map_planes) {
+		fmt::print(stderr, "P0 fixture: map-plane sidecar write failed\n");
+		std::exit(2);
+	}
+	fmt::print(stderr, "P0 fixture: wrote {}\n", _p0_fixture_output);
+	fmt::print(stderr, "P0 fixture: wrote {}.mapplanes.bin (4096 tiles, 12 bytes/tile; type,height,m1,m2le,m3,m4,m5,m6,m7,m8le)\n",
+		_p0_fixture_output);
+	_exit_game = true;
+}
+
 /**
  * Error handling for fatal user errors.
  * @param str the string to print.
@@ -374,6 +576,7 @@ struct AfterNewGRFScan : NewGRFScanCallback {
 	uint16_t dedicated_port = 0;                  ///< Port for the dedicated server.
 	std::string connection_string;              ///< Information about the server to connect to
 	std::string join_server_password;           ///< The password to join the server with.
+	std::string p0_fixture_output;              ///< Disposable P0 fixture-builder output.
 	bool save_config = true;                    ///< The save config setting.
 
 	/**
@@ -440,6 +643,10 @@ struct AfterNewGRFScan : NewGRFScanCallback {
 			NetworkClientConnectGame(connection_string, COMPANY_NEW_COMPANY, join_server_password);
 		}
 
+		if (!p0_fixture_output.empty()) {
+			_p0_fixture_output = std::move(p0_fixture_output);
+		}
+
 		/* After the scan we're not used anymore. */
 		delete this;
 	}
@@ -474,7 +681,7 @@ static std::vector<OptionData> CreateOptions()
 {
 	std::vector<OptionData> options;
 	/* Options that require a parameter. */
-	for (char c : "GIMSbcmnpqrstv") options.push_back({ .type = ODF_HAS_VALUE, .id = c, .shortname = c });
+	for (char c : "GIMSZbcmnpqrstv") options.push_back({ .type = ODF_HAS_VALUE, .id = c, .shortname = c });
 
 	/* Options with an optional parameter. */
 	for (char c : "Ddg") options.push_back({ .type = ODF_OPTIONAL_VALUE, .id = c, .shortname = c });
@@ -525,6 +732,7 @@ int openttd_main(std::span<std::string_view> arguments)
 		case 'I': graphics_set = mgo.opt; break;
 		case 'S': sounds_set = mgo.opt; break;
 		case 'M': music_set = mgo.opt; break;
+		case 'Z': scanner->p0_fixture_output = mgo.opt; break;
 		case 'm': musicdriver = mgo.opt; break;
 		case 's': sounddriver = mgo.opt; break;
 		case 'v': videodriver = mgo.opt; break;
@@ -1343,6 +1551,10 @@ void GameLoop()
 		_request_newgrf_scan_callback = nullptr;
 		/* In case someone closed the game during our scan, don't do anything else. */
 		if (_exit_game) return;
+		if (!_p0_fixture_output.empty()) {
+			BuildP0Fixture();
+			return;
+		}
 	}
 
 	ProcessAsyncSaveFinish();
