{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/schema/command-set-v1.json",
  "title": "OpenTTD P0 command registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "schema_sha256", "registry_major",
    "registry_minor", "source_commit", "command_input_format",
    "action_type_zero_reserved", "published_ids_never_reused", "actions"
  ],
  "properties": {
    "$schema": {"const": "command-set.schema.json"},
    "schema_version": {"const": "openttd-p0-commands-v1"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_major": {"const": 1},
    "registry_minor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "source_commit": {"const": "29f808ef0022064e6d9a83c8476d1e0f4686af86"},
    "command_input_format": {"const": "OTRLCMD-v1.0-little-endian"},
    "action_type_zero_reserved": {"const": true},
    "published_ids_never_reused": {"const": true},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type", "name", "action_version", "native_command_id",
        "native_command_symbol", "payload_bytes", "payload_schema_sha256",
        "allowed_flags_mask", "company_context", "source_file", "source_line",
        "source_symbol", "operands"
      ],
      "properties": {
        "action_type": {"type": "integer", "minimum": 1, "maximum": 65535},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "action_version": {"const": 1},
        "native_command_id": {"type": "integer", "minimum": 0, "maximum": 255},
        "native_command_symbol": {"type": "string", "pattern": "^Commands::[A-Za-z0-9]+$"},
        "payload_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "payload_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "allowed_flags_mask": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "company_context": {"const": "action-header-u32-exact-company-id"},
        "source_file": {"type": "string", "pattern": "^src/.+\\.(?:h|cpp)$"},
        "source_line": {"type": "integer", "minimum": 1},
        "source_symbol": {"type": "string", "minLength": 3},
        "operands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operand"}}
      }
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "offset", "width_bits", "signedness", "role", "source_type", "domain", "encoding"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "offset": {"type": "integer", "minimum": 0, "maximum": 1048575},
        "width_bits": {"enum": [8, 16, 32, 64]},
        "count": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "signedness": {"enum": ["unsigned", "signed"]},
        "role": {"enum": ["native_operand", "stable_reference", "stable_result_slot", "reserved_zero"]},
        "source_type": {"type": "string", "minLength": 2},
        "domain": {"type": "string", "minLength": 3},
        "encoding": {"const": "fixed-width-little-endian"}
      }
    }
  }
}
