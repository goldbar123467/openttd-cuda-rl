{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/openttd-rl/tape-header-v1.schema.json",
  "title": "OpenTTD RL tape v1 canonical header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend_label",
    "diagnostic_features",
    "format",
    "identity",
    "initial",
    "limits",
    "projection_policy"
  ],
  "properties": {
    "backend_label": {"type": "string", "minLength": 1, "maxLength": 128},
    "diagnostic_features": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {"const": 1},
        "minor": {"const": 0}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_sha256",
        "command_input_sha256",
        "command_schema_sha256",
        "content_sha256",
        "executable_sha256",
        "field_schema_sha256",
        "fixture_sha256",
        "instrumentation_sha256",
        "newgrfs",
        "settings_sha256",
        "source_commit"
      ],
      "properties": {
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "command_input_sha256": {"$ref": "#/$defs/sha256"},
        "command_schema_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "field_schema_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "instrumentation_sha256": {"$ref": "#/$defs/sha256"},
        "newgrfs": {"type": "array", "maxItems": 0},
        "settings_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar_date",
        "calendar_fraction",
        "economy_date",
        "economy_fraction",
        "gameplay_rng_state",
        "interactive_rng_state",
        "native_tick",
        "public_step",
        "timers"
      ],
      "properties": {
        "calendar_date": {"$ref": "#/$defs/u32"},
        "calendar_fraction": {"$ref": "#/$defs/u32"},
        "economy_date": {"$ref": "#/$defs/u32"},
        "economy_fraction": {"$ref": "#/$defs/u32"},
        "gameplay_rng_state": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "interactive_rng_state": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "native_tick": {"$ref": "#/$defs/safeCounter"},
        "public_step": {"$ref": "#/$defs/safeCounter"},
        "timers": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {"$ref": "#/$defs/safeCounter"}
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_count",
        "field_bytes",
        "field_count",
        "header_bytes",
        "record_count",
        "record_payload_bytes",
        "tape_bytes"
      ],
      "properties": {
        "command_count": {"const": 1000000},
        "field_bytes": {"const": 67108864},
        "field_count": {"const": 10000000},
        "header_bytes": {"const": 1048576},
        "record_count": {"const": 50000000},
        "record_payload_bytes": {"const": 67108864},
        "tape_bytes": {"const": 1099511627776}
      }
    },
    "projection_policy": {"const": "complete"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "safeCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
