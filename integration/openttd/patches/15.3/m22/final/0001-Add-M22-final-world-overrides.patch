diff --git a/src/rl_v2_final_world.h b/src/rl_v2_final_world.h
new file mode 100644
index 0000000..685841b
--- /dev/null
+++ b/src/rl_v2_final_world.h
@@ -0,0 +1,82 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ */
+
+/** @file rl_v2_final_world.h Fail-closed M22 final-evaluation world projection. */
+
+#ifndef RL_V2_FINAL_WORLD_H
+#define RL_V2_FINAL_WORLD_H
+
+#include "settings_type.h"
+
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <cstdint>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <system_error>
+
+struct RlV2FinalWorld {
+	uint32_t width;
+	uint32_t height;
+	LandscapeType landscape;
+	bool active;
+};
+
+inline LandscapeType ParseRlV2FinalLandscape(std::string_view value)
+{
+	if (value == "temperate") return LandscapeType::Temperate;
+	if (value == "arctic") return LandscapeType::Arctic;
+	if (value == "tropic") return LandscapeType::Tropic;
+	if (value == "toyland") return LandscapeType::Toyland;
+	throw std::runtime_error("M22 final world override: unknown climate");
+}
+
+inline uint8_t RlV2FinalLog2(uint32_t value)
+{
+	uint8_t result = 0;
+	while (value > 1) {
+		value >>= 1;
+		++result;
+	}
+	return result;
+}
+
+inline uint32_t ParseRlV2FinalSide(const char *text, std::string_view name)
+{
+	uint32_t value = 0;
+	const char *end = text;
+	while (*end != '\0') ++end;
+	auto [position, error] = std::from_chars(text, end, value);
+	if (error != std::errc() || position != end) throw std::runtime_error("M22 final world override: malformed " + std::string(name));
+	return value;
+}
+
+inline RlV2FinalWorld GetRlV2FinalWorld(uint32_t default_width, uint32_t default_height, LandscapeType default_landscape)
+{
+	const char *token = std::getenv("OPENTTD_RL_M22_FINAL_TOKEN");
+	const char *width_text = std::getenv("OPENTTD_RL_M22_FINAL_WIDTH");
+	const char *height_text = std::getenv("OPENTTD_RL_M22_FINAL_HEIGHT");
+	const char *climate_text = std::getenv("OPENTTD_RL_M22_FINAL_CLIMATE");
+	const bool any = token != nullptr || width_text != nullptr || height_text != nullptr || climate_text != nullptr;
+	if (!any) return {default_width, default_height, default_landscape, false};
+	if (token == nullptr || width_text == nullptr || height_text == nullptr || climate_text == nullptr ||
+		std::string_view(token) != "m22-independent-final-v1") {
+		throw std::runtime_error("M22 final world override: incomplete or invalid final token");
+	}
+	const uint32_t width = ParseRlV2FinalSide(width_text, "width");
+	const uint32_t height = ParseRlV2FinalSide(height_text, "height");
+	constexpr std::array<uint32_t, 4> widths = {64, 128, 512, 1024};
+	constexpr std::array<uint32_t, 3> heights = {64, 128, 1024};
+	if (std::ranges::find(widths, width) == widths.end() || std::ranges::find(heights, height) == heights.end() ||
+		static_cast<uint64_t>(width) * height > (UINT64_C(1) << 20U)) {
+		throw std::runtime_error("M22 final world override: map rectangle is outside the preregistered domain");
+	}
+	return {width, height, ParseRlV2FinalLandscape(climate_text), true};
+}
+
+#endif /* RL_V2_FINAL_WORLD_H */
