+[[noreturn]] static void Fail(std::string_view message)
+{
+	throw std::runtime_error(fmt::format("M15 bounded observation: {}", message));
+}
+
+static void Require(bool condition, std::string_view message)
+{
+	if (!condition) Fail(message);
+}
+
+static float Unit(uint64_t value, uint64_t maximum)
+{
+	return maximum == 0 ? 0.0F : std::min(1.0F, static_cast<float>(value) / static_cast<float>(maximum));
+}
+
+static float SignedUnit(int64_t value, int64_t magnitude)
+{
+	return std::clamp(static_cast<float>(value) / static_cast<float>(magnitude), -1.0F, 1.0F);
+}
+
+static void AppendFloat(std::vector<uint8_t> &output, float value)
+{
+	static_assert(sizeof(float) == sizeof(uint32_t));
+	uint32_t bits = std::bit_cast<uint32_t>(value);
+	output.push_back(static_cast<uint8_t>(bits));
+	output.push_back(static_cast<uint8_t>(bits >> 8));
+	output.push_back(static_cast<uint8_t>(bits >> 16));
+	output.push_back(static_cast<uint8_t>(bits >> 24));
+}
+
+static void AppendFloats(std::vector<uint8_t> &output, const std::vector<float> &values)
+{
+	for (float value : values) AppendFloat(output, value);
+}
+
+class Sha256 {
+public:
+	void Update(std::span<const uint8_t> bytes)
+	{
+		for (uint8_t byte : bytes) {
+			this->block[this->block_size++] = byte;
+			this->bit_count += 8;
+			if (this->block_size == this->block.size()) {
+				this->Transform();
+				this->block_size = 0;
+			}
+		}
+	}
+
+	std::string Finish()
+	{
+		uint64_t message_bits = this->bit_count;
+		this->block[this->block_size++] = 0x80;
+		if (this->block_size > 56) {
+			while (this->block_size < 64) this->block[this->block_size++] = 0;
+			this->Transform();
+			this->block_size = 0;
+		}
+		while (this->block_size < 56) this->block[this->block_size++] = 0;
+		for (int shift = 56; shift >= 0; shift -= 8) this->block[this->block_size++] = static_cast<uint8_t>(message_bits >> shift);
+		this->Transform();
+
+		static constexpr char HEX[] = "0123456789abcdef";
+		std::string result;
+		result.reserve(64);
+		for (uint32_t word : this->state) {
+			for (int shift = 28; shift >= 0; shift -= 4) result.push_back(HEX[(word >> shift) & 0xF]);
+		}
+		return result;
+	}
+
+private:
+	static constexpr std::array<uint32_t, 64> K = {
+		0x428a2f98U, 0x71374491U, 0xb5c0fbcfU, 0xe9b5dba5U, 0x3956c25bU, 0x59f111f1U, 0x923f82a4U, 0xab1c5ed5U,
+		0xd807aa98U, 0x12835b01U, 0x243185beU, 0x550c7dc3U, 0x72be5d74U, 0x80deb1feU, 0x9bdc06a7U, 0xc19bf174U,
+		0xe49b69c1U, 0xefbe4786U, 0x0fc19dc6U, 0x240ca1ccU, 0x2de92c6fU, 0x4a7484aaU, 0x5cb0a9dcU, 0x76f988daU,
+		0x983e5152U, 0xa831c66dU, 0xb00327c8U, 0xbf597fc7U, 0xc6e00bf3U, 0xd5a79147U, 0x06ca6351U, 0x14292967U,
+		0x27b70a85U, 0x2e1b2138U, 0x4d2c6dfcU, 0x53380d13U, 0x650a7354U, 0x766a0abbU, 0x81c2c92eU, 0x92722c85U,
+		0xa2bfe8a1U, 0xa81a664bU, 0xc24b8b70U, 0xc76c51a3U, 0xd192e819U, 0xd6990624U, 0xf40e3585U, 0x106aa070U,
+		0x19a4c116U, 0x1e376c08U, 0x2748774cU, 0x34b0bcb5U, 0x391c0cb3U, 0x4ed8aa4aU, 0x5b9cca4fU, 0x682e6ff3U,
+		0x748f82eeU, 0x78a5636fU, 0x84c87814U, 0x8cc70208U, 0x90befffaU, 0xa4506cebU, 0xbef9a3f7U, 0xc67178f2U,
+	};
+
+	static uint32_t Rotate(uint32_t value, uint count) { return (value >> count) | (value << (32 - count)); }
+
+	void Transform()
+	{
+		std::array<uint32_t, 64> words{};
+		for (size_t i = 0; i < 16; ++i) {
+			words[i] = static_cast<uint32_t>(this->block[i * 4]) << 24 |
+					static_cast<uint32_t>(this->block[i * 4 + 1]) << 16 |
+					static_cast<uint32_t>(this->block[i * 4 + 2]) << 8 |
+					this->block[i * 4 + 3];
+		}
+		for (size_t i = 16; i < 64; ++i) {
+			uint32_t s0 = Rotate(words[i - 15], 7) ^ Rotate(words[i - 15], 18) ^ (words[i - 15] >> 3);
+			uint32_t s1 = Rotate(words[i - 2], 17) ^ Rotate(words[i - 2], 19) ^ (words[i - 2] >> 10);
+			words[i] = words[i - 16] + s0 + words[i - 7] + s1;
+		}
+		uint32_t a = this->state[0], b = this->state[1], c = this->state[2], d = this->state[3];
+		uint32_t e = this->state[4], f = this->state[5], g = this->state[6], h = this->state[7];
+		for (size_t i = 0; i < 64; ++i) {
+			uint32_t s1 = Rotate(e, 6) ^ Rotate(e, 11) ^ Rotate(e, 25);
+			uint32_t choice = (e & f) ^ (~e & g);
+			uint32_t temp1 = h + s1 + choice + K[i] + words[i];
+			uint32_t s0 = Rotate(a, 2) ^ Rotate(a, 13) ^ Rotate(a, 22);
+			uint32_t majority = (a & b) ^ (a & c) ^ (b & c);
+			uint32_t temp2 = s0 + majority;
+			h = g; g = f; f = e; e = d + temp1;
+			d = c; c = b; b = a; a = temp1 + temp2;
+		}
+		this->state[0] += a; this->state[1] += b; this->state[2] += c; this->state[3] += d;
+		this->state[4] += e; this->state[5] += f; this->state[6] += g; this->state[7] += h;
+	}
+
+	std::array<uint32_t, 8> state{0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU, 0x5be0cd19U};
+	std::array<uint8_t, 64> block{};
+	size_t block_size = 0;
+	uint64_t bit_count = 0;
+};
+
+static std::array<float, SPATIAL_CHANNELS> TileFeatures(int x, int y)
+{
+	std::array<float, SPATIAL_CHANNELS> result{};
+	if (x < 0 || y < 0 || x >= static_cast<int>(Map::SizeX()) || y >= static_cast<int>(Map::SizeY())) return result;
+	TileIndex tile = TileXY(x, y);
+	TileType type = GetTileType(tile);
+	result[0] = 1.0F;
+	if (type <= MP_OBJECT) result[1 + static_cast<size_t>(type)] = 1.0F;
+	result[12] = Unit(TileHeight(tile), 255);
+	result[13] = IsTileFlat(tile) ? 1.0F : 0.0F;
+	result[14] = type != MP_HOUSE && type != MP_VOID && type != MP_INDUSTRY && GetTileOwner(tile) == CompanyID::Begin() ? 1.0F : 0.0F;
+	result[15] = type != MP_CLEAR && type != MP_TREES && type != MP_WATER && type != MP_VOID ? 1.0F : 0.0F;
+	return result;
+}
+
+static std::vector<const Town *> OrderedTowns()
+{
+	std::vector<const Town *> result;
+	for (const Town *town : Town::Iterate()) result.push_back(town);
+	std::sort(result.begin(), result.end(), [](const Town *a, const Town *b) {
+		return std::tuple(-static_cast<int64_t>(a->cache.population), a->index.base()) < std::tuple(-static_cast<int64_t>(b->cache.population), b->index.base());
+	});
+	return result;
+}
+
+static uint32_t IndustryProduction(const Industry *industry)
+{
+	uint32_t result = 0;
+	for (const auto &cargo : industry->produced) result += cargo.waiting + cargo.rate;
+	return result;
+}
+
+static std::vector<const Industry *> OrderedIndustries()
+{
+	std::vector<const Industry *> result;
+	for (const Industry *industry : Industry::Iterate()) result.push_back(industry);
+	std::sort(result.begin(), result.end(), [](const Industry *a, const Industry *b) {
+		return std::tuple(-static_cast<int64_t>(IndustryProduction(a)), a->index.base()) < std::tuple(-static_cast<int64_t>(IndustryProduction(b)), b->index.base());
+	});
+	return result;
+}
+
+static uint32_t StationRating(const Station *station)
+{
+	uint32_t result = 0;
+	for (const GoodsEntry &goods : station->goods) result = std::max<uint32_t>(result, goods.rating);
+	return result;
+}
+
+static uint32_t StationWaiting(const Station *station)
+{
+	uint32_t result = 0;
+	for (const GoodsEntry &goods : station->goods) result += goods.TotalCount();
+	return result;
+}
+
+static std::vector<const Station *> OrderedStations()
+{
+	std::vector<const Station *> result;
+	for (const Station *station : Station::Iterate()) result.push_back(station);
+	std::sort(result.begin(), result.end(), [](const Station *a, const Station *b) {
+		return std::tuple(a->owner == CompanyID::Begin() ? 0 : 1, -static_cast<int>(StationRating(a)), a->index.base()) <
+				std::tuple(b->owner == CompanyID::Begin() ? 0 : 1, -static_cast<int>(StationRating(b)), b->index.base());
+	});
+	return result;
+}
+
+static std::vector<const Vehicle *> OrderedVehicles()
+{
+	std::vector<const Vehicle *> result;
+	for (const Vehicle *vehicle : Vehicle::Iterate()) result.push_back(vehicle);
+	std::sort(result.begin(), result.end(), [](const Vehicle *a, const Vehicle *b) {
