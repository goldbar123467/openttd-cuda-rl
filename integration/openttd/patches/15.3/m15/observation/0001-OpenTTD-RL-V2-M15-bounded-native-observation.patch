+static void WriteNew(const std::filesystem::path &path, std::span<const uint8_t> bytes)
+{
+	Require(!path.empty() && !std::filesystem::exists(path), fmt::format("output already exists: '{}'", path.string()));
+	std::ofstream stream(path, std::ios::binary | std::ios::out | std::ios::trunc);
+	if (!stream) Fail(fmt::format("cannot create output '{}'", path.string()));
+	stream.write(reinterpret_cast<const char *>(bytes.data()), bytes.size());
+	stream.flush();
+	if (!stream) Fail(fmt::format("cannot write output '{}'", path.string()));
+}
+
+static void WriteCanonicalNew(const std::filesystem::path &path, const json &value)
+{
+	Require(!path.empty() && !std::filesystem::exists(path), fmt::format("output already exists: '{}'", path.string()));
+	std::ofstream stream(path, std::ios::binary | std::ios::out | std::ios::trunc);
+	if (!stream) Fail(fmt::format("cannot create output '{}'", path.string()));
+	stream << value.dump() << '\n';
+	stream.flush();
+	if (!stream) Fail(fmt::format("cannot write output '{}'", path.string()));
+}
+
+} // namespace
+
+void WriteRlV2Observation(const std::string &metadata_path, uint32_t map_seed, uint32_t simulation_seed, uint32_t candidate_tiebreak_seed)
+{
+	auto towns = OrderedTowns();
+	auto industries = OrderedIndustries();
+	auto stations = OrderedStations();
+	auto vehicles = OrderedVehicles();
+	uint anchor_x = towns.empty() ? Map::SizeX() / 2 : TileX(towns.front()->xy);
+	uint anchor_y = towns.empty() ? Map::SizeY() / 2 : TileY(towns.front()->xy);
+
+	std::vector<uint8_t> output;
+	output.reserve(OBSERVATION_BYTES);
+	json sections = json::array();
+	json entity_counts = json::object();
+
+	std::vector<float> structured(STRUCTURED_FEATURES, 0.0F);
+	const Company *company = Company::Get(CompanyID::Begin());
+	structured[0] = Unit(Map::SizeX(), 4096);
+	structured[1] = Unit(Map::SizeY(), 4096);
+	structured[2] = Unit(Map::Size(), 1U << 20);
+	structured[3] = Unit(Town::GetNumItems(), TownID::End().base());
+	structured[4] = Unit(Industry::GetNumItems(), IndustryID::End().base());
+	structured[5] = Unit(Station::GetNumItems(), StationID::End().base());
+	structured[6] = Unit(Vehicle::GetNumItems(), VehicleID::End().base());
+	structured[7] = Unit(Company::GetNumItems(), 15);
+	structured[8] = SignedUnit(company->money.base(), 1000000000);
+	structured[9] = Unit(company->current_loan.base(), 1000000000);
+	structured[10] = Unit(anchor_x, std::max<uint>(1, Map::SizeX() - 1));
+	structured[11] = Unit(anchor_y, std::max<uint>(1, Map::SizeY() - 1));
+	structured[12] = 1.0F;
+	structured[13] = Unit(map_seed, std::numeric_limits<uint32_t>::max());
+	structured[14] = Unit(simulation_seed, std::numeric_limits<uint32_t>::max());
+	structured[15] = Unit(candidate_tiebreak_seed, std::numeric_limits<uint32_t>::max());
+	AppendTensor(output, sections, "structured", structured, {STRUCTURED_FEATURES});
+	AppendTensor(output, sections, "spatial.global", SpatialGlobal(), {SPATIAL_CHANNELS, 64, 64});
+	AppendTensor(output, sections, "spatial.regional", SpatialCrop(static_cast<int>(anchor_x) - 32, static_cast<int>(anchor_y) - 32, 64), {SPATIAL_CHANNELS, 64, 64});
+	AppendTensor(output, sections, "spatial.local", SpatialCrop(static_cast<int>(anchor_x) - 16, static_cast<int>(anchor_y) - 16, 32), {SPATIAL_CHANNELS, 32, 32});
+
+	std::vector<const Company *> companies;
+	for (const Company *item : Company::Iterate()) companies.push_back(item);
+	std::sort(companies.begin(), companies.end(), [](const Company *a, const Company *b) {
+		return std::tuple(a->index == CompanyID::Begin() ? 0 : 1, a->index.base()) < std::tuple(b->index == CompanyID::Begin() ? 0 : 1, b->index.base());
+	});
+	std::vector<std::vector<float>> company_rows;
+	for (const Company *item : companies) {
+		std::vector<float> row(32, 0.0F);
+		row[0] = Unit(item->index.base(), 14); row[1] = item->index == CompanyID::Begin() ? 1.0F : 0.0F;
+		row[2] = SignedUnit(item->money.base(), 1000000000); row[3] = Unit(item->current_loan.base(), 1000000000);
+		row[4] = Unit(item->max_loan.base(), 1000000000); row[5] = Unit(item->months_of_bankruptcy, 255);
+		company_rows.push_back(std::move(row));
+	}
+	AppendTable(output, sections, entity_counts, "companies", company_rows, companies.size(), 15, 32);
+
+	std::vector<std::vector<float>> town_rows;
+	for (size_t i = 0; i < std::min<size_t>(towns.size(), 128); ++i) {
+		const Town *town = towns[i];
+		std::vector<float> row(24, 0.0F);
+		row[0] = Unit(town->index.base(), TownID::End().base() - 1); row[1] = Unit(TileX(town->xy), std::max<uint>(1, Map::SizeX() - 1));
+		row[2] = Unit(TileY(town->xy), std::max<uint>(1, Map::SizeY() - 1)); row[3] = Unit(town->cache.population, 100000);
+		row[4] = Unit(town->cache.num_houses, 10000); row[5] = town->larger_town ? 1.0F : 0.0F;
+		town_rows.push_back(std::move(row));
+	}
+	AppendTable(output, sections, entity_counts, "towns", town_rows, towns.size(), 128, 24);
+
+	std::vector<std::vector<float>> industry_rows;
+	for (size_t i = 0; i < std::min<size_t>(industries.size(), 256); ++i) {
+		const Industry *industry = industries[i];
+		uint32_t waiting = 0, rate = 0;
+		for (const auto &cargo : industry->produced) { waiting += cargo.waiting; rate += cargo.rate; }
+		std::vector<float> row(24, 0.0F);
+		row[0] = Unit(industry->index.base(), IndustryID::End().base() - 1); row[1] = Unit(TileX(industry->location.tile), std::max<uint>(1, Map::SizeX() - 1));
+		row[2] = Unit(TileY(industry->location.tile), std::max<uint>(1, Map::SizeY() - 1)); row[3] = Unit(industry->type, 255);
+		row[4] = Unit(waiting, 65535); row[5] = Unit(rate, 2048); row[6] = Unit(industry->prod_level, 255);
+		row[7] = industry->town == nullptr ? 0.0F : Unit(industry->town->index.base(), TownID::End().base() - 1);
+		industry_rows.push_back(std::move(row));
+	}
+	AppendTable(output, sections, entity_counts, "industries", industry_rows, industries.size(), 256, 24);
+
+	std::vector<std::vector<float>> station_rows;
+	for (size_t i = 0; i < std::min<size_t>(stations.size(), 512); ++i) {
+		const Station *station = stations[i];
+		std::vector<float> row(32, 0.0F);
+		row[0] = Unit(station->index.base(), StationID::End().base() - 1); row[1] = Unit(TileX(station->xy), std::max<uint>(1, Map::SizeX() - 1));
+		row[2] = Unit(TileY(station->xy), std::max<uint>(1, Map::SizeY() - 1)); row[3] = station->owner == CompanyID::Begin() ? 1.0F : 0.0F;
+		row[4] = Unit(StationRating(station), 255); row[5] = Unit(StationWaiting(station), 65535);
+		station_rows.push_back(std::move(row));
+	}
+	AppendTable(output, sections, entity_counts, "stations", station_rows, stations.size(), 512, 32);
+
+	std::vector<std::vector<float>> vehicle_rows;
+	for (size_t i = 0; i < std::min<size_t>(vehicles.size(), 1024); ++i) {
+		const Vehicle *vehicle = vehicles[i];
+		std::vector<float> row(40, 0.0F);
+		row[0] = Unit(vehicle->index.base(), VehicleID::End().base() - 1); row[1] = Unit(vehicle->type, VEH_END - 1);
+		row[2] = vehicle->owner == CompanyID::Begin() ? 1.0F : 0.0F; row[3] = vehicle->IsPrimaryVehicle() ? 1.0F : 0.0F;
+		if (vehicle->tile != INVALID_TILE) {
+			row[4] = Unit(TileX(vehicle->tile), std::max<uint>(1, Map::SizeX() - 1)); row[5] = Unit(TileY(vehicle->tile), std::max<uint>(1, Map::SizeY() - 1));
+		}
+		row[6] = Unit(vehicle->cur_speed, 65535); row[7] = Unit(vehicle->breakdown_delay, 255); row[8] = Unit(vehicle->breakdown_ctr, 255);
+		row[9] = SignedUnit(vehicle->profit_this_year.base(), 1000000000); row[10] = SignedUnit(vehicle->profit_last_year.base(), 1000000000);
+		row[11] = SignedUnit(vehicle->value.base(), 1000000000); row[12] = Unit(vehicle->cargo.TotalCount(), std::max<uint16_t>(1, vehicle->cargo_cap));
+		vehicle_rows.push_back(std::move(row));
+	}
+	AppendTable(output, sections, entity_counts, "vehicles", vehicle_rows, vehicles.size(), 1024, 40);
+
+	std::vector<std::vector<float>> node_rows;
+	std::map<TownID, size_t> town_nodes;
+	std::map<IndustryID, size_t> industry_nodes;
+	for (size_t i = 0; i < std::min<size_t>(towns.size(), 128); ++i) {
+		const Town *town = towns[i];
+		town_nodes[town->index] = node_rows.size();
+		std::vector<float> row(24, 0.0F); row[0] = 0.0F; row[1] = Unit(town->index.base(), TownID::End().base() - 1);
+		row[2] = Unit(TileX(town->xy), std::max<uint>(1, Map::SizeX() - 1)); row[3] = Unit(TileY(town->xy), std::max<uint>(1, Map::SizeY() - 1)); row[4] = Unit(town->cache.population, 100000);
+		node_rows.push_back(std::move(row));
+	}
+	for (size_t i = 0; i < std::min<size_t>(industries.size(), 256); ++i) {
+		const Industry *industry = industries[i];
+		industry_nodes[industry->index] = node_rows.size();
+		std::vector<float> row(24, 0.0F); row[0] = 1.0F / 3.0F; row[1] = Unit(industry->index.base(), IndustryID::End().base() - 1);
+		row[2] = Unit(TileX(industry->location.tile), std::max<uint>(1, Map::SizeX() - 1)); row[3] = Unit(TileY(industry->location.tile), std::max<uint>(1, Map::SizeY() - 1)); row[4] = Unit(IndustryProduction(industry), 65535);
+		node_rows.push_back(std::move(row));
+	}
+	for (size_t i = 0; i < std::min<size_t>(stations.size(), 512); ++i) {
+		const Station *station = stations[i];
+		std::vector<float> row(24, 0.0F); row[0] = 2.0F / 3.0F; row[1] = Unit(station->index.base(), StationID::End().base() - 1);
+		row[2] = Unit(TileX(station->xy), std::max<uint>(1, Map::SizeX() - 1)); row[3] = Unit(TileY(station->xy), std::max<uint>(1, Map::SizeY() - 1)); row[4] = Unit(StationWaiting(station), 65535);
+		node_rows.push_back(std::move(row));
+	}
+	for (size_t i = 0; i < std::min<size_t>(vehicles.size(), 1024); ++i) {
+		const Vehicle *vehicle = vehicles[i];
+		std::vector<float> row(24, 0.0F); row[0] = 1.0F; row[1] = Unit(vehicle->index.base(), VehicleID::End().base() - 1);
+		if (vehicle->tile != INVALID_TILE) { row[2] = Unit(TileX(vehicle->tile), std::max<uint>(1, Map::SizeX() - 1)); row[3] = Unit(TileY(vehicle->tile), std::max<uint>(1, Map::SizeY() - 1)); }
+		row[4] = Unit(vehicle->type, VEH_END - 1); node_rows.push_back(std::move(row));
+	}
+	Require(node_rows.size() <= 2048, "selected graph nodes exceed capacity");
+
+	struct Edge { size_t source; size_t destination; uint kind; float distance; };
+	std::vector<Edge> edges;
+	for (const auto &[industry_id, source] : industry_nodes) {
+		const Industry *industry = Industry::Get(industry_id);
+		if (industry->town == nullptr) continue;
+		auto destination = town_nodes.find(industry->town->index);
+		if (destination == town_nodes.end()) continue;
+		float dx = static_cast<float>(TileX(industry->location.tile)) - TileX(industry->town->xy);
+		float dy = static_cast<float>(TileY(industry->location.tile)) - TileY(industry->town->xy);
+		float distance = std::sqrt(dx * dx + dy * dy) / std::sqrt(static_cast<float>(Map::SizeX() * Map::SizeX() + Map::SizeY() * Map::SizeY()));
+		edges.push_back({source, destination->second, 0, distance});
+		edges.push_back({destination->second, source, 1, distance});
+	}
+	std::sort(edges.begin(), edges.end(), [](const Edge &a, const Edge &b) { return std::tie(a.source, a.destination, a.kind) < std::tie(b.source, b.destination, b.kind); });
+	Require(edges.size() <= 8192, "selected graph edges exceed capacity");
+	std::vector<std::vector<float>> edge_rows;
+	for (const Edge &edge : edges) {
+		std::vector<float> row(16, 0.0F); row[0] = Unit(edge.source, 2047); row[1] = Unit(edge.destination, 2047);
+		row[2] = static_cast<float>(edge.kind); row[3] = edge.distance; edge_rows.push_back(std::move(row));
+	}
+	AppendTable(output, sections, entity_counts, "graph_nodes", node_rows, node_rows.size(), 2048, 24);
+	AppendTable(output, sections, entity_counts, "graph_edges", edge_rows, edge_rows.size(), 8192, 16);
+	/* Rename graph sections and keep graph counts out of the entity namespace. */
+	for (json &section : sections) {
+		std::string name = section.at("name");
+		if (name.starts_with("entities.graph_nodes.")) section["name"] = "graph.nodes." + name.substr(21);
+		if (name.starts_with("entities.graph_edges.")) section["name"] = "graph.edges." + name.substr(21);
+	}
+	json graph_counts = {{"edges", entity_counts.at("graph_edges")}, {"nodes", entity_counts.at("graph_nodes")}};
+	entity_counts.erase("graph_edges"); entity_counts.erase("graph_nodes");
+
+	Require(output.size() == OBSERVATION_BYTES, fmt::format("serialized {} bytes, expected {}", output.size(), OBSERVATION_BYTES));
+	Sha256 digest; digest.Update(output); std::string sha256 = digest.Finish();
+	std::filesystem::path metadata(metadata_path);
+	std::filesystem::path binary = metadata; binary.replace_extension(".bin");
+	Require(binary != metadata, "metadata path must have an extension distinct from .bin");
+	WriteNew(binary, output);
+	json metadata_value = {
+		{"schema_version", METADATA_SCHEMA_VERSION}, {"contract_sha256", CONTRACT_SHA256}, {"observation_schema_id", OBSERVATION_SCHEMA_ID},
+		{"binary", {{"bytes", output.size()}, {"encoding", "little-endian-float32-row-major-plus-uint8-masks"}, {"file", binary.filename().string()}, {"sha256", sha256}}},
+		{"snapshot", {{"anchor_x", anchor_x}, {"anchor_y", anchor_y}, {"height", Map::SizeY()}, {"map_seed", map_seed},
+			{"simulation_seed", simulation_seed}, {"candidate_tiebreak_seed", candidate_tiebreak_seed}, {"tick", TimerGameTick::counter},
+			{"tile_count", Map::Size()}, {"width", Map::SizeX()}, {"year", TimerGameCalendar::year.base()}}},
+		{"spatial", {{"channels", {"in_map", "clear", "railway", "road", "house", "trees", "station", "water", "void", "industry", "tunnel_bridge", "object", "height_u8", "flat", "owned_by_company_0", "developed", "reserved_16", "reserved_17", "reserved_18", "reserved_19", "reserved_20", "reserved_21", "reserved_22", "reserved_23", "reserved_24", "reserved_25", "reserved_26", "reserved_27", "reserved_28", "reserved_29", "reserved_30", "reserved_31"}}, {"local_origin", {static_cast<int>(anchor_x) - 16, static_cast<int>(anchor_y) - 16}}, {"regional_origin", {static_cast<int>(anchor_x) - 32, static_cast<int>(anchor_y) - 32}}}},
+		{"entities", entity_counts}, {"graph", graph_counts}, {"sections", sections},
+	};
+	WriteCanonicalNew(metadata, metadata_value);
+}
