+static void AddSection(json &sections, std::string_view name, size_t offset, size_t bytes, std::string_view dtype, json shape)
+{
+	sections.push_back({{"bytes", bytes}, {"dtype", dtype}, {"name", name}, {"offset", offset}, {"shape", std::move(shape)}});
+}
+
+static void AppendTensor(std::vector<uint8_t> &output, json &sections, std::string_view name, const std::vector<float> &values, json shape)
+{
+	size_t offset = output.size();
+	AppendFloats(output, values);
+	AddSection(sections, name, offset, output.size() - offset, "float32-le", std::move(shape));
+}
+
+static void AppendTable(std::vector<uint8_t> &output, json &sections, json &counts, std::string_view name,
+		const std::vector<std::vector<float>> &rows, size_t total_count, size_t capacity, size_t features)
+{
+	Require(rows.size() <= capacity, fmt::format("{} selected rows exceed capacity", name));
+	size_t values_offset = output.size();
+	for (const auto &row : rows) {
+		Require(row.size() == features, fmt::format("{} row width mismatch", name));
+		AppendFloats(output, row);
+	}
+	for (size_t i = rows.size(); i < capacity; ++i) for (size_t j = 0; j < features; ++j) AppendFloat(output, 0.0F);
+	AddSection(sections, fmt::format("entities.{}.values", name), values_offset, capacity * features * sizeof(float), "float32-le", {capacity, features});
+	size_t mask_offset = output.size();
+	output.insert(output.end(), rows.size(), 1);
+	output.insert(output.end(), capacity - rows.size(), 0);
+	AddSection(sections, fmt::format("entities.{}.mask", name), mask_offset, capacity, "uint8", {capacity});
+	counts[std::string(name)] = {
+		{"capacity", capacity}, {"omitted", total_count - rows.size()}, {"selected", rows.size()},
+		{"total", total_count}, {"truncated", total_count > rows.size()},
+	};
+}
+
+static std::vector<float> SpatialGlobal()
+{
+	std::vector<float> result(SPATIAL_CHANNELS * 64 * 64, 0.0F);
+	for (uint y = 0; y < Map::SizeY(); ++y) {
+		uint gy = static_cast<uint64_t>(y) * 64 / Map::SizeY();
+		for (uint x = 0; x < Map::SizeX(); ++x) {
+			uint gx = static_cast<uint64_t>(x) * 64 / Map::SizeX();
+			auto features = TileFeatures(x, y);
+			for (size_t channel = 0; channel < SPATIAL_CHANNELS; ++channel) result[channel * 4096 + gy * 64 + gx] += features[channel];
+		}
+	}
+	for (uint gy = 0; gy < 64; ++gy) {
+		uint y0 = static_cast<uint64_t>(gy) * Map::SizeY() / 64;
+		uint y1 = static_cast<uint64_t>(gy + 1) * Map::SizeY() / 64;
+		for (uint gx = 0; gx < 64; ++gx) {
+			uint x0 = static_cast<uint64_t>(gx) * Map::SizeX() / 64;
+			uint x1 = static_cast<uint64_t>(gx + 1) * Map::SizeX() / 64;
+			float divisor = static_cast<float>((x1 - x0) * (y1 - y0));
+			for (size_t channel = 0; channel < SPATIAL_CHANNELS; ++channel) result[channel * 4096 + gy * 64 + gx] /= divisor;
+		}
+	}
+	return result;
+}
+
+static std::vector<float> SpatialCrop(int origin_x, int origin_y, size_t side)
+{
+	std::vector<float> result(SPATIAL_CHANNELS * side * side, 0.0F);
+	for (size_t y = 0; y < side; ++y) {
+		for (size_t x = 0; x < side; ++x) {
+			auto features = TileFeatures(origin_x + static_cast<int>(x), origin_y + static_cast<int>(y));
+			for (size_t channel = 0; channel < SPATIAL_CHANNELS; ++channel) result[channel * side * side + y * side + x] = features[channel];
+		}
+	}
+	return result;
+}
