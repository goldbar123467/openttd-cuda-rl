+
+#include "safeguards.h"
+
+using nlohmann::json;
+
+extern Company *DoStartupNewCompany(bool is_ai, CompanyID company = CompanyID::Invalid());
+extern void MakeNewgameSettingsLive();
+
+namespace {
+
+static constexpr std::string_view SCHEMA_VERSION = "openttd-rl-v2-m15-reset-manifest-1";
+static constexpr std::string_view PROJECTION_SCHEMA_VERSION = "openttd-rl-v2-m15-reset-projection-1";
+static constexpr std::string_view CONTRACT_SHA256 = "b7a4ba1fc20507b77e2ef2ac01347665526cdbd4fc3e036587df5bdb3666d271";
+static constexpr uint32_t MAXIMUM_GENERATED_TILES = 1U << 20;
+
+struct ResetRequest {
+	uint16_t width;
+	uint16_t height;
+	uint32_t map_seed;
+	uint32_t simulation_seed;
+	uint32_t candidate_tiebreak_seed;
+	uint16_t town_target;
+	uint16_t industry_target;
+	std::string split;
+	std::string resource_tier;
+	std::string executable_sha256;
+};
+
+[[noreturn]] static void Fail(std::string_view message)
+{
+	throw std::runtime_error(fmt::format("M15 scalable reset: {}", message));
+}
+
+static void Require(bool condition, std::string_view message)
+{
+	if (!condition) Fail(message);
+}
+
+static json ReadCanonicalJson(const std::string &path)
+{
+	std::ifstream input(path, std::ios::binary);
+	if (!input) Fail(fmt::format("cannot open reset manifest '{}'", path));
+	std::string bytes((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+	Require(!bytes.empty() && bytes.back() == '\n', "reset manifest must end with one LF");
+	bytes.pop_back();
+	Require(!bytes.empty() && bytes.back() != '\n' && bytes.back() != '\r', "reset manifest has non-canonical trailing whitespace");
+	json value;
+	try {
+		value = json::parse(bytes);
+	} catch (const json::exception &e) {
+		Fail(fmt::format("invalid reset manifest JSON: {}", e.what()));
+	}
+	Require(value.dump() == bytes, "reset manifest must be canonical compact JSON followed by LF");
+	return value;
+}
+
+static bool IsNativeSide(uint16_t value)
+{
+	return value >= 64 && value <= 4096 && (value & (value - 1)) == 0;
+}
+
+static uint8_t Log2Side(uint16_t value)
+{
+	uint8_t result = 0;
+	while (value > 1) {
+		value >>= 1;
+		++result;
+	}
+	return result;
+}
+
+static ResetRequest ValidateManifest(const json &manifest)
+{
+	Require(manifest.is_object() && manifest.size() == 21, "reset manifest must contain schema_version and the 20 contracted fields");
+	Require(manifest.at("schema_version") == SCHEMA_VERSION, "unsupported reset manifest schema_version");
+	Require(manifest.at("contract_sha256") == CONTRACT_SHA256, "scalable contract identity mismatch");
+	Require(manifest.at("engine_source_tree") == "02d8cbbb0d8c030698d37ca76ab2773b6e23c397", "engine source tree mismatch");
+	Require(manifest.at("climate") == "temperate", "M15 reset climate must be temperate");
+	Require(manifest.at("start_year") == 1950, "M15 reset start year must be 1950");
+	Require(manifest.at("generation_mode") == "native-seeded", "M15 reset generation mode must be native-seeded");
+	Require(manifest.at("company_count") == 1, "M15 reset company_count must be one");
+	Require(manifest.at("v1_adapter") == false, "native scalable reset cannot enable the V1 adapter");
+	Require(manifest.at("rejection_reason").is_null(), "accepted reset manifest cannot carry a rejection reason");
+	Require(manifest.at("settings_manifest_sha256").get<std::string>().size() == 64, "settings manifest identity must be SHA-256");
+	Require(manifest.at("content_manifest_sha256").get<std::string>().size() == 64, "content manifest identity must be SHA-256");
+	Require(manifest.at("executable_sha256").get<std::string>().size() == 64, "executable identity must be SHA-256");
+
+	ResetRequest request{
+		manifest.at("map_width").get<uint16_t>(), manifest.at("map_height").get<uint16_t>(),
+		manifest.at("map_seed").get<uint32_t>(), manifest.at("simulation_seed").get<uint32_t>(), manifest.at("candidate_tiebreak_seed").get<uint32_t>(),
+		manifest.at("town_target").get<uint16_t>(), manifest.at("industry_target").get<uint16_t>(),
+		manifest.at("split").get<std::string>(), manifest.at("resource_tier").get<std::string>(), manifest.at("executable_sha256").get<std::string>(),
+	};
+	Require(IsNativeSide(request.width) && IsNativeSide(request.height), "map dimensions are not a native 64..4096 power-of-two rectangle");
+	uint64_t tile_count = static_cast<uint64_t>(request.width) * request.height;
+	Require(tile_count <= MAXIMUM_GENERATED_TILES, "tile count exceeds the M15 preflight generation budget");
+	uint16_t expected_towns = std::max<uint16_t>(2, std::min<uint16_t>(128, tile_count / 4096));
+	Require(request.town_target == expected_towns, "town target does not match max(2,min(128,tile_count//4096))");
+	Require(request.industry_target == 256, "M15 industry target must declare the 256-row observation cap");
+	Require(request.split == "training" || request.split == "development" || request.split == "generalization" || request.split == "final", "unknown seed split");
+	Require(request.resource_tier == "curriculum" || request.resource_tier == "generalization", "unsupported generated resource tier");
+	return request;
+}
+
+static void ConfigureSettings(const ResetRequest &request)
+{
+	_settings_newgame.game_creation.generation_seed = request.map_seed;
+	_settings_newgame.game_creation.starting_year = TimerGameCalendar::Year{1950};
+	_settings_newgame.game_creation.map_x = Log2Side(request.width);
+	_settings_newgame.game_creation.map_y = Log2Side(request.height);
+	_settings_newgame.game_creation.landscape = LandscapeType::Temperate;
+	_settings_newgame.game_creation.custom_town_number = request.town_target;
+	_settings_newgame.difficulty.number_towns = CUSTOM_TOWN_NUMBER_DIFFICULTY;
+	_settings_newgame.difficulty.max_no_competitors = 0;
+	_settings_newgame.difficulty.industry_density = ID_NORMAL;
+	_settings_newgame.difficulty.vehicle_breakdowns = 0;
+	_settings_newgame.difficulty.disasters = false;
+	_settings_newgame.economy.inflation = false;
+	_settings_newgame.economy.town_layout = TL_ORIGINAL;
+	_settings_newgame.economy.timekeeping_units = TKU_CALENDAR;
+	_settings_newgame.vehicle.max_aircraft = 0;
+	_settings_newgame.vehicle.max_roadveh = std::min<uint16_t>(5000, 16 + static_cast<uint32_t>(request.width) * request.height / 1024);
+	_settings_newgame.vehicle.max_ships = 0;
+	_settings_newgame.vehicle.max_trains = 0;
+	_settings_newgame.vehicle.never_expire_vehicles = true;
+
+	for (CompanyID id = CompanyID::Begin(); id < MAX_COMPANIES; ++id) _settings_newgame.script_config.ai[id].reset();
+	_settings_newgame.script_config.game.reset();
+	MakeNewgameSettingsLive();
+}
+
+static json ProjectTowns()
+{
+	json towns = json::array();
+	for (const Town *town : Town::Iterate()) {
+		towns.push_back({
+			{"id", town->index.base()},
+			{"population", town->cache.population},
+			{"x", TileX(town->xy)},
+			{"y", TileY(town->xy)},
+		});
+	}
+	return towns;
+}
+
+static json BuildProjection(const ResetRequest &request)
+{
+	uint32_t clear_tiles = 0;
+	uint32_t house_tiles = 0;
+	uint32_t road_tiles = 0;
+	uint32_t water_tiles = 0;
+	for (TileIndex tile{}; tile < Map::Size(); ++tile) {
+		switch (GetTileType(tile)) {
+			case MP_CLEAR: ++clear_tiles; break;
+			case MP_HOUSE: ++house_tiles; break;
+			case MP_ROAD: ++road_tiles; break;
+			case MP_WATER: ++water_tiles; break;
+			default: break;
+		}
+	}
+	const Company *company = Company::Get(CompanyID::Begin());
+	return {
+		{"schema_version", PROJECTION_SCHEMA_VERSION},
+		{"contract_sha256", CONTRACT_SHA256},
+		{"request", {
+			{"candidate_tiebreak_seed", request.candidate_tiebreak_seed},
+			{"executable_sha256", request.executable_sha256},
+			{"height", request.height},
+			{"industry_target", request.industry_target},
+			{"interactive_seed", request.simulation_seed ^ 0x524C5632U},
+			{"map_seed", request.map_seed},
+			{"resource_tier", request.resource_tier},
+			{"simulation_seed", request.simulation_seed},
+			{"split", request.split},
+			{"town_target", request.town_target},
+			{"width", request.width},
+		}},
+		{"state", {
+			{"company", {{"id", company->index.base()}, {"loan", company->current_loan.base()}, {"money", company->money.base()}}},
+			{"counts", {
+				{"companies", Company::GetNumItems()}, {"depots", Depot::GetNumItems()},
+				{"industries", Industry::GetNumItems()}, {"objects", Object::GetNumItems()},
+				{"order_lists", OrderList::GetNumItems()}, {"signs", Sign::GetNumItems()},
+				{"stations", Station::GetNumItems()}, {"subsidies", Subsidy::GetNumItems()},
+				{"towns", Town::GetNumItems()}, {"vehicles", Vehicle::GetNumItems()},
+			}},
+			{"date", {{"date_fract", TimerGameCalendar::date_fract}, {"tick", TimerGameTick::counter}, {"year", TimerGameCalendar::year.base()}}},
+			{"map", {
+				{"clear_tiles", clear_tiles}, {"height", Map::SizeY()}, {"house_tiles", house_tiles},
+				{"road_tiles", road_tiles}, {"tile_count", Map::Size()}, {"water_tiles", water_tiles}, {"width", Map::SizeX()},
+			}},
+			{"towns", ProjectTowns()},
+		}},
+	};
+}
+
+static void WriteCanonicalNew(const std::string &path, const json &value)
+{
+	std::filesystem::path output(path);
+	Require(!output.empty() && !std::filesystem::exists(output), fmt::format("projection output already exists: '{}'", path));
+	std::ofstream stream(output, std::ios::binary | std::ios::out | std::ios::trunc);
+	if (!stream) Fail(fmt::format("cannot create projection output '{}'", path));
+	stream << value.dump() << '\n';
+	stream.flush();
+	if (!stream) Fail(fmt::format("cannot write projection output '{}'", path));
+}
+
+} // namespace
+
+void RunRlV2ScalableReset(const std::string &manifest_path, const std::string &projection_path)
+{
+	ResetRequest request = ValidateManifest(ReadCanonicalJson(manifest_path));
+	ConfigureSettings(request);
+	_random.SetSeed(request.simulation_seed);
+	_interactive_random.SetSeed(request.simulation_seed ^ 0x524C5632U);
+	_game_mode = GM_NORMAL;
+	_switch_mode = SM_NONE;
+	/* The initial NewGRF scanner owns modal progress until its callback returns.
+	 * This synchronous reset owns the process after validation. */
+	SetModalProgress(false);
+	GenerateWorld(GWM_NEWGAME, request.width, request.height, false);
+	Require(Map::SizeX() == request.width && Map::SizeY() == request.height,
+		fmt::format("native map dimensions are {}x{}, expected {}x{}", Map::SizeX(), Map::SizeY(), request.width, request.height));
+	Require(Town::GetNumItems() >= 2 && Town::GetNumItems() <= request.town_target, "native town count is outside 2..town_target");
+	Require(Company::GetNumItems() == 0, "native reset unexpectedly created a company before explicit allocation");
+	Company *company = DoStartupNewCompany(false, CompanyID::Begin());
+	Require(company != nullptr && company->index == CompanyID::Begin(), "failed to create learning company 0");
+	SetLocalCompany(CompanyID::Begin());
+	_current_company = CompanyID::Begin();
+	WriteCanonicalNew(projection_path, BuildProjection(request));
+}
