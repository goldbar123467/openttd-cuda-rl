@@ -528,3 +615,182 @@ void WriteRlV2CandidatesAndMaybeExecute(const std::string &metadata_path, const
 		{"state_sha256_before",state_before},{"status",status},{"tick_after",TimerGameTick::counter},{"tick_before",tick_before}};
 	WriteCanonicalNew(result_path, result);
 }
+
+void RunRlV2EpisodeProgram(const std::string &program_path, const std::string &trace_path,
+	const std::string &artifact_directory, uint32_t map_seed, uint32_t simulation_seed,
+	uint32_t candidate_tiebreak_seed)
+{
+	json program = ReadCanonicalJson(program_path);
+	Require(program.is_object() && program.size() == 5, "episode program must contain exactly five fields");
+	Require(program.at("schema_version") == EPISODE_PROGRAM_SCHEMA_VERSION, "unsupported episode program schema_version");
+	Require(program.at("action_schema_id") == ACTION_SCHEMA_ID, "episode action schema mismatch");
+	Require(program.at("contract_sha256") == CONTRACT_SHA256, "episode contract mismatch");
+	Require(program.at("program_id").is_string() && SafeArtifactName(program.at("program_id").get<std::string>()), "invalid episode program_id");
+	Require(program.at("steps").is_array() && !program.at("steps").empty() && program.at("steps").size() <= 128,
+		"episode steps must be a nonempty array of at most 128 items");
+	std::filesystem::path artifact_root(artifact_directory);
+	Require(artifact_root.is_absolute() && std::filesystem::is_directory(artifact_root), "episode artifact directory must be an existing absolute directory");
+	Require(!std::filesystem::is_symlink(artifact_root), "episode artifact directory cannot be a symlink");
+	std::filesystem::path trace_output(trace_path);
+	Require(trace_output.is_absolute() && !std::filesystem::exists(trace_output), "episode trace must be a new absolute path");
+
+	std::string program_sha256 = Sha256File(program_path);
+	json trace_steps = json::array();
+	std::array<uint32_t, FAMILY_COUNT> executed_families{};
+	std::map<std::string, std::filesystem::path> save_slots;
+	std::map<std::string, CaptureDigest> equivalence_first;
+	std::map<std::string, uint32_t> equivalence_count;
+	uint64_t transition = 0;
+	std::string initial_state = NativeStateSha256();
+	json initial_counts = NativeCounts();
+	uint64_t initial_tick = TimerGameTick::counter;
+
+	for (size_t ordinal = 0; ordinal < program.at("steps").size(); ++ordinal) {
+		const json &step = program.at("steps").at(ordinal);
+		Require(step.is_object() && step.contains("operation") && step.contains("label"), "episode step lacks operation or label");
+		std::string operation = step.at("operation").get<std::string>();
+		std::string label = step.at("label").get<std::string>();
+		Require(SafeArtifactName(label), "invalid episode step label");
+		uint64_t tick_before = TimerGameTick::counter;
+		std::string state_before = NativeStateSha256();
+		json record = {{"label",label},{"operation",operation},{"ordinal",ordinal},{"state_sha256_before",state_before},{"tick_before",tick_before}};
+
+		if (operation == "ACTION") {
+			Require(step.size() == 5 && step.contains("family") && step.contains("selection") && step.contains("advance_ticks"),
+				"ACTION step must contain exactly operation,label,family,selection,advance_ticks");
+			Require(step.at("selection") == "FIRST" || step.at("selection") == "LAST", "selection must be FIRST or LAST");
+			uint32_t advance_ticks = step.at("advance_ticks").get<uint32_t>();
+			Require(advance_ticks <= 128, "ACTION advance_ticks exceeds 128");
+			size_t family = FamilyIndex(step.at("family").get<std::string>());
+			CandidateEnumeration enumeration = EnumerateCandidates();
+			Require(!enumeration.selected[family].empty(), fmt::format("ACTION family {} has no exposed legal candidate", FAMILY_NAMES[family]));
+			const Candidate &candidate = step.at("selection") == "FIRST" ? enumeration.selected[family].front() : enumeration.selected[family].back();
+			json execution = ExecuteCandidate(candidate);
+			std::string status = execution.at("status").get<std::string>();
+			Require(status == "SUCCESS" || status == "NO_OP", fmt::format("ACTION family {} returned {}", FAMILY_NAMES[family], status));
+			for (uint32_t tick = 0; tick < advance_ticks; ++tick) StateGameLoop();
+			++executed_families[family];
+			++transition;
+			record["advance_ticks"] = advance_ticks;
+			record["candidate"] = {{"cost",candidate.cost.base()},{"family_index",family},{"parameters",candidate.parameters},
+				{"priority",candidate.priority},{"stable_key",candidate.stable_key}};
+			record["candidate_semantic_sha256"] = CandidateSemanticSha256(enumeration);
+			record["family"] = FAMILY_NAMES[family];
+			record["native_commands"] = execution.at("native_commands");
+			record["rolled_back"] = execution.at("rolled_back");
+			record["selected_legal"] = enumeration.selected[family].size();
+			record["status"] = status;
+			record["total_legal"] = enumeration.total_legal[family];
+			record["transition"] = transition;
+		} else if (operation == "ROLLBACK") {
+			Require(step.size() == 4 && step.contains("family") && step.contains("selection"),
+				"ROLLBACK step must contain exactly operation,label,family,selection");
+			Require(step.at("family") == "SET_ROUTE", "ROLLBACK probe must target SET_ROUTE");
+			Require(step.at("selection") == "FIRST" || step.at("selection") == "LAST", "ROLLBACK selection must be FIRST or LAST");
+			size_t family = static_cast<size_t>(Family::SetRoute);
+			CandidateEnumeration enumeration = EnumerateCandidates();
+			Require(!enumeration.selected[family].empty(), "ROLLBACK SET_ROUTE has no exposed legal candidate");
+			const Candidate &candidate = step.at("selection") == "FIRST" ? enumeration.selected[family].front() : enumeration.selected[family].back();
+			json execution = ExecuteCandidate(candidate, true);
+			Require(execution.at("status") == "NATIVE_REJECTED" && execution.at("rolled_back") == true,
+				"ROLLBACK probe did not reject and restore the route transaction");
+			Require(TimerGameTick::counter == tick_before && NativeStateSha256() == state_before,
+				"ROLLBACK probe changed ticks or native state");
+			record["candidate"] = {{"cost",candidate.cost.base()},{"family_index",family},{"parameters",candidate.parameters},
+				{"priority",candidate.priority},{"stable_key",candidate.stable_key}};
+			record["family"] = FAMILY_NAMES[family];
+			record["native_commands"] = execution.at("native_commands");
+			record["rolled_back"] = true;
+			record["status"] = "NATIVE_REJECTED";
+		} else if (operation == "SAVE") {
+			Require(step.size() == 3 && step.contains("slot"), "SAVE step must contain exactly operation,label,slot");
+			std::string slot = step.at("slot").get<std::string>();
+			Require(SafeArtifactName(slot) && !save_slots.contains(slot), "SAVE slot is invalid or duplicated");
+			std::filesystem::path save_path = artifact_root / (slot + ".sav");
+			Require(!std::filesystem::exists(save_path), "SAVE artifact already exists");
+			Require(SaveOrLoad(save_path.string(), SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "native SAVE failed");
+			save_slots.emplace(slot, save_path);
+			record["bytes"] = std::filesystem::file_size(save_path);
+			record["save_sha256"] = Sha256File(save_path);
+			record["slot"] = slot;
+			record["status"] = "SUCCESS";
+		} else if (operation == "LOAD") {
+			Require(step.size() == 3 && step.contains("slot"), "LOAD step must contain exactly operation,label,slot");
+			std::string slot = step.at("slot").get<std::string>();
+			Require(save_slots.contains(slot), "LOAD references an unknown slot");
+			Require(SaveOrLoad(save_slots.at(slot).string(), SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "native LOAD failed");
+			SetLocalCompany(CompanyID::Begin());
+			_current_company = CompanyID::Begin();
+			record["save_sha256"] = Sha256File(save_slots.at(slot));
+			record["slot"] = slot;
+			record["status"] = "SUCCESS";
+		} else if (operation == "CAPTURE") {
+			Require(step.size() == 3 && step.contains("equivalence_group"), "CAPTURE step must contain exactly operation,label,equivalence_group");
+			std::string group = step.at("equivalence_group").get<std::string>();
+			Require(SafeArtifactName(group), "invalid CAPTURE equivalence_group");
+			std::filesystem::path save_path = artifact_root / (label + ".sav");
+			std::filesystem::path observation_path = artifact_root / (label + "-observation.json");
+			std::filesystem::path candidate_path = artifact_root / (label + "-candidates.json");
+			Require(!std::filesystem::exists(save_path), "CAPTURE save artifact already exists");
+			Require(SaveOrLoad(save_path.string(), SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "CAPTURE native SAVE failed");
+			std::string observation_sha256 = WriteRlV2Observation(observation_path.string(), map_seed, simulation_seed, candidate_tiebreak_seed);
+			WriteRlV2CandidatesAndMaybeExecute(candidate_path.string(), "", "", observation_sha256, map_seed, simulation_seed, candidate_tiebreak_seed);
+			json candidate_metadata = ReadCanonicalJson(candidate_path.string());
+			CandidateEnumeration enumeration = EnumerateCandidates();
+			CaptureDigest digest{NativeStateSha256(), Sha256File(save_path), observation_sha256,
+				candidate_metadata.at("binary").at("sha256").get<std::string>(), CandidateSemanticSha256(enumeration)};
+			if (equivalence_first.contains(group)) {
+				const CaptureDigest &first = equivalence_first.at(group);
+				Require(digest.state_sha256 == first.state_sha256, "CAPTURE state equivalence failed");
+				Require(digest.save_sha256 == first.save_sha256, "CAPTURE save-byte equivalence failed");
+				Require(digest.observation_sha256 == first.observation_sha256, "CAPTURE observation equivalence failed");
+				Require(digest.candidate_sha256 == first.candidate_sha256, "CAPTURE candidate-byte equivalence failed");
+				Require(digest.candidate_semantic_sha256 == first.candidate_semantic_sha256, "CAPTURE candidate semantic equivalence failed");
+			} else {
+				equivalence_first.emplace(group, digest);
+			}
+			++equivalence_count[group];
+			record["candidate_semantic_sha256"] = digest.candidate_semantic_sha256;
+			record["candidate_sha256"] = digest.candidate_sha256;
+			record["equivalence_group"] = group;
+			record["observation_sha256"] = digest.observation_sha256;
+			record["save_sha256"] = digest.save_sha256;
+			record["status"] = "SUCCESS";
+		} else {
+			Fail(fmt::format("unsupported episode operation '{}'", operation));
+		}
+		record["counts_after"] = NativeCounts();
+		record["state_sha256_after"] = NativeStateSha256();
+		record["tick_after"] = TimerGameTick::counter;
+		trace_steps.push_back(std::move(record));
+	}
+
+	json coverage = json::array();
+	bool all_families = true;
+	for (size_t family = 0; family < FAMILY_COUNT; ++family) {
+		coverage.push_back({{"executions",executed_families[family]},{"family_index",family},{"name",FAMILY_NAMES[family]}});
+		all_families = all_families && executed_families[family] > 0;
+	}
+	json equivalence = json::array();
+	bool replay_exact = !equivalence_count.empty();
+	for (const auto &[group, count] : equivalence_count) {
+		equivalence.push_back({{"captures",count},{"group",group},{"status",count >= 2 ? "EXACT" : "UNPAIRED"}});
+		replay_exact = replay_exact && count >= 2;
+	}
+	json trace = {
+		{"schema_version",EPISODE_TRACE_SCHEMA_VERSION},
+		{"action_schema_id",ACTION_SCHEMA_ID},
+		{"contract_sha256",CONTRACT_SHA256},
+		{"coverage",coverage},
+		{"equivalence_groups",equivalence},
+		{"final",{{"counts",NativeCounts()},{"state_sha256",NativeStateSha256()},{"tick",TimerGameTick::counter}}},
+		{"initial",{{"counts",initial_counts},{"state_sha256",initial_state},{"tick",initial_tick}}},
+		{"invariants",{{"all_action_families_executed",all_families},{"save_load_replay_exact",replay_exact}}},
+		{"program_id",program.at("program_id")},
+		{"program_sha256",program_sha256},
+		{"seeds",{{"candidate_tiebreak_seed",candidate_tiebreak_seed},{"map_seed",map_seed},{"simulation_seed",simulation_seed}}},
+		{"steps",trace_steps},
+		{"transitions",transition},
+	};
+	WriteCanonicalNew(trace_output, trace);
+}
