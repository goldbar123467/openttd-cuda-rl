+static size_t FamilyIndex(std::string_view name)
+{
+	for (size_t index = 0; index < FAMILY_NAMES.size(); ++index) {
+		if (FAMILY_NAMES[index] == name) return index;
+	}
+	Fail(fmt::format("unknown action family '{}'", name));
+}
+
+static std::string Sha256File(const std::filesystem::path &path)
+{
+	std::ifstream input(path, std::ios::binary);
+	Require(input.good(), fmt::format("cannot read artifact '{}'", path.string()));
+	Sha256 sha;
+	std::array<uint8_t, 65536> buffer{};
+	while (input) {
+		input.read(reinterpret_cast<char *>(buffer.data()), buffer.size());
+		std::streamsize count = input.gcount();
+		if (count > 0) sha.Update(std::span(buffer.data(), static_cast<size_t>(count)));
+	}
+	Require(input.eof(), fmt::format("failed while hashing artifact '{}'", path.string()));
+	return sha.Finish();
+}
+
+static std::string CandidateSemanticSha256(const CandidateEnumeration &enumeration)
+{
+	Sha256 sha;
+	auto add_u64 = [&sha](uint64_t value) {
+		std::array<uint8_t, 8> bytes{};
+		for (size_t index = 0; index < bytes.size(); ++index) bytes[index] = static_cast<uint8_t>(value >> (index * 8));
+		sha.Update(bytes);
+	};
+	for (size_t family = 0; family < FAMILY_COUNT; ++family) {
+		add_u64(family);
+		add_u64(enumeration.total_legal[family]);
+		add_u64(enumeration.selected[family].size());
+		for (const Candidate &candidate : enumeration.selected[family]) {
+			sha.Update(candidate.stable_key);
+			add_u64(candidate.priority);
+			add_u64(static_cast<uint64_t>(candidate.cost.base()));
+			for (uint32_t parameter : candidate.parameters) add_u64(parameter);
+		}
+	}
+	return sha.Finish();
+}
+
+static json NativeCounts()
+{
+	return {
+		{"companies", Company::GetNumItems()},
+		{"depots", Depot::GetNumItems()},
+		{"stations", Station::GetNumItems()},
+		{"towns", Town::GetNumItems()},
+		{"vehicles", Vehicle::GetNumItems()},
+	};
+}
+
+static bool SafeArtifactName(std::string_view value)
+{
+	return !value.empty() && value.size() <= 64 && std::all_of(value.begin(), value.end(), [](char character) {
+		return (character >= 'a' && character <= 'z') || (character >= '0' && character <= '9') || character == '-' || character == '_';
+	});
+}
+
+struct CaptureDigest {
+	std::string state_sha256;
+	std::string save_sha256;
+	std::string observation_sha256;
+	std::string candidate_sha256;
+	std::string candidate_semantic_sha256;
+};
+
