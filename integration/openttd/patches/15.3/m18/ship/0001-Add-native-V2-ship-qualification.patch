+static json RunService(CargoType cargo, bool constructed)
+{
+	json commands = json::array();
+	WaterRoute route = constructed ? BuildConstructedRoute(32, commands, true) :
+		BuildNaturalRoute(IsCargoInClass(cargo, CargoClass::Passengers) ? WaterClass::Sea : WaterClass::River, 32, commands, true);
+	ShipBuild build = BuildShip(route.depot, cargo, commands);
+	std::array<StationID, 2> orders{route.source, route.destination};
+	SetOrders(build.vehicle, orders, std::nullopt, commands);
+	InjectCargo(route.source, cargo, build.capacity);
+	uint loaded = LoadShipFromStation(build.vehicle, route.source, route.destination);
+	Require(loaded == build.capacity, "native station-to-ship loading did not fill ship");
+	SetDestinationAcceptance(route.destination, cargo);
+	Company *company = Company::Get(CompanyID::Begin());
+	Money income_before = company->cur_economy.income;
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	RlV2ClearCargoPaymentEvents();
+	StartVehicle(build.vehicle, commands);
+	uint64_t ticks = 0;
+	bool saw_lock = false;
+	bool saw_aqueduct = false;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(route.destination, cargo);
+		StateGameLoop();
+		++ticks;
+		const Ship *ship = Ship::Get(build.vehicle);
+		saw_lock |= IsTileType(ship->tile, MP_WATER) && IsLock(ship->tile);
+		saw_aqueduct |= IsBridgeTile(ship->tile) && GetTunnelBridgeTransportType(ship->tile) == TRANSPORT_WATER;
+	}
+	Money income = company->cur_economy.income - income_before;
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	const Ship *ship = Ship::Get(build.vehicle);
+	Require(delivered > 0 && income > 0 && !ship->vehstatus.Test(VehState::Crashed),
+		fmt::format("ship service failed: constructed={}, cargo={}, ticks={}, tile={}, lost={}, delivered={}, income={}, onboard={}, events={}",
+			constructed, CargoText(cargo), ticks, ship->tile.base(), ship->vehicle_flags.Test(VehicleFlag::PathfinderLost),
+			delivered, income.base(), ship->cargo.StoredCount(), RlV2GetCargoPaymentEvents().size()));
+	if (constructed) Require(saw_lock && saw_aqueduct, "constructed service did not observably traverse lock and aqueduct");
+	RlV2ClearQualificationAcceptance();
+	return {{"accounting", {{"delivered", delivered}, {"income", income.base()}, {"payment_events", PaymentEvents()}}},
+		{"commands", std::move(commands)}, {"route", {{"aqueduct_traversed", saw_aqueduct}, {"constructed", constructed},
+			{"lock_traversed", saw_lock}, {"water_class", WATER_CLASS_NAMES[to_underlying(route.water_class)]}}},
+		{"ship", {{"capacity", build.capacity}, {"engine", build.engine.base()},
+			{"lost", ship->vehicle_flags.Test(VehicleFlag::PathfinderLost)}, {"vehicle", build.vehicle.base()}}}, {"ticks", ticks}};
+}
