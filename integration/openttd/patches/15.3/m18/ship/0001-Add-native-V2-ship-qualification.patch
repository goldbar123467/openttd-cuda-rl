+static json ConstructionOracle()
+{
+	json commands = json::array();
+	WaterRoute route = BuildConstructedRoute(32, commands, true);
+	Require(GetWaterClass(TileXY(6, 32)) == WaterClass::Canal && GetTileOwner(TileXY(6, 32)) == CompanyID::Begin(),
+		"canal class or ownership projection failed");
+	CommandCost invalid_class = Command<CMD_BUILD_CANAL>::Do({}, TileXY(4, 4), TileXY(4, 4), WaterClass::Invalid, false);
+	commands.push_back(CostRecord("CMD_BUILD_CANAL_INVALID_CLASS", invalid_class));
+	Require(invalid_class.Failed(), "invalid water class was accepted");
+
+	MakeNaturalRange(6, 14, 14, WaterClass::Sea, 0);
+	SetHorizontalTileHeights(5, 14, 1, 0);
+	StationID joined = BuildDock(TileXY(5, 14), NEW_STATION, commands);
+	MakeNaturalRange(6, 14, 18, WaterClass::River, 1);
+	SetHorizontalTileHeights(5, 18, 2, 1);
+	Require(BuildDock(TileXY(5, 18), joined, commands) == joined, "explicit distant dock join failed");
+	const Station *joined_station = Station::Get(joined);
+	uint joined_area = static_cast<uint>(joined_station->rect.right - joined_station->rect.left + 1) *
+		static_cast<uint>(joined_station->rect.bottom - joined_station->rect.top + 1);
+	Require(joined_station->facilities.Test(StationFacility::Dock) && joined_area >= 2, "joined dock station geometry/facility projection failed");
+
+	CommandCost dock_remove = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, TileXY(5, 14));
+	commands.push_back(CostRecord("CMD_REMOVE_DOCK", dock_remove));
+	Require(dock_remove.Succeeded() && !IsDockTile(TileXY(5, 14)) && Station::IsValidID(joined), "dock removal destroyed joined station or failed");
+	CommandCost buoy_remove = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, TileXY(42, 32));
+	commands.push_back(CostRecord("CMD_REMOVE_BUOY", buoy_remove));
+	Require(buoy_remove.Succeeded() && !IsBuoyTile(TileXY(42, 32)), "buoy removal failed");
+	CommandCost depot_remove = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, route.depot);
+	commands.push_back(CostRecord("CMD_REMOVE_SHIP_DEPOT", depot_remove));
+	Require(depot_remove.Succeeded() && !IsShipDepotTile(route.depot), "ship-depot removal failed");
+	CommandCost lock_remove = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, route.lock);
+	commands.push_back(CostRecord("CMD_REMOVE_LOCK", lock_remove));
+	Require(lock_remove.Succeeded() && !(IsWaterTile(route.lock) && IsLock(route.lock)), "lock removal failed");
+	CommandCost aqueduct_remove = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, route.aqueduct_start);
+	commands.push_back(CostRecord("CMD_REMOVE_AQUEDUCT", aqueduct_remove));
+	Require(aqueduct_remove.Succeeded() && !IsBridgeTile(route.aqueduct_start), "aqueduct removal failed");
+	CommandCost canal_remove = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, TileXY(8, 32));
+	commands.push_back(CostRecord("CMD_REMOVE_CANAL", canal_remove));
+	Require(canal_remove.Succeeded() && (!IsTileType(TileXY(8, 32), MP_WATER) || !IsCanal(TileXY(8, 32))),
+		"canal removal failed");
+
+	AutoRestoreBackup company(_current_company, CompanyID{1});
+	CommandCost ownership = Command<CMD_LANDSCAPE_CLEAR>::Do({}, TileXY(7, 32));
+	commands.push_back(CostRecord("CMD_REMOVE_FOREIGN_CANAL", ownership));
+	Require(ownership.Failed(), "foreign canal removal was accepted");
+	for (TileIndex tile : Map::Iterate()) {
+		if (IsTileType(tile, MP_WATER)) SetNonFloodingWaterTile(tile, true);
+	}
+	return {{"commands", std::move(commands)}, {"distant_dock_join", true}, {"invalid_class_rejected", true},
+		{"removal_roundtrip", {{"aqueduct", true}, {"buoy", true}, {"canal", true}, {"depot", true}, {"dock", true}, {"lock", true}}},
+		{"water_classes", {"canal", "river", "sea"}}};
+}
