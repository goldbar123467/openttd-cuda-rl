+static WaterRoute BuildNaturalRoute(WaterClass water_class, uint y, json &commands, bool fixtures = true)
+{
+	Require(water_class == WaterClass::Sea || water_class == WaterClass::River, "natural route needs sea or river");
+	uint height = water_class == WaterClass::Sea ? 0 : 1;
+	MakeNaturalRange(6, 55, y, water_class, height);
+	SetHorizontalTileHeights(5, y, height + 1, height);
+	SetHorizontalTileHeights(56, y, height, height + 1);
+	StationID source = BuildDock(TileXY(5, y), NEW_STATION, commands);
+	StationID destination = BuildDock(TileXY(56, y), NEW_STATION, commands);
+	TileIndex depot = fixtures ? BuildDepot(TileXY(10, y), AXIS_X, commands) : INVALID_TILE;
+	if (fixtures) BuildBuoy(TileXY(40, y), commands);
+	return {source, destination, depot, INVALID_TILE, INVALID_TILE, INVALID_TILE, water_class};
+}
+
+static WaterRoute BuildFlatCanalRoute(uint y, json &commands, bool fixtures = true)
+{
+	SetHorizontalTileHeights(5, y, 2, 1);
+	SetHorizontalTileHeights(56, y, 1, 2);
+	BuildCanalRange(6, 55, y, commands);
+	StationID source = BuildDock(TileXY(5, y), NEW_STATION, commands);
+	StationID destination = BuildDock(TileXY(56, y), NEW_STATION, commands);
+	TileIndex depot = fixtures ? BuildDepot(TileXY(10, y), AXIS_X, commands) : INVALID_TILE;
+	if (fixtures) BuildBuoy(TileXY(40, y), commands);
+	return {source, destination, depot, INVALID_TILE, INVALID_TILE, INVALID_TILE, WaterClass::Canal};
+}
+
+static WaterRoute BuildConstructedRoute(uint y, json &commands, bool fixtures = true)
+{
+	for (uint x = 6; x <= 20; ++x) SetHorizontalTileHeights(x, y, 1, 1);
+	for (uint x = 21; x <= 30; ++x) SetHorizontalTileHeights(x, y, 2, 2);
+	for (uint x = 31; x <= 36; ++x) SetHorizontalTileHeights(x, y, 1, 1);
+	for (uint x = 37; x <= 56; ++x) SetHorizontalTileHeights(x, y, 2, 2);
+	SetHorizontalTileHeights(5, y, 2, 1);
+	SetHorizontalTileHeights(20, y, 1, 2);
+	SetHorizontalTileHeights(30, y, 2, 1);
+	SetHorizontalTileHeights(36, y, 1, 2);
+	SetHorizontalTileHeights(56, y, 2, 3);
+	BuildCanalRange(6, 19, y, commands);
+	BuildCanalRange(21, 29, y, commands);
+	BuildCanalRange(37, 55, y, commands);
+	TileIndex lock = TileXY(20, y);
+	CommandCost lock_test = Command<CMD_BUILD_LOCK>::Do({}, lock);
+	commands.push_back(CostRecord("CMD_BUILD_LOCK_TEST", lock_test));
+	Require(lock_test.Succeeded(), "lock test failed");
+	CommandCost lock_execute = Command<CMD_BUILD_LOCK>::Do(DoCommandFlag::Execute, lock);
+	commands.push_back(CostRecord("CMD_BUILD_LOCK", lock_execute));
+	Require(lock_execute.Succeeded() && IsTileType(lock, MP_WATER) && IsLock(lock) && GetLockPart(lock) == LockPart::Middle, "lock execution failed");
+	TileIndex aqueduct_start = TileXY(30, y);
+	TileIndex aqueduct_end = TileXY(36, y);
+	CommandCost aqueduct_test = Command<CMD_BUILD_BRIDGE>::Do({}, aqueduct_end, aqueduct_start, TRANSPORT_WATER, 0, 0);
+	commands.push_back(CostRecord("CMD_BUILD_AQUEDUCT_TEST", aqueduct_test));
+	Require(aqueduct_test.Succeeded(), "aqueduct test failed");
+	CommandCost aqueduct_execute = Command<CMD_BUILD_BRIDGE>::Do(DoCommandFlag::Execute, aqueduct_end, aqueduct_start, TRANSPORT_WATER, 0, 0);
+	commands.push_back(CostRecord("CMD_BUILD_AQUEDUCT", aqueduct_execute));
+	Require(aqueduct_execute.Succeeded() && IsBridgeTile(aqueduct_start) && IsBridgeTile(aqueduct_end) &&
+		GetTunnelBridgeTransportType(aqueduct_start) == TRANSPORT_WATER, "aqueduct execution failed");
+	StationID source = BuildDock(TileXY(5, y), NEW_STATION, commands);
+	StationID destination = BuildDock(TileXY(56, y), NEW_STATION, commands);
+	TileIndex depot = fixtures ? BuildDepot(TileXY(10, y), AXIS_X, commands) : INVALID_TILE;
+	if (fixtures) BuildBuoy(TileXY(42, y), commands);
+	return {source, destination, depot, lock, aqueduct_start, aqueduct_end, WaterClass::Canal};
+}
+
+static ShipBuild BuildShip(TileIndex depot, CargoType cargo, json &commands)
+{
+	for (const Engine *engine : Engine::IterateType(VEH_SHIP)) {
+		if (!engine->company_avail.Test(CompanyID::Begin()) || !engine->CanCarryCargo()) continue;
+		if (!HasBit(GetUnionOfArticulatedRefitMasks(engine->index, true), cargo)) continue;
+		auto result = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, depot, engine->index, true, cargo, INVALID_CLIENT_ID);
+		commands.push_back(CostRecord("CMD_BUILD_VEHICLE_SHIP", std::get<0>(result)));
+		if (std::get<0>(result).Failed()) continue;
+		VehicleID vehicle = std::get<1>(result);
+		auto refit = Command<CMD_REFIT_VEHICLE>::Do(DoCommandFlag::Execute, vehicle, cargo, 0, false, false, 0);
+		commands.push_back(CostRecord("CMD_REFIT_SHIP", std::get<0>(refit)));
+		Require(std::get<0>(refit).Succeeded(), "ship refit failed after build");
+		const Ship *ship = Ship::Get(vehicle);
+		Require(ship->cargo_type == cargo && ship->cargo_cap > 0 && ship->IsInDepot(), "built ship has wrong cargo, capacity, or location");
+		return {vehicle, engine->index, ship->cargo_cap};
+	}
+	Fail(fmt::format("no buildable ship for cargo {}", CargoText(cargo)));
+}
+
+static void SetOrders(VehicleID vehicle, std::span<const StationID> stations, std::optional<size_t> transfer_ordinal, json &commands)
+{
+	for (size_t ordinal = 0; ordinal < stations.size(); ++ordinal) {
+		Order order;
+		order.MakeGoToStation(stations[ordinal]);
+		order.SetStopLocation(OrderStopLocation::FarEnd);
+		if (transfer_ordinal.has_value() && *transfer_ordinal == ordinal) {
+			order.SetUnloadType(OrderUnloadType::Transfer);
+			order.SetLoadType(OrderLoadType::NoLoad);
+		}
+		CommandCost cost = Command<CMD_INSERT_ORDER>::Do(DoCommandFlag::Execute, vehicle,
+			VehicleOrderID{static_cast<uint8_t>(ordinal)}, order);
+		commands.push_back(CostRecord("CMD_INSERT_SHIP_ORDER", cost));
+		Require(cost.Succeeded(), fmt::format("failed to insert vehicle order ordinal={} station={} error={}",
+			ordinal, stations[ordinal].base(), static_cast<uint64_t>(cost.GetErrorMessage())));
+	}
+}
+
+static void ModifyOrder(VehicleID vehicle, VehicleOrderID ordinal, ModifyOrderFlags field, uint16_t value,
+	std::string_view name, json &commands)
+{
+	CommandCost test = Command<CMD_MODIFY_ORDER>::Do({}, vehicle, ordinal, field, value);
+	commands.push_back(CostRecord(fmt::format("{}_TEST", name), test));
+	Require(test.Succeeded(), fmt::format("order modification test failed: {}", name));
+	CommandCost execute = Command<CMD_MODIFY_ORDER>::Do(DoCommandFlag::Execute, vehicle, ordinal, field, value);
+	commands.push_back(CostRecord(name, execute));
+	Require(execute.Succeeded(), fmt::format("order modification execution failed: {}", name));
+}
