+		engines.push_back({{"acceleration", info.acceleration}, {"available", engine->company_avail.Test(CompanyID::Begin())},
+			{"canal_speed_fraction", info.canal_speed_frac}, {"capacity", info.capacity}, {"engine_id", engine->index.base()},
+			{"max_speed", info.max_speed}, {"ocean_speed_fraction", info.ocean_speed_frac}, {"refit_cargos", std::move(refit)}});
