+static void ResetWorld(const Request &request)
+{
+	Configure(request);
+	_random.SetSeed(request.seed ^ 0x4d313853U);
+	_interactive_random.SetSeed(request.seed ^ 0x53484950U);
+	_game_mode = GM_NORMAL;
+	_switch_mode = SM_NONE;
+	SetModalProgress(false);
+	uint map_side = request.probe == "shipai-scenario" ? 128 : MAP_SIDE;
+	GenerateWorld(GWM_EMPTY, map_side, map_side, false);
+	Require(Map::SizeX() == map_side && Map::SizeY() == map_side, "empty qualification map has wrong dimensions");
+	{
+		AutoRestoreBackup company(_current_company, OWNER_DEITY);
+		if (request.probe == "shipai-scenario") {
+			for (uint y = 8; y <= 119; ++y) {
+				SetTileHeight(TileXY(47, y), 1);
+				for (uint x = 48; x <= 80; ++x) SetTileHeight(TileXY(x, y), 0);
+				SetTileHeight(TileXY(81, y), 1);
+			}
+			for (uint y = 8; y <= 118; ++y) {
+				for (uint x = 48; x <= 79; ++x) {
+					MakeSea(TileXY(x, y));
+					InvalidateWaterRegion(TileXY(x, y));
+				}
+			}
+			for (auto [tile, name] : {std::pair{TileXY(40, 64), std::string("Westhaven")},
+					std::pair{TileXY(87, 64), std::string("Easthaven")}}) {
+				auto [cost, required_money, town_id] = Command<CMD_FOUND_TOWN>::Do(DoCommandFlag::Execute, tile, TSZ_LARGE,
+					false, TL_ORIGINAL, false, 0, name);
+				(void)required_money;
+				Require(cost.Succeeded() && Town::IsValidID(town_id), "failed to create ShipAI coast town");
+			}
+		} else {
+			auto [cost, required_money, town_id] = Command<CMD_FOUND_TOWN>::Do(DoCommandFlag::Execute, TileXY(12, 12), TSZ_SMALL,
+				false, TL_ORIGINAL, false, 0, std::string("M18 Water Oracle Town"));
+			(void)required_money;
+			Require(cost.Succeeded() && Town::IsValidID(town_id), "failed to create qualification town");
+		}
+	}
+	Company *company = DoStartupNewCompany(false, CompanyID::Begin());
+	Require(company != nullptr && company->index == CompanyID::Begin(), "failed to create qualification company");
+	SetLocalCompany(CompanyID::Begin());
+	_current_company = CompanyID::Begin();
+	Require(Command<CMD_INCREASE_LOAN>::Do(DoCommandFlag::Execute, LoanCommand::Max, Money{0}).Succeeded(), "failed to fund qualification company");
+	AllocateWaterRegions();
+}
+
+static void SetVertex(uint x, uint y, uint height)
+{
+	Require(x < Map::SizeX() && y < Map::SizeY(), "height fixture vertex outside map");
+	SetTileHeight(TileXY(x, y), height);
+}
+
+static void SetHorizontalTileHeights(uint x, uint y, uint left, uint right)
+{
+	SetVertex(x, y, left);
+	SetVertex(x, y + 1, left);
+	SetVertex(x + 1, y, right);
+	SetVertex(x + 1, y + 1, right);
+}
+
+static void MakeNaturalRange(uint first_x, uint last_x, uint y, WaterClass water_class, uint height)
+{
+	for (uint x = first_x; x <= last_x + 1; ++x) {
+		SetVertex(x, y, height);
+		SetVertex(x, y + 1, height);
+	}
+	for (uint x = first_x; x <= last_x; ++x) {
+		TileIndex tile = TileXY(x, y);
+		if (water_class == WaterClass::Sea) MakeSea(tile); else MakeRiver(tile, static_cast<uint8_t>(x * 17 + y));
+		InvalidateWaterRegion(tile);
+		MarkTileDirtyByTile(tile);
+	}
+}
+
+static void BuildCanalRange(uint first_x, uint last_x, uint y, json &commands)
+{
+	TileIndex first = TileXY(first_x, y);
+	TileIndex last = TileXY(last_x, y);
+	CommandCost test = Command<CMD_BUILD_CANAL>::Do({}, last, first, WaterClass::Canal, false);
+	commands.push_back(CostRecord("CMD_BUILD_CANAL_TEST", test));
+	Require(test.Succeeded(), fmt::format("canal test failed for x={}..{} y={}", first_x, last_x, y));
+	CommandCost execute = Command<CMD_BUILD_CANAL>::Do(DoCommandFlag::Execute, last, first, WaterClass::Canal, false);
+	commands.push_back(CostRecord("CMD_BUILD_CANAL", execute));
+	Require(execute.Succeeded(), "canal execution diverged from test");
+	for (uint x = first_x; x <= last_x; ++x) Require(IsCanal(TileXY(x, y)), "canal did not materialize with canal water class");
+}
+
+static StationID BuildDock(TileIndex land, StationID join, json &commands)
+{
+	CommandCost test = Command<CMD_BUILD_DOCK>::Do({}, land, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_DOCK_TEST", test));
+	Require(test.Succeeded(), fmt::format("dock test failed at {}", land.base()));
+	CommandCost execute = Command<CMD_BUILD_DOCK>::Do(DoCommandFlag::Execute, land, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_DOCK", execute));
+	Require(execute.Succeeded() && IsDockTile(land), "dock execution failed");
+	StationID station = GetStationIndex(land);
+	Require(Station::IsValidID(station) && (join == NEW_STATION || station == join), "dock station identity or join diverged");
+	return station;
+}
+
+static TileIndex BuildDepot(TileIndex tile, Axis axis, json &commands)
+{
+	CommandCost test = Command<CMD_BUILD_SHIP_DEPOT>::Do({}, tile, axis);
+	commands.push_back(CostRecord("CMD_BUILD_SHIP_DEPOT_TEST", test));
+	Require(test.Succeeded(), "ship-depot test failed");
+	CommandCost execute = Command<CMD_BUILD_SHIP_DEPOT>::Do(DoCommandFlag::Execute, tile, axis);
+	commands.push_back(CostRecord("CMD_BUILD_SHIP_DEPOT", execute));
+	Require(execute.Succeeded() && IsShipDepotTile(tile), "ship depot execution failed");
+	return tile;
+}
+
+static void BuildBuoy(TileIndex tile, json &commands)
+{
+	CommandCost test = Command<CMD_BUILD_BUOY>::Do({}, tile);
+	commands.push_back(CostRecord("CMD_BUILD_BUOY_TEST", test));
+	Require(test.Succeeded(), "buoy test failed");
+	CommandCost execute = Command<CMD_BUILD_BUOY>::Do(DoCommandFlag::Execute, tile);
+	commands.push_back(CostRecord("CMD_BUILD_BUOY", execute));
+	Require(execute.Succeeded() && IsBuoyTile(tile), "buoy execution failed");
+}
