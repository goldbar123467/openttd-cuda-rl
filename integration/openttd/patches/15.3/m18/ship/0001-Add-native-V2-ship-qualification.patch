+static json Catalog()
+{
+	json water_classes = json::array();
+	for (size_t index = 0; index < WATER_CLASS_NAMES.size(); ++index) {
+		water_classes.push_back({{"id", index}, {"name", WATER_CLASS_NAMES[index]}});
