+static bool IndependentlyReachable(TileIndex start, TileIndex destination)
+{
+	std::deque<TileIndex> queue{start};
+	std::set<TileIndex> visited{start};
+	while (!queue.empty()) {
+		TileIndex tile = queue.front();
+		queue.pop_front();
+		if (tile == destination) return true;
+		for (DiagDirection direction = DIAGDIR_BEGIN; direction < DIAGDIR_END; direction++) {
+			TileIndex next = TileAddByDiagDir(tile, direction);
+			if (!IsValidTile(next) || visited.contains(next)) continue;
+			TrackBits current_tracks = TrackStatusToTrackBits(GetTileTrackStatus(tile, TRANSPORT_WATER, 0));
+			TrackBits next_tracks = TrackStatusToTrackBits(GetTileTrackStatus(next, TRANSPORT_WATER, 0));
+			if (current_tracks == TRACK_BIT_NONE || next_tracks == TRACK_BIT_NONE) continue;
+			visited.insert(next);
+			queue.push_back(next);
+		}
+	}
+	return false;
+}
+
+static bool EngineRegionReachable(TileIndex start, TileIndex destination)
+{
+	WaterRegionPatchDesc origin = GetWaterRegionPatchInfo(start);
+	WaterRegionPatchDesc goal = GetWaterRegionPatchInfo(destination);
+	if (origin.label == INVALID_WATER_REGION_PATCH || goal.label == INVALID_WATER_REGION_PATCH) return false;
+	std::deque<WaterRegionPatchDesc> queue{origin};
+	std::set<int> visited{CalculateWaterRegionPatchHash(origin)};
+	while (!queue.empty()) {
+		WaterRegionPatchDesc patch = queue.front();
+		queue.pop_front();
+		if (patch == goal) return true;
+		VisitWaterRegionPatchCallback visit = [&](const WaterRegionPatchDesc &next) {
+			int hash = CalculateWaterRegionPatchHash(next);
+			if (visited.insert(hash).second) queue.push_back(next);
+		};
+		VisitWaterRegionPatchNeighbours(patch, visit);
+	}
+	return false;
+}
