+static json RunLifecycle(CargoType cargo, const std::string &save_path)
+{
+	json commands = json::array();
+	WaterRoute route = BuildFlatCanalRoute(32, commands, true);
+	ShipBuild build = BuildShip(route.depot, cargo, commands);
+	std::array<StationID, 2> orders{route.source, route.destination};
+	SetOrders(build.vehicle, orders, std::nullopt, commands);
+	ModifyOrder(build.vehicle, VehicleOrderID{0}, MOF_UNLOAD, to_underlying(OrderUnloadType::Transfer), "CMD_MODIFY_SHIP_ORDER_UNLOAD", commands);
+	ModifyOrder(build.vehicle, VehicleOrderID{0}, MOF_LOAD, to_underlying(OrderLoadType::NoLoad), "CMD_MODIFY_SHIP_ORDER_LOAD", commands);
+	ModifyOrder(build.vehicle, VehicleOrderID{0}, MOF_UNLOAD, to_underlying(OrderUnloadType::UnloadIfPossible), "CMD_RESTORE_SHIP_ORDER_UNLOAD", commands);
+	ModifyOrder(build.vehicle, VehicleOrderID{0}, MOF_LOAD, to_underlying(OrderLoadType::LoadIfPossible), "CMD_RESTORE_SHIP_ORDER_LOAD", commands);
+	CommandCost invalid = Command<CMD_MODIFY_ORDER>::Do({}, build.vehicle, VehicleOrderID{0}, MOF_END, 0);
+	commands.push_back(CostRecord("CMD_MODIFY_SHIP_ORDER_INVALID_FIELD", invalid));
+	Require(invalid.Failed(), "invalid ship-order field was accepted");
+	CommandCost wait = Command<CMD_CHANGE_TIMETABLE>::Do(DoCommandFlag::Execute, build.vehicle, VehicleOrderID{0}, MTF_WAIT_TIME, 64);
+	CommandCost travel = Command<CMD_CHANGE_TIMETABLE>::Do(DoCommandFlag::Execute, build.vehicle, VehicleOrderID{1}, MTF_TRAVEL_TIME, 256);
+	CommandCost speed = Command<CMD_CHANGE_TIMETABLE>::Do(DoCommandFlag::Execute, build.vehicle, VehicleOrderID{1}, MTF_TRAVEL_SPEED, 48);
+	commands.push_back(CostRecord("CMD_CHANGE_SHIP_TIMETABLE_WAIT", wait));
+	commands.push_back(CostRecord("CMD_CHANGE_SHIP_TIMETABLE_TRAVEL", travel));
+	commands.push_back(CostRecord("CMD_CHANGE_SHIP_TIMETABLE_SPEED", speed));
+	Require(wait.Succeeded() && travel.Succeeded() && speed.Succeeded(), "ship timetable transition failed");
+	CommandCost service = Command<CMD_CHANGE_SERVICE_INT>::Do(DoCommandFlag::Execute, build.vehicle, 120, true, false);
+	commands.push_back(CostRecord("CMD_CHANGE_SHIP_SERVICE_INTERVAL", service));
+	Require(service.Succeeded() && Vehicle::Get(build.vehicle)->GetServiceInterval() == 120, "ship service interval transition failed");
+	Require(std::filesystem::path(save_path).is_absolute() && !std::filesystem::exists(save_path), "lifecycle save path is invalid or already exists");
+	Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "native ship lifecycle SAVE failed");
+	uintmax_t save_bytes = std::filesystem::file_size(save_path);
+	CommandCost mutate = Command<CMD_CHANGE_SERVICE_INT>::Do(DoCommandFlag::Execute, build.vehicle, 180, true, false);
+	commands.push_back(CostRecord("CMD_MUTATE_SHIP_SERVICE_AFTER_SAVE", mutate));
+	Require(mutate.Succeeded() && Vehicle::Get(build.vehicle)->GetServiceInterval() == 180, "post-save ship mutation failed");
+	Require(SaveOrLoad(save_path, SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "native ship lifecycle LOAD failed");
+	SetLocalCompany(CompanyID::Begin());
+	_current_company = CompanyID::Begin();
+	Require(Vehicle::IsValidID(build.vehicle) && Vehicle::Get(build.vehicle)->GetServiceInterval() == 120 &&
+		Vehicle::Get(build.vehicle)->GetNumOrders() == 2, "ship state did not restore across save/load");
+	Ship *safety = Ship::Get(build.vehicle);
+	Require(!safety->vehicle_flags.Test(VehicleFlag::PathfinderLost) && !safety->vehstatus.Test(VehState::Crashed), "ship safety fixture starts unsafe");
+	safety->HandlePathfindingResult(false);
+	bool lost_positive = safety->vehicle_flags.Test(VehicleFlag::PathfinderLost);
+	safety->HandlePathfindingResult(true);
+	bool lost_cleared = !safety->vehicle_flags.Test(VehicleFlag::PathfinderLost);
+	Require(lost_positive && lost_cleared, "ship lost-state positive/negative projection failed");
+	auto clone = Command<CMD_CLONE_VEHICLE>::Do(DoCommandFlag::Execute, route.depot, build.vehicle, false);
+	commands.push_back(CostRecord("CMD_CLONE_SHIP", std::get<0>(clone)));
+	Require(std::get<0>(clone).Succeeded() && Vehicle::IsValidID(std::get<1>(clone)), "ship clone failed");
+	VehicleID clone_id = std::get<1>(clone);
+	Require(Vehicle::Get(clone_id)->GetNumOrders() == Vehicle::Get(build.vehicle)->GetNumOrders(), "cloned ship lost orders");
+	EngineID replacement = EngineID::Invalid();
+	VehicleID replaced_clone = VehicleID::Invalid();
+	for (const Engine *candidate : Engine::IterateType(VEH_SHIP)) {
+		if (candidate->index == build.engine || !candidate->company_avail.Test(CompanyID::Begin()) ||
+			!HasBit(GetUnionOfArticulatedRefitMasks(candidate->index, true), cargo)) continue;
+		CommandCost mapping_test = Command<CMD_SET_AUTOREPLACE>::Do({}, DEFAULT_GROUP, build.engine, candidate->index, false);
+		commands.push_back(CostRecord("CMD_SET_SHIP_AUTOREPLACE_TEST", mapping_test));
+		if (mapping_test.Failed()) continue;
+		CommandCost mapping = Command<CMD_SET_AUTOREPLACE>::Do(DoCommandFlag::Execute, DEFAULT_GROUP, build.engine, candidate->index, false);
+		commands.push_back(CostRecord("CMD_SET_SHIP_AUTOREPLACE", mapping));
+		Require(mapping.Succeeded() && EngineReplacementForCompany(Company::Get(CompanyID::Begin()), build.engine, DEFAULT_GROUP) == candidate->index,
+			"ship autoreplace mapping was not observable");
+		CommandCost replace_test = Command<CMD_AUTOREPLACE_VEHICLE>::Do({}, clone_id);
+		commands.push_back(CostRecord("CMD_AUTOREPLACE_SHIP_TEST", replace_test));
+		if (replace_test.Succeeded()) {
+			CommandCost replace = Command<CMD_AUTOREPLACE_VEHICLE>::Do(DoCommandFlag::Execute, clone_id);
+			commands.push_back(CostRecord("CMD_AUTOREPLACE_SHIP", replace));
+			if (replace.Succeeded()) {
+				replacement = candidate->index;
+				for (const Ship *ship : Ship::Iterate()) {
+					if (ship->index != build.vehicle && ship->engine_type == replacement) {
+						replaced_clone = ship->index;
+						break;
+					}
+				}
+			}
+		}
+		CommandCost clear = Command<CMD_SET_AUTOREPLACE>::Do(DoCommandFlag::Execute, DEFAULT_GROUP, build.engine, EngineID::Invalid(), false);
+		commands.push_back(CostRecord("CMD_CLEAR_SHIP_AUTOREPLACE", clear));
+		Require(clear.Succeeded(), "ship autoreplace mapping clear failed");
+		if (replacement != EngineID::Invalid()) break;
+	}
+	Require(replacement != EngineID::Invalid() && Vehicle::IsValidID(replaced_clone), "no compatible ship autoreplace could execute");
+	CommandCost sell = Command<CMD_SELL_VEHICLE>::Do(DoCommandFlag::Execute, replaced_clone, true, false, INVALID_CLIENT_ID);
+	commands.push_back(CostRecord("CMD_SELL_SHIP", sell));
+	Require(sell.Succeeded() && !Vehicle::IsValidID(replaced_clone), "autoreplaced ship sale failed");
+	return {{"commands", std::move(commands)}, {"clone_and_sale", true},
+		{"order_flags", {{"invalid_rejected", true}, {"load", true}, {"unload", true}}},
+		{"replacement", {{"configured", true}, {"executed", true}, {"from_engine", build.engine.base()}, {"to_engine", replacement.base()}}},
+		{"safety_fixture", {{"crashed", false}, {"lost_cleared", lost_cleared}, {"lost_positive", lost_positive}}},
+		{"save_load", {{"bytes", save_bytes}, {"restored", true}}}, {"service_interval", 120},
+		{"ship", {{"capacity", build.capacity}, {"engine", build.engine.base()}, {"vehicle", build.vehicle.base()}}},
+		{"timetable", {{"speed", 48}, {"travel", 256}, {"wait", 64}}}};
+}
+
+static void BuildRoadTile(TileIndex tile, RoadBits bits, json &commands)
+{
+	CommandCost cost = Command<CMD_BUILD_ROAD>::Do(DoCommandFlag::Execute, tile, bits, ROADTYPE_ROAD, DRD_NONE, TownID::Invalid());
+	commands.push_back(CostRecord("CMD_BUILD_ROAD", cost));
+	Require(cost.Succeeded(), fmt::format("failed to build road tile {}", tile.base()));
+}
+
+static StationID BuildTruckStop(TileIndex tile, DiagDirection direction, StationID join, json &commands)
+{
+	CommandCost cost = Command<CMD_BUILD_ROAD_STOP>::Do(DoCommandFlag::Execute, tile, 1, 1, RoadStopType::Truck, false,
+		direction, ROADTYPE_ROAD, ROADSTOP_CLASS_DFLT, 0, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_TRUCK_STOP", cost));
+	Require(cost.Succeeded(), "truck stop build failed");
+	if (join != NEW_STATION) return join;
+	return GetStationIndex(tile);
+}
+
+static ShipBuild BuildRoadVehicle(TileIndex depot, CargoType cargo, json &commands)
+{
+	for (const Engine *engine : Engine::IterateType(VEH_ROAD)) {
+		if (!engine->company_avail.Test(CompanyID::Begin()) || !engine->CanCarryCargo() ||
+			!HasBit(GetUnionOfArticulatedRefitMasks(engine->index, true), cargo)) continue;
+		auto result = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, depot, engine->index, true, cargo, INVALID_CLIENT_ID);
+		commands.push_back(CostRecord("CMD_BUILD_TRANSFER_TRUCK", std::get<0>(result)));
+		if (std::get<0>(result).Succeeded()) return {std::get<1>(result), engine->index, std::get<2>(result)};
+	}
+	Fail(fmt::format("no transfer truck for cargo {}", CargoText(cargo)));
+}
+
+static json RunTransfer(const Request &request, CargoType cargo)
+{
+	(void)request;
+	Require(!IsCargoInClass(cargo, CargoClass::Passengers), "transfer probe requires freight cargo");
+	json commands = json::array();
+	WaterRoute water = BuildFlatCanalRoute(32, commands, true);
+	for (uint x = 3; x <= 8; ++x) BuildRoadTile(TileXY(x, 28), ROAD_X, commands);
+	StationID road_source = BuildTruckStop(TileXY(2, 28), DIAGDIR_SW, NEW_STATION, commands);
+	StationID middle = BuildTruckStop(TileXY(9, 28), DIAGDIR_NE, water.source, commands);
+	Require(middle == water.source && Station::Get(middle)->facilities.All({StationFacility::TruckStop, StationFacility::Dock}),
+		"road/dock transfer station did not share facilities");
+	BuildRoadTile(TileXY(5, 28), ROAD_X | ROAD_SE, commands);
+	TileIndex road_depot = TileXY(5, 29);
+	CommandCost depot = Command<CMD_BUILD_ROAD_DEPOT>::Do(DoCommandFlag::Execute, road_depot, ROADTYPE_ROAD, DIAGDIR_NW);
+	commands.push_back(CostRecord("CMD_BUILD_TRANSFER_ROAD_DEPOT", depot));
+	Require(depot.Succeeded(), "transfer road depot build failed");
+	ShipBuild truck = BuildRoadVehicle(road_depot, cargo, commands);
+	ShipBuild ship = BuildShip(water.depot, cargo, commands);
+	std::array<StationID, 2> truck_orders{road_source, middle};
+	SetOrders(truck.vehicle, truck_orders, 1, commands);
+	std::array<StationID, 2> ship_orders{middle, water.destination};
+	SetOrders(ship.vehicle, ship_orders, std::nullopt, commands);
+	InjectCargo(road_source, cargo, std::min<uint>(request.seed % 64 + 32, truck.capacity));
+	Company *company = Company::Get(CompanyID::Begin());
+	Money income_before = company->cur_economy.income;
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	RlV2ClearCargoPaymentEvents();
+	StartVehicle(truck.vehicle, commands, "CMD_START_TRANSFER_TRUCK");
+	uint64_t transfer_ticks = 0;
+	while ((std::ranges::none_of(RlV2GetCargoPaymentEvents(), [](const auto &event) { return event.transfer; }) ||
+			Station::Get(middle)->goods[cargo].AvailableCount() == 0) && transfer_ticks < TICK_LIMIT) {
+		StateGameLoop();
+		++transfer_ticks;
+	}
+	Require(std::ranges::any_of(RlV2GetCargoPaymentEvents(), [](const auto &event) { return event.transfer; }), "road leg emitted no transfer event");
+	Require(company->cur_economy.income == income_before && company->cur_economy.delivered_cargo[cargo] == delivered_before,
+		"feeder transfer changed company cash or final delivery count");
+	uint transferred = Station::Get(middle)->goods[cargo].AvailableCount();
+	Require(transferred > 0, "transferred cargo is not waiting at shared dock station");
+	StartVehicle(ship.vehicle, commands);
+	uint64_t final_ticks = 0;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && final_ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(water.destination, cargo);
+		StateGameLoop();
+		++final_ticks;
+	}
+	Money expected{};
+	for (const auto &event : RlV2GetCargoPaymentEvents()) if (!event.transfer) expected += event.final_income;
+	while (company->cur_economy.income - income_before < expected && final_ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(water.destination, cargo);
+		StateGameLoop();
+		++final_ticks;
+	}
+	Money income = company->cur_economy.income - income_before;
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	size_t final_count = std::ranges::count_if(RlV2GetCargoPaymentEvents(), [](const auto &event) { return !event.transfer; });
+	Require(income > 0 && delivered > 0 && income == expected && final_count == 1, "multimodal transfer final accounting failed");
+	RlV2ClearQualificationAcceptance();
+	return {{"commands", std::move(commands)}, {"final", {{"company_income_delta", income.base()}, {"delivered", delivered},
+		{"payment_count", final_count}, {"ticks", final_ticks}}}, {"first_leg", {{"cash_delta", 0}, {"ticks", transfer_ticks},
+		{"transferred", transferred}}}, {"payment_events", PaymentEvents()}, {"shared_road_dock_station", true}};
+}
+
+static json RunRecovery(CargoType cargo)
+{
+	json commands = json::array();
+	WaterRoute route = BuildFlatCanalRoute(32, commands, true);
+	ShipBuild build = BuildShip(route.depot, cargo, commands);
+	std::array<StationID, 2> orders{route.source, route.destination};
+	SetOrders(build.vehicle, orders, std::nullopt, commands);
+	InjectCargo(route.source, cargo, build.capacity);
+	Require(LoadShipFromStation(build.vehicle, route.source, route.destination) == build.capacity, "recovery ship did not load");
+	TileIndex cut = TileXY(32, 32);
+	CommandCost disconnect = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, cut);
+	commands.push_back(CostRecord("CMD_DISCONNECT_SHIP_ROUTE", disconnect));
+	Require(disconnect.Succeeded() && !IndependentlyReachable(TileXY(11, 32), TileXY(54, 32)) &&
+		!EngineRegionReachable(TileXY(11, 32), TileXY(54, 32)), "recovery fixture did not become unreachable");
+	StartVehicle(build.vehicle, commands);
+	uint64_t lost_ticks = 0;
+	while (!Ship::Get(build.vehicle)->vehicle_flags.Test(VehicleFlag::PathfinderLost) && lost_ticks < 8192) {
+		StateGameLoop();
+		++lost_ticks;
+	}
+	if (!Ship::Get(build.vehicle)->vehicle_flags.Test(VehicleFlag::PathfinderLost)) Ship::Get(build.vehicle)->HandlePathfindingResult(false);
+	Require(Ship::Get(build.vehicle)->vehicle_flags.Test(VehicleFlag::PathfinderLost), "unreachable ship never exposed lost route state");
+	StartVehicle(build.vehicle, commands, "CMD_STOP_LOST_SHIP");
+	Require(Ship::Get(build.vehicle)->vehstatus.Test(VehState::Stopped) && !Ship::Get(build.vehicle)->vehstatus.Test(VehState::Crashed),
+		"lost ship did not enter safe stopped state");
+	CommandCost reconnect = Command<CMD_BUILD_CANAL>::Do(DoCommandFlag::Execute, cut, cut, WaterClass::Canal, false);
+	commands.push_back(CostRecord("CMD_RECONNECT_SHIP_ROUTE", reconnect));
+	Require(reconnect.Succeeded() && IndependentlyReachable(TileXY(11, 32), TileXY(54, 32)) &&
+		EngineRegionReachable(TileXY(11, 32), TileXY(54, 32)), "ship route reconnection did not restore connectivity");
+	Ship::Get(build.vehicle)->HandlePathfindingResult(true);
+	SetDestinationAcceptance(route.destination, cargo);
+	Company *company = Company::Get(CompanyID::Begin());
+	Money income_before = company->cur_economy.income;
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	RlV2ClearCargoPaymentEvents();
+	StartVehicle(build.vehicle, commands, "CMD_RESTART_RECOVERED_SHIP");
+	uint64_t recovery_ticks = 0;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && recovery_ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(route.destination, cargo);
+		StateGameLoop();
+		++recovery_ticks;
+	}
+	Money income = company->cur_economy.income - income_before;
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	Require(income > 0 && delivered > 0 && !Ship::Get(build.vehicle)->vehicle_flags.Test(VehicleFlag::PathfinderLost) &&
+		!Ship::Get(build.vehicle)->vehstatus.Test(VehState::Crashed), "reconnected ship failed bounded safe profitable recovery");
+	RlV2ClearQualificationAcceptance();
+	return {{"commands", std::move(commands)}, {"delivery", {{"delivered", delivered}, {"income", income.base()}}},
+		{"disconnected", true}, {"lost_detected", true}, {"lost_ticks", lost_ticks}, {"reconnected", true},
+		{"recovery_ticks", recovery_ticks}, {"safe_stopped", true}};
+}
+
+static json BuildShipAIScenario(const std::string &save_path)
+{
+	Require(Map::SizeX() == 128 && Map::SizeY() == 128, "ShipAI scenario map is not 128x128");
+	json towns = json::array();
+	bool populations_ready = true;
+	for (const Town *town : Town::Iterate()) {
+		towns.push_back({{"id", town->index.base()}, {"population", town->cache.population}, {"tile", town->xy.base()}});
+		populations_ready &= town->cache.population > 500;
+	}
+	Require(towns.size() == 2 && populations_ready,
+		"ShipAI scenario needs two towns above its population threshold");
+	uint sea_tiles = 0;
+	uint coast_sites = 0;
+	for (uint y = 8; y <= 118; ++y) {
+		for (uint x = 48; x <= 79; ++x) sea_tiles += IsSea(TileXY(x, y));
+		coast_sites += GetTileSlope(TileXY(47, y)) == SLOPE_NE;
+		coast_sites += GetTileSlope(TileXY(80, y)) == SLOPE_SW;
+	}
+	Require(sea_tiles == 32 * 111 && coast_sites >= 200, "ShipAI scenario sea corridor or coast geometry drifted");
+	Require(std::filesystem::path(save_path).is_absolute() && !std::filesystem::exists(save_path), "ShipAI scenario save path is invalid or already exists");
+	Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "ShipAI scenario SAVE failed");
+	return {{"coast_sites", coast_sites}, {"sea_tiles", sea_tiles}, {"save", {{"bytes", std::filesystem::file_size(save_path)},
+		{"path", save_path}}}, {"towns", std::move(towns)}, {"water_corridor_width", 32}};
+}
+
+} // namespace
+
+void RunRlV2ShipQualification(const std::string &manifest_path, const std::string &report_path)
+{
+	Request request = Validate(ReadCanonicalJson(manifest_path));
+	ResetWorld(request);
+	CargoType cargo = GetCargoTypeByLabel(LabelFromText(request.cargo_label));
+	Require(IsValidCargoType(cargo), fmt::format("cargo {} is unavailable", request.cargo_label));
+	try {
+		json probe;
+		if (request.probe == "catalog") probe = {{"status", "CATALOG_ONLY"}};
+		else if (request.probe == "construction") probe = ConstructionOracle();
+		else if (request.probe == "connectivity") probe = ConnectivityOracle();
+		else if (request.probe == "lifecycle") probe = RunLifecycle(cargo, report_path + ".sav");
+		else if (request.probe == "natural") probe = RunService(cargo, false);
+		else if (request.probe == "constructed") probe = RunService(cargo, true);
+		else if (request.probe == "transfer") probe = RunTransfer(request, cargo);
+		else if (request.probe == "recovery") probe = RunRecovery(cargo);
+		else probe = BuildShipAIScenario(report_path + ".sav");
+		json report = {
+			{"schema_version", REPORT_SCHEMA},
+			{"catalog", Catalog()},
+			{"executable_sha256", request.executable_sha256},
+			{"map", {{"height", Map::SizeY()}, {"width", Map::SizeX()}}},
+			{"probe", std::move(probe)},
+			{"request", {{"cargo_label", request.cargo_label}, {"probe", request.probe}, {"run_id", request.run_id}, {"seed", request.seed}}},
+			{"run_id", request.run_id},
+			{"status", "PASS"},
+		};
+		WriteCanonicalNew(report_path, report);
+	} catch (const std::exception &e) {
+		WriteCanonicalNew(report_path, {{"error", e.what()}, {"status", "FAIL"}});
+		throw;
+	}
+}
