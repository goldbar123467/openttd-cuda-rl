+
+static json ReadCanonicalJson(const std::string &path)
+{
+	std::ifstream input(path, std::ios::binary);
+	if (!input) Fail(fmt::format("cannot open manifest '{}'", path));
+	std::string bytes((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+	Require(!bytes.empty() && bytes.back() == '\n', "manifest must end with one LF");
+	bytes.pop_back();
+	Require(!bytes.empty() && bytes.back() != '\n' && bytes.back() != '\r', "manifest has trailing whitespace");
+	json value;
+	try { value = json::parse(bytes); } catch (const json::exception &e) { Fail(fmt::format("invalid manifest JSON: {}", e.what())); }
+	Require(value.dump() == bytes, "manifest must be canonical compact JSON followed by LF");
+	return value;
+}
+
+static void WriteCanonicalNew(const std::string &path, const json &value)
+{
+	std::filesystem::path output(path);
+	Require(output.is_absolute() && !std::filesystem::exists(output), "report must be a new absolute path");
+	std::ofstream stream(output, std::ios::binary | std::ios::out | std::ios::trunc);
+	Require(stream.good(), fmt::format("cannot create report '{}'", path));
+	stream << value.dump() << '\n';
+	stream.flush();
+	Require(stream.good(), fmt::format("cannot write report '{}'", path));
+}
+
+static bool SafeName(std::string_view value)
+{
+	return !value.empty() && value.size() <= 80 && std::ranges::all_of(value, [](char c) {
+		return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_';
+	});
+}
+
+static Request Validate(const json &manifest)
+{
+	Require(manifest.is_object() && manifest.size() == 6, "manifest must contain exactly six fields");
+	Require(manifest.at("schema_version") == MANIFEST_SCHEMA, "unsupported manifest schema_version");
+	std::string run_id = manifest.at("run_id").get<std::string>();
+	Require(SafeName(run_id), "invalid run_id");
+	std::string probe = manifest.at("probe").get<std::string>();
+	Require(probe == "catalog" || probe == "construction" || probe == "connectivity" || probe == "lifecycle" ||
+		probe == "natural" || probe == "constructed" || probe == "transfer" || probe == "recovery" ||
+		probe == "shipai-scenario", "unknown probe");
+	std::string cargo = manifest.at("cargo_label").get<std::string>();
+	Require(cargo.size() == 4, "cargo_label must contain exactly four bytes");
+	std::string executable = manifest.at("executable_sha256").get<std::string>();
+	Require(executable.size() == 64 && std::ranges::all_of(executable, [](char c) {
+		return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+	}), "executable_sha256 is not lowercase SHA-256");
+	return {std::move(run_id), std::move(probe), std::move(cargo), manifest.at("seed").get<uint32_t>(), std::move(executable)};
+}
+
+static CargoLabel LabelFromText(std::string_view label)
+{
+	return CargoLabel{static_cast<uint32_t>(static_cast<uint8_t>(label[0])) << 24 |
+		static_cast<uint32_t>(static_cast<uint8_t>(label[1])) << 16 |
+		static_cast<uint32_t>(static_cast<uint8_t>(label[2])) << 8 |
+		static_cast<uint32_t>(static_cast<uint8_t>(label[3]))};
+}
+
+static std::string CargoText(CargoType cargo)
+{
+	if (!IsValidCargoType(cargo)) return "----";
+	uint32_t value = CargoSpec::Get(cargo)->label.base();
+	return {static_cast<char>(value >> 24), static_cast<char>(value >> 16), static_cast<char>(value >> 8), static_cast<char>(value)};
+}
+
+static json CostRecord(std::string_view command, const CommandCost &cost)
+{
+	return {{"command", command}, {"cost", cost.Succeeded() ? cost.GetCost().base() : 0},
+		{"error_message_id", static_cast<uint64_t>(cost.GetErrorMessage())}, {"status", cost.Succeeded() ? "SUCCESS" : "REJECTED"}};
+}
