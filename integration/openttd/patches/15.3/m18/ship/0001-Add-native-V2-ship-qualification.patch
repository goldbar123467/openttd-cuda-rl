+static void InjectCargo(StationID station_id, CargoType cargo, uint amount)
+{
+	Require(CargoPacket::CanAllocateItem(), "cargo packet pool is full");
+	Station *station = Station::Get(station_id);
+	GoodsEntry &goods = station->goods[cargo];
+	goods.rating = 255;
+	goods.status.Set(GoodsEntry::State::Rating);
+	Source source{Town::Get(TownID{0})->index, SourceType::Town};
+	goods.GetOrCreateData().cargo.Append(new CargoPacket(station_id, static_cast<uint16_t>(amount), source), StationID::Invalid());
+}
+
+static void SetDestinationAcceptance(StationID station_id, CargoType cargo)
+{
+	RlV2SetQualificationAcceptance(station_id, cargo, true);
+	Station *station = Station::Get(station_id);
+	station->goods[cargo].status.Set(GoodsEntry::State::Acceptance);
+	SetBit(station->always_accepted, cargo);
+}
+
+static uint LoadShipFromStation(VehicleID vehicle, StationID source, StationID destination)
+{
+	Ship *ship = Ship::Get(vehicle);
+	GoodsEntry &goods = Station::Get(source)->goods[ship->cargo_type];
+	std::array<StationID, 1> next{destination};
+	return goods.GetOrCreateData().cargo.Load(ship->cargo_cap, &ship->cargo, next, Station::Get(source)->xy);
+}
