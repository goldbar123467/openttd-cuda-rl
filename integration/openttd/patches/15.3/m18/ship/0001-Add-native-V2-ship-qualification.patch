+static json ConnectivityOracle()
+{
+	json commands = json::array();
+	BuildCanalRange(4, 59, 32, commands);
+	TileIndex start = TileXY(4, 32);
+	TileIndex destination = TileXY(59, 32);
+	bool independent_before = IndependentlyReachable(start, destination);
+	bool engine_before = EngineRegionReachable(start, destination);
+	Require(independent_before && engine_before, "connected canal is not reachable in both graph projections");
+	TileIndex cut = TileXY(32, 32);
+	CommandCost clear = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, cut);
+	commands.push_back(CostRecord("CMD_DISCONNECT_CANAL", clear));
+	Require(clear.Succeeded(), "connectivity cut failed");
+	bool independent_after = IndependentlyReachable(start, destination);
+	bool engine_after = EngineRegionReachable(start, destination);
+	Require(!independent_after && !engine_after, "disconnected canal remained reachable in a graph projection");
+	CommandCost reconnect = Command<CMD_BUILD_CANAL>::Do(DoCommandFlag::Execute, cut, cut, WaterClass::Canal, false);
+	commands.push_back(CostRecord("CMD_RECONNECT_CANAL", reconnect));
+	Require(reconnect.Succeeded() && IndependentlyReachable(start, destination) && EngineRegionReachable(start, destination),
+		"reconnected canal did not restore both graph projections");
+	WaterRegionDesc region = GetWaterRegionInfo(start);
+	WaterRegionPatchDesc patch = GetWaterRegionPatchInfo(start);
+	return {{"commands", std::move(commands)}, {"after_cut", {{"engine", engine_after}, {"independent", independent_after}}},
+		{"before_cut", {{"engine", engine_before}, {"independent", independent_before}}}, {"reconnected", true},
+		{"start_patch", {{"label", patch.label.base()}, {"x", patch.x}, {"y", patch.y}}},
+		{"start_region", {{"x", region.x}, {"y", region.y}}}};
+}
