index 0000000000000000000000000000000000000000..f2f4fbbf0d940aa558a52892f7c41bfb9a5ddb3d
--- /dev/null
+++ b/src/rl_reward.cpp
@@ -0,0 +1,234 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file rl_reward.cpp Authoritative M06 reward and episode-boundary projection. */
+
+#include "stdafx.h"
+
+#include "rl_reward.h"
+
+#include "3rdparty/nlohmann/json.hpp"
+#include "cargotype.h"
+#include "company_base.h"
+#include "vehicle_base.h"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+#include "safeguards.h"
+
+using nlohmann::json;
+
+namespace {
+
+static constexpr std::string_view REWARD_SCHEMA_VERSION = "openttd-rl-v1-m06-reward-1";
+static constexpr std::string_view TERMINATION_SCHEMA_VERSION = "openttd-rl-v1-m06-termination-1";
+static constexpr uint8_t MAX_PRIMARY_BUSES = 8;
+
+static json SourceJson(const RlRewardSource &source)
+{
+	return {
+		{"company_present", source.company_present},
+		{"delivered_passengers_total", source.delivered_passengers_total},
+		{"operating_expenses_total", source.operating_expenses_total},
+		{"operating_income_total", source.operating_income_total},
+		{"primary_bus_count", source.primary_bus_count},
+		{"stopped_primary_bus_count", source.stopped_primary_bus_count},
+	};
+}
+
+static std::string Float64Bits(double value)
+{
+	static_assert(sizeof(double) == 8);
+	std::array<uint8_t, sizeof(double)> bytes = std::bit_cast<std::array<uint8_t, sizeof(double)>>(value);
+	if constexpr (std::endian::native == std::endian::big) std::reverse(bytes.begin(), bytes.end());
+	std::string output;
+	for (uint8_t byte : bytes) output += fmt::format("{:02x}", byte);
+	return output;
+}
+
+static void RequireSource(const RlRewardSource &source, std::string_view name)
+{
+	if (source.delivered_passengers_total < 0 || source.operating_income_total < 0 || source.operating_expenses_total > 0) {
+		throw std::runtime_error(fmt::format("M06 {} source has invalid lifetime economy signs", name));
+	}
+	if (source.primary_bus_count < 0 || source.primary_bus_count > MAX_PRIMARY_BUSES ||
+			source.stopped_primary_bus_count < 0 || source.stopped_primary_bus_count > source.primary_bus_count) {
+		throw std::runtime_error(fmt::format("M06 {} source violates the M05 primary-bus bound", name));
+	}
+}
+
+static json TerminationJson(bool bankruptcy, bool action_horizon, bool tick_horizon)
+{
+	std::string_view reason = "NONE";
+	std::string_view kind = "CONTINUE";
+	bool terminal = false;
+	bool truncated = false;
+	bool bootstrap = true;
+	if (bankruptcy) {
+		reason = "BANKRUPTCY";
+		kind = "TERMINAL";
+		terminal = true;
+		bootstrap = false;
+	} else if (action_horizon && tick_horizon) {
+		reason = "ACTION_AND_TICK_HORIZON";
+		kind = "TRUNCATED";
+		truncated = true;
+	} else if (action_horizon) {
+		reason = "ACTION_HORIZON";
+		kind = "TRUNCATED";
+		truncated = true;
+	} else if (tick_horizon) {
+		reason = "TICK_HORIZON";
+		kind = "TRUNCATED";
+		truncated = true;
+	}
+	return {
+		{"bootstrap", bootstrap},
+		{"kind", kind},
+		{"reason", reason},
+		{"schema_version", TERMINATION_SCHEMA_VERSION},
+		{"terminal", terminal},
+		{"trainable", true},
+		{"truncated", truncated},
+	};
+}
+
+} // namespace
+
+int64_t RlActionCapitalSpend(std::string_view serialized_action_outcome)
+{
+	json action = json::parse(serialized_action_outcome);
+	if (!action.is_object() || !action.contains("native_commands") || !action.at("native_commands").is_array()) {
+		throw std::runtime_error("M06 action outcome lacks native_commands");
+	}
+	int64_t capital_spend = 0;
+	for (const json &command : action.at("native_commands")) {
+		if (!command.is_object() || !command.contains("cost") || !command.at("cost").is_number_integer()) {
+			throw std::runtime_error("M06 native command cost is not an integer");
+		}
+		int64_t cost = command.at("cost").get<int64_t>();
+		if (cost > 0) {
+			if (capital_spend > std::numeric_limits<int64_t>::max() - cost) throw std::runtime_error("M06 capital spend overflow");
+			capital_spend += cost;
+		}
+	}
+	return capital_spend;
+}
+
+RlRewardSource CaptureRlRewardSource(int64_t cumulative_capital_spend, const RlRewardSource *absent_fallback)
+{
+	if (cumulative_capital_spend < 0) throw std::runtime_error("M06 cumulative capital spend is negative");
+	/* OpenTTD cur_economy expenses include only running, property, and interest categories;
+	 * command construction and vehicle-purchase costs are already excluded. */
+	const Company *company = Company::GetIfValid(CompanyID::Begin());
+	if (company == nullptr) {
+		if (absent_fallback == nullptr) return {};
+		RlRewardSource result = *absent_fallback;
+		result.company_present = false;
+		result.primary_bus_count = 0;
+		result.stopped_primary_bus_count = 0;
+		return result;
+	}
+
+	CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+	if (!IsValidCargoType(passengers)) throw std::runtime_error("M06 passenger cargo is unavailable");
+	RlRewardSource result;
+	/* In single-player OpenTTD preserves the local company at the final native bankruptcy stage. */
+	result.company_present = company->months_of_bankruptcy < 10;
+	auto add_economy = [&result, passengers](const CompanyEconomyEntry &entry) {
+		result.delivered_passengers_total += entry.delivered_cargo[passengers];
+		result.operating_income_total += entry.income.base();
+		result.operating_expenses_total += entry.expenses.base();
+	};
+	add_economy(company->cur_economy);
+	for (uint8_t index = 0; index < company->num_valid_stat_ent; ++index) add_economy(company->old_economy[index]);
+	for (const Vehicle *vehicle : Vehicle::Iterate()) {
+		if (vehicle->owner != CompanyID::Begin() || vehicle->type != VEH_ROAD || !vehicle->IsPrimaryVehicle()) continue;
+		++result.primary_bus_count;
+		if (vehicle->vehstatus.Test(VehState::Stopped)) ++result.stopped_primary_bus_count;
+	}
+	RequireSource(result, "captured");
+	return result;
+}
+
+std::string BuildRlRewardTransition(const RlRewardSource &pre, const RlRewardSource &post,
+		std::string_view serialized_action_outcome, uint64_t advanced_ticks, bool action_horizon, bool tick_horizon)
+{
+	RequireSource(pre, "pre");
+	RequireSource(post, "post");
+	if (advanced_ticks > 128) throw std::runtime_error("M06 advanced tick count exceeds 128");
+	if (post.delivered_passengers_total < pre.delivered_passengers_total || post.operating_income_total < pre.operating_income_total ||
+			post.operating_expenses_total > pre.operating_expenses_total) {
+		throw std::runtime_error("M06 lifetime economy source regressed across a transition");
+	}
+
+	json action = json::parse(serialized_action_outcome);
+	if (!action.contains("status") || !action.at("status").is_string()) throw std::runtime_error("M06 action outcome lacks status");
+	std::string status = action.at("status").get<std::string>();
+	if (status != "SUCCESS" && status != "NO_OP" && status != "NATIVE_REJECTED") {
+		throw std::runtime_error(fmt::format("M06 cannot reward action outcome {}", status));
+	}
+
+	std::array<int64_t, 8> raw = {
+		post.delivered_passengers_total - pre.delivered_passengers_total,
+		post.operating_income_total + post.operating_expenses_total - pre.operating_income_total - pre.operating_expenses_total,
+		RlActionCapitalSpend(serialized_action_outcome),
+		status == "NO_OP" ? 1 : 0,
+		status == "NATIVE_REJECTED" ? 1 : 0,
+		post.stopped_primary_bus_count * static_cast<int64_t>(advanced_ticks),
+		std::max<int64_t>(pre.primary_bus_count - post.primary_bus_count, 0),
+		pre.company_present && !post.company_present ? 1 : 0,
+	};
+	static constexpr std::array<int64_t, 8> minimum = {0, -16384, 0, 0, 0, 0, 0, 0};
+	static constexpr std::array<int64_t, 8> maximum = {128, 16384, 65536, 1, 1, 1024, 8, 1};
+	static constexpr std::array<int64_t, 8> numerator = {1, 1, -1, -1, -1, -1, -2, -8};
+	static constexpr std::array<int64_t, 8> denominator = {16, 4096, 16384, 64, 4, 65536, 1, 1};
+	static constexpr std::array<std::string_view, 8> component_id = {"RC-001", "RC-002", "RC-003", "RC-004", "RC-005", "RC-006", "RC-007", "RC-008"};
+	static constexpr std::array<std::string_view, 8> name = {"passenger_delivery", "operating_profit", "capital_spend", "noop", "native_rejection", "idle_bus_ticks", "vehicle_loss", "bankruptcy"};
+	static constexpr std::array<std::string_view, 8> raw_field = {"delivered_passengers_delta", "operating_profit_delta", "capital_spend", "noop", "native_rejected", "idle_bus_ticks", "vehicle_loss_count", "bankruptcy"};
+
+	json raw_json = json::object();
+	json components = json::array();
+	double scalar = 0.0;
+	for (size_t index = 0; index < raw.size(); ++index) {
+		int64_t clamped = std::clamp(raw[index], minimum[index], maximum[index]);
+		double weighted = static_cast<double>(clamped * numerator[index]) / static_cast<double>(denominator[index]);
+		if (!std::isfinite(weighted)) throw std::runtime_error(fmt::format("M06 {} produced a nonfinite value", component_id[index]));
+		scalar += weighted;
+		if (!std::isfinite(scalar)) throw std::runtime_error("M06 scalar reward became nonfinite");
+		raw_json[raw_field[index]] = raw[index];
+		components.push_back({
+			{"clamped", clamped},
+			{"component_id", component_id[index]},
+			{"name", name[index]},
+			{"order", index},
+			{"raw", raw[index]},
+			{"raw_field", raw_field[index]},
+			{"weighted", weighted},
+			{"weighted_float64_bits", Float64Bits(weighted)},
+		});
+	}
+
+	bool bankruptcy = raw[7] == 1;
+	return json({
+		{"reward", {
+			{"compatibility_sha256", RL_REWARD_COMPATIBILITY_SHA256},
+			{"components", std::move(components)},
+			{"raw", std::move(raw_json)},
+			{"scalar", scalar},
+			{"scalar_float64_bits", Float64Bits(scalar)},
+			{"schema_version", REWARD_SCHEMA_VERSION},
+			{"source", {{"post", SourceJson(post)}, {"pre", SourceJson(pre)}}},
+		}},
+		{"termination", TerminationJson(bankruptcy, action_horizon, tick_horizon)},
+	}).dump();
+}
