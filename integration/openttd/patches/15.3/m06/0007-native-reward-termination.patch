+/** Cumulative, quarter-rotation-safe engine facts at one transition boundary. */
+struct RlRewardSource {
+	bool company_present = false;
+	int64_t delivered_passengers_total = 0;
+	int64_t operating_income_total = 0;
+	int64_t operating_expenses_total = 0;
+	int64_t primary_bus_count = 0;
+	int64_t stopped_primary_bus_count = 0;
