+static json RunAirService(CargoType cargo, bool airplane)
+{
+	json commands = json::array();
+	uint8_t airport_type = airplane ? AT_COMMUTER : AT_HELIDEPOT;
+	AirportPair pair = BuildAirportPair(airport_type);
+	UnitBuild build = BuildAircraft(pair.source_hangar, cargo, airplane, commands);
+	std::array<StationID, 2> orders{pair.source, pair.destination};
+	SetOrders(build.vehicle, orders, std::nullopt, commands);
+	InjectCargo(pair.source, cargo, build.capacity);
+	uint loaded = LoadFromStation(build.vehicle, pair.source, pair.destination);
+	Require(loaded == build.capacity, "native station-to-aircraft loading did not fill aircraft");
+	SetDestinationAcceptance(pair.destination, cargo);
+	Company *company = Company::Get(CompanyID::Begin());
+	Money income_before = company->cur_economy.income;
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	RlV2ClearCargoPaymentEvents();
+	ToggleVehicle(build.vehicle, commands, airplane ? "CMD_START_AIRPLANE" : "CMD_START_HELICOPTER");
+	uint64_t ticks = 0;
+	std::set<uint8_t> states;
+	std::set<uint64_t> source_blocks;
+	std::set<uint64_t> destination_blocks;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(pair.destination, cargo);
+		StateGameLoop();
+		++ticks;
+		const Aircraft *aircraft = Aircraft::Get(build.vehicle);
+		states.insert(aircraft->state);
+		source_blocks.insert(Station::Get(pair.source)->airport.blocks.base());
+		destination_blocks.insert(Station::Get(pair.destination)->airport.blocks.base());
+	}
+	Money income = company->cur_economy.income - income_before;
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	const Aircraft *aircraft = Aircraft::Get(build.vehicle);
+	Require(delivered > 0 && income > 0 && !aircraft->vehstatus.Test(VehState::Crashed),
+		fmt::format("{} service failed cargo={} ticks={} state={} delivered={} income={}",
+			airplane ? "airplane" : "helicopter", CargoText(cargo), ticks, aircraft->state, delivered, income.base()));
+	Require(states.contains(FLYING), "aircraft service never exposed flying state");
+	RlV2ClearQualificationAcceptance();
+	return {{"accounting", {{"delivered", delivered}, {"income", income.base()}, {"payment_events", PaymentEvents()}}},
+		{"aircraft", {{"capacity", build.capacity}, {"engine", build.engine.base()}, {"kind", airplane ? "airplane" : "helicopter"},
+			{"max_range", aircraft->GetRange()}, {"vehicle", build.vehicle.base()}}}, {"commands", std::move(commands)},
+		{"movement", {{"destination_block_samples", destination_blocks.size()}, {"state_count", states.size()},
+			{"states", states}, {"source_block_samples", source_blocks.size()}}}, {"ticks", ticks}};
+}
+
+static json RunLifecycle(CargoType cargo, const std::string &save_path)
+{
+	json commands = json::array();
+	AirportPair pair = BuildAirportPair(AT_INTERNATIONAL);
+	CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+	Require(IsValidCargoType(passengers), "passenger cargo is unavailable");
+	UnitBuild plane = BuildAircraft(pair.source_hangar, cargo, true, commands, "CMD_BUILD_LIFECYCLE_AIRPLANE");
+	UnitBuild helicopter = BuildAircraft(pair.source_hangar, passengers, false, commands, "CMD_BUILD_LIFECYCLE_HELICOPTER");
+	std::array<StationID, 2> orders{pair.source, pair.destination};
+	SetOrders(plane.vehicle, orders, std::nullopt, commands);
+	SetOrders(helicopter.vehicle, orders, std::nullopt, commands);
+	CommandCost wait = Command<CMD_CHANGE_TIMETABLE>::Do(DoCommandFlag::Execute, plane.vehicle, VehicleOrderID{0}, MTF_WAIT_TIME, 64);
+	CommandCost travel = Command<CMD_CHANGE_TIMETABLE>::Do(DoCommandFlag::Execute, plane.vehicle, VehicleOrderID{1}, MTF_TRAVEL_TIME, 256);
+	CommandCost speed = Command<CMD_CHANGE_TIMETABLE>::Do(DoCommandFlag::Execute, plane.vehicle, VehicleOrderID{1}, MTF_TRAVEL_SPEED, 48);
+	commands.push_back(CostRecord("CMD_CHANGE_AIRCRAFT_TIMETABLE_WAIT", wait));
+	commands.push_back(CostRecord("CMD_CHANGE_AIRCRAFT_TIMETABLE_TRAVEL", travel));
+	commands.push_back(CostRecord("CMD_REJECT_AIRCRAFT_TIMETABLE_SPEED", speed));
+	Require(wait.Succeeded() && travel.Succeeded() && speed.Failed(), fmt::format(
+		"aircraft timetable transition failed wait={} travel={} speed={}",
+		static_cast<uint64_t>(wait.GetErrorMessage()), static_cast<uint64_t>(travel.GetErrorMessage()), static_cast<uint64_t>(speed.GetErrorMessage())));
+	CommandCost plane_service = Command<CMD_CHANGE_SERVICE_INT>::Do(DoCommandFlag::Execute, plane.vehicle, 120, true, false);
+	CommandCost heli_service = Command<CMD_CHANGE_SERVICE_INT>::Do(DoCommandFlag::Execute, helicopter.vehicle, 90, true, false);
+	commands.push_back(CostRecord("CMD_CHANGE_AIRPLANE_SERVICE_INTERVAL", plane_service));
+	commands.push_back(CostRecord("CMD_CHANGE_HELICOPTER_SERVICE_INTERVAL", heli_service));
+	Require(plane_service.Succeeded() && heli_service.Succeeded(), "aircraft service interval transition failed");
+	UnitBuild range_probe = BuildAircraft(pair.source_hangar, cargo, true, commands, "CMD_BUILD_RANGE_PROBE_AIRPLANE");
+	Aircraft *limited = Aircraft::Get(range_probe.vehicle);
+	limited->acache.cached_max_range = 8;
+	limited->acache.cached_max_range_sqr = 64;
+	CommandCost limited_copy = Command<CMD_CLONE_ORDER>::Do({}, CO_COPY, range_probe.vehicle, plane.vehicle);
+	commands.push_back(CostRecord("CMD_COPY_AIRCRAFT_ORDERS_RANGE_MASK", limited_copy));
+	Require(limited_copy.Failed(), "bounded aircraft range mask accepted an over-range order cycle");
+	limited->acache.cached_max_range = 0;
+	limited->acache.cached_max_range_sqr = 0;
+	CommandCost unlimited_copy = Command<CMD_CLONE_ORDER>::Do(DoCommandFlag::Execute, CO_COPY, range_probe.vehicle, plane.vehicle);
+	commands.push_back(CostRecord("CMD_COPY_AIRCRAFT_ORDERS_UNLIMITED", unlimited_copy));
+	Require(unlimited_copy.Succeeded() && Vehicle::Get(range_probe.vehicle)->GetNumOrders() == 2,
+		"unlimited aircraft range did not accept valid order cycle");
+	Require(std::filesystem::path(save_path).is_absolute() && !std::filesystem::exists(save_path), "lifecycle save path is invalid or already exists");
+	Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "native aircraft lifecycle SAVE failed");
+	uintmax_t save_bytes = std::filesystem::file_size(save_path);
+	CommandCost mutate = Command<CMD_CHANGE_SERVICE_INT>::Do(DoCommandFlag::Execute, plane.vehicle, 180, true, false);
+	commands.push_back(CostRecord("CMD_MUTATE_AIRCRAFT_SERVICE_AFTER_SAVE", mutate));
+	Require(mutate.Succeeded() && Vehicle::Get(plane.vehicle)->GetServiceInterval() == 180, "post-save aircraft mutation failed");
+	Require(SaveOrLoad(save_path, SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "native aircraft lifecycle LOAD failed");
+	SetLocalCompany(CompanyID::Begin());
+	_current_company = CompanyID::Begin();
+	Require(Vehicle::IsValidID(plane.vehicle) && Vehicle::Get(plane.vehicle)->GetServiceInterval() == 120 &&
+		Vehicle::Get(plane.vehicle)->GetNumOrders() == 2 && Vehicle::IsValidID(helicopter.vehicle) &&
+		Vehicle::Get(helicopter.vehicle)->GetServiceInterval() == 90, "aircraft state did not restore across save/load");
+	auto clone = Command<CMD_CLONE_VEHICLE>::Do(DoCommandFlag::Execute, pair.source_hangar, plane.vehicle, false);
+	commands.push_back(CostRecord("CMD_CLONE_AIRCRAFT", std::get<0>(clone)));
+	Require(std::get<0>(clone).Succeeded() && Vehicle::IsValidID(std::get<1>(clone)), "aircraft clone failed");
+	VehicleID clone_id = std::get<1>(clone);
+	EngineID replacement = EngineID::Invalid();
+	VehicleID replaced_clone = VehicleID::Invalid();
+	for (const Engine *candidate : Engine::IterateType(VEH_AIRCRAFT)) {
+		const AircraftVehicleInfo &info = candidate->VehInfo<AircraftVehicleInfo>();
+		if ((info.subtype & AIR_CTOL) == 0 || candidate->index == plane.engine || !candidate->company_avail.Test(CompanyID::Begin()) ||
+			!HasBit(GetUnionOfArticulatedRefitMasks(candidate->index, true), cargo) || !CanVehicleUseStation(candidate->index, Station::Get(pair.source))) continue;
+		CommandCost mapping_test = Command<CMD_SET_AUTOREPLACE>::Do({}, DEFAULT_GROUP, plane.engine, candidate->index, false);
+		commands.push_back(CostRecord("CMD_SET_AIRCRAFT_AUTOREPLACE_TEST", mapping_test));
+		if (mapping_test.Failed()) continue;
+		CommandCost mapping = Command<CMD_SET_AUTOREPLACE>::Do(DoCommandFlag::Execute, DEFAULT_GROUP, plane.engine, candidate->index, false);
+		commands.push_back(CostRecord("CMD_SET_AIRCRAFT_AUTOREPLACE", mapping));
+		Require(mapping.Succeeded(), "aircraft autoreplace mapping failed");
+		CommandCost replace_test = Command<CMD_AUTOREPLACE_VEHICLE>::Do({}, clone_id);
+		commands.push_back(CostRecord("CMD_AUTOREPLACE_AIRCRAFT_TEST", replace_test));
+		if (replace_test.Succeeded()) {
+			CommandCost replace = Command<CMD_AUTOREPLACE_VEHICLE>::Do(DoCommandFlag::Execute, clone_id);
+			commands.push_back(CostRecord("CMD_AUTOREPLACE_AIRCRAFT", replace));
+			if (replace.Succeeded()) {
+				replacement = candidate->index;
+				for (const Aircraft *aircraft : Aircraft::Iterate()) {
+					if (aircraft->IsNormalAircraft() && aircraft->index != plane.vehicle && aircraft->index != helicopter.vehicle &&
+						aircraft->index != range_probe.vehicle && aircraft->engine_type == replacement) {
+						replaced_clone = aircraft->index;
+						break;
+					}
+				}
+			}
+		}
+		CommandCost clear = Command<CMD_SET_AUTOREPLACE>::Do(DoCommandFlag::Execute, DEFAULT_GROUP, plane.engine, EngineID::Invalid(), false);
+		commands.push_back(CostRecord("CMD_CLEAR_AIRCRAFT_AUTOREPLACE", clear));
+		Require(clear.Succeeded(), "aircraft autoreplace mapping clear failed");
+		if (replacement != EngineID::Invalid()) break;
+	}
+	Require(replacement != EngineID::Invalid() && Vehicle::IsValidID(replaced_clone), "no compatible aircraft autoreplace could execute");
+	CommandCost sell = Command<CMD_SELL_VEHICLE>::Do(DoCommandFlag::Execute, replaced_clone, true, false, INVALID_CLIENT_ID);
+	commands.push_back(CostRecord("CMD_SELL_AIRCRAFT", sell));
+	Require(sell.Succeeded() && !Vehicle::IsValidID(replaced_clone), "autoreplaced aircraft sale failed");
+	return {{"airplane", {{"capacity", plane.capacity}, {"engine", plane.engine.base()}, {"vehicle", plane.vehicle.base()}}},
+		{"clone_and_sale", true}, {"commands", std::move(commands)},
+		{"helicopter", {{"capacity", helicopter.capacity}, {"engine", helicopter.engine.base()}, {"vehicle", helicopter.vehicle.base()}}},
+		{"range_mask", {{"bounded_rejected", true}, {"limit", 8}, {"unlimited_accepted", true}}},
+		{"replacement", {{"executed", true}, {"from_engine", plane.engine.base()}, {"to_engine", replacement.base()}}},
+		{"save_load", {{"bytes", save_bytes}, {"restored", true}}}, {"service_intervals", {{"airplane", 120}, {"helicopter", 90}}},
+		{"timetable", {{"speed_limit_rejected", true}, {"travel", 256}, {"wait", 64}}}};
+}
+
+static json RunOccupancy(CargoType cargo)
+{
+	json commands = json::array();
+	SetCalendarYear(1950);
+	AirportPair pair = BuildAirportPair(AT_SMALL);
+	SetCalendarYear(2050);
+	std::vector<UnitBuild> fleet;
+	for (uint i = 0; i < 4; ++i) {
+		fleet.push_back(BuildAircraft(pair.source_hangar, cargo, true, commands, "CMD_BUILD_CONGESTION_AIRPLANE"));
+		std::array<StationID, 2> orders{pair.source, pair.destination};
+		SetOrders(fleet.back().vehicle, orders, std::nullopt, commands);
+		InjectCargo(pair.source, cargo, fleet.back().capacity);
+		Require(LoadFromStation(fleet.back().vehicle, pair.source, pair.destination) == fleet.back().capacity,
+			"congestion aircraft did not load");
+		ToggleVehicle(fleet.back().vehicle, commands, "CMD_START_CONGESTION_AIRPLANE");
+	}
+	std::set<uint64_t> block_states;
+	std::set<uint8_t> headings;
+	uint peak_destination_contenders = 0;
+	uint nonzero_block_ticks = 0;
+	for (uint64_t tick = 0; tick < 24000; ++tick) {
+		StateGameLoop();
+		uint64_t blocks = Station::Get(pair.source)->airport.blocks.base() | Station::Get(pair.destination)->airport.blocks.base();
+		block_states.insert(blocks);
+		nonzero_block_ticks += blocks != 0;
+		uint contenders = 0;
+		for (const UnitBuild &unit : fleet) {
+			const Aircraft *aircraft = Aircraft::Get(unit.vehicle);
+			headings.insert(aircraft->state);
+			contenders += aircraft->targetairport == pair.destination && aircraft->state == FLYING;
+		}
+		peak_destination_contenders = std::max(peak_destination_contenders, contenders);
+	}
+	Require(block_states.size() > 2 && nonzero_block_ticks > 0 && headings.contains(FLYING) && peak_destination_contenders >= 2,
+		"airport occupancy oracle did not expose blocks, movement, and competing arrivals");
+	return {{"aircraft", fleet.size()}, {"block_state_count", block_states.size()}, {"commands", std::move(commands)},
+		{"headings", headings}, {"nonzero_block_ticks", nonzero_block_ticks}, {"peak_destination_contenders", peak_destination_contenders},
+		{"source_airport", pair.source.base()}, {"destination_airport", pair.destination.base()}};
+}
