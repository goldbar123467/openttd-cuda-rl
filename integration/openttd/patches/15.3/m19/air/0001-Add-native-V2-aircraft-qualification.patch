+static json CostRecord(std::string_view command, const CommandCost &cost)
+{
+	return {{"command", command}, {"cost", cost.Succeeded() ? cost.GetCost().base() : 0},
+		{"error_message_id", static_cast<uint64_t>(cost.GetErrorMessage())}, {"status", cost.Succeeded() ? "SUCCESS" : "REJECTED"}};
+}
