+
+static json AirportCatalog()
+{
+	json airports = json::array();
+	for (uint8_t type = 0; type < 10; ++type) {
+		const AirportSpec *spec = AirportSpec::Get(type);
+		const AirportFTAClass *fsm = spec->fsm;
+		uint terminals = 0;
+		if (fsm->terminals != nullptr) {
+			for (uint group = 0; group < fsm->terminals[0]; ++group) terminals += fsm->terminals[group + 1];
+		}
+		airports.push_back({
+			{"airplanes", fsm->flags.Test(AirportFTAClass::Flag::Airplanes)},
+			{"catchment", spec->catchment},
+			{"depots", spec->depots.size()},
+			{"enabled", spec->enabled},
+			{"fsm_elements", fsm->nofelements},
+			{"helicopters", fsm->flags.Test(AirportFTAClass::Flag::Helicopters)},
+			{"helipads", fsm->num_helipads},
+			{"id", type},
+			{"layouts", spec->layouts.size()},
+			{"maintenance", spec->maintenance_cost},
+			{"max_year", spec->max_year.base()},
+			{"min_year", spec->min_year.base()},
+			{"name", AIRPORT_NAMES[type]},
+			{"noise", spec->noise_level},
+			{"short_strip", fsm->flags.Test(AirportFTAClass::Flag::ShortStrip)},
+			{"size_x", spec->size_x},
+			{"size_y", spec->size_y},
+			{"terminals", terminals},
+		});
+	}
+	return airports;
+}
+
+static json AircraftCatalog()
+{
+	json engines = json::array();
+	for (const Engine *engine : Engine::IterateType(VEH_AIRCRAFT)) {
+		const AircraftVehicleInfo &info = engine->VehInfo<AircraftVehicleInfo>();
+		json refit = json::array();
+		CargoTypes mask = GetUnionOfArticulatedRefitMasks(engine->index, true);
+		for (const CargoSpec *cargo : CargoSpec::Iterate()) if (HasBit(mask, cargo->Index())) refit.push_back(CargoText(cargo->Index()));
+		engines.push_back({
+			{"acceleration", info.acceleration},
+			{"available", engine->company_avail.Test(CompanyID::Begin())},
+			{"engine_id", engine->index.base()},
+			{"kind", (info.subtype & AIR_CTOL) != 0 ? "airplane" : "helicopter"},
+			{"mail_capacity", info.mail_capacity},
+			{"max_range", info.max_range},
+			{"max_speed", info.max_speed},
+			{"passenger_capacity", info.passenger_capacity},
+			{"refit_cargos", std::move(refit)},
+		});
+	}
+	return engines;
+}
