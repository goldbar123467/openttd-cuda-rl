+static StationID BuildAirport(TileIndex tile, uint8_t type, StationID join, json &commands, std::string_view label = "CMD_BUILD_AIRPORT")
+{
+	CommandCost test = Command<CMD_BUILD_AIRPORT>::Do({}, tile, type, 0, join, false);
+	commands.push_back(CostRecord(fmt::format("{}_TEST", label), test));
+	Require(test.Succeeded(), fmt::format("airport test failed type={} tile={} error={}", type, tile.base(), static_cast<uint64_t>(test.GetErrorMessage())));
+	CommandCost execute = Command<CMD_BUILD_AIRPORT>::Do(DoCommandFlag::Execute, tile, type, 0, join, false);
+	commands.push_back(CostRecord(label, execute));
+	Require(execute.Succeeded() && IsAirportTile(tile), "airport execution diverged from test");
+	StationID station = GetStationIndex(tile);
+	Require(Station::IsValidID(station) && (join == NEW_STATION || station == join), "airport station identity or join diverged");
+	return station;
+}
+
+static AirportPair BuildAirportPair(uint8_t type, TileIndex source_tile = TileXY(4, 28), TileIndex destination_tile = TileXY(52, 28))
+{
+	json ignored = json::array();
+	StationID source = BuildAirport(source_tile, type, NEW_STATION, ignored);
+	StationID destination = BuildAirport(destination_tile, type, NEW_STATION, ignored);
+	const Station *source_station = Station::Get(source);
+	const Station *destination_station = Station::Get(destination);
+	Require(source_station->airport.GetNumHangars() > 0 && destination_station->airport.GetNumHangars() > 0,
+		"airport pair needs hangars");
+	return {source, destination, source_station->airport.GetHangarTile(0), destination_station->airport.GetHangarTile(0)};
+}
+
+static json ConstructionOracle()
+{
+	json commands = json::array();
+	json types = json::array();
+	TileIndex tile = TileXY(30, 30);
+	for (uint8_t type = 0; type < 9; ++type) {
+		const AirportSpec *spec = AirportSpec::Get(type);
+		int year = std::max(0, spec->min_year.base());
+		if (spec->max_year.base() >= 2050 && year <= 2050) year = 2050;
+		SetCalendarYear(year);
+		if (spec->min_year.base() > 0) {
+			SetCalendarYear(spec->min_year.base() - 1);
+			CommandCost early = Command<CMD_BUILD_AIRPORT>::Do({}, tile, type, 0, NEW_STATION, false);
+			commands.push_back(CostRecord("CMD_BUILD_AIRPORT_BEFORE_INTRODUCTION", early));
+			Require(early.Failed(), "airport was buildable before introduction year");
+			SetCalendarYear(year);
+		}
+		if (spec->max_year.base() < CalendarTime::MAX_YEAR.base()) {
+			SetCalendarYear(spec->max_year.base() + 1);
+			CommandCost late = Command<CMD_BUILD_AIRPORT>::Do({}, tile, type, 0, NEW_STATION, false);
+			commands.push_back(CostRecord("CMD_BUILD_AIRPORT_AFTER_EXPIRY", late));
+			Require(late.Failed(), "airport was buildable after expiry year");
+			SetCalendarYear(year);
+		}
+		CommandCost test = Command<CMD_BUILD_AIRPORT>::Do({}, tile, type, 0, NEW_STATION, false);
+		commands.push_back(CostRecord("CMD_BUILD_AIRPORT_TYPE_TEST", test));
+		Require(test.Succeeded(), fmt::format("buildable airport type {} test failed", type));
+		CommandCost execute = Command<CMD_BUILD_AIRPORT>::Do(DoCommandFlag::Execute, tile, type, 0, NEW_STATION, false);
+		commands.push_back(CostRecord("CMD_BUILD_AIRPORT_TYPE", execute));
+		Require(execute.Succeeded(), fmt::format("buildable airport type {} execution failed", type));
+		StationID station_id = GetStationIndex(tile);
+		const Station *station = Station::Get(station_id);
+		Require(station->airport.w == spec->size_x && station->airport.h == spec->size_y && station->airport.type == type,
+			"airport footprint or type diverged");
+		types.push_back({{"cost", execute.GetCost().base()}, {"height", station->airport.h}, {"id", type},
+			{"name", AIRPORT_NAMES[type]}, {"station", station_id.base()}, {"width", station->airport.w}, {"year", year}});
+		CommandCost remove_test = Command<CMD_LANDSCAPE_CLEAR>::Do({}, tile);
+		commands.push_back(CostRecord("CMD_REMOVE_AIRPORT_TEST", remove_test));
+		Require(remove_test.Succeeded(), "airport remove test failed");
+		CommandCost remove = Command<CMD_LANDSCAPE_CLEAR>::Do(DoCommandFlag::Execute, tile);
+		commands.push_back(CostRecord("CMD_REMOVE_AIRPORT", remove));
+		Require(remove.Succeeded() && !Station::Get(station_id)->facilities.Test(StationFacility::Airport), "airport removal failed");
+	}
+	SetCalendarYear(2050);
+	CommandCost oilrig = Command<CMD_BUILD_AIRPORT>::Do({}, tile, AT_OILRIG, 0, NEW_STATION, false);
+	commands.push_back(CostRecord("CMD_BUILD_DISABLED_OILRIG", oilrig));
+	Require(oilrig.Failed(), "disabled oil-rig airport was buildable");
+	uint8_t old_spread = _settings_game.station.station_spread;
+	_settings_game.station.station_spread = 8;
+	CommandCost spread = Command<CMD_BUILD_AIRPORT>::Do({}, tile, AT_INTERCON, 0, NEW_STATION, false);
+	commands.push_back(CostRecord("CMD_BUILD_AIRPORT_SPREAD_MASK", spread));
+	_settings_game.station.station_spread = old_spread;
+	Require(spread.Failed(), "station-spread mask accepted oversized airport");
+	SetTileHeight(TileXY(31, 30), 2);
+	CommandCost terrain = Command<CMD_BUILD_AIRPORT>::Do({}, tile, AT_COMMUTER, 0, NEW_STATION, false);
+	commands.push_back(CostRecord("CMD_BUILD_AIRPORT_TERRAIN_MASK", terrain));
+	SetTileHeight(TileXY(31, 30), 1);
+	Require(terrain.Failed(), "terrain mask accepted non-flat airport site");
+	CommandCost invalid = Command<CMD_BUILD_AIRPORT>::Do({}, tile, NUM_AIRPORTS, 0, NEW_STATION, false);
+	commands.push_back(CostRecord("CMD_BUILD_AIRPORT_INVALID_TYPE", invalid));
+	Require(invalid.Failed(), "invalid airport type was accepted");
+	StationID owner_station = BuildAirport(TileXY(44, 44), AT_COMMUTER, NEW_STATION, commands, "CMD_BUILD_OWNERSHIP_AIRPORT");
+	_current_company = CompanyID{1};
+	CommandCost ownership = Command<CMD_LANDSCAPE_CLEAR>::Do({}, TileXY(44, 44));
+	commands.push_back(CostRecord("CMD_REMOVE_FOREIGN_AIRPORT", ownership));
+	_current_company = CompanyID::Begin();
+	Require(ownership.Failed() && Station::Get(owner_station)->facilities.Test(StationFacility::Airport), "foreign airport ownership mask failed");
+	return {{"buildable_types", std::move(types)}, {"commands", std::move(commands)}, {"disabled_oilrig_rejected", true},
+		{"footprint_mask", true}, {"ownership_mask", true}, {"spread_mask", true}, {"terrain_mask", true}};
+}
+
+static UnitBuild BuildAircraft(TileIndex hangar, CargoType cargo, bool airplane, json &commands, std::string_view label = "CMD_BUILD_AIRCRAFT")
+{
+	const Station *station = Station::GetByTile(hangar);
+	for (const Engine *engine : Engine::IterateType(VEH_AIRCRAFT)) {
+		const AircraftVehicleInfo &info = engine->VehInfo<AircraftVehicleInfo>();
+		if (((info.subtype & AIR_CTOL) != 0) != airplane || !engine->company_avail.Test(CompanyID::Begin()) || !engine->CanCarryCargo()) continue;
+		if (!HasBit(GetUnionOfArticulatedRefitMasks(engine->index, true), cargo) || !CanVehicleUseStation(engine->index, station)) continue;
+		auto result = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, hangar, engine->index, true, cargo, INVALID_CLIENT_ID);
+		commands.push_back(CostRecord(label, std::get<0>(result)));
+		if (std::get<0>(result).Failed()) continue;
+		VehicleID vehicle = std::get<1>(result);
+		auto refit = Command<CMD_REFIT_VEHICLE>::Do(DoCommandFlag::Execute, vehicle, cargo, 0, false, false, 0);
+		commands.push_back(CostRecord("CMD_REFIT_AIRCRAFT", std::get<0>(refit)));
+		Require(std::get<0>(refit).Succeeded(), "aircraft refit failed after build");
+		const Aircraft *aircraft = Aircraft::Get(vehicle);
+		Require(aircraft->cargo_type == cargo && aircraft->cargo_cap > 0 && aircraft->IsInDepot(),
+			"built aircraft has wrong cargo, capacity, or location");
+		return {vehicle, engine->index, aircraft->cargo_cap};
+	}
+	Fail(fmt::format("no buildable {} for cargo {}", airplane ? "airplane" : "helicopter", CargoText(cargo)));
+}
+
+static void SetOrders(VehicleID vehicle, std::span<const StationID> stations, std::optional<size_t> transfer_ordinal,
+	json &commands, std::string_view label = "CMD_INSERT_AIRCRAFT_ORDER")
+{
+	for (size_t ordinal = 0; ordinal < stations.size(); ++ordinal) {
+		Order order;
+		order.MakeGoToStation(stations[ordinal]);
+		order.SetStopLocation(OrderStopLocation::FarEnd);
+		if (transfer_ordinal.has_value() && *transfer_ordinal == ordinal) {
+			order.SetUnloadType(OrderUnloadType::Transfer);
+			order.SetLoadType(OrderLoadType::NoLoad);
+		}
+		CommandCost cost = Command<CMD_INSERT_ORDER>::Do(DoCommandFlag::Execute, vehicle,
+			VehicleOrderID{static_cast<uint8_t>(ordinal)}, order);
+		commands.push_back(CostRecord(label, cost));
+		Require(cost.Succeeded(), fmt::format("failed to insert order ordinal={} station={} error={}",
+			ordinal, stations[ordinal].base(), static_cast<uint64_t>(cost.GetErrorMessage())));
+	}
+}
+
+static void InjectCargo(StationID station_id, CargoType cargo, uint amount)
+{
+	Require(CargoPacket::CanAllocateItem(), "cargo packet pool is full");
+	Station *station = Station::Get(station_id);
+	GoodsEntry &goods = station->goods[cargo];
+	goods.rating = 255;
+	goods.status.Set(GoodsEntry::State::Rating);
+	Source source{Town::Get(TownID{0})->index, SourceType::Town};
+	goods.GetOrCreateData().cargo.Append(new CargoPacket(station_id, static_cast<uint16_t>(amount), source), StationID::Invalid());
+}
+
+static void SetDestinationAcceptance(StationID station_id, CargoType cargo)
+{
+	RlV2SetQualificationAcceptance(station_id, cargo, true);
+	Station *station = Station::Get(station_id);
+	station->goods[cargo].status.Set(GoodsEntry::State::Acceptance);
+	SetBit(station->always_accepted, cargo);
+}
+
+static uint LoadFromStation(VehicleID vehicle, StationID source, StationID destination)
+{
+	Vehicle *unit = Vehicle::Get(vehicle);
+	GoodsEntry &goods = Station::Get(source)->goods[unit->cargo_type];
+	std::array<StationID, 1> next{destination};
+	return goods.GetOrCreateData().cargo.Load(unit->cargo_cap, &unit->cargo, next, Station::Get(source)->xy);
+}
+
+static void ToggleVehicle(VehicleID vehicle, json &commands, std::string_view label)
+{
+	CommandCost cost = Command<CMD_START_STOP_VEHICLE>::Do(DoCommandFlag::Execute, vehicle, false);
+	commands.push_back(CostRecord(label, cost));
+	Require(cost.Succeeded(), fmt::format("vehicle toggle failed: {}", label));
+}
