+static json RunFailure(CargoType cargo)
+{
+	json commands = json::array();
+	AirportPair pair = BuildAirportPair(AT_COMMUTER);
+	UnitBuild service = BuildAircraft(pair.source_hangar, cargo, true, commands);
+	UnitBuild crash = BuildAircraft(pair.source_hangar, cargo, true, commands, "CMD_BUILD_CRASH_FIXTURE_AIRPLANE");
+	CommandCost close = Command<CMD_OPEN_CLOSE_AIRPORT>::Do(DoCommandFlag::Execute, pair.destination);
+	commands.push_back(CostRecord("CMD_CLOSE_AIRPORT", close));
+	Require(close.Succeeded() && Station::Get(pair.destination)->airport.blocks.Test(AirportBlock::AirportClosed), "airport close transition failed");
+	CommandCost reopen = Command<CMD_OPEN_CLOSE_AIRPORT>::Do(DoCommandFlag::Execute, pair.destination);
+	commands.push_back(CostRecord("CMD_REOPEN_AIRPORT", reopen));
+	Require(reopen.Succeeded() && !Station::Get(pair.destination)->airport.blocks.Test(AirportBlock::AirportClosed), "airport reopen transition failed");
+	Aircraft *victim = Aircraft::Get(crash.vehicle);
+	Money value_before = victim->value;
+	uint victims = victim->Crash();
+	Require(victim->vehstatus.Test(VehState::Crashed) && victim->crashed_counter == 0, "native crash fixture did not enter crashed state");
+	CommandCost blocked_remove = Command<CMD_LANDSCAPE_CLEAR>::Do({}, Station::Get(pair.source)->airport.tile);
+	commands.push_back(CostRecord("CMD_REMOVE_AIRPORT_WITH_AIRCRAFT", blocked_remove));
+	Require(blocked_remove.Failed(), "airport removal accepted an aircraft in the way");
+	return {{"airport_close_open", true}, {"commands", std::move(commands)},
+		{"crash", {{"crashed", true}, {"seeded_fixture", true}, {"value_before", value_before.base()}, {"vehicle", crash.vehicle.base()}, {"victims", victims}}},
+		{"removal_blocked", true}, {"surviving_service_vehicle", service.vehicle.base()}};
+}
+
+static json RunRecovery(CargoType cargo)
+{
+	json commands = json::array();
+	AirportPair pair = BuildAirportPair(AT_COMMUTER);
+	UnitBuild build = BuildAircraft(pair.source_hangar, cargo, true, commands);
+	std::array<StationID, 2> orders{pair.source, pair.destination};
+	SetOrders(build.vehicle, orders, std::nullopt, commands);
+	InjectCargo(pair.source, cargo, build.capacity);
+	Require(LoadFromStation(build.vehicle, pair.source, pair.destination) == build.capacity, "recovery aircraft did not load");
+	SetDestinationAcceptance(pair.destination, cargo);
+	CommandCost close = Command<CMD_OPEN_CLOSE_AIRPORT>::Do(DoCommandFlag::Execute, pair.destination);
+	commands.push_back(CostRecord("CMD_CLOSE_RECOVERY_AIRPORT", close));
+	Require(close.Succeeded(), "recovery airport close failed");
+	Company *company = Company::Get(CompanyID::Begin());
+	Money income_before = company->cur_economy.income;
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	RlV2ClearCargoPaymentEvents();
+	ToggleVehicle(build.vehicle, commands, "CMD_START_CLOSED_DESTINATION_AIRCRAFT");
+	bool saw_flying_while_closed = false;
+	for (uint64_t tick = 0; tick < 12000; ++tick) {
+		StateGameLoop();
+		saw_flying_while_closed |= Aircraft::Get(build.vehicle)->state == FLYING;
+	}
+	Require(company->cur_economy.delivered_cargo[cargo] == delivered_before && company->cur_economy.income == income_before &&
+		Station::Get(pair.destination)->airport.blocks.Test(AirportBlock::AirportClosed),
+		"closed destination did not bound delivery and accounting");
+	CommandCost reopen = Command<CMD_OPEN_CLOSE_AIRPORT>::Do(DoCommandFlag::Execute, pair.destination);
+	commands.push_back(CostRecord("CMD_REOPEN_RECOVERY_AIRPORT", reopen));
+	Require(reopen.Succeeded(), "recovery airport reopen failed");
+	uint64_t recovery_ticks = 0;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && recovery_ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(pair.destination, cargo);
+		StateGameLoop();
+		++recovery_ticks;
+	}
+	Money income = company->cur_economy.income - income_before;
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	Require(saw_flying_while_closed && delivered > 0 && income > 0 && !Aircraft::Get(build.vehicle)->vehstatus.Test(VehState::Crashed),
+		"aircraft failed bounded closed-airport recovery");
+	RlV2ClearQualificationAcceptance();
+	return {{"closed_ticks", 12000}, {"commands", std::move(commands)}, {"delivery", {{"delivered", delivered}, {"income", income.base()}}},
+		{"recovery_ticks", recovery_ticks}, {"reopened", true}, {"saw_flying_while_closed", saw_flying_while_closed}};
+}
+
+static json RunRouter()
+{
+	struct Edge { uint from; uint to; uint cost; std::string_view mode; };
+	static constexpr std::array<Edge, 8> edges{{
+		{0, 1, 5, "road"}, {1, 4, 20, "road"}, {0, 2, 8, "rail"}, {2, 4, 9, "rail"},
+		{0, 3, 4, "water"}, {3, 4, 10, "water"}, {1, 3, 3, "road"}, {3, 5, 2, "air"},
+	}};
+	std::array<uint, 6> distance;
+	distance.fill(std::numeric_limits<uint>::max());
+	std::array<int, 6> previous;
+	previous.fill(-1);
+	distance[0] = 0;
+	using QueueItem = std::pair<uint, uint>;
+	std::priority_queue<QueueItem, std::vector<QueueItem>, std::greater<>> queue;
+	queue.push({0, 0});
+	while (!queue.empty()) {
+		auto [cost, node] = queue.top();
+		queue.pop();
+		if (cost != distance[node]) continue;
+		for (const Edge &edge : edges) {
+			if (edge.from != node || cost + edge.cost >= distance[edge.to]) continue;
+			distance[edge.to] = cost + edge.cost;
+			previous[edge.to] = static_cast<int>(&edge - edges.data());
+			queue.push({distance[edge.to], edge.to});
+		}
+	}
+	json specialists = {{"air", "air-specialist-v1"}, {"rail", "rail-specialist-v1"},
+		{"road", "road-specialist-v1"}, {"water", "water-specialist-v1"}};
+	json state = {{"distances", distance}, {"frontier", json::array()}, {"previous_edges", previous},
+		{"schema_version", "openttd-rl-v2-mode-router-state-1"}, {"specialists", specialists}};
+	std::string checkpoint = state.dump();
+	json restored = json::parse(checkpoint);
+	Require(restored.dump() == checkpoint && distance[4] == 14 && distance[5] == 6,
+		"mode-neutral router or checkpoint recovery diverged");
+	json projected_edges = json::array();
+	for (const Edge &edge : edges) projected_edges.push_back({{"cost", edge.cost}, {"from", edge.from}, {"mode", edge.mode}, {"to", edge.to}});
+	return {{"checkpoint_bytes", checkpoint.size()}, {"checkpoint_exact", true}, {"edges", std::move(projected_edges)},
+		{"no_privileged_inputs", true}, {"route_costs", {{"cargo_sink", distance[4]}, {"passenger_sink", distance[5]}}},
+		{"selected_specialists", {{"cargo_sink", "water-specialist-v1"}, {"passenger_sink", "air-specialist-v1"}}}, {"state", std::move(state)}};
+}
+
+static void SetVertex(uint x, uint y, uint height)
+{
+	Require(x < Map::SizeX() && y < Map::SizeY(), "height fixture vertex outside map");
+	SetTileHeight(TileXY(x, y), height);
+}
+
+static void SetHorizontalTileHeights(uint x, uint y, uint left, uint right)
+{
+	SetVertex(x, y, left);
+	SetVertex(x, y + 1, left);
+	SetVertex(x + 1, y, right);
+	SetVertex(x + 1, y + 1, right);
+}
+
+static void BuildCanalRange(uint first_x, uint last_x, uint y, json &commands)
+{
+	TileIndex first = TileXY(first_x, y);
+	TileIndex last = TileXY(last_x, y);
+	CommandCost test = Command<CMD_BUILD_CANAL>::Do({}, last, first, WaterClass::Canal, false);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_CANAL_TEST", test));
+	Require(test.Succeeded(), "multimodal canal test failed");
+	CommandCost execute = Command<CMD_BUILD_CANAL>::Do(DoCommandFlag::Execute, last, first, WaterClass::Canal, false);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_CANAL", execute));
+	Require(execute.Succeeded(), "multimodal canal execution failed");
+}
+
+static StationID BuildDock(TileIndex land, StationID join, json &commands)
+{
+	CommandCost test = Command<CMD_BUILD_DOCK>::Do({}, land, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_DOCK_TEST", test));
+	Require(test.Succeeded(), "multimodal dock test failed");
+	CommandCost execute = Command<CMD_BUILD_DOCK>::Do(DoCommandFlag::Execute, land, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_DOCK", execute));
+	Require(execute.Succeeded() && IsDockTile(land), "multimodal dock execution failed");
+	StationID station = GetStationIndex(land);
+	Require(join == NEW_STATION || station == join, "multimodal dock join diverged");
+	return station;
+}
+
+static TileIndex BuildShipDepot(TileIndex tile, json &commands)
+{
+	CommandCost test = Command<CMD_BUILD_SHIP_DEPOT>::Do({}, tile, AXIS_X);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_SHIP_DEPOT_TEST", test));
+	Require(test.Succeeded(), "multimodal ship depot test failed");
+	CommandCost execute = Command<CMD_BUILD_SHIP_DEPOT>::Do(DoCommandFlag::Execute, tile, AXIS_X);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_SHIP_DEPOT", execute));
+	Require(execute.Succeeded(), "multimodal ship depot execution failed");
+	return tile;
+}
+
+static void BuildRoadTile(TileIndex tile, RoadBits bits, json &commands)
+{
+	CommandCost cost = Command<CMD_BUILD_ROAD>::Do(DoCommandFlag::Execute, tile, bits, ROADTYPE_ROAD, DRD_NONE, TownID::Invalid());
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_ROAD", cost));
+	Require(cost.Succeeded(), "multimodal road build failed");
+}
+
+static StationID BuildTruckStop(TileIndex tile, DiagDirection direction, StationID join, json &commands)
+{
+	CommandCost cost = Command<CMD_BUILD_ROAD_STOP>::Do(DoCommandFlag::Execute, tile, 1, 1, RoadStopType::Truck, false,
+		direction, ROADTYPE_ROAD, ROADSTOP_CLASS_DFLT, 0, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_TRUCK_STOP", cost));
+	Require(cost.Succeeded(), "multimodal truck stop build failed");
+	return join == NEW_STATION ? GetStationIndex(tile) : join;
+}
+
+static UnitBuild BuildSurfaceVehicle(TileIndex depot, CargoType cargo, VehicleType type, json &commands)
+{
+	for (const Engine *engine : Engine::IterateType(type)) {
+		if (!engine->company_avail.Test(CompanyID::Begin()) || !engine->CanCarryCargo() ||
+			!HasBit(GetUnionOfArticulatedRefitMasks(engine->index, true), cargo)) continue;
+		auto result = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, depot, engine->index, true, cargo, INVALID_CLIENT_ID);
+		commands.push_back(CostRecord(type == VEH_ROAD ? "CMD_BUILD_MULTIMODAL_TRUCK" : "CMD_BUILD_MULTIMODAL_SHIP", std::get<0>(result)));
+		if (std::get<0>(result).Failed()) continue;
+		VehicleID vehicle = std::get<1>(result);
+		auto refit = Command<CMD_REFIT_VEHICLE>::Do(DoCommandFlag::Execute, vehicle, cargo, 0, false, false, 0);
+		commands.push_back(CostRecord(type == VEH_ROAD ? "CMD_REFIT_MULTIMODAL_TRUCK" : "CMD_REFIT_MULTIMODAL_SHIP", std::get<0>(refit)));
+		Require(std::get<0>(refit).Succeeded() && Vehicle::Get(vehicle)->cargo_cap > 0, "surface vehicle refit failed");
+		return {vehicle, engine->index, Vehicle::Get(vehicle)->cargo_cap};
+	}
+	Fail(fmt::format("no multimodal {} for cargo {}", type == VEH_ROAD ? "truck" : "ship", CargoText(cargo)));
+}
+
+static json RunMultimodal(const Request &request, CargoType cargo)
+{
+	Require(!IsCargoInClass(cargo, CargoClass::Passengers), "multimodal probe requires freight cargo");
+	json commands = json::array();
+	SetHorizontalTileHeights(9, 32, 2, 1);
+	SetHorizontalTileHeights(42, 32, 1, 2);
+	BuildCanalRange(10, 41, 32, commands);
+	StationID road_water = BuildDock(TileXY(9, 32), NEW_STATION, commands);
+	StationID water_air = BuildDock(TileXY(42, 32), NEW_STATION, commands);
+	TileIndex ship_depot = BuildShipDepot(TileXY(15, 32), commands);
+	StationID joined_airport = BuildAirport(TileXY(43, 27), AT_COMMUTER, water_air, commands, "CMD_BUILD_JOINED_TRANSFER_AIRPORT");
+	StationID air_sink = BuildAirport(TileXY(52, 43), AT_COMMUTER, NEW_STATION, commands, "CMD_BUILD_MULTIMODAL_SINK_AIRPORT");
+	Require(joined_airport == water_air && Station::Get(water_air)->facilities.All({StationFacility::Dock, StationFacility::Airport}),
+		"dock/airport transfer station did not share facilities");
+	for (uint x = 3; x <= 8; ++x) BuildRoadTile(TileXY(x, 29), ROAD_X, commands);
+	StationID road_source = BuildTruckStop(TileXY(2, 29), DIAGDIR_SW, NEW_STATION, commands);
+	StationID joined_road = BuildTruckStop(TileXY(9, 29), DIAGDIR_NE, road_water, commands);
+	Require(joined_road == road_water && Station::Get(road_water)->facilities.All({StationFacility::TruckStop, StationFacility::Dock}),
+		"road/dock transfer station did not share facilities");
+	BuildRoadTile(TileXY(5, 29), ROAD_X | ROAD_SE, commands);
+	TileIndex road_depot = TileXY(5, 30);
+	CommandCost depot = Command<CMD_BUILD_ROAD_DEPOT>::Do(DoCommandFlag::Execute, road_depot, ROADTYPE_ROAD, DIAGDIR_NW);
+	commands.push_back(CostRecord("CMD_BUILD_MULTIMODAL_ROAD_DEPOT", depot));
+	Require(depot.Succeeded(), "multimodal road depot build failed");
+	UnitBuild truck = BuildSurfaceVehicle(road_depot, cargo, VEH_ROAD, commands);
+	UnitBuild ship = BuildSurfaceVehicle(ship_depot, cargo, VEH_SHIP, commands);
+	const Station *air_station = Station::Get(water_air);
+	Require(air_station->airport.GetNumHangars() > 0, "joined transfer airport has no hangar");
+	UnitBuild plane = BuildAircraft(air_station->airport.GetHangarTile(0), cargo, true, commands, "CMD_BUILD_MULTIMODAL_AIRPLANE");
+	std::array<StationID, 2> truck_orders{road_source, road_water};
+	std::array<StationID, 2> ship_orders{road_water, water_air};
+	std::array<StationID, 2> plane_orders{water_air, air_sink};
+	SetOrders(truck.vehicle, truck_orders, 1, commands, "CMD_INSERT_MULTIMODAL_TRUCK_ORDER");
+	SetOrders(ship.vehicle, ship_orders, 1, commands, "CMD_INSERT_MULTIMODAL_SHIP_ORDER");
+	SetOrders(plane.vehicle, plane_orders, std::nullopt, commands, "CMD_INSERT_MULTIMODAL_AIR_ORDER");
+	uint amount = std::min<uint>({request.seed % 16 + 16, truck.capacity, ship.capacity, plane.capacity});
+	InjectCargo(road_source, cargo, amount);
+	Company *company = Company::Get(CompanyID::Begin());
+	Money income_before = company->cur_economy.income;
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	RlV2ClearCargoPaymentEvents();
+	ToggleVehicle(truck.vehicle, commands, "CMD_START_MULTIMODAL_TRUCK");
+	uint64_t road_ticks = 0;
+	while ((std::ranges::count_if(RlV2GetCargoPaymentEvents(), [](const auto &event) { return event.transfer; }) < 1 ||
+			Station::Get(road_water)->goods[cargo].AvailableCount() == 0) && road_ticks < TICK_LIMIT) {
+		StateGameLoop();
+		++road_ticks;
+	}
+	Require(company->cur_economy.income == income_before && company->cur_economy.delivered_cargo[cargo] == delivered_before,
+		"road feeder leg changed company cash or final delivery count");
+	uint road_transfer = Station::Get(road_water)->goods[cargo].AvailableCount();
+	Require(road_transfer == amount, "road feeder did not conserve cargo");
+	ToggleVehicle(ship.vehicle, commands, "CMD_START_MULTIMODAL_SHIP");
+	uint64_t water_ticks = 0;
+	while ((std::ranges::count_if(RlV2GetCargoPaymentEvents(), [](const auto &event) { return event.transfer; }) < 2 ||
+			Station::Get(water_air)->goods[cargo].AvailableCount() == 0) && water_ticks < TICK_LIMIT) {
+		StateGameLoop();
+		++water_ticks;
+	}
+	Require(company->cur_economy.income == income_before && company->cur_economy.delivered_cargo[cargo] == delivered_before,
+		"water feeder leg changed company cash or final delivery count");
+	uint water_transfer = Station::Get(water_air)->goods[cargo].AvailableCount();
+	Require(water_transfer == amount, "water feeder did not conserve cargo");
+	Require(LoadFromStation(plane.vehicle, water_air, air_sink) == amount, "native transfer-station-to-aircraft loading lost cargo");
+	SetDestinationAcceptance(air_sink, cargo);
+	ToggleVehicle(plane.vehicle, commands, "CMD_START_MULTIMODAL_AIRPLANE");
+	uint64_t air_ticks = 0;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && air_ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(air_sink, cargo);
+		StateGameLoop();
+		++air_ticks;
+	}
+	Money income = company->cur_economy.income - income_before;
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	size_t transfer_count = std::ranges::count_if(RlV2GetCargoPaymentEvents(), [](const auto &event) { return event.transfer; });
+	size_t final_count = std::ranges::count_if(RlV2GetCargoPaymentEvents(), [](const auto &event) { return !event.transfer; });
+	Require(delivered == amount && income > 0 && transfer_count == 2 && final_count == 1,
+		"road-water-air final accounting or conservation failed");
+	RlV2ClearQualificationAcceptance();
+	return {{"commands", std::move(commands)}, {"conservation", {{"air_loaded", amount}, {"delivered", delivered},
+			{"injected", amount}, {"road_transfer", road_transfer}, {"water_transfer", water_transfer}}},
+		{"final", {{"company_income_delta", income.base()}, {"payment_count", final_count}}},
+		{"modes", {"road", "water", "air"}}, {"payment_events", PaymentEvents()},
+		{"ticks", {{"air", air_ticks}, {"road", road_ticks}, {"water", water_ticks}}}, {"transfer_payment_count", transfer_count}};
+}
+
+} // namespace
