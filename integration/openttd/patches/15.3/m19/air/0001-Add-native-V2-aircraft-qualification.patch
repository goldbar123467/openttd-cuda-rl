+static json PaymentEvents()
+{
+	json result = json::array();
+	for (const RlV2CargoPaymentEvent &event : RlV2GetCargoPaymentEvents()) {
+		result.push_back({{"base_income", event.base_income.base()}, {"cargo", CargoText(event.cargo)}, {"count", event.count},
+			{"distance", event.distance}, {"feeder_share", event.feeder_share.base()}, {"final_income", event.final_income.base()},
+			{"periods_in_transit", event.periods_in_transit}, {"station", event.station.base()}, {"transfer", event.transfer}});
+	}
+	return result;
+}
