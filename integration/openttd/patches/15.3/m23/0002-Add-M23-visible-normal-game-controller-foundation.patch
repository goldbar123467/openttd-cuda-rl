+struct CampaignSpec {
+	std::string_view id;
+	uint32_t seed;
+	std::string_view program;
+	std::string_view mode;
+	std::string_view climate;
+	uint map_width;
+	uint map_height;
+	std::string_view opponent;
+};
+
+static constexpr std::array<CampaignSpec, 8> CAMPAIGNS = {{
+	{"visible-road-passenger-kraken", 131136999, "road-passenger", "road", "temperate", 128, 128, "KrakenAI2"},
+	{"visible-road-cargo-control", 1118866958, "road-cargo", "road", "toyland", 128, 128, "NoOpAI"},
+	{"visible-rail-passenger-aaahogex", 936218737, "rail-passenger", "rail", "arctic", 128, 128, "AAAHogEx"},
+	{"visible-rail-freight-kraken", 625844863, "rail-freight", "rail", "tropic", 512, 128, "KrakenAI2"},
+	{"visible-water-aaahogex", 327830242, "ship-natural", "water", "tropic", 512, 128, "AAAHogEx"},
+	{"visible-air-kraken", 871455497, "air-service", "air", "toyland", 128, 128, "KrakenAI2"},
+	{"visible-multimodal-aaahogex", 1729581758, "multimodal-transfer", "multimodal", "temperate", 128, 128, "AAAHogEx"},
+	{"visible-company-kraken", 2047174508, "competition-head-to-head", "company", "arctic", 128, 128, "KrakenAI2"},
+}};
+
+static const CampaignSpec &ParseCampaign(const json &value)
+{
+	RequireKeys(value, {"climate", "id", "map_height", "map_width", "mode", "opponent", "program", "seed"}, "campaign");
+	for (const auto &campaign : CAMPAIGNS) {
+		if (value.at("id") == campaign.id) {
+			Require(value == json{{"climate", campaign.climate}, {"id", campaign.id},
+				{"map_height", campaign.map_height}, {"map_width", campaign.map_width},
+				{"mode", campaign.mode}, {"opponent", campaign.opponent},
+				{"program", campaign.program}, {"seed", campaign.seed}},
+				"campaign fields differ from the frozen preregistration");
+			return campaign;
+		}
+	}
+	throw std::runtime_error("M23 V2 neural agent: campaign ID is not preregistered");
+}
+
+static LandscapeType ParseClimate(std::string_view climate)
+{
+	if (climate == "temperate") return LandscapeType::Temperate;
+	if (climate == "arctic") return LandscapeType::Arctic;
+	if (climate == "tropic") return LandscapeType::Tropic;
+	if (climate == "toyland") return LandscapeType::Toyland;
+	throw std::runtime_error("M23 V2 neural agent: campaign climate is unknown");
+}
+
+static uint8_t ModeIndex(std::string_view mode)
+{
+	static constexpr std::array<std::string_view, 7> MODES = {"road", "rail", "water", "air", "multimodal", "company", "broad"};
+	for (uint8_t index = 0; index < MODES.size(); ++index) if (MODES[index] == mode) return index;
+	throw std::runtime_error("M23 V2 neural agent: campaign mode is unknown");
+}
+
+static uint8_t ClimateIndex(LandscapeType climate)
+{
+	switch (climate) {
+		case LandscapeType::Temperate: return 0;
+		case LandscapeType::Arctic: return 1;
+		case LandscapeType::Tropic: return 2;
+		case LandscapeType::Toyland: return 3;
+		default: throw std::runtime_error("M23 V2 neural agent: live climate is unsupported");
+	}
+}
+
+static int OpponentVersion(std::string_view opponent)
+{
+	if (opponent == "AAAHogEx") return 115;
+	if (opponent == "KrakenAI2") return 3;
+	if (opponent == "NoOpAI") return 4;
+	throw std::runtime_error("M23 V2 neural agent: campaign opponent is unknown");
+}
+
+static float OpponentFeature(std::string_view opponent)
+{
+	if (opponent == "AAAHogEx") return 1.0F / 3.0F;
+	if (opponent == "KrakenAI2") return 2.0F / 3.0F;
+	if (opponent == "NoOpAI") return 1.0F;
+	return 0.0F;
+}
+
+static std::pair<std::string_view, std::string_view> ProgramContext(uint8_t program)
+{
+	switch (program) {
+		case 1: return {"PASS", "standard"};
+		case 2: return {"SUGR", "freight"};
+		case 3: return {"PASS", "passenger"};
+		case 4: return {"COAL", "freight"};
+		case 5: return {"PASS", "natural"};
+		case 6: return {"COAL", "constructed"};
+		case 7: return {"PASS", "airplane"};
+		case 8: return {"GOOD", "helicopter"};
+		case 9: return {"GOOD", "transfer"};
+		case 10: return {"PASS", "router"};
+		case 11: return {"PASS", "head-to-head"};
+		case 12: return {"not-applicable", "calendar"};
+		case 13: return {"not-applicable", "authority-economy"};
+		case 14: return {"not-applicable", "events"};
+		case 15: return {"not-applicable", "gamescript"};
+		case 16: return {"not-applicable", "content"};
+		default: return {"not-applicable", "wait"};
+	}
+}
+
+struct PlaybackConfig {
+	const CampaignSpec *campaign = nullptr;
+	std::filesystem::path package_path;
+	std::filesystem::path reload_package_path;
+	std::filesystem::path log_path;
+	std::filesystem::path report_path;
+	std::filesystem::path savegame_path;
+	uint interval_ticks = 128;
+	uint64_t maximum_boundaries = 4;
+	uint64_t maximum_records = 4096;
+	bool exit_when_complete = false;
+	bool screenshot_on_complete = false;
+	bool open_window = true;
+	bool start_paused = false;
+	bool start_running = true;
+};
+
+static PlaybackConfig ParsePlaybackConfig(const json &config)
+{
+	RequireKeys(config, {"acceptance", "campaign", "contract_sha256", "controls", "inference", "logging",
+		"operation", "package_path", "reload_package_path", "report_path", "schema_version", "world"}, "configuration");
+	Require(config.at("schema_version") == M23_PLAYBACK_SCHEMA, "configuration schema_version is incompatible");
+	Require(config.at("contract_sha256") == M23_CONTRACT_SHA256, "configuration contract_sha256 is incompatible");
+	Require(config.at("operation") == "playback", "configuration operation is unsupported");
+
+	PlaybackConfig result;
+	result.campaign = &ParseCampaign(config.at("campaign"));
+	result.package_path = AbsolutePath(config.at("package_path"), "package_path");
+	result.reload_package_path = AbsolutePath(config.at("reload_package_path"), "reload_package_path");
+	result.report_path = AbsolutePath(config.at("report_path"), "report_path");
+
+	const json &inference = config.at("inference");
+	RequireKeys(inference, {"interval_ticks", "mode"}, "inference");
+	Require(inference.at("mode") == "greedy", "visible acceptance requires greedy inference");
+	result.interval_ticks = inference.at("interval_ticks").get<uint>();
+	Require(result.interval_ticks >= 128 && result.interval_ticks <= 1024 && result.interval_ticks % 128 == 0,
+		"policy interval must be a 128-tick multiple in 128..1024");
+
+	const json &logging = config.at("logging");
+	RequireKeys(logging, {"maximum_records", "path"}, "logging");
+	result.log_path = AbsolutePath(logging.at("path"), "logging.path");
+	result.maximum_records = logging.at("maximum_records").get<uint64_t>();
+	Require(result.maximum_records >= 16 && result.maximum_records <= 65536, "log bound must be in 16..65536");
+
+	const json &controls = config.at("controls");
+	RequireKeys(controls, {"open_window", "start_paused", "start_running"}, "controls");
+	result.open_window = controls.at("open_window").get<bool>();
+	result.start_paused = controls.at("start_paused").get<bool>();
+	result.start_running = controls.at("start_running").get<bool>();
+	Require(!result.start_paused || result.start_running, "start_paused requires start_running");
+
+	const json &acceptance = config.at("acceptance");
+	RequireKeys(acceptance, {"exit_when_complete", "maximum_policy_boundaries", "screenshot_on_complete"}, "acceptance");
+	result.exit_when_complete = acceptance.at("exit_when_complete").get<bool>();
+	result.screenshot_on_complete = acceptance.at("screenshot_on_complete").get<bool>();
+	result.maximum_boundaries = acceptance.at("maximum_policy_boundaries").get<uint64_t>();
+	Require(result.maximum_boundaries >= 4 && result.maximum_boundaries <= 4096,
+		"visible acceptance boundary count must be in 4..4096");
+	Require(!result.exit_when_complete || result.screenshot_on_complete,
+		"automatic visible exit requires screenshot_on_complete");
+
+	const json &world = config.at("world");
+	RequireKeys(world, {"savegame_path", "start_year"}, "world");
+	Require(world.at("start_year") == 1950, "visible campaign start year must be 1950");
+	result.savegame_path = AbsolutePath(world.at("savegame_path"), "world.savegame_path");
+
+	RequireNewOutput(result.log_path, "logging.path");
+	RequireNewOutput(result.report_path, "report_path");
+	RequireNewOutput(result.savegame_path, "world.savegame_path");
 	return result;
 }
 
+enum class ControllerState : uint8_t {
+	Prepared,
+	Stopped,
+	Running,
+	Paused,
+	Faulted,
+	Complete,
+};
+
+static std::string_view StateName(ControllerState state)
+{
+	switch (state) {
+		case ControllerState::Prepared: return "PREPARED";
+		case ControllerState::Stopped: return "STOPPED";
+		case ControllerState::Running: return "RUNNING";
+		case ControllerState::Paused: return "PAUSED";
+		case ControllerState::Faulted: return "FAULTED";
+		case ControllerState::Complete: return "COMPLETE";
+	}
+	return "INVALID";
+}
+
+class V2NeuralAgentController {
+public:
+	V2NeuralAgentController(PlaybackConfig config, std::unique_ptr<M23DeploymentPackage> package) :
+		config_(std::move(config)), package_(std::move(package)), hidden_(256, 0.0F)
+	{
+		Require(this->package_->package_id() == MONOLITHIC_PACKAGE_ID,
+			"visible playback package is valid but is not the frozen default monolithic package");
+		this->target_program_ = GetRlV2ProgramIndex(this->config_.campaign->program);
+		this->log_.open(this->config_.log_path, std::ios::binary | std::ios::trunc);
+		Require(static_cast<bool>(this->log_), "cannot open bounded canonical controller log");
+		this->WriteReport();
+	}
+
+	void GameLoop()
+	{
+		if (!this->world_active_) {
+			if (_game_mode != GM_NORMAL || !Company::IsValidID(CompanyID::Begin())) return;
+			this->ActivateWorld();
+		}
+		if (this->pending_exit_) {
+			if (!this->screenshot_requested_) {
+				MakeScreenshot(SC_VIEWPORT, std::string(this->config_.campaign->id));
+				this->screenshot_requested_ = true;
+				return;
+			}
+			if (_full_screenshot_path.empty()) return;
+			_exit_game = true;
+			return;
+		}
+		if (this->state_ != ControllerState::Running || TimerGameTick::counter < this->next_tick_) return;
+		this->RunSafely(false);
+	}
+
+	void Start()
+	{
+		Require(this->world_active_, "start is unavailable before the normal world is active");
+		Require(this->state_ == ControllerState::Stopped || this->state_ == ControllerState::Faulted,
+			"start requires stopped or faulted state");
+		this->ResetRecurrentAndExecutor();
+		this->last_error_.clear();
+		this->state_ = ControllerState::Running;
+		this->next_tick_ = TimerGameTick::counter;
+		this->AppendControl("start");
+		this->WriteReport();
+	}
+
+	void Stop()
+	{
+		Require(this->state_ == ControllerState::Running || this->state_ == ControllerState::Paused,
+			"stop requires running or paused state");
+		this->state_ = ControllerState::Stopped;
+		this->AppendControl("stop");
+		this->WriteReport();
+	}
+
+	void TogglePause()
+	{
+		Require(this->state_ == ControllerState::Running || this->state_ == ControllerState::Paused,
+			"pause toggle requires running or paused state");
+		this->state_ = this->state_ == ControllerState::Running ? ControllerState::Paused : ControllerState::Running;
+		if (this->state_ == ControllerState::Running) this->next_tick_ = std::max<uint64_t>(this->next_tick_, TimerGameTick::counter);
+		this->AppendControl(this->state_ == ControllerState::Paused ? "pause" : "resume");
+		this->WriteReport();
+	}
+
+	void StepOnce()
+	{
+		Require(this->state_ == ControllerState::Paused, "step requires paused controller state");
+		Require(_pause_mode.None(), "step requires the native game to be running");
+		this->RunSafely(true);
+		if (this->state_ == ControllerState::Running) this->state_ = ControllerState::Paused;
+		if (this->state_ == ControllerState::Paused) this->AppendControl("step-complete");
+		this->WriteReport();
+	}
+
+	void Reload()
+	{
+		try {
+			auto candidate = std::make_unique<M23DeploymentPackage>(this->config_.reload_package_path);
+			Require(candidate->package_id() == MONOLITHIC_PACKAGE_ID || candidate->package_id() == SPECIALIST_PACKAGE_ID,
+				"reload package is not one of the two frozen learned architectures");
+			this->package_.swap(candidate);
+			this->ResetRecurrentAndExecutor();
+			this->last_error_.clear();
+			this->AppendControl("reload");
+			this->WriteReport();
+		} catch (const std::exception &e) {
+			this->last_error_ = e.what();
+			this->AppendControl("reload-rejected");
+			this->WriteReport();
+			throw;
+		}
+	}
+
+	[[nodiscard]] bool running() const { return this->state_ == ControllerState::Running; }
+	[[nodiscard]] bool paused() const { return this->state_ == ControllerState::Paused; }
+
+	std::vector<std::string> InspectionLines() const
+	{
+		std::vector<std::string> lines;
+		lines.push_back(fmt::format("State: {} | health: {} | game: {}", StateName(this->state_),
+			this->state_ == ControllerState::Faulted ? "FAULT" : "OK", _pause_mode.Any() ? "paused" : "running"));
+		lines.push_back(fmt::format("Architecture: {} | package {}...", this->package_->architecture_id(), this->package_->package_id().substr(0, 12)));
+		lines.push_back(fmt::format("Checkpoint: {}... | campaign: {}", this->package_->checkpoint_id().substr(0, 12), this->config_.campaign->id));
+		lines.push_back(fmt::format("Program: {} | confidence: {:.6f} | value: {:.6f} | legal: {}", GetRlV2ProgramName(this->last_program_), this->confidence_, this->value_, this->legal_programs_));
+		lines.push_back(fmt::format("Hidden norm: {:.6f} | boundaries: {} | tick: {}", this->hidden_norm_, this->boundary_ordinal_, TimerGameTick::counter));
+		lines.push_back(fmt::format("Executor: {} | last command: {}", this->executor_.Inspect().phase, this->executor_.Inspect().last_command));
+		lines.push_back(fmt::format("Last error: {}", this->last_error_.empty() ? "none" : this->last_error_));
+		return lines;
+	}
+
+private:
+	void ActivateWorld()
+	{
+		Require(Map::SizeX() == this->config_.campaign->map_width && Map::SizeY() == this->config_.campaign->map_height,
+			"generated normal-game map dimensions differ from campaign");
+		Require(_settings_game.game_creation.landscape == ParseClimate(this->config_.campaign->climate),
+			"generated normal-game climate differs from campaign");
+		this->StartOpponent();
+		this->world_active_ = true;
+		this->state_ = ControllerState::Stopped;
+		this->AppendControl("world-ready");
+		if (this->config_.open_window) ShowRlV2NeuralAgentWindow();
+		if (this->config_.start_running) {
+			this->Start();
+			if (this->config_.start_paused) this->TogglePause();
+		}
+	}
+
+	void StartOpponent()
+	{
+		const CompanyID slot{1};
+		AIConfig *config = AIConfig::GetConfig(slot, AIConfig::SSS_FORCE_GAME);
+		Require(config != nullptr && config->GetInfo() != nullptr,
+			"configured opponent package is unavailable after world generation");
+		Require(config->GetInfo()->GetName() == this->config_.campaign->opponent &&
+			config->GetInfo()->GetVersion() == OpponentVersion(this->config_.campaign->opponent),
+			"configured opponent package identity drifted");
+		if (!Company::IsValidID(slot)) {
+			Company *company = DoStartupNewCompany(true, slot);
+			Require(company != nullptr && company->is_ai && company->ai_instance != nullptr,
+				"normal-game opponent failed to start");
+		}
+	}
+
+	void ResetRecurrentAndExecutor()
+	{
+		std::fill(this->hidden_.begin(), this->hidden_.end(), 0.0F);
+		this->recurrent_reset_ = true;
+		this->hidden_norm_ = 0.0;
+		this->executor_.Reset();
+	}
+
+	std::vector<float> PublicFeatures() const
+	{
+		std::vector<float> result(32, 0.0F);
+		result[ModeIndex(this->config_.campaign->mode)] = 1.0F;
+		result[7 + ClimateIndex(_settings_game.game_creation.landscape)] = 1.0F;
+		result[11] = static_cast<float>(Map::SizeX()) / 4096.0F;
+		result[12] = static_cast<float>(Map::SizeY()) / 4096.0F;
+		result[13] = static_cast<float>(Map::Size()) / 1048576.0F;
+		if (this->target_program_ > 0 && this->executor_.CanExecute(this->target_program_)) result[13 + this->target_program_] = 1.0F;
+		result[30] = OpponentFeature(this->config_.campaign->opponent);
+		const auto [cargo, variant] = ProgramContext(this->target_program_);
+		const std::string context = std::string(cargo) + '\0' + std::string(variant);
+		const std::string digest = openttd_rl::v2::m23_sha256_bytes(context);
+		uint32_t prefix = 0;
+		for (size_t index = 0; index < 8; ++index) {
+			const char digit = digest[index];
+			Require((digit >= '0' && digit <= '9') || (digit >= 'a' && digit <= 'f'), "context digest is malformed");
+			prefix = prefix * 16U + static_cast<uint32_t>(digit <= '9' ? digit - '0' : digit - 'a' + 10);
+		}
+		result[31] = static_cast<float>(static_cast<double>(prefix) / static_cast<double>(UINT32_MAX));
+		Require(std::all_of(result.begin(), result.end(), [](float value) { return std::isfinite(value) && value >= 0.0F && value <= 1.0F; }),
+			"live public feature escaped finite unit range");
+		return result;
+	}
+
+	std::vector<uint8_t> ProgramMask()
+	{
+		std::vector<uint8_t> result(17, 0);
+		result[0] = 1;
+		if (this->executor_.CanExecute(this->target_program_)) result[this->target_program_] = 1;
+		this->legal_programs_ = static_cast<uint8_t>(std::count(result.begin(), result.end(), uint8_t{1}));
+		Require(this->legal_programs_ >= 1, "live program mask is all illegal");
+		return result;
+	}
+
+	void RunSafely(bool step)
+	{
+		try {
+			this->RunOne(step);
+		} catch (const std::exception &e) {
+			this->state_ = ControllerState::Faulted;
+			this->last_error_ = e.what();
+			this->last_program_ = 0;
+			const auto safe_wait = this->executor_.ExecuteBoundary(0, false);
+			(void)safe_wait;
+			this->AppendControl("runtime-fault");
+			this->WriteReport();
+			Debug(misc, 0, "M23 V2 neural agent entered wait-only fault state: {}", e.what());
+		}
+	}
+
+	void RunOne(bool step)
+	{
+		Require(this->boundary_ordinal_ < 4096, "controller boundary bound exhausted");
+		AutoRestoreBackup company(_current_company, CompanyID::Begin());
+		const auto features = this->PublicFeatures();
+		const auto mask = this->ProgramMask();
+		const auto output = this->package_->model().run(1, features, mask, this->hidden_, {static_cast<uint8_t>(this->recurrent_reset_)});
+		Require(output.program_logits.size() == 17 && output.program_value.size() == 1 &&
+			output.next_hidden.size() == 256 && output.greedy_program.size() == 1,
+			"live recurrent output shape drifted");
+		const auto selected = output.greedy_program[0];
+		Require(selected >= 0 && selected < 17 && mask[static_cast<size_t>(selected)] == 1,
+			"live policy selected an illegal program");
+
+		const float maximum = *std::max_element(output.program_logits.begin(), output.program_logits.end());
+		double denominator = 0.0;
+		for (size_t index = 0; index < output.program_logits.size(); ++index) {
+			if (mask[index]) denominator += std::exp(static_cast<double>(output.program_logits[index] - maximum));
+		}
+		Require(std::isfinite(denominator) && denominator > 0.0, "live policy confidence denominator is invalid");
+		this->confidence_ = std::exp(static_cast<double>(output.program_logits[static_cast<size_t>(selected)] - maximum)) / denominator;
+		this->value_ = output.program_value[0];
+		this->hidden_ = output.next_hidden;
+		this->hidden_norm_ = std::sqrt(std::inner_product(this->hidden_.begin(), this->hidden_.end(), this->hidden_.begin(), 0.0));
+		Require(std::isfinite(this->confidence_) && std::isfinite(this->value_) && std::isfinite(this->hidden_norm_),
+			"live inspection scalar is nonfinite");
+		this->recurrent_reset_ = false;
+		this->last_program_ = static_cast<uint8_t>(selected);
+		const RlV2ExecutorResult executor = this->executor_.ExecuteBoundary(this->last_program_, true);
+
+		this->latest_ = {
+			{"architecture", this->package_->architecture_id()},
+			{"boundary", this->boundary_ordinal_},
+			{"campaign", this->config_.campaign->id},
+			{"checkpoint_id", this->package_->checkpoint_id()},
+			{"confidence", this->confidence_},
+			{"event", step ? "step-boundary" : "policy-boundary"},
+			{"executor", {{"boundary_complete", executor.boundary_complete}, {"command_count", executor.command_count},
+				{"last_command", executor.last_command}, {"last_error", executor.last_error.empty() ? json(nullptr) : json(executor.last_error)}, {"phase", executor.phase}}},
+			{"health", "OK"},
+			{"hidden_norm", this->hidden_norm_},
+			{"legal_programs", this->legal_programs_},
+			{"package_id", this->package_->package_id()},
+			{"program", {{"index", this->last_program_}, {"name", GetRlV2ProgramName(this->last_program_)}}},
+			{"schema_version", M23_RECORD_SCHEMA},
+			{"state", StateName(this->state_)},
+			{"tick", TimerGameTick::counter},
+			{"value", this->value_},
+		};
+		this->AppendRecord(this->latest_);
+		++this->boundary_ordinal_;
+		this->next_tick_ = TimerGameTick::counter + this->config_.interval_ticks;
+		const bool complete = this->boundary_ordinal_ >= this->config_.maximum_boundaries;
+		if (complete) this->Complete();
+		this->WriteReport();
+		SetWindowDirty(WC_RL_NEURAL_AGENT, 0);
+		MarkWholeScreenDirty();
+	}
+
+	void Complete()
+	{
+		this->state_ = ControllerState::Complete;
+		Require(SaveOrLoad(this->config_.savegame_path.string(), SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK,
+			"normal-game campaign save failed");
+		this->AppendControl("complete");
+		if (this->config_.screenshot_on_complete) {
+			this->pending_exit_ = this->config_.exit_when_complete;
+			if (!this->pending_exit_) MakeScreenshot(SC_VIEWPORT, std::string(this->config_.campaign->id));
+		} else if (this->config_.exit_when_complete) {
+			_exit_game = true;
+		}
+	}
+
+	void AppendControl(std::string_view event)
+	{
+		json record = {
+			{"architecture", this->package_->architecture_id()},
+			{"boundary", this->boundary_ordinal_},
+			{"campaign", this->config_.campaign->id},
+			{"checkpoint_id", this->package_->checkpoint_id()},
+			{"event", event},
+			{"health", this->state_ == ControllerState::Faulted ? "FAULT" : "OK"},
+			{"last_error", this->last_error_.empty() ? json(nullptr) : json(this->last_error_)},
+			{"package_id", this->package_->package_id()},
+			{"schema_version", M23_RECORD_SCHEMA},
+			{"state", StateName(this->state_)},
+			{"tick", TimerGameTick::counter},
+		};
+		this->AppendRecord(record);
+	}
+
+	void AppendRecord(const json &record)
+	{
+		if (this->log_records_ >= this->config_.maximum_records) return;
+		this->log_ << record.dump() << '\n';
+		this->log_.flush();
+		Require(static_cast<bool>(this->log_), "bounded controller log write failed");
+		++this->log_records_;
+	}
+
+	void WriteReport()
+	{
+		const RlV2ExecutorResult &executor = this->executor_.Inspect();
+		json report = {
+			{"architecture", this->package_->architecture_id()},
+			{"boundary_count", this->boundary_ordinal_},
+			{"campaign", {{"climate", this->config_.campaign->climate}, {"id", this->config_.campaign->id},
+				{"map_height", this->config_.campaign->map_height}, {"map_width", this->config_.campaign->map_width},
+				{"mode", this->config_.campaign->mode}, {"opponent", this->config_.campaign->opponent},
+				{"program", this->config_.campaign->program}, {"seed", this->config_.campaign->seed}}},
+			{"checkpoint_id", this->package_->checkpoint_id()},
+			{"contract_sha256", M23_CONTRACT_SHA256},
+			{"controller", {{"confidence", this->confidence_}, {"health", this->state_ == ControllerState::Faulted ? "FAULT" : "OK"},
+				{"hidden_norm", this->hidden_norm_}, {"last_error", this->last_error_.empty() ? json(nullptr) : json(this->last_error_)},
+				{"legal_programs", this->legal_programs_}, {"program", GetRlV2ProgramName(this->last_program_)},
+				{"state", StateName(this->state_)}, {"value", this->value_}}},
+			{"executor", {{"command_count", executor.command_count}, {"last_command", executor.last_command},
+				{"last_error", executor.last_error.empty() ? json(nullptr) : json(executor.last_error)}, {"phase", executor.phase}}},
+			{"latest", this->latest_},
+			{"log_records", this->log_records_},
+			{"package_id", this->package_->package_id()},
+			{"schema_version", M23_REPORT_SCHEMA},
+		};
+		const std::filesystem::path temporary = this->config_.report_path.string() + ".tmp";
+		std::ofstream output(temporary, std::ios::binary | std::ios::trunc);
+		Require(static_cast<bool>(output), "cannot open temporary controller report");
+		output << report.dump() << '\n';
+		output.close();
+		Require(static_cast<bool>(output), "controller report write failed");
+		std::error_code error;
+		std::filesystem::rename(temporary, this->config_.report_path, error);
+		Require(!error, fmt::format("cannot publish controller report: {}", error.message()));
+	}
+
+	PlaybackConfig config_;
+	std::unique_ptr<M23DeploymentPackage> package_;
+	RlV2ProgramExecutor executor_;
+	std::vector<float> hidden_;
+	json latest_ = nullptr;
+	std::ofstream log_;
+	ControllerState state_ = ControllerState::Prepared;
+	uint64_t boundary_ordinal_ = 0;
+	uint64_t next_tick_ = 0;
+	uint64_t log_records_ = 0;
+	uint8_t target_program_ = 0;
+	uint8_t last_program_ = 0;
+	uint8_t legal_programs_ = 1;
+	bool recurrent_reset_ = true;
+	bool world_active_ = false;
+	bool pending_exit_ = false;
+	bool screenshot_requested_ = false;
+	double confidence_ = 1.0;
+	double value_ = 0.0;
+	double hidden_norm_ = 0.0;
+	std::string last_error_;
+};
+
+static std::unique_ptr<V2NeuralAgentController> controller;
+
+static void ConfigureNormalWorld(const CampaignSpec &campaign)
+{
+	Require(std::has_single_bit(campaign.map_width) && std::has_single_bit(campaign.map_height),
+		"campaign map dimensions are not powers of two");
+	_settings_newgame.game_creation.generation_seed = campaign.seed;
+	_settings_newgame.game_creation.map_x = static_cast<uint8_t>(std::countr_zero(campaign.map_width));
+	_settings_newgame.game_creation.map_y = static_cast<uint8_t>(std::countr_zero(campaign.map_height));
+	_settings_newgame.game_creation.landscape = ParseClimate(campaign.climate);
+	_settings_newgame.game_creation.starting_year = TimerGameCalendar::Year{1950};
+	_settings_newgame.economy.timekeeping_units = TKU_CALENDAR;
+	_settings_newgame.vehicle.never_expire_vehicles = true;
+	_settings_newgame.vehicle.plane_crashes = 0;
+	for (CompanyID id = CompanyID::Begin(); id < MAX_COMPANIES; ++id) _settings_newgame.script_config.ai[id].reset();
+	const CompanyID slot{1};
+	AIConfig *opponent = AIConfig::GetConfig(slot, AIConfig::SSS_FORCE_NEWGAME);
+	Require(opponent != nullptr, "cannot allocate normal-game opponent configuration");
+	opponent->Change(std::string(campaign.opponent), OpponentVersion(campaign.opponent), true);
+	Require(opponent->GetInfo() != nullptr && opponent->GetInfo()->GetName() == campaign.opponent &&
+		opponent->GetInfo()->GetVersion() == OpponentVersion(campaign.opponent),
+		"exact normal-game opponent package is unavailable");
+	_switch_mode = SM_NEWGAME;
+}
+
 } // namespace
 
