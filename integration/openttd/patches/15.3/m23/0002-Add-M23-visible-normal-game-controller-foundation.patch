+static void RequireInputFile(const std::filesystem::path &path, std::string_view name)
+{
+	Require(std::filesystem::is_regular_file(path) && !std::filesystem::is_symlink(path),
+		fmt::format("{} must be a regular nonsymlink file", name));
+}
+
+static void RequireNewOutput(const std::filesystem::path &path, std::string_view name)
+{
+	Require(!std::filesystem::exists(path) && !std::filesystem::is_symlink(path) &&
+		std::filesystem::is_directory(path.parent_path()) && !std::filesystem::is_symlink(path.parent_path()),
+		fmt::format("{} must be a new file below an existing nonsymlink directory", name));
+}
