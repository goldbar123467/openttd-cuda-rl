+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ */
+
+/** @file rl_v2_program_executor.h Reviewed normal-command executors for M23 programs. */
+
+#ifndef RL_V2_PROGRAM_EXECUTOR_H
+#define RL_V2_PROGRAM_EXECUTOR_H
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+struct RlV2ExecutorResult {
+	std::string phase;
+	std::string last_command;
+	std::string last_error;
+	uint64_t command_count = 0;
+	bool boundary_complete = false;
+};
+
+class RlV2ProgramExecutor {
+public:
+	void Reset();
+	[[nodiscard]] bool CanExecute(uint8_t program) const;
+	[[nodiscard]] RlV2ExecutorResult ExecuteBoundary(uint8_t program, bool commands_allowed);
+	[[nodiscard]] const RlV2ExecutorResult &Inspect() const { return this->state_; }
+
+private:
+	RlV2ExecutorResult state_{"IDLE", "none", "", 0, false};
+};
+
+[[nodiscard]] std::string_view GetRlV2ProgramName(uint8_t program);
+[[nodiscard]] uint8_t GetRlV2ProgramIndex(std::string_view program);
+
+#endif /* RL_V2_PROGRAM_EXECUTOR_H */
