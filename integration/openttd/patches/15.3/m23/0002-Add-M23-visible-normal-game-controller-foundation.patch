+bool PrepareRlV2NeuralAgentConfig(const std::string &config_path)
+{
+	Require(controller == nullptr, "configuration may be prepared only once per process");
+	const json config = json::parse(ReadCanonicalJson(std::filesystem::path(config_path)));
+	Require(config.is_object() && config.contains("operation") && config.at("operation").is_string(),
+		"configuration operation is missing or invalid");
+	if (config.at("operation") == "equivalence") {
+		const auto value = ParseEquivalenceConfig(config);
+		M23DeploymentPackage monolithic(value.monolithic_package_path);
+		M23DeploymentPackage specialist(value.specialist_package_path);
+		Require(monolithic.package_id() == MONOLITHIC_PACKAGE_ID,
+			"monolithic package is valid but is not the frozen development package");
+		Require(specialist.package_id() == SPECIALIST_PACKAGE_ID,
+			"specialist package is valid but is not the frozen development package");
+		const auto summary = openttd_rl::v2::run_m23_onnx_equivalence(
+			value.golden_path, monolithic.model(), specialist.model(), value.report_path,
+			"source-integrated-ingame-onnxruntime-1.28.0-cpu");
+		Require(summary.cases == 48 && summary.failures == 0, "source-integrated equivalence failed");
+		fmt::print(stdout, "M23_INGAME_EQUIVALENCE=PASS cases={} failures={} max_abs={}\n",
+			summary.cases, summary.failures, summary.maximum_absolute);
+		return true;
+	}
+
+	PlaybackConfig playback = ParsePlaybackConfig(config);
+	auto package = std::make_unique<M23DeploymentPackage>(playback.package_path);
+	ConfigureNormalWorld(*playback.campaign);
+	controller = std::make_unique<V2NeuralAgentController>(std::move(playback), std::move(package));
+	return false;
+}
