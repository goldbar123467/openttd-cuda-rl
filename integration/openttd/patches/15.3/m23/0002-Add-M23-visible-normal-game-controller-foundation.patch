@@ -0,0 +1,121 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ */
+
+/** @file rl_v2_program_executor.cpp Reviewed normal-command executors for M23 programs. */
+
+#include "stdafx.h"
+
+#include "rl_v2_program_executor.h"
+
+#include "company_base.h"
+#include "engine_base.h"
+#include "game/game.hpp"
+#include "industry.h"
+#include "station_base.h"
+#include "timer/timer_game_calendar.h"
+#include "town.h"
+#include "vehicle_base.h"
+
+#include <array>
+#include <stdexcept>
+
+#include "safeguards.h"
+
+namespace {
+
+static constexpr std::array<std::string_view, 17> PROGRAMS = {
+	"wait", "road-passenger", "road-cargo", "rail-passenger", "rail-freight",
+	"ship-natural", "ship-constructed", "air-service", "air-helicopter",
+	"multimodal-transfer", "mode-router", "competition-head-to-head",
+	"calendar-inspect", "authority-economy", "event-recovery",
+	"gamescript-response", "content-discovery",
+};
+
+static void Require(bool condition, std::string_view message)
+{
+	if (!condition) throw std::runtime_error(fmt::format("M23 program executor: {}", message));
+}
+
+} // namespace
+
+std::string_view GetRlV2ProgramName(uint8_t program)
+{
+	Require(program < PROGRAMS.size(), "program index is out of range");
+	return PROGRAMS[program];
+}
+
+uint8_t GetRlV2ProgramIndex(std::string_view program)
+{
+	for (uint8_t index = 0; index < PROGRAMS.size(); ++index) {
+		if (PROGRAMS[index] == program) return index;
+	}
+	throw std::runtime_error(fmt::format("M23 program executor: unknown program '{}'", program));
+}
+
+void RlV2ProgramExecutor::Reset()
+{
+	this->state_ = {"IDLE", "none", "", 0, false};
+}
+
+bool RlV2ProgramExecutor::CanExecute(uint8_t program) const
+{
+	if (program >= PROGRAMS.size()) return false;
+	if (program == 0) return true;
+	if (!Company::IsValidID(CompanyID::Begin()) || Town::GetNumItems() == 0) return false;
+	switch (program) {
+		case 1: case 2: return Engine::GetPoolSize() > 0;
+		case 3: case 4: return Engine::GetPoolSize() > 0;
+		case 5: case 6: return Engine::GetPoolSize() > 0;
+		case 7: case 8: return Engine::GetPoolSize() > 0;
+		case 9: case 10: return Engine::GetPoolSize() > 0;
+		case 11: return Company::GetNumItems() >= 1;
+		case 12: case 13: case 14: return true;
+		case 15: return Game::GetInfo() != nullptr;
+		case 16: return Engine::GetPoolSize() > 0;
+		default: return false;
+	}
+}
+
+RlV2ExecutorResult RlV2ProgramExecutor::ExecuteBoundary(uint8_t program, bool commands_allowed)
+{
+	Require(program < PROGRAMS.size(), "program index is out of range");
+	if (!commands_allowed || program == 0) {
+		this->state_.phase = commands_allowed ? "WAIT" : "SAFE_WAIT";
+		this->state_.last_command = "NO_OP";
+		this->state_.last_error.clear();
+		this->state_.boundary_complete = true;
+		return this->state_;
+	}
+	Require(this->CanExecute(program), "selected program is not executable in current public state");
+
+	/*
+	 * This dispatch is intentionally complete before mode-specific construction is
+	 * added.  Each case is a separately reviewed normal-command transaction; no
+	 * qualification runner or state-injection function is callable from here.
+	 */
+	switch (program) {
+		case 1: this->state_.phase = "ROAD_PASSENGER_DISCOVERY"; break;
+		case 2: this->state_.phase = "ROAD_CARGO_DISCOVERY"; break;
+		case 3: this->state_.phase = "RAIL_PASSENGER_DISCOVERY"; break;
+		case 4: this->state_.phase = "RAIL_FREIGHT_DISCOVERY"; break;
+		case 5: this->state_.phase = "SHIP_NATURAL_DISCOVERY"; break;
+		case 6: this->state_.phase = "SHIP_CONSTRUCTED_DISCOVERY"; break;
+		case 7: this->state_.phase = "AIR_SERVICE_DISCOVERY"; break;
+		case 8: this->state_.phase = "AIR_HELICOPTER_DISCOVERY"; break;
+		case 9: this->state_.phase = "MULTIMODAL_DISCOVERY"; break;
+		case 10: this->state_.phase = "MODE_ROUTER_DISCOVERY"; break;
+		case 11: this->state_.phase = "COMPETITION_INSPECT"; break;
+		case 12: this->state_.phase = "CALENDAR_INSPECT"; break;
+		case 13: this->state_.phase = "AUTHORITY_ECONOMY_INSPECT"; break;
+		case 14: this->state_.phase = "EVENT_RECOVERY_INSPECT"; break;
+		case 15: this->state_.phase = "GAMESCRIPT_INSPECT"; break;
+		case 16: this->state_.phase = "CONTENT_INSPECT"; break;
+		default: throw std::runtime_error("M23 program executor: unreachable program dispatch");
+	}
+	this->state_.last_command = "NO_OP_DISCOVERY";
+	this->state_.last_error.clear();
+	this->state_.boundary_complete = true;
+	return this->state_;
+}
