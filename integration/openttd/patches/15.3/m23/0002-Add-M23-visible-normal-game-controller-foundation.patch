+enum RlV2NeuralAgentWidgets : WidgetID {
+	WID_RLV2_CAPTION,
+	WID_RLV2_INSPECTION,
+	WID_RLV2_START,
+	WID_RLV2_STOP,
+	WID_RLV2_PAUSE,
+	WID_RLV2_STEP,
+	WID_RLV2_RELOAD,
+	WID_RLV2_GAME_PAUSE,
+};
+
+class RlV2NeuralAgentWindow : public Window {
+public:
+	RlV2NeuralAgentWindow(WindowDesc &desc, int window_number) : Window(desc)
+	{
+		this->InitNested(window_number);
+	}
+
+	void OnPaint() override
+	{
+		this->DrawWidgets();
+	}
+
+	std::string GetWidgetString(WidgetID widget, StringID stringid) const override
+	{
+		if (widget == WID_RLV2_CAPTION) return "OpenTTD-RL V2 Neural Company";
+		return this->Window::GetWidgetString(widget, stringid);
+	}
+
+	void DrawWidget(const Rect &rect, WidgetID widget) const override
+	{
+		const Rect inner = rect.Shrink(WidgetDimensions::scaled.frametext);
+		switch (widget) {
+			case WID_RLV2_INSPECTION: {
+				int y = inner.top;
+				for (const std::string &line : GetRlV2NeuralAgentInspectionLines()) {
+					DrawString(inner.left, inner.right, y, line, TC_BLACK, SA_LEFT | SA_FORCE);
+					y += GetCharacterHeight(FS_NORMAL);
+				}
+				break;
+			}
+			case WID_RLV2_START:
+				DrawString(inner, "Start", IsRlV2NeuralAgentRunning() || IsRlV2NeuralAgentPaused() ? TC_GREY : TC_BLACK, SA_CENTER);
+				break;
+			case WID_RLV2_STOP:
+				DrawString(inner, "Stop", IsRlV2NeuralAgentRunning() || IsRlV2NeuralAgentPaused() ? TC_BLACK : TC_GREY, SA_CENTER);
+				break;
+			case WID_RLV2_PAUSE:
+				DrawString(inner, IsRlV2NeuralAgentPaused() ? "Resume" : "Pause", IsRlV2NeuralAgentRunning() || IsRlV2NeuralAgentPaused() ? TC_BLACK : TC_GREY, SA_CENTER);
+				break;
+			case WID_RLV2_STEP:
+				DrawString(inner, "Step boundary", IsRlV2NeuralAgentPaused() && _pause_mode.None() ? TC_BLACK : TC_GREY, SA_CENTER);
+				break;
+			case WID_RLV2_RELOAD:
+				DrawString(inner, "Reload package", TC_BLACK, SA_CENTER);
+				break;
+			case WID_RLV2_GAME_PAUSE:
+				DrawString(inner, _pause_mode.Any() ? "Resume game" : "Pause game", TC_BLACK, SA_CENTER);
+				break;
+		}
+	}
+
+	void OnClick([[maybe_unused]] Point point, WidgetID widget, [[maybe_unused]] int click_count) override
+	{
+		try {
+			switch (widget) {
+				case WID_RLV2_START: StartRlV2NeuralAgentControl(); break;
+				case WID_RLV2_STOP: StopRlV2NeuralAgentControl(); break;
+				case WID_RLV2_PAUSE: ToggleRlV2NeuralAgentPause(); break;
+				case WID_RLV2_STEP: StepRlV2NeuralAgentOnce(); break;
+				case WID_RLV2_RELOAD: ReloadRlV2NeuralAgentPackage(); break;
+				case WID_RLV2_GAME_PAUSE: ToggleRlV2NeuralAgentGamePause(); break;
+			}
+		} catch (const std::exception &e) {
+			Debug(misc, 0, "M23 V2 operator control rejected: {}", e.what());
+		}
+		this->SetDirty();
+	}
+
+	void OnRealtimeTick([[maybe_unused]] uint delta_ms) override
+	{
+		this->SetDirty();
+	}
+};
