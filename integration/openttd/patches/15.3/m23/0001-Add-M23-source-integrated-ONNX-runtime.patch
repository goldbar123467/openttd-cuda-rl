diff --git a/src/rl_v2_neural_agent.cpp b/src/rl_v2_neural_agent.cpp
new file mode 100644
index 0000000..cdce18c
--- /dev/null
+++ b/src/rl_v2_neural_agent.cpp
@@ -0,0 +1,136 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file rl_v2_neural_agent.cpp M23 inference-only V2 source-integrated runtime. */
+
+#include "stdafx.h"
+
+#include "rl_v2_neural_agent.h"
+
+#include "3rdparty/nlohmann/json.hpp"
+
+#include "openttd_rl/v2/m23_equivalence.h"
+#include "openttd_rl/v2/m23_onnx.h"
+
+#include <filesystem>
+#include <fstream>
+#include <set>
+#include <stdexcept>
+#include <string_view>
+
+using nlohmann::json;
+using openttd_rl::v2::M23DeploymentPackage;
+
+namespace {
+
+static constexpr std::string_view M23_CONTRACT_SHA256 = "cfb0309998eff08d6cf8cf51d14e965236bf1de3f0980e06f5d9ee9adb613f20";
+static constexpr std::string_view M23_PLAYBACK_SCHEMA = "openttd-rl-v2-m23-playback-config-1";
+static constexpr std::string_view MONOLITHIC_PACKAGE_ID = "50060fd871d3c737b41bb4523748fbaac5047fed106e9ce0a9d1b36c7637f955";
+static constexpr std::string_view SPECIALIST_PACKAGE_ID = "d280683090b65eeea8e6cba1ab6ece3ca561a1b1d1708840f8616855ff44ac5a";
+
+static void Require(bool condition, std::string_view message)
+{
+	if (!condition) throw std::runtime_error(fmt::format("M23 V2 neural agent: {}", message));
+}
+
+static void RequireKeys(const json &value, std::initializer_list<std::string_view> expected, std::string_view name)
+{
+	Require(value.is_object(), fmt::format("{} must be an object", name));
+	std::set<std::string> observed;
+	for (const auto &[key, item] : value.items()) {
+		(void)item;
+		observed.insert(key);
+	}
+	std::set<std::string> required;
+	for (const auto key : expected) required.emplace(key);
+	Require(observed == required, fmt::format("{} field inventory drifted", name));
+}
+
+static std::string ReadCanonicalJson(const std::filesystem::path &path)
+{
+	Require(path.is_absolute(), "configuration path must be absolute");
+	Require(std::filesystem::is_regular_file(path) && !std::filesystem::is_symlink(path),
+		"configuration must be a regular nonsymlink file");
+	const auto size = std::filesystem::file_size(path);
+	Require(size > 1 && size <= 1024U * 1024U, "configuration size is outside bounds");
+	std::ifstream input(path, std::ios::binary);
+	Require(static_cast<bool>(input), "cannot open configuration");
+	std::string bytes(static_cast<std::size_t>(size), '\0');
+	input.read(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+	Require(static_cast<bool>(input) && input.peek() == std::ifstream::traits_type::eof(),
+		"cannot read exact configuration bytes");
+	Require(bytes.back() == '\n' && (bytes.size() < 2 || bytes[bytes.size() - 2] != '\r'),
+		"configuration must end in exactly one LF");
+	bytes.pop_back();
+	Require(!bytes.empty() && bytes.back() != '\n', "configuration has noncanonical trailing whitespace");
+	json parsed = json::parse(bytes);
+	Require(parsed.dump() == bytes, "configuration must be compact sorted JSON plus one LF");
+	return bytes;
+}
+
+static std::filesystem::path AbsolutePath(const json &value, std::string_view name)
+{
+	Require(value.is_string(), fmt::format("{} must be a string", name));
+	std::filesystem::path path(value.get<std::string>());
+	Require(path.is_absolute() && path.string().size() <= 4096U,
+		fmt::format("{} must be a bounded absolute path", name));
+	return path;
+}
+
+struct EquivalenceConfig {
+	std::filesystem::path golden_path;
+	std::filesystem::path monolithic_package_path;
+	std::filesystem::path specialist_package_path;
+	std::filesystem::path report_path;
+};
+
+static EquivalenceConfig ParseEquivalenceConfig(const std::filesystem::path &path)
+{
+	const json config = json::parse(ReadCanonicalJson(path));
+	RequireKeys(config, {"contract_sha256", "equivalence", "inference", "monolithic_package_path",
+		"operation", "schema_version", "specialist_package_path"}, "configuration");
+	Require(config.at("schema_version") == M23_PLAYBACK_SCHEMA, "configuration schema_version is incompatible");
+	Require(config.at("contract_sha256") == M23_CONTRACT_SHA256, "configuration contract_sha256 is incompatible");
+	Require(config.at("operation") == "equivalence", "configuration operation is unsupported at this boundary");
+	const json &inference = config.at("inference");
+	RequireKeys(inference, {"interval_ticks", "mode"}, "inference");
+	Require(inference.at("mode") == "greedy", "equivalence inference must use greedy mode");
+	Require(inference.at("interval_ticks") == 128, "equivalence interval must be the minimum frozen 128 ticks");
+	const json &equivalence = config.at("equivalence");
+	RequireKeys(equivalence, {"golden_path", "report_path"}, "equivalence");
+	EquivalenceConfig result{
+		AbsolutePath(equivalence.at("golden_path"), "equivalence.golden_path"),
+		AbsolutePath(config.at("monolithic_package_path"), "monolithic_package_path"),
+		AbsolutePath(config.at("specialist_package_path"), "specialist_package_path"),
+		AbsolutePath(equivalence.at("report_path"), "equivalence.report_path"),
+	};
+	Require(std::filesystem::is_regular_file(result.golden_path) && !std::filesystem::is_symlink(result.golden_path),
+		"equivalence golden is not a regular nonsymlink file");
+	Require(!std::filesystem::exists(result.report_path) && !std::filesystem::is_symlink(result.report_path) &&
+		std::filesystem::is_directory(result.report_path.parent_path()),
+		"equivalence report must be a new file below an existing directory");
+	return result;
+}
+
+} // namespace
+
+void RunRlV2NeuralAgentConfig(const std::string &config_path)
+{
+	const auto config = ParseEquivalenceConfig(std::filesystem::path(config_path));
+	M23DeploymentPackage monolithic(config.monolithic_package_path);
+	M23DeploymentPackage specialist(config.specialist_package_path);
+	Require(monolithic.package_id() == MONOLITHIC_PACKAGE_ID,
+		"monolithic package is valid but is not the frozen development package");
+	Require(specialist.package_id() == SPECIALIST_PACKAGE_ID,
+		"specialist package is valid but is not the frozen development package");
+	const auto summary = openttd_rl::v2::run_m23_onnx_equivalence(
+		config.golden_path, monolithic.model(), specialist.model(), config.report_path,
+		"source-integrated-ingame-onnxruntime-1.28.0-cpu");
+	Require(summary.cases == 48 && summary.failures == 0, "source-integrated equivalence failed");
+	fmt::print(stdout, "M23_INGAME_EQUIVALENCE=PASS cases={} failures={} max_abs={}\n",
+		summary.cases, summary.failures, summary.maximum_absolute);
+}
