diff --git a/CMakeLists.txt b/CMakeLists.txt
index cd23186..a6e4086 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -307,6 +307,30 @@ if(OPTION_RL_NEURAL_AGENT)
     set_property(TARGET openttd_test APPEND PROPERTY BUILD_RPATH "${OPENTTD_RL_ONNXRUNTIME_ROOT}/lib")
 endif()
 
+if(OPTION_RL_V2_NEURAL_AGENT)
+    if(NOT IS_ABSOLUTE "${OPENTTD_RL_PROJECT_ROOT}" OR NOT EXISTS "${OPENTTD_RL_PROJECT_ROOT}/training/v2/src/m23_equivalence.cpp")
+        message(FATAL_ERROR "OPENTTD_RL_PROJECT_ROOT must be the absolute OpenTTD-RL repository root with M23 sources")
+    endif()
+    if(NOT IS_ABSOLUTE "${OPENTTD_RL_ONNXRUNTIME_ROOT}" OR NOT EXISTS "${OPENTTD_RL_ONNXRUNTIME_ROOT}/include/onnxruntime_cxx_api.h")
+        message(FATAL_ERROR "OPENTTD_RL_ONNXRUNTIME_ROOT must be an absolute ONNX Runtime 1.28.0 installation")
+    endif()
+    find_library(OPENTTD_RL_V2_ONNXRUNTIME_LIBRARY onnxruntime PATHS "${OPENTTD_RL_ONNXRUNTIME_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
+    find_package(OpenSSL 3.0 REQUIRED COMPONENTS Crypto)
+    target_sources(openttd_lib PRIVATE
+        "${OPENTTD_RL_PROJECT_ROOT}/training/v2/src/m23_equivalence.cpp"
+        "${OPENTTD_RL_PROJECT_ROOT}/training/v2/src/m23_golden.cpp"
+        "${OPENTTD_RL_PROJECT_ROOT}/training/v2/src/m23_onnx.cpp"
+    )
+    target_include_directories(openttd_lib PRIVATE
+        "${OPENTTD_RL_PROJECT_ROOT}/training/v2/include"
+        "${OPENTTD_RL_ONNXRUNTIME_ROOT}/include"
+    )
+    target_link_libraries(openttd "${OPENTTD_RL_V2_ONNXRUNTIME_LIBRARY}" OpenSSL::Crypto)
+    target_link_libraries(openttd_test PRIVATE "${OPENTTD_RL_V2_ONNXRUNTIME_LIBRARY}" OpenSSL::Crypto)
+    set_property(TARGET openttd APPEND PROPERTY BUILD_RPATH "${OPENTTD_RL_ONNXRUNTIME_ROOT}/lib")
+    set_property(TARGET openttd_test APPEND PROPERTY BUILD_RPATH "${OPENTTD_RL_ONNXRUNTIME_ROOT}/lib")
+endif()
+
 include(Catch)
 catch_discover_tests(openttd_test)
 
