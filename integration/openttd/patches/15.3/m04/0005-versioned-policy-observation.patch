+/** @file rl_observation.h Authoritative fixed-shape M04 policy observation encoder. */
+
+#ifndef RL_OBSERVATION_H
+#define RL_OBSERVATION_H
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+static constexpr uint16_t RL_OBSERVATION_STRUCTURED_SIZE = 256;
+static constexpr uint16_t RL_OBSERVATION_SPATIAL_CHANNELS = 32;
+static constexpr uint16_t RL_OBSERVATION_MAP_WIDTH = 32;
+static constexpr uint16_t RL_OBSERVATION_MAP_HEIGHT = 32;
+static constexpr uint32_t RL_OBSERVATION_TILE_COUNT = RL_OBSERVATION_MAP_WIDTH * RL_OBSERVATION_MAP_HEIGHT;
+static constexpr uint32_t RL_OBSERVATION_SPATIAL_SIZE = RL_OBSERVATION_SPATIAL_CHANNELS * RL_OBSERVATION_TILE_COUNT;
+
+/** Raw source projection retained only for actual-engine semantic oracle comparisons. */
+struct RlObservationSourceProjection {
+	std::array<int64_t, RL_OBSERVATION_STRUCTURED_SIZE> structured{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> tile_type{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> height{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> clear_flat{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> road_bits{};
+	std::array<int16_t, RL_OBSERVATION_TILE_COUNT> road_owner{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> house_population{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> passenger_source{};
+	std::array<int32_t, RL_OBSERVATION_TILE_COUNT> town_id{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> town_center{};
+	std::array<int8_t, RL_OBSERVATION_TILE_COUNT> bus_stop_direction{};
+	std::array<int8_t, RL_OBSERVATION_TILE_COUNT> depot_direction{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> route_endpoint{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> vehicle_count{};
+	std::array<int16_t, RL_OBSERVATION_TILE_COUNT> tile_owner{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> station_catchment{};
+};
+
+/** Native tensor object used unchanged by bridge, trainer, evaluator, ONNX and in-game adapters. */
+struct RlObservation {
+	std::array<float, RL_OBSERVATION_STRUCTURED_SIZE> structured{};
+	std::array<float, RL_OBSERVATION_SPATIAL_SIZE> spatial{};
+	RlObservationSourceProjection source{};
+};
+
+RlObservation EncodeRlObservation(uint64_t transition_ordinal, uint64_t tick_zero);
+std::string SerializeRlObservation(const RlObservation &observation, bool include_source_projection);
+
+#endif /* RL_OBSERVATION_H */
