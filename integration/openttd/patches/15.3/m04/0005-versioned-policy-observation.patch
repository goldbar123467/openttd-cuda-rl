+/** @file rl_observation.cpp Authoritative fixed-shape M04 policy observation encoder. */
+
+#include "stdafx.h"
+
+#include "rl_observation.h"
+
+#include "3rdparty/nlohmann/json.hpp"
+#include "company_base.h"
+#include "depot_base.h"
+#include "house.h"
+#include "landscape.h"
+#include "map_func.h"
+#include "order_base.h"
+#include "road_map.h"
+#include "station_base.h"
+#include "station_map.h"
+#include "tile_cmd.h"
+#include "tile_map.h"
+#include "timer/timer_game_calendar.h"
+#include "timer/timer_game_tick.h"
+#include "town.h"
+#include "town_map.h"
+#include "vehicle_base.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <string_view>
+
+#include "safeguards.h"
+
+using nlohmann::json;
+
+namespace {
+
+static constexpr std::string_view OBSERVATION_SCHEMA_VERSION = "openttd-rl-v1-m04-observation-1";
+static constexpr std::string_view OBSERVATION_COMPATIBILITY_SHA256 = "7f8a46af1fe2a2c23e755c71b3bc2d04c9a0d057c573e901e5c9ed9178ca13eb";
+static constexpr uint8_t MAX_TOWNS = 2;
+static constexpr uint8_t MAX_VEHICLES = 8;
+static constexpr uint8_t MAX_STATIONS = 16;
+static constexpr uint8_t MAX_ROUTES = 8;
+static constexpr uint16_t TOWN_OFFSET = 28;
+static constexpr uint16_t TOWN_STRIDE = 10;
+static constexpr uint16_t VEHICLE_OFFSET = 48;
+static constexpr uint16_t VEHICLE_STRIDE = 10;
+static constexpr uint16_t STATION_OFFSET = 128;
+static constexpr uint16_t STATION_STRIDE = 5;
+static constexpr uint16_t ROUTE_OFFSET = 208;
+static constexpr uint16_t ROUTE_STRIDE = 6;
+
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559);
+static_assert(ROUTE_OFFSET + MAX_ROUTES * ROUTE_STRIDE == RL_OBSERVATION_STRUCTURED_SIZE);
+
+static float Unit(bool value)
+{
+	return value ? 1.0F : 0.0F;
+}
+
+static float UnsignedScale(uint64_t value, uint64_t denominator)
+{
+	return static_cast<float>(std::min(value, denominator)) / static_cast<float>(denominator);
+}
+
+static float SignedScale(int64_t value, int64_t denominator)
+{
+	value = std::clamp(value, -denominator, denominator);
+	return static_cast<float>(value) / static_cast<float>(denominator);
+}
+
+static size_t SpatialIndex(uint8_t channel, uint32_t x, uint32_t y)
+{
+	return static_cast<size_t>(channel) * RL_OBSERVATION_TILE_COUNT + y * RL_OBSERVATION_MAP_WIDTH + x;
+}
+
+static bool IsLearningBus(const Vehicle *vehicle, CompanyID company)
+{
+	return vehicle->type == VEH_ROAD && vehicle->owner == company && vehicle->IsPrimaryVehicle();
+}
+
+static std::array<StationID, 2> RouteEndpoints(const Vehicle *vehicle)
+{
+	std::array<StationID, 2> endpoints{StationID::Invalid(), StationID::Invalid()};
+	uint8_t endpoint = 0;
+	for (const Order &order : vehicle->Orders()) {
+		if (!order.IsType(OT_GOTO_STATION)) continue;
+		StationID station = order.GetDestination().ToStationID();
+		if (!Station::IsValidID(station)) continue;
+		if (endpoint != 0 && endpoints[endpoint - 1] == station) continue;
+		endpoints[endpoint++] = station;
+		if (endpoint == endpoints.size()) break;
+	}
+	return endpoints;
+}
+
+static uint32_t WaitingPassengers(const Station *station, CargoType passengers)
+{
+	const GoodsEntry &goods = station->goods[passengers];
+	return goods.HasData() ? goods.GetData().cargo.TotalCount() : 0;
+}
+
+static void SetStructured(RlObservation &result, size_t index, int64_t raw, float normalized)
+{
+	result.source.structured.at(index) = raw;
+	result.structured.at(index) = normalized;
+}
+
+static void EncodeStructured(RlObservation &result, uint64_t transition_ordinal, uint64_t tick_zero, CargoType passengers)
+{
+	if (Company::GetNumItems() != 1) throw std::runtime_error("M04 observation requires exactly one company");
+	const Company *company = Company::Get(CompanyID::Begin());
+	CompanyID company_id = company->index;
+	uint64_t tick = TimerGameTick::counter;
+	if (tick < tick_zero) throw std::runtime_error("M04 observation tick precedes episode tick zero");
+	uint64_t relative_ticks = tick - tick_zero;
+	uint64_t remaining_actions = transition_ordinal >= 512 ? 0 : 512 - transition_ordinal;
+	uint64_t remaining_ticks = relative_ticks >= 65536 ? 0 : 65536 - relative_ticks;
+
+	uint32_t bus_count = 0;
+	uint32_t route_count = 0;
+	bool vehicle_overflow = false;
+	bool route_overflow = false;
+	std::array<const Vehicle *, MAX_VEHICLES> vehicles{};
+	for (const Vehicle *vehicle : Vehicle::Iterate()) {
+		if (!IsLearningBus(vehicle, company_id)) continue;
+		++bus_count;
+		uint64_t id = vehicle->index.base();
+		if (id >= MAX_VEHICLES) {
+			vehicle_overflow = true;
+			continue;
+		}
+		vehicles[id] = vehicle;
+		auto endpoints = RouteEndpoints(vehicle);
+		if (endpoints[0] != StationID::Invalid() && endpoints[1] != StationID::Invalid()) ++route_count;
+	}
+	if (route_count > MAX_ROUTES) route_overflow = true;
+
+	uint32_t bus_station_count = 0;
+	bool station_overflow = false;
+	std::array<const Station *, MAX_STATIONS> stations{};
+	for (const Station *station : Station::Iterate()) {
+		if (station->owner != company_id || !station->facilities.Test(StationFacility::BusStop)) continue;
+		++bus_station_count;
+		uint64_t id = station->index.base();
+		if (id >= MAX_STATIONS) {
+			station_overflow = true;
+			continue;
+		}
+		stations[id] = station;
+	}
+
+	uint32_t owned_road_tiles = 0;
+	uint32_t static_buildable_tiles = 0;
+	for (TileIndex tile{}; tile < Map::Size(); ++tile) {
+		if (MayHaveRoad(tile) && HasTileRoadType(tile, RTT_ROAD) && GetRoadOwner(tile, RTT_ROAD) == company_id) ++owned_road_tiles;
+		if (IsTileType(tile, MP_CLEAR) && GetTileSlope(tile) == SLOPE_FLAT) ++static_buildable_tiles;
+	}
+
+	SetStructured(result, 0, company->money.base(), SignedScale(company->money.base(), 1048576));
+	SetStructured(result, 1, company->current_loan.base(), UnsignedScale(company->current_loan.base(), 524288));
+	SetStructured(result, 2, company->cur_economy.income.base(), SignedScale(company->cur_economy.income.base(), 1048576));
+	SetStructured(result, 3, company->cur_economy.expenses.base(), SignedScale(company->cur_economy.expenses.base(), 1048576));
+	Money company_value = CalculateCompanyValue(company);
+	SetStructured(result, 4, company_value.base(), SignedScale(company_value.base(), 1048576));
+	SetStructured(result, 5, company->cur_economy.delivered_cargo[passengers], UnsignedScale(company->cur_economy.delivered_cargo[passengers], 4096));
+	SetStructured(result, 6, bus_count, UnsignedScale(bus_count, MAX_VEHICLES));
+	SetStructured(result, 7, Depot::GetNumItems(), UnsignedScale(Depot::GetNumItems(), MAX_VEHICLES));
+	SetStructured(result, 8, bus_station_count, UnsignedScale(bus_station_count, MAX_STATIONS));
+	SetStructured(result, 9, route_count, UnsignedScale(route_count, MAX_ROUTES));
+	SetStructured(result, 10, owned_road_tiles, UnsignedScale(owned_road_tiles, 1024));
+	SetStructured(result, 11, company->infrastructure.station, UnsignedScale(company->infrastructure.station, MAX_STATIONS));
+	SetStructured(result, 12, TimerGameCalendar::year.base() - 1950, SignedScale(TimerGameCalendar::year.base() - 1950, 4));
+	SetStructured(result, 13, relative_ticks / Ticks::DAY_TICKS, UnsignedScale(relative_ticks / Ticks::DAY_TICKS, 1024));
+	SetStructured(result, 14, TimerGameCalendar::date_fract, UnsignedScale(TimerGameCalendar::date_fract, Ticks::DAY_TICKS));
+	SetStructured(result, 15, relative_ticks % 128, UnsignedScale(relative_ticks % 128, 128));
+	SetStructured(result, 16, transition_ordinal, UnsignedScale(transition_ordinal, 512));
+	SetStructured(result, 17, remaining_actions, UnsignedScale(remaining_actions, 512));
+	SetStructured(result, 18, relative_ticks, UnsignedScale(relative_ticks, 65536));
+	SetStructured(result, 19, remaining_ticks, UnsignedScale(remaining_ticks, 65536));
+	SetStructured(result, 20, Town::GetNumItems(), UnsignedScale(Town::GetNumItems(), MAX_TOWNS));
+	SetStructured(result, 21, company_id.base(), UnsignedScale(company_id.base(), 16));
+	bool has_owned_infrastructure = owned_road_tiles != 0 || company->infrastructure.station != 0 || Depot::GetNumItems() != 0;
+	SetStructured(result, 22, has_owned_infrastructure, Unit(has_owned_infrastructure));
+	SetStructured(result, 23, Town::GetNumItems() > MAX_TOWNS, Unit(Town::GetNumItems() > MAX_TOWNS));
+	SetStructured(result, 24, vehicle_overflow, Unit(vehicle_overflow));
+	SetStructured(result, 25, station_overflow, Unit(station_overflow));
+	SetStructured(result, 26, route_overflow, Unit(route_overflow));
+	SetStructured(result, 27, static_buildable_tiles, UnsignedScale(static_buildable_tiles, RL_OBSERVATION_TILE_COUNT));
+
+	for (const Town *town : Town::Iterate()) {
+		uint64_t id = town->index.base();
+		if (id >= MAX_TOWNS) continue;
+		size_t offset = TOWN_OFFSET + id * TOWN_STRIDE;
+		auto supplied = town->GetCargoSupplied(passengers);
+		uint32_t production = supplied == town->supplied.end() ? 0 : supplied->history[LAST_MONTH].production;
+		uint8_t transported = town->GetPercentTransported(passengers);
+		bool rating_present = town->have_ratings.Test(company_id);
+		int16_t rating = rating_present ? town->ratings[company_id] : 0;
+		SetStructured(result, offset + 0, 1, 1.0F);
+		SetStructured(result, offset + 1, id, UnsignedScale(id + 1, 65536));
+		SetStructured(result, offset + 2, TileX(town->xy), UnsignedScale(TileX(town->xy), 32));
+		SetStructured(result, offset + 3, TileY(town->xy), UnsignedScale(TileY(town->xy), 32));
+		SetStructured(result, offset + 4, town->cache.population, UnsignedScale(town->cache.population, 1024));
+		SetStructured(result, offset + 5, production, UnsignedScale(production, 4096));
+		SetStructured(result, offset + 6, transported, UnsignedScale(transported, 256));
+		SetStructured(result, offset + 7, rating_present, Unit(rating_present));
+		SetStructured(result, offset + 8, rating, SignedScale(rating, 1000));
+		SetStructured(result, offset + 9, transported != 0, Unit(transported != 0));
+	}
+
+	for (uint8_t slot = 0; slot < MAX_VEHICLES; ++slot) {
+		const Vehicle *vehicle = vehicles[slot];
+		if (vehicle == nullptr) continue;
+		size_t offset = VEHICLE_OFFSET + slot * VEHICLE_STRIDE;
+		bool valid_tile = vehicle->tile != INVALID_TILE && vehicle->tile < Map::Size();
+		SetStructured(result, offset + 0, 1, 1.0F);
+		SetStructured(result, offset + 1, vehicle->index.base(), UnsignedScale(vehicle->index.base() + 1, 1048576));
+		SetStructured(result, offset + 2, valid_tile ? TileX(vehicle->tile) : -1, valid_tile ? UnsignedScale(TileX(vehicle->tile), 32) : 0.0F);
+		SetStructured(result, offset + 3, valid_tile ? TileY(vehicle->tile) : -1, valid_tile ? UnsignedScale(TileY(vehicle->tile), 32) : 0.0F);
+		SetStructured(result, offset + 4, vehicle->age.base(), UnsignedScale(std::max<int64_t>(0, vehicle->age.base()), 2048));
+		SetStructured(result, offset + 5, vehicle->cargo_cap, UnsignedScale(vehicle->cargo_cap, 64));
+		SetStructured(result, offset + 6, vehicle->cargo.StoredCount(), vehicle->cargo_cap == 0 ? 0.0F : UnsignedScale(vehicle->cargo.StoredCount(), vehicle->cargo_cap));
+		SetStructured(result, offset + 7, vehicle->GetDisplayProfitThisYear().base(), SignedScale(vehicle->GetDisplayProfitThisYear().base(), 262144));
+		bool running = !vehicle->vehstatus.Test(VehState::Stopped) && !vehicle->vehstatus.Test(VehState::Crashed);
+		SetStructured(result, offset + 8, running, Unit(running));
+		SetStructured(result, offset + 9, vehicle->GetNumManualOrders(), UnsignedScale(vehicle->GetNumManualOrders(), 16));
+	}
+
+	for (uint8_t slot = 0; slot < MAX_STATIONS; ++slot) {
+		const Station *station = stations[slot];
+		if (station == nullptr) continue;
+		size_t offset = STATION_OFFSET + slot * STATION_STRIDE;
+		SetStructured(result, offset + 0, 1, 1.0F);
+		SetStructured(result, offset + 1, TileX(station->xy), UnsignedScale(TileX(station->xy), 32));
+		SetStructured(result, offset + 2, TileY(station->xy), UnsignedScale(TileY(station->xy), 32));
+		SetStructured(result, offset + 3, station->owner == company_id, Unit(station->owner == company_id));
+		uint32_t waiting = WaitingPassengers(station, passengers);
+		SetStructured(result, offset + 4, waiting, UnsignedScale(waiting, 4096));
+	}
+
+	for (uint8_t slot = 0; slot < MAX_ROUTES; ++slot) {
+		const Vehicle *vehicle = vehicles[slot];
+		if (vehicle == nullptr) continue;
+		auto endpoints = RouteEndpoints(vehicle);
+		if (endpoints[0] == StationID::Invalid() || endpoints[1] == StationID::Invalid()) continue;
+		size_t offset = ROUTE_OFFSET + slot * ROUTE_STRIDE;
+		bool active = !vehicle->vehstatus.Test(VehState::Stopped) && !vehicle->vehstatus.Test(VehState::Crashed);
+		SetStructured(result, offset + 0, 1, 1.0F);
+		SetStructured(result, offset + 1, endpoints[0].base(), UnsignedScale(endpoints[0].base() + 1, MAX_STATIONS));
+		SetStructured(result, offset + 2, endpoints[1].base(), UnsignedScale(endpoints[1].base() + 1, MAX_STATIONS));
+		SetStructured(result, offset + 3, active, Unit(active));
+		SetStructured(result, offset + 4, vehicle->cargo.StoredCount(), vehicle->cargo_cap == 0 ? 0.0F : UnsignedScale(vehicle->cargo.StoredCount(), vehicle->cargo_cap));
+		SetStructured(result, offset + 5, vehicle->GetDisplayProfitThisYear().base(), SignedScale(vehicle->GetDisplayProfitThisYear().base(), 262144));
+	}
+}
+
+static void EncodeSpatial(RlObservation &result, CompanyID company, CargoType passengers)
+{
+	result.source.road_owner.fill(-1);
+	result.source.town_id.fill(-1);
+	result.source.bus_stop_direction.fill(-1);
+	result.source.depot_direction.fill(-1);
+	result.source.tile_owner.fill(-1);
+
+	std::array<bool, RL_OBSERVATION_TILE_COUNT> route_endpoint{};
+	std::array<uint8_t, RL_OBSERVATION_TILE_COUNT> vehicle_count{};
+	for (const Vehicle *vehicle : Vehicle::Iterate()) {
+		if (!IsLearningBus(vehicle, company)) continue;
+		if (vehicle->tile != INVALID_TILE && vehicle->tile < Map::Size()) {
+			size_t tile = vehicle->tile.base();
+			vehicle_count[tile] = std::min<uint8_t>(8, vehicle_count[tile] + 1);
+		}
+		for (StationID endpoint : RouteEndpoints(vehicle)) {
+			if (endpoint == StationID::Invalid()) continue;
+			const Station *station = Station::Get(endpoint);
+			for (TileIndex tile{}; tile < Map::Size(); ++tile) {
+				if (IsStationRoadStopTile(tile) && GetStationIndex(tile) == station->index) route_endpoint[tile.base()] = true;
+			}
+		}
+	}
+
+	for (TileIndex tile{}; tile < Map::Size(); ++tile) {
+		uint32_t x = TileX(tile);
+		uint32_t y = TileY(tile);
+		if (x >= RL_OBSERVATION_MAP_WIDTH || y >= RL_OBSERVATION_MAP_HEIGHT) throw std::runtime_error("M04 observation map exceeds 32 by 32");
+		size_t raw = tile.base();
+		TileType type = GetTileType(tile);
+		bool valid = type != MP_VOID;
+		bool clear_flat = IsTileType(tile, MP_CLEAR) && GetTileSlope(tile) == SLOPE_FLAT;
+		bool has_road = MayHaveRoad(tile) && HasTileRoadType(tile, RTT_ROAD);
+		RoadBits road_bits = has_road ? GetAnyRoadBits(tile, RTT_ROAD) : ROAD_NONE;
+		int16_t road_owner = has_road ? GetRoadOwner(tile, RTT_ROAD).base() : -1;
+		bool road_owned = road_owner == company.base();
+		bool building = IsTileType(tile, MP_HOUSE);
+		uint8_t population = building && IsHouseCompleted(tile) ? HouseSpec::Get(GetHouseType(tile))->population : 0;
+		bool passenger_source = false;
+		if (building && IsHouseCompleted(tile)) {
+			CargoArray produced{};
+			AddProducedCargo(tile, produced);
+			passenger_source = produced[passengers] != 0;
+		}
+		int32_t town_id = -1;
+		if (building) {
+			town_id = GetTownIndex(tile).base();
+		} else if (IsNormalRoadTile(tile)) {
+			TownID candidate = GetTownIndex(tile);
+			if (Town::IsValidID(candidate)) town_id = candidate.base();
+		} else if (IsStationRoadStopTile(tile)) {
+			const Station *station = Station::Get(GetStationIndex(tile));
+			if (station->town != nullptr) town_id = station->town->index.base();
+		}
+		bool town_center = false;
+		for (const Town *town : Town::Iterate()) {
+			if (town->xy == tile) {
+				town_center = true;
+				break;
+			}
+		}
+		int8_t stop_direction = -1;
+		if (IsStationRoadStopTile(tile) && IsBusStop(tile) && IsBayRoadStopTile(tile)) stop_direction = GetBayRoadStopDir(tile);
+		int8_t depot_direction = IsRoadDepotTile(tile) ? GetRoadDepotDirection(tile) : -1;
+		/* Houses encode their town attribution above; OpenTTD deliberately has no
+		 * generic tile-owner accessor for MP_HOUSE. */
+		int16_t tile_owner = valid && !building ? GetTileOwner(tile).base() : -1;
+		bool catchment = false;
+		for (const Station *station : Station::Iterate()) {
+			if (station->owner == company && station->facilities.Test(StationFacility::BusStop) && station->TileIsInCatchment(tile)) {
+				catchment = true;
+				break;
+			}
+		}
+		bool company_station = IsStationRoadStopTile(tile) && GetTileOwner(tile) == company;
+		bool company_depot = IsRoadDepotTile(tile) && GetTileOwner(tile) == company;
+		bool owned_infrastructure = road_owned || company_station || company_depot;
+
+		result.source.tile_type[raw] = type;
+		result.source.height[raw] = TileHeight(tile);
+		result.source.clear_flat[raw] = clear_flat;
+		result.source.road_bits[raw] = road_bits;
+		result.source.road_owner[raw] = road_owner;
+		result.source.house_population[raw] = population;
+		result.source.passenger_source[raw] = passenger_source;
+		result.source.town_id[raw] = town_id;
+		result.source.town_center[raw] = town_center;
+		result.source.bus_stop_direction[raw] = stop_direction;
+		result.source.depot_direction[raw] = depot_direction;
+		result.source.route_endpoint[raw] = route_endpoint[raw];
+		result.source.vehicle_count[raw] = vehicle_count[raw];
+		result.source.tile_owner[raw] = tile_owner;
+		result.source.station_catchment[raw] = catchment;
+
+		auto set = [&result, x, y](uint8_t channel, float value) { result.spatial[SpatialIndex(channel, x, y)] = value; };
+		set(0, Unit(valid));
+		set(1, Unit(!valid));
+		set(2, UnsignedScale(TileHeight(tile), 256));
+		set(3, Unit(IsTileType(tile, MP_CLEAR)));
+		set(4, Unit(has_road));
+		set(5, Unit(road_owned));
+		set(6, Unit((road_bits & ROAD_NE) != ROAD_NONE));
+		set(7, Unit((road_bits & ROAD_SE) != ROAD_NONE));
+		set(8, Unit((road_bits & ROAD_SW) != ROAD_NONE));
+		set(9, Unit((road_bits & ROAD_NW) != ROAD_NONE));
+		set(10, Unit(building));
+		set(11, Unit(town_id == 0));
+		set(12, Unit(town_id == 1));
+		set(13, Unit(town_center));
+		set(14, UnsignedScale(population, 256));
+		set(15, Unit(passenger_source));
+		set(16, Unit(stop_direction >= 0));
+		set(17, Unit(stop_direction == DIAGDIR_NE));
+		set(18, Unit(stop_direction == DIAGDIR_SE));
+		set(19, Unit(stop_direction == DIAGDIR_SW));
+		set(20, Unit(stop_direction == DIAGDIR_NW));
+		set(21, Unit(depot_direction >= 0));
+		set(22, Unit(depot_direction == DIAGDIR_NE));
+		set(23, Unit(depot_direction == DIAGDIR_SE));
+		set(24, Unit(depot_direction == DIAGDIR_SW));
+		set(25, Unit(depot_direction == DIAGDIR_NW));
+		set(26, Unit(route_endpoint[raw]));
+		set(27, UnsignedScale(vehicle_count[raw], 8));
+		set(28, Unit(clear_flat));
+		set(29, Unit(valid && !clear_flat));
+		set(30, Unit(owned_infrastructure));
+		set(31, Unit(catchment));
+	}
+}
+
+template <typename T, size_t N>
+static json ArrayJson(const std::array<T, N> &value)
+{
+	json output = json::array();
+	for (const T &item : value) output.push_back(item);
+	return output;
+}
+
+} // namespace
+
+RlObservation EncodeRlObservation(uint64_t transition_ordinal, uint64_t tick_zero)
+{
+	if (Map::SizeX() != RL_OBSERVATION_MAP_WIDTH || Map::SizeY() != RL_OBSERVATION_MAP_HEIGHT) {
+		throw std::runtime_error("M04 observation requires the frozen 32 by 32 map");
+	}
+	CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+	if (!IsValidCargoType(passengers)) throw std::runtime_error("M04 observation passenger cargo is unavailable");
+	RlObservation result;
+	EncodeStructured(result, transition_ordinal, tick_zero, passengers);
+	EncodeSpatial(result, CompanyID::Begin(), passengers);
+	for (float value : result.structured) {
+		if (!std::isfinite(value) || value < -1.0F || value > 1.0F) throw std::runtime_error("M04 structured tensor contains an invalid value");
+	}
+	for (float value : result.spatial) {
+		if (!std::isfinite(value) || value < 0.0F || value > 1.0F) throw std::runtime_error("M04 spatial tensor contains an invalid value");
+	}
+	return result;
+}
+
+std::string SerializeRlObservation(const RlObservation &observation, bool include_source_projection)
+{
+	json output = {
+		{"compatibility_sha256", OBSERVATION_COMPATIBILITY_SHA256},
+		{"schema_version", OBSERVATION_SCHEMA_VERSION},
+		{"spatial", {
+			{"data", ArrayJson(observation.spatial)},
+			{"dtype", "float32"},
+			{"logical_order", "channel-y-x"},
+			{"shape", {RL_OBSERVATION_SPATIAL_CHANNELS, RL_OBSERVATION_MAP_HEIGHT, RL_OBSERVATION_MAP_WIDTH}},
+		}},
+		{"structured", {
+			{"data", ArrayJson(observation.structured)},
+			{"dtype", "float32"},
+			{"logical_order", "feature"},
+			{"shape", {RL_OBSERVATION_STRUCTURED_SIZE}},
+		}},
+	};
+	if (include_source_projection) {
+		output["source_projection"] = {
+			{"bus_stop_direction", ArrayJson(observation.source.bus_stop_direction)},
+			{"clear_flat", ArrayJson(observation.source.clear_flat)},
+			{"depot_direction", ArrayJson(observation.source.depot_direction)},
+			{"height", ArrayJson(observation.source.height)},
+			{"house_population", ArrayJson(observation.source.house_population)},
+			{"passenger_source", ArrayJson(observation.source.passenger_source)},
+			{"road_bits", ArrayJson(observation.source.road_bits)},
+			{"road_owner", ArrayJson(observation.source.road_owner)},
+			{"route_endpoint", ArrayJson(observation.source.route_endpoint)},
+			{"station_catchment", ArrayJson(observation.source.station_catchment)},
+			{"structured", ArrayJson(observation.source.structured)},
+			{"tile_owner", ArrayJson(observation.source.tile_owner)},
+			{"tile_type", ArrayJson(observation.source.tile_type)},
+			{"town_center", ArrayJson(observation.source.town_center)},
+			{"town_id", ArrayJson(observation.source.town_id)},
+			{"vehicle_count", ArrayJson(observation.source.vehicle_count)},
+		};
+	}
+	return output.dump();
+}
