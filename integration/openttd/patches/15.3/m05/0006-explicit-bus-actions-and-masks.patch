+
+RlActionMask BuildRlActionMask(const RlActionSelection &selection)
+{
+	RlActionMask mask;
+	for (uint16_t index = 0; index < RL_ACTION_COUNT; ++index) mask.legal[index] = NativeLegal(Decode(index), selection) ? 1 : 0;
+	return mask;
+}
+
+std::string SerializeRlActionMask(const RlActionMask &mask, const RlActionSelection &selection, bool include_source_projection)
+{
+	json legal = json::array();
+	uint16_t legal_count = 0;
+	for (uint8_t value : mask.legal) {
+		legal.push_back(value);
+		legal_count += value;
+	}
+	json result = {
+		{"action_count", RL_ACTION_COUNT},
+		{"compatibility_sha256", ACTION_COMPATIBILITY_SHA256},
+		{"dtype", "uint8"},
+		{"legal", std::move(legal)},
+		{"legal_count", legal_count},
+		{"schema_version", "openttd-rl-v1-m05-action-mask-1"},
+	};
+	if (include_source_projection) result["source_projection"] = SourceProjection(selection);
+	return result.dump();
+}
+
+std::string RlActionMaskToken(const RlActionMask &mask, std::string_view boundary_token)
+{
+	uint64_t hash = 1469598103934665603ULL;
+	for (uint8_t value : boundary_token) hash = (hash ^ value) * 1099511628211ULL;
+	for (uint8_t value : mask.legal) hash = (hash ^ value) * 1099511628211ULL;
+	return fmt::format("m05m1:{:016x}", hash);
+}
+
+std::string ExecuteRlAction(uint16_t action_index, RlActionSelection &selection, std::string_view injected_failure)
+{
+	const DecodedAction action = Decode(action_index);
+	const RlEnvironmentActionPlan plan = GetRlEnvironmentActionPlan();
+	Company *company = Company::Get(CompanyID::Begin());
+	json commands = json::array();
+	std::string_view outcome = "SUCCESS";
+	bool rolled_back = false;
+	Money balance_before = company->money;
+	uint64_t tick_before = TimerGameTick::counter;
+	if (!injected_failure.empty() && (injected_failure != "route-after-first-order" || action.family != ActionFamily::AssignRoute)) {
+		throw std::runtime_error(fmt::format("unsupported M05 injected failure hook '{}' for {}", injected_failure, FamilyName(action.family)));
+	}
+
+	auto execute_one = [&commands, &outcome](std::string_view name, auto &&call) {
+		CommandCost cost = call();
+		commands.push_back(CommandLog(name, "EXECUTE", cost));
+		if (cost.Failed()) outcome = "NATIVE_REJECTED";
+		return cost;
+	};
+
+	switch (action.family) {
+		case ActionFamily::Wait:
+			outcome = "NO_OP";
+			break;
+		case ActionFamily::SelectTowns:
+			selection.origin_town_slot = action.first;
+			selection.destination_town_slot = action.second;
+			break;
+		case ActionFamily::BuildRoadConnector:
+			execute_one("CMD_BUILD_LONG_ROAD", [&] { return Command<CMD_BUILD_LONG_ROAD>::Do(DoCommandFlag::Execute,
+				TileIndex{plan.connector_end_tile}, TileIndex{plan.connector_start_tile}, ROADTYPE_ROAD,
+				static_cast<Axis>(plan.connector_axis), DRD_NONE, false, true, true); });
+			break;
+		case ActionFamily::BuildBusStop:
+			execute_one("CMD_BUILD_ROAD_STOP", [&] { return Command<CMD_BUILD_ROAD_STOP>::Do(DoCommandFlag::Execute,
+				TileIndex{plan.stop_tiles[action.first]}, 1, 1, RoadStopType::Bus, false, static_cast<DiagDirection>(action.second),
+				ROADTYPE_ROAD, ROADSTOP_CLASS_DFLT, 0, NEW_STATION, false); });
+			break;
+		case ActionFamily::BuildRoadDepot:
+			execute_one("CMD_BUILD_ROAD_DEPOT", [&] { return Command<CMD_BUILD_ROAD_DEPOT>::Do(DoCommandFlag::Execute,
+				TileIndex{plan.depot_tile}, ROADTYPE_ROAD, static_cast<DiagDirection>(action.first)); });
+			break;
+		case ActionFamily::BuyBus: {
+			CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+			auto result = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, TileIndex{plan.depot_tile}, BUS_ENGINE, true, passengers, INVALID_CLIENT_ID);
+			CommandCost cost = std::get<0>(result);
+			commands.push_back(CommandLog("CMD_BUILD_VEHICLE", "EXECUTE", cost));
+			if (cost.Failed()) outcome = "NATIVE_REJECTED";
+			break;
+		}
+		case ActionFamily::AssignRoute: {
+			Vehicle *vehicle = Vehicle::Get(VehicleID{action.first});
+			StationID origin = StationForTownSlot(selection.origin_town_slot, plan);
+			StationID destination = StationForTownSlot(selection.destination_town_slot, plan);
+			std::vector<Order> prior;
+			for (const Order &order : vehicle->Orders()) prior.push_back(order);
+			CommandCost clear = Command<CMD_DELETE_ORDER>::Do(DoCommandFlag::Execute, vehicle->index, INVALID_VEH_ORDER_ID);
+			commands.push_back(CommandLog("CMD_DELETE_ORDER_ALL", "EXECUTE", clear));
+			if (clear.Failed()) {
+				outcome = "NATIVE_REJECTED";
+				break;
+			}
+			CommandCost first = Command<CMD_INSERT_ORDER>::Do(DoCommandFlag::Execute, vehicle->index, VehicleOrderID{0}, StationOrder(origin));
+			commands.push_back(CommandLog("CMD_INSERT_ORDER", "EXECUTE", first));
+			if (first.Failed() || injected_failure == "route-after-first-order") {
+				RollbackOrders(vehicle->index, prior, commands);
+				rolled_back = true;
+				outcome = "NATIVE_REJECTED";
+				break;
+			}
+			CommandCost second = Command<CMD_INSERT_ORDER>::Do(DoCommandFlag::Execute, vehicle->index, VehicleOrderID{1}, StationOrder(destination));
+			commands.push_back(CommandLog("CMD_INSERT_ORDER", "EXECUTE", second));
+			if (second.Failed()) {
+				RollbackOrders(vehicle->index, prior, commands);
+				rolled_back = true;
+				outcome = "NATIVE_REJECTED";
+			}
+			break;
+		}
+		case ActionFamily::SetRunning:
+		case ActionFamily::SetStopped:
+			execute_one("CMD_START_STOP_VEHICLE", [&] { return Command<CMD_START_STOP_VEHICLE>::Do(DoCommandFlag::Execute, VehicleID{action.first}, false); });
+			break;
+	}
+
+	return json({
+		{"action_index", action_index},
+		{"balance_after", company->money.base()},
+		{"balance_before", balance_before.base()},
+		{"family", FamilyName(action.family)},
+		{"native_commands", std::move(commands)},
+		{"parameters", Parameters(action_index)},
+		{"rolled_back", rolled_back},
+		{"schema_version", "openttd-rl-v1-m05-action-result-1"},
+		{"status", outcome},
+		{"tick_after_command", TimerGameTick::counter},
+		{"tick_before_command", tick_before},
+	}).dump();
+}
