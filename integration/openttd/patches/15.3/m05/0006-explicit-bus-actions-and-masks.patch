+RlEnvironmentActionPlan GetRlEnvironmentActionPlan()
+{
+	Require(bridge_spec != nullptr, "M05 action plan requested before bridge reset");
+	auto depot_front = bridge_spec->depot;
+	DiagDirection depot_direction = ParseCardinalDirection(bridge_spec->depot_entrance);
+	if (bridge_spec->depot_entrance == "north") --depot_front.y;
+	else if (bridge_spec->depot_entrance == "south") ++depot_front.y;
+	else if (bridge_spec->depot_entrance == "east") ++depot_front.x;
+	else --depot_front.x;
+	Axis connector_axis = depot_front.x == bridge_spec->depot.x ? AXIS_Y : AXIS_X;
+	return {
+		static_cast<uint16_t>(TileXY(depot_front.x, depot_front.y).base()),
+		static_cast<uint16_t>(TileXY(bridge_spec->depot.x, bridge_spec->depot.y).base()),
+		static_cast<uint8_t>(connector_axis),
+		{static_cast<uint16_t>(TileXY(bridge_spec->stops[0].point.x, bridge_spec->stops[0].point.y).base()),
+			static_cast<uint16_t>(TileXY(bridge_spec->stops[1].point.x, bridge_spec->stops[1].point.y).base())},
+		{static_cast<uint8_t>(StopRouteEntranceDirection(*bridge_spec, 0)),
+			static_cast<uint8_t>(StopRouteEntranceDirection(*bridge_spec, 1))},
+		static_cast<uint16_t>(TileXY(bridge_spec->depot.x, bridge_spec->depot.y).base()),
+		static_cast<uint8_t>(depot_direction),
+	};
