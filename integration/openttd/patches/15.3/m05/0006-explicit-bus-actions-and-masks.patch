+static constexpr std::string_view ACTION_COMPATIBILITY_SHA256 = "215c7d3ebeea97f1629debee4a2d10301838ccfd3085e4828685591677b58536";
+static constexpr EngineID BUS_ENGINE{116};
+static constexpr uint8_t MAX_VEHICLE_SLOTS = 8;
+static constexpr uint16_t WAIT_INDEX = 0;
+static constexpr uint16_t SELECT_OFFSET = 1;
+static constexpr uint16_t CONNECTOR_INDEX = 3;
+static constexpr uint16_t STOP_OFFSET = 4;
+static constexpr uint16_t DEPOT_OFFSET = 12;
+static constexpr uint16_t BUY_INDEX = 16;
+static constexpr uint16_t ROUTE_OFFSET = 17;
+static constexpr uint16_t RUN_OFFSET = 25;
+static constexpr uint16_t STOP_VEHICLE_OFFSET = 33;
+
+enum class ActionFamily : uint8_t {
+	Wait,
+	SelectTowns,
+	BuildRoadConnector,
+	BuildBusStop,
+	BuildRoadDepot,
+	BuyBus,
+	AssignRoute,
+	SetRunning,
+	SetStopped,
+};
+
+struct DecodedAction {
+	ActionFamily family;
+	uint8_t first = 0;
+	uint8_t second = 0;
+};
+
+static DecodedAction Decode(uint16_t index)
+{
+	if (index == WAIT_INDEX) return {ActionFamily::Wait};
+	if (index >= SELECT_OFFSET && index < CONNECTOR_INDEX) {
+		uint8_t origin = static_cast<uint8_t>(index - SELECT_OFFSET);
+		return {ActionFamily::SelectTowns, origin, static_cast<uint8_t>(1 - origin)};
+	}
+	if (index == CONNECTOR_INDEX) return {ActionFamily::BuildRoadConnector};
+	if (index >= STOP_OFFSET && index < DEPOT_OFFSET) {
+		uint8_t value = static_cast<uint8_t>(index - STOP_OFFSET);
+		return {ActionFamily::BuildBusStop, static_cast<uint8_t>(value / 4), static_cast<uint8_t>(value % 4)};
+	}
+	if (index >= DEPOT_OFFSET && index < BUY_INDEX) return {ActionFamily::BuildRoadDepot, static_cast<uint8_t>(index - DEPOT_OFFSET)};
+	if (index == BUY_INDEX) return {ActionFamily::BuyBus};
+	if (index >= ROUTE_OFFSET && index < RUN_OFFSET) return {ActionFamily::AssignRoute, static_cast<uint8_t>(index - ROUTE_OFFSET)};
+	if (index >= RUN_OFFSET && index < STOP_VEHICLE_OFFSET) return {ActionFamily::SetRunning, static_cast<uint8_t>(index - RUN_OFFSET)};
+	if (index >= STOP_VEHICLE_OFFSET && index < RL_ACTION_COUNT) return {ActionFamily::SetStopped, static_cast<uint8_t>(index - STOP_VEHICLE_OFFSET)};
+	throw std::runtime_error(fmt::format("M05 action index {} is outside the fixed catalog", index));
+}
+
+static std::string_view FamilyName(ActionFamily family)
+{
+	switch (family) {
+		case ActionFamily::Wait: return "WAIT";
+		case ActionFamily::SelectTowns: return "SELECT_TOWNS";
+		case ActionFamily::BuildRoadConnector: return "BUILD_ROAD_CONNECTOR";
+		case ActionFamily::BuildBusStop: return "BUILD_BUS_STOP";
+		case ActionFamily::BuildRoadDepot: return "BUILD_ROAD_DEPOT";
+		case ActionFamily::BuyBus: return "BUY_BUS";
+		case ActionFamily::AssignRoute: return "ASSIGN_ROUTE";
+		case ActionFamily::SetRunning: return "SET_RUNNING";
+		case ActionFamily::SetStopped: return "SET_STOPPED";
+	}
+	return "UNKNOWN";
+}
+
+static const Vehicle *GetBus(uint8_t slot)
+{
+	const Vehicle *vehicle = Vehicle::GetIfValid(VehicleID{slot});
+	if (vehicle == nullptr || vehicle->type != VEH_ROAD || vehicle->owner != CompanyID::Begin() || !vehicle->IsPrimaryVehicle()) return nullptr;
+	return vehicle;
+}
+
+static StationID StationForTownSlot(uint8_t slot, const RlEnvironmentActionPlan &plan)
+{
+	if (slot >= plan.stop_tiles.size()) return StationID::Invalid();
+	TileIndex tile{plan.stop_tiles[slot]};
+	if (!IsStationRoadStopTile(tile) || !IsBusStop(tile) || GetTileOwner(tile) != CompanyID::Begin()) return StationID::Invalid();
+	return GetStationIndex(tile);
+}
+
+static bool ConnectorBuilt(const RlEnvironmentActionPlan &plan)
+{
+	TileIndex start{plan.connector_start_tile};
+	TileIndex end{plan.connector_end_tile};
+	if (IsRoadDepotTile(end)) return true;
+	if (!IsNormalRoadTile(start) || !IsNormalRoadTile(end) || !HasTileRoadType(start, RTT_ROAD) || !HasTileRoadType(end, RTT_ROAD)) return false;
+	Axis axis = static_cast<Axis>(plan.connector_axis);
+	return (GetRoadBits(start, RTT_ROAD) & AxisToRoadBits(axis)) != ROAD_NONE &&
+		(GetRoadBits(end, RTT_ROAD) & AxisToRoadBits(axis)) != ROAD_NONE;
+}
+
+static bool RouteMatches(const Vehicle *vehicle, StationID origin, StationID destination)
+{
+	std::array<StationID, 2> observed{StationID::Invalid(), StationID::Invalid()};
+	uint8_t count = 0;
+	for (const Order &order : vehicle->Orders()) {
+		if (!order.IsType(OT_GOTO_STATION)) continue;
+		if (count < observed.size()) observed[count] = order.GetDestination().ToStationID();
+		++count;
+	}
+	return count == 2 && observed[0] == origin && observed[1] == destination;
+}
+
+static Order StationOrder(StationID station)
+{
+	Order order;
+	order.MakeGoToStation(station);
+	order.SetStopLocation(OrderStopLocation::FarEnd);
+	return order;
+}
+
+static bool NativeLegal(const DecodedAction &action, const RlActionSelection &selection)
+{
+	const RlEnvironmentActionPlan plan = GetRlEnvironmentActionPlan();
+	CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+	switch (action.family) {
+		case ActionFamily::Wait:
+			return true;
+		case ActionFamily::SelectTowns:
+			return Town::IsValidID(TownID{action.first}) && Town::IsValidID(TownID{action.second}) && action.first != action.second &&
+				(selection.origin_town_slot != action.first || selection.destination_town_slot != action.second);
+		case ActionFamily::BuildRoadConnector: {
+			if (ConnectorBuilt(plan) || IsRoadDepotTile(TileIndex{plan.depot_tile})) return false;
+			CommandCost cost = Command<CMD_BUILD_LONG_ROAD>::Do({}, TileIndex{plan.connector_end_tile}, TileIndex{plan.connector_start_tile},
+				ROADTYPE_ROAD, static_cast<Axis>(plan.connector_axis), DRD_NONE, false, true, true);
+			return cost.Succeeded();
+		}
+		case ActionFamily::BuildBusStop: {
+			if (action.first >= plan.stop_tiles.size() || action.second != plan.stop_directions[action.first]) return false;
+			TileIndex tile{plan.stop_tiles[action.first]};
+			if (IsStationRoadStopTile(tile)) return false;
+			CommandCost cost = Command<CMD_BUILD_ROAD_STOP>::Do({}, tile, 1, 1, RoadStopType::Bus, false,
+				static_cast<DiagDirection>(action.second), ROADTYPE_ROAD, ROADSTOP_CLASS_DFLT, 0, NEW_STATION, false);
+			return cost.Succeeded();
+		}
+		case ActionFamily::BuildRoadDepot: {
+			if (action.first != plan.depot_direction || !ConnectorBuilt(plan) || IsRoadDepotTile(TileIndex{plan.depot_tile})) return false;
+			CommandCost cost = Command<CMD_BUILD_ROAD_DEPOT>::Do({}, TileIndex{plan.depot_tile}, ROADTYPE_ROAD, static_cast<DiagDirection>(action.first));
+			return cost.Succeeded();
+		}
+		case ActionFamily::BuyBus: {
+			if (!IsRoadDepotTile(TileIndex{plan.depot_tile}) || Vehicle::GetNumItems() >= MAX_VEHICLE_SLOTS || !IsValidCargoType(passengers)) return false;
+			auto [cost, vehicle_id, refit_capacity, refit_mail, capacities] = Command<CMD_BUILD_VEHICLE>::Do({}, TileIndex{plan.depot_tile}, BUS_ENGINE, true, passengers, INVALID_CLIENT_ID);
+			(void)vehicle_id; (void)refit_capacity; (void)refit_mail; (void)capacities;
+			return cost.Succeeded();
+		}
+		case ActionFamily::AssignRoute: {
+			const Vehicle *vehicle = GetBus(action.first);
+			if (vehicle == nullptr || selection.origin_town_slot >= 2 || selection.destination_town_slot >= 2 || selection.origin_town_slot == selection.destination_town_slot) return false;
+			StationID origin = StationForTownSlot(selection.origin_town_slot, plan);
+			StationID destination = StationForTownSlot(selection.destination_town_slot, plan);
+			if (!Station::IsValidID(origin) || !Station::IsValidID(destination) || origin == destination || RouteMatches(vehicle, origin, destination)) return false;
+			CommandCost first = Command<CMD_INSERT_ORDER>::Do({}, vehicle->index, VehicleOrderID{0}, StationOrder(origin));
+			CommandCost second = Command<CMD_INSERT_ORDER>::Do({}, vehicle->index, VehicleOrderID{0}, StationOrder(destination));
+			return first.Succeeded() && second.Succeeded();
+		}
+		case ActionFamily::SetRunning: {
+			const Vehicle *vehicle = GetBus(action.first);
+			if (vehicle == nullptr || !vehicle->vehstatus.Test(VehState::Stopped) || vehicle->GetNumManualOrders() != 2) return false;
+			return Command<CMD_START_STOP_VEHICLE>::Do({}, vehicle->index, false).Succeeded();
+		}
+		case ActionFamily::SetStopped: {
+			const Vehicle *vehicle = GetBus(action.first);
+			if (vehicle == nullptr || vehicle->vehstatus.Test(VehState::Stopped)) return false;
+			return Command<CMD_START_STOP_VEHICLE>::Do({}, vehicle->index, false).Succeeded();
+		}
+	}
+	return false;
+}
+
+static json Parameters(uint16_t index)
+{
+	const DecodedAction action = Decode(index);
+	const RlEnvironmentActionPlan plan = GetRlEnvironmentActionPlan();
+	switch (action.family) {
+		case ActionFamily::Wait: return json::object();
+		case ActionFamily::SelectTowns: return {{"destination_town_slot", action.second}, {"origin_town_slot", action.first}};
+		case ActionFamily::BuildRoadConnector: return {{"axis", plan.connector_axis}, {"end_tile", plan.connector_end_tile}, {"start_tile", plan.connector_start_tile}};
+		case ActionFamily::BuildBusStop: return {{"orientation", action.second}, {"site_town_slot", action.first}, {"tile", plan.stop_tiles[action.first]}};
+		case ActionFamily::BuildRoadDepot: return {{"orientation", action.first}, {"tile", plan.depot_tile}};
+		case ActionFamily::BuyBus: return {{"depot_tile", plan.depot_tile}, {"engine_id", BUS_ENGINE.base()}};
+		case ActionFamily::AssignRoute: return {{"vehicle_slot", action.first}};
+		case ActionFamily::SetRunning:
+		case ActionFamily::SetStopped: return {{"vehicle_slot", action.first}};
+	}
+	return json::object();
+}
+
+static json CommandLog(std::string_view command, std::string_view phase, const CommandCost &cost)
+{
+	return {
+		{"command", command},
+		{"cost", cost.Succeeded() ? cost.GetCost().base() : 0},
+		{"error_message_id", static_cast<uint64_t>(cost.GetErrorMessage())},
+		{"extra_error_message_id", static_cast<uint64_t>(cost.GetExtraErrorMessage())},
+		{"phase", phase},
+		{"status", cost.Succeeded() ? "SUCCESS" : "REJECTED"},
+	};
+}
+
+static void RequireRollback(const CommandCost &cost, std::string_view operation)
+{
+	if (cost.Failed()) throw std::runtime_error(fmt::format("M05 route rollback command {} failed error={} extra={}", operation, cost.GetErrorMessage(), cost.GetExtraErrorMessage()));
+}
+
+static void RollbackOrders(VehicleID vehicle_id, const std::vector<Order> &prior, json &commands)
+{
+	CommandCost clear = Command<CMD_DELETE_ORDER>::Do(DoCommandFlag::Execute, vehicle_id, INVALID_VEH_ORDER_ID);
+	commands.push_back(CommandLog("CMD_DELETE_ORDER_ALL", "ROLLBACK", clear));
+	RequireRollback(clear, "clear");
+	for (uint8_t index = 0; index < prior.size(); ++index) {
+		CommandCost restore = Command<CMD_INSERT_ORDER>::Do(DoCommandFlag::Execute, vehicle_id, VehicleOrderID{index}, prior[index]);
+		commands.push_back(CommandLog("CMD_INSERT_ORDER", "ROLLBACK", restore));
+		RequireRollback(restore, "restore");
+	}
+}
+
+static json SourceProjection(const RlActionSelection &selection)
+{
+	const RlEnvironmentActionPlan plan = GetRlEnvironmentActionPlan();
+	json stops = json::array();
+	for (uint8_t slot = 0; slot < plan.stop_tiles.size(); ++slot) {
+		TileIndex tile{plan.stop_tiles[slot]};
+		bool present = IsStationRoadStopTile(tile) && IsBusStop(tile);
+		stops.push_back({
+			{"actual_direction", present && IsBayRoadStopTile(tile) ? static_cast<int>(GetBayRoadStopDir(tile)) : -1},
+			{"expected_direction", plan.stop_directions[slot]},
+			{"owner", present ? static_cast<int>(GetTileOwner(tile).base()) : -1},
+			{"station_id", present ? static_cast<int>(GetStationIndex(tile).base()) : -1},
+			{"tile", tile.base()},
+			{"town_slot", slot},
+		});
+	}
+	json vehicles = json::array();
+	for (uint8_t slot = 0; slot < MAX_VEHICLE_SLOTS; ++slot) {
+		const Vehicle *vehicle = GetBus(slot);
+		json orders = json::array();
+		if (vehicle != nullptr) {
+			for (const Order &order : vehicle->Orders()) if (order.IsType(OT_GOTO_STATION)) orders.push_back(order.GetDestination().ToStationID().base());
+		}
+		vehicles.push_back({
+			{"orders", std::move(orders)},
+			{"present", vehicle != nullptr},
+			{"running", vehicle != nullptr && !vehicle->vehstatus.Test(VehState::Stopped)},
+			{"slot", slot},
+			{"tile", vehicle == nullptr ? -1 : static_cast<int>(vehicle->tile.base())},
+		});
+	}
+	const Company *company = Company::Get(CompanyID::Begin());
+	TileIndex depot_tile{plan.depot_tile};
+	TileIndex connector_start{plan.connector_start_tile};
+	TileIndex connector_end{plan.connector_end_tile};
+	return {
+		{"company", {{"balance", company->money.base()}, {"id", company->index.base()}}},
+		{"connector", {{"axis", plan.connector_axis}, {"built", ConnectorBuilt(plan)}, {"end_owner", IsRoadDepotTile(connector_end) ? static_cast<int>(GetTileOwner(connector_end).base()) : IsNormalRoadTile(connector_end) ? static_cast<int>(GetRoadOwner(connector_end, RTT_ROAD).base()) : -1}, {"end_tile", plan.connector_end_tile}, {"start_owner", IsNormalRoadTile(connector_start) ? static_cast<int>(GetRoadOwner(connector_start, RTT_ROAD).base()) : -1}, {"start_tile", plan.connector_start_tile}}},
+		{"depot", {{"actual_direction", IsRoadDepotTile(depot_tile) ? static_cast<int>(GetRoadDepotDirection(depot_tile)) : -1}, {"expected_direction", plan.depot_direction}, {"owner", IsRoadDepotTile(depot_tile) ? static_cast<int>(GetTileOwner(depot_tile).base()) : -1}, {"present", IsRoadDepotTile(depot_tile)}, {"tile", plan.depot_tile}}},
+		{"selection", {{"destination_town_slot", selection.destination_town_slot == RL_ACTION_UNSELECTED_TOWN ? -1 : selection.destination_town_slot}, {"origin_town_slot", selection.origin_town_slot == RL_ACTION_UNSELECTED_TOWN ? -1 : selection.origin_town_slot}}},
+		{"stops", std::move(stops)},
+		{"town_slots_present", {Town::IsValidID(TownID{0}), Town::IsValidID(TownID{1})}},
+		{"vehicles", std::move(vehicles)},
+	};
+}
