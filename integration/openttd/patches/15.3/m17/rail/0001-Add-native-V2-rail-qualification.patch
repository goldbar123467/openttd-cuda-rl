+static StationID BuildStation(TileIndex tile, Axis axis, uint8_t tracks, uint8_t length, StationID join, json &commands)
+{
+	CommandCost test = Command<CMD_BUILD_RAIL_STATION>::Do({}, tile, RAILTYPE_RAIL, axis, tracks, length,
+		StationClassID::STAT_CLASS_DFLT, 0, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_RAIL_STATION_TEST", test));
+	Require(test.Succeeded(), fmt::format("rail station test failed at {}", tile.base()));
+	CommandCost cost = Command<CMD_BUILD_RAIL_STATION>::Do(DoCommandFlag::Execute, tile, RAILTYPE_RAIL, axis, tracks, length,
+		StationClassID::STAT_CLASS_DFLT, 0, join, false);
+	commands.push_back(CostRecord("CMD_BUILD_RAIL_STATION", cost));
+	Require(cost.Succeeded() && IsRailStationTile(tile), "rail station execution failed");
+	return GetStationIndex(tile);
+}
+
+static void BuildTrack(TileIndex tile, Track track, json &commands)
+{
+	CommandCost test = Command<CMD_BUILD_SINGLE_RAIL>::Do({}, tile, RAILTYPE_RAIL, track, false);
+	commands.push_back(CostRecord("CMD_BUILD_RAIL_TEST", test));
+	Require(test.Succeeded(), fmt::format("rail test failed at {} track {}", tile.base(), to_underlying(track)));
+	CommandCost cost = Command<CMD_BUILD_SINGLE_RAIL>::Do(DoCommandFlag::Execute, tile, RAILTYPE_RAIL, track, false);
+	commands.push_back(CostRecord("CMD_BUILD_RAIL", cost));
+	bool materialized = (IsPlainRailTile(tile) && HasTrack(tile, track)) ||
+		(IsLevelCrossingTile(tile) && GetCrossingRailTrack(tile) == track);
+	Require(cost.Succeeded() && materialized, "rail execution failed");
+}
+
+static RailRoute BuildLine(uint y, StationID source_join, StationID destination_join, json &commands)
+{
+	StationID source = BuildStation(TileXY(8, y), AXIS_X, 1, 2, source_join, commands);
+	StationID destination = BuildStation(TileXY(54, y), AXIS_X, 1, 2, destination_join, commands);
+	for (uint x = 10; x <= 53; ++x) BuildTrack(TileXY(x, y), TRACK_X, commands);
+	BuildTrack(TileXY(7, y), TRACK_X, commands);
+	TileIndex depot = TileXY(6, y);
+	CommandCost depot_test = Command<CMD_BUILD_TRAIN_DEPOT>::Do({}, depot, RAILTYPE_RAIL, DIAGDIR_SW);
+	commands.push_back(CostRecord("CMD_BUILD_RAIL_DEPOT_TEST", depot_test));
+	Require(depot_test.Succeeded(), "rail depot test failed");
+	CommandCost depot_cost = Command<CMD_BUILD_TRAIN_DEPOT>::Do(DoCommandFlag::Execute, depot, RAILTYPE_RAIL, DIAGDIR_SW);
+	commands.push_back(CostRecord("CMD_BUILD_RAIL_DEPOT", depot_cost));
+	Require(depot_cost.Succeeded() && IsRailDepot(depot), "rail depot execution failed");
+	return {source, destination, depot, AXIS_X, TRACK_X};
+}
