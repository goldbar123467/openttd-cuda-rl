+static bool HasRoadConnection(Point from, Point to)
+{
+	DiagDirection direction = DirectionBetween(from, to);
+	TileIndex from_tile = TileXY(from.x, from.y);
+	TileIndex to_tile = TileXY(to.x, to.y);
+	if (!IsNormalRoadTile(from_tile) || !IsNormalRoadTile(to_tile)) return false;
+	if (!HasTileRoadType(from_tile, RTT_ROAD) || !HasTileRoadType(to_tile, RTT_ROAD)) return false;
+	return (GetRoadBits(from_tile, RTT_ROAD) & DiagDirToRoadBits(direction)) != ROAD_NONE &&
+		(GetRoadBits(to_tile, RTT_ROAD) & DiagDirToRoadBits(ReverseDiagDir(direction))) != ROAD_NONE;
+}
+
+static json ValidatePlannedConstruction(const TemplateSpec &spec)
+{
+	uint path_length = 0;
+	for (uint8_t segment = 1; segment < spec.waypoint_count; ++segment) {
+		Point current = spec.waypoints[segment - 1];
+		const Point end = spec.waypoints[segment];
+		while (current.x != end.x || current.y != end.y) {
+			Point next = current;
+			if (next.x < end.x) ++next.x;
+			else if (next.x > end.x) --next.x;
+			else if (next.y < end.y) ++next.y;
+			else --next.y;
+			Require(HasRoadConnection(current, next), fmt::format("planned route is disconnected between ({}, {}) and ({}, {})", current.x, current.y, next.x, next.y));
+			++path_length;
+			current = next;
+		}
+	}
+	Require(path_length >= 8 && path_length <= 48, "native route length is outside 8..48");
+
+	json planned_stops = json::array();
+	for (const StopSpec &stop : spec.stops) {
+		TileIndex stop_tile = TileXY(stop.point.x, stop.point.y);
+		Require(IsNormalRoadTile(stop_tile) && HasTileRoadType(stop_tile, RTT_ROAD), fmt::format("planned bus stop ({}, {}) is not on a road", stop.point.x, stop.point.y));
+
+		uint passenger_sources = 0;
+		for (TileIndex tile{}; tile < Map::Size(); ++tile) {
+			if (!IsTileType(tile, MP_HOUSE) || GetTownIndex(tile) != TownID{stop.town_id}) continue;
+			if (HouseSpec::Get(GetHouseType(tile))->population == 0) continue;
+			if (std::abs(static_cast<int>(TileX(tile)) - stop.point.x) <= static_cast<int>(CA_BUS) &&
+					std::abs(static_cast<int>(TileY(tile)) - stop.point.y) <= static_cast<int>(CA_BUS)) ++passenger_sources;
+		}
+		Require(passenger_sources > 0, fmt::format("planned bus stop ({}, {}) covers no passenger source for town {}", stop.point.x, stop.point.y, stop.town_id));
+		planned_stops.push_back({
+			{"approach", stop.approach}, {"passenger_source_tiles_in_catchment", passenger_sources},
+			{"town_id", stop.town_id}, {"x", stop.point.x}, {"y", stop.point.y},
+		});
+	}
+
+	Point depot_front = spec.depot;
+	if (spec.depot_entrance == "north") --depot_front.y;
+	else if (spec.depot_entrance == "south") ++depot_front.y;
+	else if (spec.depot_entrance == "east") ++depot_front.x;
+	else if (spec.depot_entrance == "west") --depot_front.x;
+	else Fail("invalid depot entrance in compiled corpus");
+	TileIndex depot_tile = TileXY(spec.depot.x, spec.depot.y);
+	TileIndex front_tile = TileXY(depot_front.x, depot_front.y);
+	Require(IsTileType(depot_tile, MP_CLEAR) && IsTileFlat(depot_tile), "planned road depot tile is not clear and flat");
+	Require(IsNormalRoadTile(front_tile) && HasTileRoadType(front_tile, RTT_ROAD), "planned road depot entrance does not face the route");
+
+	return {
+		{"bus_stops", std::move(planned_stops)},
+		{"road_depot", {{"entrance", spec.depot_entrance}, {"front_x", depot_front.x}, {"front_y", depot_front.y}, {"x", spec.depot.x}, {"y", spec.depot.y}}},
+		{"road_path_length", path_length},
+	};
+}
