+static json ReadCanonicalInstance(const std::string &path)
+{
+	std::ifstream input(path, std::ios::binary);
+	if (!input) Fail(fmt::format("cannot open scenario instance '{}'", path));
+	std::string bytes((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+	if (bytes.empty()) Fail("scenario instance is empty");
+	if (bytes.back() != '\n') Fail("scenario instance must end with one LF");
+	bytes.pop_back();
+	if (bytes.empty() || bytes.back() == '\n' || bytes.back() == '\r') Fail("scenario instance has non-canonical trailing whitespace");
+
+	json instance;
+	try {
+		instance = json::parse(bytes);
+	} catch (const json::exception &e) {
+		Fail(fmt::format("invalid scenario JSON: {}", e.what()));
+	}
+	Require(instance.dump() == bytes, "scenario instance is not canonical compact JSON followed by LF");
+	return instance;
+}
