+static json ExpectedTemplate(const TemplateSpec &spec)
+{
+	json towns = json::array();
+	for (uint8_t i = 0; i < spec.towns.size(); ++i) {
+		const TownSpec &town = spec.towns[i];
+		towns.push_back({{"name", town.name}, {"size", "small"}, {"town_id", i}, {"x", town.point.x}, {"y", town.point.y}});
+	}
+
+	json waypoints = json::array();
+	for (uint8_t i = 0; i < spec.waypoint_count; ++i) waypoints.push_back({{"x", spec.waypoints[i].x}, {"y", spec.waypoints[i].y}});
+
+	json stops = json::array();
+	for (const StopSpec &stop : spec.stops) {
+		stops.push_back({{"approach", stop.approach}, {"town_id", stop.town_id}, {"x", stop.point.x}, {"y", stop.point.y}});
+	}
+
+	return {
+		{"bus_stops", std::move(stops)},
+		{"road_depot", {{"entrance", spec.depot_entrance}, {"x", spec.depot.x}, {"y", spec.depot.y}}},
+		{"road_waypoints", std::move(waypoints)},
+		{"seed", spec.seed},
+		{"split", spec.split},
+		{"template_id", spec.id},
+		{"towns", std::move(towns)},
+	};
+}
