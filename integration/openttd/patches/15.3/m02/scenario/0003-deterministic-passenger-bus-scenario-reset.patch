+static void Materialize(const TemplateSpec &spec)
+{
+	ConfigureSettings(spec.seed);
+	_random.SetSeed(spec.seed);
+	_interactive_random.SetSeed(spec.seed ^ 0x524C4D32U);
+
+	_game_mode = GM_NORMAL;
+	_switch_mode = SM_NONE;
+	GenerateWorld(GWM_EMPTY, 32, 32, false);
+	Require(Map::SizeX() == 32 && Map::SizeY() == 32, fmt::format("native map dimensions are {}x{}, expected 32x32", Map::SizeX(), Map::SizeY()));
+
+	BuildRoadRoute(spec);
+	BuildTowns(spec);
+
+	Company *company = DoStartupNewCompany(false, CompanyID::Begin());
+	Require(company != nullptr && company->index == CompanyID::Begin(), "failed to create company 0");
+	SetLocalCompany(CompanyID::Begin());
+	_current_company = CompanyID::Begin();
+	Require(company->money == 100000 && company->current_loan == 100000, "company initial finance mismatch");
+}
