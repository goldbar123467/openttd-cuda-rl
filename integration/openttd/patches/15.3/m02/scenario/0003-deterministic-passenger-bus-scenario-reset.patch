+static DiagDirection ParseCardinalDirection(std::string_view direction)
+{
+	if (direction == "east") return DIAGDIR_SW;
+	if (direction == "west") return DIAGDIR_NE;
+	if (direction == "south") return DIAGDIR_SE;
+	if (direction == "north") return DIAGDIR_NW;
+	Fail(fmt::format("invalid cardinal direction '{}'", direction));
+}
+
+static DiagDirection StopRouteEntranceDirection(const TemplateSpec &spec, uint8_t stop_index)
+{
+	std::vector<Point> route;
+	for (uint8_t segment = 1; segment < spec.waypoint_count; ++segment) {
+		Point current = spec.waypoints[segment - 1];
+		const Point end = spec.waypoints[segment];
+		if (route.empty()) route.push_back(current);
+		while (current.x != end.x || current.y != end.y) {
+			if (current.x < end.x) ++current.x;
+			else if (current.x > end.x) --current.x;
+			else if (current.y < end.y) ++current.y;
+			else --current.y;
+			route.push_back(current);
+		}
+	}
+	const Point stop = spec.stops[stop_index].point;
+	auto it = std::ranges::find_if(route, [stop](Point point) { return point.x == stop.x && point.y == stop.y; });
+	Require(it != route.end(), fmt::format("scripted bus stop {} is absent from the route", stop_index));
+	size_t position = std::distance(route.begin(), it);
+	if (stop_index == 0) {
+		Require(position + 1 < route.size(), "first bus stop has no inward route neighbor");
+		return DirectionBetween(stop, route[position + 1]);
+	}
+	Require(position > 0, "second bus stop has no inward route neighbor");
+	return DirectionBetween(stop, route[position - 1]);
+}
+
+static void RecordCommand(json &actions, std::string_view action, const CommandCost &cost)
+{
+	Require(cost.Succeeded(), fmt::format("scripted action '{}' failed: error={} extra={}", action, cost.GetErrorMessage(), cost.GetExtraErrorMessage()));
+	const Company *company = Company::Get(CompanyID::Begin());
+	actions.push_back({{"action", action}, {"balance_after", company->money.base()}, {"cost", cost.GetCost().base()}});
+}
+
+static json RunScriptedTrajectory(const TemplateSpec &spec)
+{
+	static constexpr uint64_t TICK_LIMIT = 65536;
+	static constexpr EngineID BUS_ENGINE{116};
+	CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+	Require(IsValidCargoType(passengers), "passenger cargo label is unavailable");
+
+	json actions = json::array();
+	std::array<StationID, 2> station_ids{};
+	for (uint8_t index = 0; index < spec.stops.size(); ++index) {
+		const StopSpec &stop = spec.stops[index];
+		TileIndex tile = TileXY(stop.point.x, stop.point.y);
+		CommandCost cost = Command<CMD_BUILD_ROAD_STOP>::Do(
+			DoCommandFlag::Execute, tile, 1, 1, RoadStopType::Bus, false,
+			StopRouteEntranceDirection(spec, index), ROADTYPE_ROAD,
+			ROADSTOP_CLASS_DFLT, 0, NEW_STATION, false);
+		RecordCommand(actions, fmt::format("build-bus-stop-{}", index), cost);
+		Require(IsTileType(tile, MP_STATION) && IsStationRoadStop(tile), fmt::format("bus stop {} did not materialize", index));
+		station_ids[index] = GetStationIndex(tile);
+		Require(station_ids[index] == StationID{index}, fmt::format("bus stop {} received unexpected station ID {}", index, station_ids[index].base()));
+	}
+
+	Point depot_front = spec.depot;
+	DiagDirection depot_direction = ParseCardinalDirection(spec.depot_entrance);
+	if (spec.depot_entrance == "north") --depot_front.y;
+	else if (spec.depot_entrance == "south") ++depot_front.y;
+	else if (spec.depot_entrance == "east") ++depot_front.x;
+	else --depot_front.x;
+	CommandCost connection_cost = Command<CMD_BUILD_ROAD>::Do(
+		DoCommandFlag::Execute, TileXY(depot_front.x, depot_front.y),
+		DiagDirToRoadBits(ReverseDiagDir(depot_direction)), ROADTYPE_ROAD,
+		DRD_NONE, TownID::Invalid());
+	RecordCommand(actions, "connect-road-depot", connection_cost);
+
+	TileIndex depot_tile = TileXY(spec.depot.x, spec.depot.y);
+	CommandCost depot_cost = Command<CMD_BUILD_ROAD_DEPOT>::Do(
+		DoCommandFlag::Execute, depot_tile, ROADTYPE_ROAD, depot_direction);
+	RecordCommand(actions, "build-road-depot", depot_cost);
+	Require(IsRoadDepotTile(depot_tile), "road depot did not materialize");
+
+	auto [vehicle_cost, vehicle_id, refit_capacity, refit_mail, cargo_capacities] =
+		Command<CMD_BUILD_VEHICLE>::Do(
+			DoCommandFlag::Execute, depot_tile, BUS_ENGINE, true, passengers, INVALID_CLIENT_ID);
+	(void)refit_mail;
+	RecordCommand(actions, "build-mps-regal-bus", vehicle_cost);
+	Require(vehicle_id == VehicleID{0}, fmt::format("scripted bus received unexpected vehicle ID {}", vehicle_id.base()));
+	Require(refit_capacity == 31 && cargo_capacities[passengers] == 31, "MPS Regal Bus capacity is not 31 passengers");
+
+	for (uint8_t index = 0; index < station_ids.size(); ++index) {
+		Order order;
+		order.MakeGoToStation(station_ids[index]);
+		order.SetStopLocation(OrderStopLocation::FarEnd);
+		CommandCost order_cost = Command<CMD_INSERT_ORDER>::Do(
+			DoCommandFlag::Execute, vehicle_id, VehicleOrderID{index}, order);
+		RecordCommand(actions, fmt::format("insert-station-order-{}", index), order_cost);
+	}
+
+	CommandCost start_cost = Command<CMD_START_STOP_VEHICLE>::Do(
+		DoCommandFlag::Execute, vehicle_id, false);
+	RecordCommand(actions, "start-bus", start_cost);
+	const Vehicle *vehicle = Vehicle::Get(vehicle_id);
+	Require(!vehicle->vehstatus.Test(VehState::Stopped), "scripted bus remained stopped");
+
+	Company *company = Company::Get(CompanyID::Begin());
+	uint64_t ticks_executed = 0;
+	while ((company->cur_economy.delivered_cargo[passengers] == 0 || company->cur_economy.income <= 0) && ticks_executed < TICK_LIMIT) {
+		StateGameLoop();
+		++ticks_executed;
+	}
+	uint32_t delivered_passengers = company->cur_economy.delivered_cargo[passengers];
+	if (delivered_passengers == 0) {
+		vehicle = Vehicle::Get(vehicle_id);
+		std::array<uint, 2> waiting{};
+		for (uint8_t index = 0; index < station_ids.size(); ++index) {
+			const GoodsEntry &goods = Station::Get(station_ids[index])->goods[passengers];
+			waiting[index] = goods.HasData() ? goods.GetData().cargo.TotalCount() : 0;
+		}
+		Fail(fmt::format(
+			"scripted bus delivered no passengers within {} ticks: tile=({}, {}) stopped={} crashed={} cargo={} order_type={} last_station={} waiting=[{}, {}]",
+			TICK_LIMIT, TileX(vehicle->tile), TileY(vehicle->tile), vehicle->vehstatus.Test(VehState::Stopped),
+			vehicle->vehstatus.Test(VehState::Crashed), vehicle->cargo.StoredCount(), to_underlying(vehicle->current_order.GetType()),
+			vehicle->last_station_visited.base(), waiting[0], waiting[1]));
+	}
+	Require(company->cur_economy.income > 0, "scripted passenger delivery produced no company income");
+	for (CargoType cargo = 0; cargo < NUM_CARGO; ++cargo) {
+		if (cargo != passengers) Require(company->cur_economy.delivered_cargo[cargo] == 0, fmt::format("scripted trajectory delivered forbidden cargo type {}", cargo));
+	}
+
+	vehicle = Vehicle::Get(vehicle_id);
+	Require(vehicle->type == VEH_ROAD && vehicle->engine_type == BUS_ENGINE, "scripted vehicle is not the MPS Regal Bus");
+	Require(vehicle->owner == CompanyID::Begin(), "scripted bus owner mismatch");
+	Require(vehicle->cargo_type == passengers && vehicle->cargo_cap == 31, "scripted vehicle cargo scope mismatch");
+	Require(vehicle->GetNumManualOrders() == 2, "scripted bus does not have exactly two manual orders");
+	json orders = json::array();
+	for (const Order &order : vehicle->Orders()) {
+		if (!order.IsType(OT_GOTO_STATION)) continue;
+		orders.push_back({{"destination_station_id", order.GetDestination().ToStationID().base()}, {"type", "go-to-station"}});
+	}
+	Require(orders == json({
+		{{"destination_station_id", 0}, {"type", "go-to-station"}},
+		{{"destination_station_id", 1}, {"type", "go-to-station"}},
+	}), "scripted bus order sequence mismatch");
+
+	json stations = json::array();
+	for (StationID station_id : station_ids) {
+		const Station *station = Station::Get(station_id);
+		const GoodsEntry &goods = station->goods[passengers];
+		uint waiting = goods.HasData() ? goods.GetData().cargo.TotalCount() : 0;
+		stations.push_back({
+			{"ever_accepted_passengers", goods.status.Test(GoodsEntry::State::EverAccepted)},
+			{"id", station_id.base()},
+			{"owner", station->owner.base()},
+			{"tile", station->xy.base()},
+			{"waiting_passengers", waiting},
+		});
+	}
+	Require(std::ranges::any_of(stations, [](const json &station) { return station.at("ever_accepted_passengers").get<bool>(); }), "no bus station recorded accepted passengers");
+
+	Require(Company::GetNumItems() == 1 && Vehicle::GetNumItems() == 1 && Station::GetNumItems() == 2 && Depot::GetNumItems() == 1, "scripted trajectory entity counts mismatch");
+	Require(Industry::GetNumItems() == 0, "scripted trajectory contains an industry");
+	Require(company->infrastructure.GetRailTotal() == 0 && company->infrastructure.GetTramTotal() == 0 && company->infrastructure.airport == 0 && company->infrastructure.water == 0, "scripted trajectory created forbidden infrastructure");
+
+	return {
+		{"actions", std::move(actions)},
+		{"company", {
+			{"balance", company->money.base()},
+			{"delivered_passengers", delivered_passengers},
+			{"expenses", company->cur_economy.expenses.base()},
+			{"id", company->index.base()},
+			{"income", company->cur_economy.income.base()},
+		}},
+		{"facilities", {{"depot_count", Depot::GetNumItems()}, {"station_count", Station::GetNumItems()}}},
+		{"forbidden", {
+			{"airports", company->infrastructure.airport}, {"industries", Industry::GetNumItems()},
+			{"rail", company->infrastructure.GetRailTotal()}, {"ships", 0}, {"trams", company->infrastructure.GetTramTotal()}, {"trucks", 0}
+		}},
+		{"orders", std::move(orders)},
+		{"scenario", {{"scenario_sha256", spec.scenario_sha256}, {"seed", spec.seed}, {"template_id", spec.id}}},
+		{"stations", std::move(stations)},
+		{"ticks", {{"executed", ticks_executed}, {"final", TimerGameTick::counter}, {"limit", TICK_LIMIT}}},
+		{"vehicle", {
+			{"capacity", vehicle->cargo_cap}, {"cargo", "passengers"}, {"cargo_stored", vehicle->cargo.StoredCount()},
+			{"engine_id", vehicle->engine_type.base()}, {"id", vehicle->index.base()}, {"profit_this_year", vehicle->GetDisplayProfitThisYear().base()},
+			{"running", !vehicle->vehstatus.Test(VehState::Stopped)}, {"type", "bus"}
+		}},
+	};
+}
+
+static void WriteCanonicalJson(const std::string &path, const json &value)
+{
+	Require(!path.empty(), "JSON output path is empty");
+	Require(!std::filesystem::exists(path), fmt::format("JSON output already exists: '{}'", path));
+	std::string output = value.dump();
+	std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+	if (!stream) Fail(fmt::format("cannot create JSON output '{}'", path));
+	stream.write(output.data(), static_cast<std::streamsize>(output.size()));
+	stream.put('\n');
+	stream.close();
+	if (!stream) Fail(fmt::format("failed to write JSON output '{}'", path));
+}
+
+} // namespace
+
+bool IsRlEnvironmentScenarioActive()
+{
+	return scenario_active;
+}
+
+void RunRlEnvironmentScenario(const std::string &instance_path, const std::string &projection_path, const std::string &trajectory_path, uint32_t repetitions)
+{
+	try {
+		Require(repetitions >= 1 && repetitions <= 16, "reset repetitions must be in 1..16");
+		Require(!projection_path.empty(), "projection output path is empty");
+		Require(!std::filesystem::exists(projection_path), fmt::format("projection output already exists: '{}'", projection_path));
+		Require(trajectory_path.empty() || trajectory_path != projection_path, "trajectory and projection output paths must differ");
+		Require(trajectory_path.empty() || !std::filesystem::exists(trajectory_path), fmt::format("trajectory output already exists: '{}'", trajectory_path));
+
+		json instance = ReadCanonicalInstance(instance_path);
+		const TemplateSpec &spec = ValidateInstance(instance);
+
+		std::string canonical_projection;
+		scenario_active = true;
+		/* The initial NewGRF scanner invokes its callback before releasing its modal
+		 * progress state. This synchronous runner owns the process from this point. */
+		SetModalProgress(false);
+		for (uint32_t repetition = 0; repetition < repetitions; ++repetition) {
+			Materialize(spec);
+			std::string current = BuildProjection(spec).dump();
+			if (repetition == 0) {
+				canonical_projection = std::move(current);
+			} else {
+				Require(current == canonical_projection, fmt::format("same-process reset {} differs from reset 0", repetition));
+			}
+		}
+		scenario_active = false;
+
+		json report = {
+			{"projection", json::parse(canonical_projection)},
+			{"same_process_byte_identical", true},
+			{"same_process_repetitions", repetitions},
+			{"schema_version", "openttd-rl-v1-m02-reset-projection-1"},
+			{"status", "PASS"},
+		};
+		WriteCanonicalJson(projection_path, report);
+		if (!trajectory_path.empty()) {
+			json trajectory_report = {
+				{"schema_version", "openttd-rl-v1-m02-scripted-bus-trajectory-1"},
+				{"status", "PASS"},
+				{"trajectory", RunScriptedTrajectory(spec)},
+			};
+			WriteCanonicalJson(trajectory_path, trajectory_report);
+		}
+
+		fmt::print("M02_SCENARIO_RESET=PASS template={} repetitions={} projection_bytes={} trajectory={}\n", spec.id, repetitions, report.dump().size() + 1, trajectory_path.empty() ? "SKIP" : "PASS");
+	} catch (...) {
+		scenario_active = false;
+		throw;
+	}
+}
