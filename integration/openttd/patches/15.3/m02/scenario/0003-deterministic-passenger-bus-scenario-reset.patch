+static const TemplateSpec &FindTemplate(std::string_view id)
+{
+	auto it = std::ranges::find(TEMPLATE_SPECS, id, &TemplateSpec::id);
+	if (it == TEMPLATE_SPECS.end()) Fail(fmt::format("unknown template_id '{}'", id));
+	return *it;
+}
