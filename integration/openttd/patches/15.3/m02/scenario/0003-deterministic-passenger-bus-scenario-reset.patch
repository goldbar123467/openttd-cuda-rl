+static const TemplateSpec &ValidateInstance(const json &instance)
+{
+	Require(instance.is_object() && instance.size() == 13, "scenario instance must contain exactly 13 top-level fields");
+	Require(instance.at("schema_version") == "openttd-rl-v1-m02-scenario-instance-1", "unsupported scenario schema_version");
+	Require(instance.at("contract_id") == CONTRACT_ID, "contract_id mismatch");
+	Require(instance.at("contract_compatibility_sha256") == CONTRACT_SHA256, "contract compatibility identity mismatch");
+	Require(instance.at("corpus_sha256") == CORPUS_SHA256, "corpus identity mismatch");
+	Require(instance.at("seed_ledger_sha256") == LEDGER_SHA256, "seed ledger identity mismatch");
+	Require(instance.at("generation") == json({{"implicit_retry_count", 0}, {"mode", "fixed-template"}, {"rejection_policy", "record-and-fail"}}), "generation policy mismatch");
+	Require(instance.at("engine") == json({
+		{"build_option", "OPTION_RL_ENVIRONMENT=ON"},
+		{"composed_source_identity_sha256", "2140e34ccee8534dbf712487acd2225eda4b66d1c807b9e0ce07243ba40afdbd"},
+		{"map_profile", "rl-32x32-v1"},
+		{"openttd_version", "15.3"},
+		{"prepared_tree", "eba8f4bd3c37042c184d968d2f038864184e3132"},
+		{"source_commit", "14ec60f248547d4d062a1160f0fc26d742319888"},
+	}), "engine identity mismatch");
+	Require(instance.at("content") == json({
+		{"ai_scripts", json::array()},
+		{"base_graphics", {{"installed_name", "opengfx-8.0.tar"}, {"name", "OpenGFX"}, {"sha256", "9389bcb0807058c80bd95121e978f05d9ef86b4b1bc3ac2da8da8bb02456043c"}, {"version", "8.0"}}},
+		{"game_script", nullptr},
+		{"multiplayer", false},
+		{"networking", false},
+		{"newgrfs", json::array()},
+	}), "content identity mismatch");
+
+	const std::string template_id = instance.at("template_id").get<std::string>();
+	const TemplateSpec &spec = FindTemplate(template_id);
+	Require(instance.at("split") == spec.split, "template split mismatch");
+	Require(instance.at("seed") == spec.seed, "template seed mismatch");
+	Require(instance.at("template") == ExpectedTemplate(spec), "template geometry mismatch");
+	Require(instance.at("identity") == json({
+		{"algorithm", "sha256-canonical-json-v1"},
+		{"scenario_sha256", spec.scenario_sha256},
+		{"schema_path", "docs/project/schema/v1-m02-scenario-instance.schema.json"},
+		{"schema_sha256", INSTANCE_SCHEMA_SHA256},
+	}), "scenario instance identity mismatch");
+	return spec;
+}
