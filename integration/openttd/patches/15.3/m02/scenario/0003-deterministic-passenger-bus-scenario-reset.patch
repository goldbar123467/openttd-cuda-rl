+static DiagDirection DirectionBetween(Point from, Point to)
+{
+	if (from.x + 1 == to.x && from.y == to.y) return DIAGDIR_SW;
+	if (from.x == to.x + 1 && from.y == to.y) return DIAGDIR_NE;
+	if (from.y + 1 == to.y && from.x == to.x) return DIAGDIR_SE;
+	if (from.y == to.y + 1 && from.x == to.x) return DIAGDIR_NW;
+	Fail("road waypoint expansion produced non-adjacent tiles");
+}
+
+static void AddRoadConnection(std::map<uint16_t, RoadBits> &road_bits, Point from, Point to)
+{
+	DiagDirection direction = DirectionBetween(from, to);
+	uint16_t from_index = TileXY(from.x, from.y).base();
+	uint16_t to_index = TileXY(to.x, to.y).base();
+	road_bits[from_index] |= DiagDirToRoadBits(direction);
+	road_bits[to_index] |= DiagDirToRoadBits(ReverseDiagDir(direction));
+}
+
+static void BuildRoadRoute(const TemplateSpec &spec)
+{
+	std::map<uint16_t, RoadBits> road_bits;
+	for (uint8_t segment = 1; segment < spec.waypoint_count; ++segment) {
+		Point current = spec.waypoints[segment - 1];
+		const Point end = spec.waypoints[segment];
+		while (current.x != end.x || current.y != end.y) {
+			Point next = current;
+			if (next.x < end.x) ++next.x;
+			else if (next.x > end.x) --next.x;
+			else if (next.y < end.y) ++next.y;
+			else --next.y;
+			AddRoadConnection(road_bits, current, next);
+			current = next;
+		}
+	}
+
+	AutoRestoreBackup company(_current_company, OWNER_DEITY);
+	for (const auto &[tile_index, bits] : road_bits) {
+		CommandCost result = Command<CMD_BUILD_ROAD>::Do(DoCommandFlag::Execute, TileIndex{tile_index}, bits, ROADTYPE_ROAD, DRD_NONE, TownID::Invalid());
+		if (result.Failed()) Fail(fmt::format("failed to build route road at tile {}", tile_index));
+	}
+}
+
+static void BuildTowns(const TemplateSpec &spec)
+{
+	AutoRestoreBackup company(_current_company, OWNER_DEITY);
+	for (uint8_t i = 0; i < spec.towns.size(); ++i) {
+		const TownSpec &town_spec = spec.towns[i];
+		auto [cost, required_money, town_id] = Command<CMD_FOUND_TOWN>::Do(DoCommandFlag::Execute, TileXY(town_spec.point.x, town_spec.point.y), TSZ_SMALL, false, TL_ORIGINAL, false, 0, std::string(town_spec.name));
+		(void)required_money;
+		if (cost.Failed() || town_id != TownID{i}) Fail(fmt::format("failed to found town {} at ({}, {})", town_spec.name, town_spec.point.x, town_spec.point.y));
+	}
+
+	for (Town *town : Town::Iterate()) {
+		uint attempts = 0;
+		while (town->cache.population < 250 && attempts++ < 4096) {
+			CommandCost result = Command<CMD_EXPAND_TOWN>::Do(DoCommandFlag::Execute, town->index, 1, TownExpandModes{TownExpandMode::Buildings, TownExpandMode::Roads});
+			if (result.Failed()) Fail(fmt::format("failed to expand town {}", town->index.base()));
+		}
+		Require(town->cache.population >= 250 && town->cache.population <= 800, fmt::format("town {} population {} is outside 250..800 after {} expansion attempts", town->index.base(), town->cache.population, attempts));
+		town->flags.Reset(TownFlag::IsGrowing);
+		town->growth_rate = TOWN_GROWTH_RATE_NONE;
+	}
+}
