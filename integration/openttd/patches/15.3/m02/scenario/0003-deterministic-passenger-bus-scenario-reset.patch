+static json BuildProjection(const TemplateSpec &spec)
+{
+	json companies = json::array();
+	for (const Company *company : Company::Iterate()) {
+		companies.push_back({
+			{"id", company->index.base()},
+			{"is_ai", company->is_ai},
+			{"money", company->money.base()},
+			{"loan", company->current_loan.base()},
+			{"max_loan", company->GetMaxLoan().base()},
+			{"owned_airport", company->infrastructure.airport},
+			{"owned_rail", company->infrastructure.GetRailTotal()},
+			{"owned_road", company->infrastructure.GetRoadTotal()},
+			{"owned_station", company->infrastructure.station},
+			{"owned_tram", company->infrastructure.GetTramTotal()},
+			{"owned_water", company->infrastructure.water},
+		});
+	}
+
+	json towns = json::array();
+	for (const Town *town : Town::Iterate()) {
+		uint house_tiles = 0;
+		uint passenger_source_tiles = 0;
+		for (TileIndex tile{}; tile < Map::Size(); ++tile) {
+			if (!IsTileType(tile, MP_HOUSE) || GetTownIndex(tile) != town->index) continue;
+			++house_tiles;
+			if (HouseSpec::Get(GetHouseType(tile))->population > 0) ++passenger_source_tiles;
+		}
+		towns.push_back({
+			{"growth_enabled", town->flags.Test(TownFlag::IsGrowing)},
+			{"growth_rate", town->growth_rate},
+			{"house_tiles", house_tiles},
+			{"id", town->index.base()},
+			{"layout", to_underlying(town->layout)},
+			{"name", town->GetCachedName()},
+			{"passenger_source_tiles", passenger_source_tiles},
+			{"population", town->cache.population},
+			{"x", TileX(town->xy)},
+			{"y", TileY(town->xy)},
+		});
+	}
+
+	json roads = json::array();
+	json tiles = json::array();
+	std::array<uint32_t, static_cast<size_t>(MP_OBJECT) + 1> tile_type_counts{};
+	for (TileIndex tile{}; tile < Map::Size(); ++tile) {
+		Tile map_tile{tile};
+		TileType type = GetTileType(tile);
+		++tile_type_counts[type];
+		bool border = TileX(tile) == 0 || TileY(tile) == 0 || TileX(tile) == Map::MaxX() || TileY(tile) == Map::MaxY();
+		if (border) {
+			Require(type == MP_VOID, fmt::format("border tile {} is not void", tile.base()));
+		} else {
+			Require(type != MP_VOID && type != MP_WATER, fmt::format("interior tile {} is void or water", tile.base()));
+			Require(TileHeight(tile) == 1, fmt::format("interior tile {} does not have terrain height 1", tile.base()));
+		}
+		json raw = {map_tile.type(), map_tile.height(), map_tile.m1(), map_tile.m2(), map_tile.m3(), map_tile.m4(), map_tile.m5(), map_tile.m6(), map_tile.m7(), map_tile.m8()};
+		tiles.push_back({{"index", tile.base()}, {"raw", std::move(raw)}, {"x", TileX(tile)}, {"y", TileY(tile)}});
+		if (IsNormalRoadTile(tile) && HasTileRoadType(tile, RTT_ROAD)) {
+			roads.push_back({
+				{"bits", to_underlying(GetRoadBits(tile, RTT_ROAD))},
+				{"index", tile.base()},
+				{"owner", GetRoadOwner(tile, RTT_ROAD).base()},
+				{"road_type", to_underlying(GetRoadType(tile, RTT_ROAD))},
+				{"town_id", GetTownIndex(tile).base()},
+				{"x", TileX(tile)},
+				{"y", TileY(tile)},
+			});
+		}
+	}
+
+	json type_counts = json::array();
+	for (uint i = 0; i < tile_type_counts.size(); ++i) type_counts.push_back(tile_type_counts[i]);
+
+	const GraphicsSet *graphics = BaseGraphics::GetUsedSet();
+	Require(graphics != nullptr, "no active base graphics set");
+	Require(graphics->name == "OpenGFX", "active base graphics set is not OpenGFX");
+	/* OpenGFX 8.0 identifies its frozen metadata payload with version 9499. */
+	Require(graphics->version == std::vector<uint32_t>({9499}), "active OpenGFX metadata version is not 9499 (OpenGFX 8.0)");
+	Require(_grfconfig.empty() && _grfconfig_static.empty(), "NewGRF configuration is not empty");
+	Require(!_networking, "networking is active in the reset environment");
+	Require(Game::GetInfo() == nullptr, "a GameScript is active in the reset environment");
+	json planned_construction = ValidatePlannedConstruction(spec);
+
+	json projection = {
+		{"companies", std::move(companies)},
+		{"compatibility", {{"contract_sha256", CONTRACT_SHA256}, {"corpus_sha256", CORPUS_SHA256}, {"ledger_sha256", LEDGER_SHA256}}},
+		{"content", {{"ai_company_count", 0}, {"base_graphics_metadata_version", graphics->version}, {"base_graphics_name", graphics->name}, {"game_script", nullptr}, {"multiplayer", false}, {"networking", false}, {"newgrf_count", 0}}},
+		{"depots", json::array()},
+		{"economy", {{"inflation_payment", _economy.inflation_payment}, {"inflation_prices", _economy.inflation_prices}, {"interest_rate", _economy.interest_rate}, {"maximum_loan", _economy.max_loan.base()}}},
+		{"map", {{"height", Map::SizeY()}, {"terrain_height", 1}, {"tile_type_counts", std::move(type_counts)}, {"tiles", std::move(tiles)}, {"width", Map::SizeX()}}},
+		{"orders", json::array()},
+		{"pools", {
+			{"cargo_packets", CargoPacket::GetNumItems()}, {"companies", Company::GetNumItems()}, {"depots", Depot::GetNumItems()},
+			{"groups", Group::GetNumItems()}, {"industries", Industry::GetNumItems()}, {"objects", Object::GetNumItems()},
+			{"order_lists", OrderList::GetNumItems()}, {"signs", Sign::GetNumItems()}, {"stations", Station::GetNumItems()},
+			{"subsidies", Subsidy::GetNumItems()}, {"towns", Town::GetNumItems()}, {"vehicles", Vehicle::GetNumItems()}
+		}},
+		{"rng-streams", {{"interactive", {_interactive_random.state[0], _interactive_random.state[1]}}, {"simulation", {_random.state[0], _random.state[1]}}}},
+		{"roads", std::move(roads)},
+		{"scenario", {{"planned_construction", std::move(planned_construction)}, {"scenario_sha256", spec.scenario_sha256}, {"seed", spec.seed}, {"split", spec.split}, {"template_id", spec.id}}},
+		{"settings", ProjectSettings()},
+		{"stations", json::array()},
+		{"time", {
+			{"calendar_date", TimerGameCalendar::date.base()}, {"calendar_date_fraction", TimerGameCalendar::date_fract},
+			{"calendar_month", TimerGameCalendar::month}, {"calendar_year", TimerGameCalendar::year.base()},
+			{"economy_date", TimerGameEconomy::date.base()}, {"economy_date_fraction", TimerGameEconomy::date_fract},
+			{"economy_month", TimerGameEconomy::month}, {"economy_year", TimerGameEconomy::year.base()},
+			{"tick", TimerGameTick::counter}, {"ticks_per_day", Ticks::DAY_TICKS}
+		}},
+		{"towns", std::move(towns)},
+		{"vehicles", json::array()},
+	};
+
+	Require(projection.size() == 16, "semantic projection field count mismatch");
+	Require(projection["companies"].size() == 1, "reset must contain exactly one company");
+	Require(projection["towns"].size() == 2, "reset must contain exactly two towns");
+	Require(projection["pools"]["industries"] == 0 && projection["pools"]["stations"] == 0 && projection["pools"]["vehicles"] == 0, "forbidden entity pool is not empty at reset");
+	return projection;
+}
