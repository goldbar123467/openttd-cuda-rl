@@ -20,6 +20,36 @@ struct TileCoord {
 	uint x, y;
 };
 
+TEST_CASE("Map size profile and scaling")
+{
+#ifdef WITH_RL_ENVIRONMENT
+	CHECK(MIN_MAP_SIZE_BITS == 5);
+	CHECK(MIN_MAP_SIZE == 32);
+
+	Map::Allocate(32, 32);
+	CHECK(Map::SizeX() == 32);
+	CHECK(Map::SizeY() == 32);
+	CHECK(Map::Size() == 1024);
+	CHECK(Map::LogX() == 5);
+	CHECK(Map::LogY() == 5);
+	CHECK(Map::ScaleBySize(1) == 1);
+	CHECK(Map::ScaleBySize(64) == 1);
+	CHECK(Map::ScaleBySize(65) == 2);
+
+	Map::Allocate(32, 64);
+	CHECK(Map::ScaleBySize(32) == 1);
+	CHECK(Map::ScaleBySize(33) == 2);
+#else
+	CHECK(MIN_MAP_SIZE_BITS == 6);
+	CHECK(MIN_MAP_SIZE == 64);
+#endif
+
+	Map::Allocate(64, 64);
+	CHECK(Map::ScaleBySize(1) == 1);
+	CHECK(Map::ScaleBySize(16) == 1);
+	CHECK(Map::ScaleBySize(17) == 2);
+}
