diff --git a/src/map_func.h b/src/map_func.h
index fd431b4..a329878 100644
--- a/src/map_func.h
+++ b/src/map_func.h
@@ -339,6 +339,13 @@ public:
 	 */
 	static inline uint ScaleBySize(uint n)
 	{
+#ifdef WITH_RL_ENVIRONMENT
+		/* A 32x32 or 32x64 map has fewer than 4096 tiles, so the normal
+		 * left-shift expression would have a negative shift count. */
+		if (Map::LogX() + Map::LogY() < 12) {
+			return CeilDiv(n, 1U << (16 - Map::LogX() - Map::LogY()));
+		}
+#endif
 		/* Subtract 12 from shift in order to prevent integer overflow
 		 * for large values of n. It's safe since the min mapsize is 64x64. */
 		return CeilDiv(n << (Map::LogX() + Map::LogY() - 12), 1 << 4);
