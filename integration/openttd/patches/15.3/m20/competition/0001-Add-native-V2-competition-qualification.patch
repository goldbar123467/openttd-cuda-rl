+static Request Validate(const json &manifest)
+{
+	Require(manifest.is_object() && manifest.size() == 18, "manifest must contain exactly eighteen fields");
+	Require(manifest.at("schema_version") == MANIFEST_SCHEMA, "unsupported manifest schema_version");
+	Request request{
+		manifest.at("run_id").get<std::string>(),
+		manifest.at("probe").get<std::string>(),
+		manifest.at("split").get<std::string>(),
+		manifest.at("map_seed").get<uint32_t>(),
+		manifest.at("simulation_seed").get<uint32_t>(),
+		manifest.at("competition_manifest_sha256").get<std::string>(),
+		manifest.at("m20_contract_sha256").get<std::string>(),
+		manifest.at("map_manifest_sha256").get<std::string>(),
+		manifest.at("settings_manifest_sha256").get<std::string>(),
+		manifest.at("content_manifest_sha256").get<std::string>(),
+		manifest.at("engine_source_tree").get<std::string>(),
+		manifest.at("executable_sha256").get<std::string>(),
+		manifest.at("policy_package_sha256").get<std::string>(),
+		CompanyID{manifest.at("rl_slot").get<uint8_t>()},
+		manifest.at("rl_start_delay_days").get<uint>(),
+		manifest.at("calendar_days").get<uint>(),
+		{},
+	};
+	Require(SafeName(request.run_id), "invalid run_id");
+	Require(request.probe == "solo" || request.probe == "head_to_head" || request.probe == "mixed_field" ||
+		request.probe == "fault" || request.probe == "interaction", "unknown competition probe");
+	Require(request.split == "development", "M20 qualification runs must use the development split");
+	Require(IsSha256(request.competition_manifest_sha256) && IsSha256(request.m20_contract_sha256) &&
+		IsSha256(request.map_manifest_sha256) && IsSha256(request.settings_manifest_sha256) &&
+		IsSha256(request.content_manifest_sha256) && IsSha256(request.executable_sha256) && IsSha256(request.policy_package_sha256),
+		"competition, contract, map, settings, content, executable, and policy identities must be SHA-256");
+	Require(request.engine_source_tree.size() == 40 && std::ranges::all_of(request.engine_source_tree, [](char c) {
+		return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+	}), "engine_source_tree must be a lowercase Git tree identity");
+	Require(request.rl_slot < MAX_COMPANIES && (request.rl_slot == CompanyID{0} || request.rl_slot == CompanyID{1} ||
+		request.rl_slot == CompanyID{2} || request.rl_slot == CompanyID{3}), "rl_slot must be 0..3");
+	Require(request.rl_start_delay_days == 0 || request.rl_start_delay_days == 365, "RL start delay must be 0 or 365 days");
+	Require(request.calendar_days >= 20 && request.calendar_days <= MAX_CALENDAR_DAYS, "calendar_days is outside 20..730");
+
+	Require(manifest.at("opponents").is_array(), "opponents must be an array");
+	std::set<uint8_t> slots{request.rl_slot.base()};
+	std::set<std::string> names;
+	for (const json &item : manifest.at("opponents")) {
+		Require(item.is_object() && item.size() == 6, "opponent entry must contain exactly six fields");
+		OpponentRequest opponent{
+			item.at("name").get<std::string>(), item.at("version").get<int>(), CompanyID{item.at("slot").get<uint8_t>()},
+			item.at("start_delay_days").get<uint>(), item.at("package_evidence_sha256").get<std::string>(),
+			item.at("runtime_evidence_sha256").get<std::string>(),
+		};
+		bool identity = (opponent.name == "AAAHogEx" && opponent.version == 115) ||
+			(opponent.name == "KrakenAI2" && opponent.version == 3) || (opponent.name == "NoOpAI" && opponent.version == 3);
+		Require(identity, "opponent is outside the frozen qualified roster");
+		Require(opponent.slot < MAX_COMPANIES && opponent.slot.base() <= 3 && slots.insert(opponent.slot.base()).second,
+			"opponent slot is invalid, duplicated, or collides with RL");
+		Require(names.insert(opponent.name).second, "opponent roster contains a duplicate name");
+		Require(opponent.start_delay_days == 0 || opponent.start_delay_days == 365, "opponent start delay must be 0 or 365 days");
+		Require(IsSha256(opponent.package_evidence_sha256) && IsSha256(opponent.runtime_evidence_sha256),
+			"opponent evidence identities must be SHA-256");
+		Require(request.calendar_days >= opponent.start_delay_days + 30, "opponent lacks thirty post-delay qualification days");
+		request.opponents.push_back(std::move(opponent));
+	}
+	Require(request.calendar_days >= request.rl_start_delay_days + 30, "RL lacks thirty post-delay qualification days");
+	if (request.probe == "solo") Require(request.opponents.empty(), "solo probe cannot include opponents");
+	if (request.probe == "head_to_head" || request.probe == "fault" || request.probe == "interaction") {
+		Require(request.opponents.size() == 1, "single-opponent probe requires exactly one opponent");
+	}
+	if (request.probe == "interaction") {
+		Require(request.rl_start_delay_days == 0 && request.opponents[0].start_delay_days == 0,
+			"interaction probe requires both participants at day zero");
+	}
+	if (request.probe == "mixed_field") Require(request.opponents.size() == 3, "mixed-field probe requires the complete three-opponent roster");
+	return request;
+}
