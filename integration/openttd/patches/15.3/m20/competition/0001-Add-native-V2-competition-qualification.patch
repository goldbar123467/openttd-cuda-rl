+static StationID BuildAirportAt(TileIndex tile, uint8_t type)
+{
+	CommandCost test = Command<CMD_BUILD_AIRPORT>::Do({}, tile, type, 0, NEW_STATION, false);
+	Require(test.Succeeded(), "selected airport site no longer passes native test mode");
+	CommandCost execute = Command<CMD_BUILD_AIRPORT>::Do(DoCommandFlag::Execute, tile, type, 0, NEW_STATION, false);
+	Require(execute.Succeeded() && IsAirportTile(tile), "native airport execution failed");
+	return GetStationIndex(tile);
+}
