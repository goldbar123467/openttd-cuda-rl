+static std::optional<TileIndex> FindAirportSite(uint8_t type, std::optional<TileIndex> distant_from)
+{
+	const AirportSpec *spec = AirportSpec::Get(type);
+	for (uint y = 2; y + spec->size_y + 2 < Map::SizeY(); ++y) {
+		for (uint x = 2; x + spec->size_x + 2 < Map::SizeX(); ++x) {
+			TileIndex tile = TileXY(x, y);
+			if (TileHeight(tile) < 2) continue;
+			if (distant_from.has_value()) {
+				uint distance = DistanceManhattan(tile, *distant_from);
+				if (distance < 16) continue;
+			}
+			if (Command<CMD_BUILD_AIRPORT>::Do({}, tile, type, 0, NEW_STATION, false).Succeeded()) return tile;
+		}
+	}
+	return std::nullopt;
+}
+
+static AirService StartAirService(const Request &request, json &events)
+{
+	_current_company = request.rl_slot;
+	SetLocalCompany(request.rl_slot);
+	CargoType cargo = GetCargoTypeByLabel(LabelFromText("PASS"));
+	Require(IsValidCargoType(cargo), "passenger cargo is unavailable");
+	uint8_t airport_type = AT_METROPOLITAN;
+	auto source_tile = FindAirportSite(airport_type, std::nullopt);
+	Require(source_tile.has_value(), "no native-legal source airport site exists");
+	StationID source = BuildAirportAt(*source_tile, airport_type);
+	auto destination_tile = FindAirportSite(airport_type, source_tile);
+	Require(destination_tile.has_value(), "no native-legal distant destination airport site exists");
+	StationID destination = BuildAirportAt(*destination_tile, airport_type);
+	const Station *source_station = Station::Get(source);
+	Require(source_station->airport.GetNumHangars() > 0, "source airport has no hangar");
+	TileIndex hangar = source_station->airport.GetHangarTile(0);
+
+	VehicleID vehicle = VehicleID::Invalid();
+	uint capacity = 0;
+	for (const Engine *engine : Engine::IterateType(VEH_AIRCRAFT)) {
+		const AircraftVehicleInfo &info = engine->VehInfo<AircraftVehicleInfo>();
+		if ((info.subtype & AIR_CTOL) == 0 || !engine->company_avail.Test(request.rl_slot) || !engine->CanCarryCargo()) continue;
+		if (!HasBit(GetUnionOfArticulatedRefitMasks(engine->index, true), cargo) || !CanVehicleUseStation(engine->index, source_station)) continue;
+		auto build = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, hangar, engine->index, true, cargo, INVALID_CLIENT_ID);
+		if (std::get<0>(build).Failed()) continue;
+		vehicle = std::get<1>(build);
+		auto refit = Command<CMD_REFIT_VEHICLE>::Do(DoCommandFlag::Execute, vehicle, cargo, 0, false, false, 0);
+		Require(std::get<0>(refit).Succeeded(), "RL aircraft refit failed");
+		capacity = Aircraft::Get(vehicle)->cargo_cap;
+		break;
+	}
+	Require(Vehicle::IsValidID(vehicle) && capacity > 0, "no native aircraft could be built for RL service");
+	std::array<StationID, 2> stations{destination, source};
+	for (uint8_t ordinal = 0; ordinal < stations.size(); ++ordinal) {
+		Order order;
+		order.MakeGoToStation(stations[ordinal]);
+		order.SetStopLocation(OrderStopLocation::FarEnd);
+		Require(Command<CMD_INSERT_ORDER>::Do(DoCommandFlag::Execute, vehicle, VehicleOrderID{ordinal}, order).Succeeded(),
+			"RL aircraft order insertion failed");
+	}
+	Require(Vehicle::Get(vehicle)->GetNumOrders() == stations.size(), "RL aircraft order list did not retain both stations");
+	Require(CargoPacket::CanAllocateItem(), "cargo packet pool is full");
+	GoodsEntry &goods = Station::Get(source)->goods[cargo];
+	goods.rating = 255;
+	goods.status.Set(GoodsEntry::State::Rating);
+	Source cargo_source{Town::Get(TownID{0})->index, SourceType::Town};
+	goods.GetOrCreateData().cargo.Append(new CargoPacket(source, static_cast<uint16_t>(capacity), cargo_source), StationID::Invalid());
+	Vehicle *unit = Vehicle::Get(vehicle);
+	std::array<StationID, 1> next{destination};
+	uint loaded = goods.GetOrCreateData().cargo.Load(capacity, &unit->cargo, next, Station::Get(source)->xy);
+	Require(loaded == capacity, "RL aircraft loading lost qualification cargo");
+	RlV2SetQualificationAcceptance(destination, cargo, true);
+	Station::Get(destination)->goods[cargo].status.Set(GoodsEntry::State::Acceptance);
+	SetBit(Station::Get(destination)->always_accepted, cargo);
+	Require(Command<CMD_START_STOP_VEHICLE>::Do(DoCommandFlag::Execute, vehicle, false).Succeeded(), "RL aircraft start failed");
+	events.push_back({{"capacity", capacity}, {"day", request.rl_start_delay_days}, {"destination", destination.base()},
+		{"kind", "rl_service_started"}, {"source", source.base()}, {"vehicle", vehicle.base()}});
+	return {vehicle, source, destination, cargo, capacity};
+}
+
+static uint64_t DeliveredTotal(const Company *company)
+{
+	uint64_t total = std::accumulate(company->cur_economy.delivered_cargo.begin(), company->cur_economy.delivered_cargo.end(), uint64_t{0});
+	for (uint index = 0; index < company->num_valid_stat_ent; ++index) {
+		total += std::accumulate(company->old_economy[index].delivered_cargo.begin(),
+			company->old_economy[index].delivered_cargo.end(), uint64_t{0});
+	}
+	return total;
+}
+
+static Money OperatingProfitTotal(const Company *company)
+{
+	Money total = company->cur_economy.income + company->cur_economy.expenses;
+	for (uint index = 0; index < company->num_valid_stat_ent; ++index) {
+		total += company->old_economy[index].income + company->old_economy[index].expenses;
+	}
+	return total;
+}
+
+static Money IncomeTotal(const Company *company)
+{
+	Money total = company->cur_economy.income;
+	for (uint index = 0; index < company->num_valid_stat_ent; ++index) total += company->old_economy[index].income;
+	return total;
+}
+
+static json PublicCompany(CompanyID slot)
+{
+	const Company *company = Company::GetIfValid(slot);
+	if (company == nullptr) return {{"alive", false}, {"company_id", slot.base()}};
+	std::array<uint32_t, 4> vehicles{};
+	uint32_t crashed = 0;
+	for (const Vehicle *vehicle : Vehicle::Iterate()) {
+		if (vehicle->owner != slot || !vehicle->IsPrimaryVehicle()) continue;
+		if (vehicle->type < VEH_COMPANY_END) ++vehicles[vehicle->type];
+		if (vehicle->vehstatus.Test(VehState::Crashed)) ++crashed;
+	}
+	uint32_t stations = 0;
+	uint64_t waiting = 0;
+	for (const Station *station : Station::Iterate()) {
+		if (station->owner != slot) continue;
+		++stations;
+		for (CargoType cargo = 0; cargo < NUM_CARGO; ++cargo) {
+			if (!IsValidCargoType(cargo)) continue;
+			waiting += station->goods[cargo].AvailableCount();
+		}
+	}
+	uint32_t subsidies = 0;
+	for (const Subsidy *subsidy : Subsidy::Iterate()) if (subsidy->awarded == slot) ++subsidies;
+	return {
+		{"alive", true}, {"aircraft", vehicles[VEH_AIRCRAFT]}, {"company_id", slot.base()},
+		{"company_value", CalculateCompanyValue(company).base()}, {"crashed_vehicles", crashed},
+		{"delivered_cargo_units", DeliveredTotal(company)}, {"infrastructure", {
+			{"airports", company->infrastructure.airport}, {"rail", company->infrastructure.GetRailTotal()},
+			{"road", company->infrastructure.GetRoadTotal()}, {"signals", company->infrastructure.signal},
+			{"station_tiles", company->infrastructure.station}, {"water", company->infrastructure.water}}},
+		{"is_ai", company->is_ai}, {"loan", company->current_loan.base()}, {"money", company->money.base()},
+		{"operating_profit", OperatingProfitTotal(company).base()},
+		{"performance", company->cur_economy.performance_history}, {"road_vehicles", vehicles[VEH_ROAD]},
+		{"ships", vehicles[VEH_SHIP]}, {"stations", stations}, {"subsidies_awarded", subsidies},
+		{"trains", vehicles[VEH_TRAIN]}, {"waiting_cargo_units", waiting},
+	};
+}
+
+static json PublicSnapshot(const Request &request)
+{
+	json companies = json::array();
+	companies.push_back(PublicCompany(request.rl_slot));
+	for (const OpponentRequest &opponent : request.opponents) companies.push_back(PublicCompany(opponent.slot));
+	std::sort(companies.begin(), companies.end(), [](const json &a, const json &b) {
+		return a.at("company_id").get<uint8_t>() < b.at("company_id").get<uint8_t>();
+	});
+	return {
+		{"companies", std::move(companies)},
+		{"map", {{"height", Map::SizeY()}, {"industries", Industry::GetNumItems()}, {"towns", Town::GetNumItems()}, {"width", Map::SizeX()}}},
+	};
+}
+
+static json Score(const Request &request)
+{
+	json rl = PublicCompany(request.rl_slot);
+	json opponents = json::array();
+	for (const OpponentRequest &opponent : request.opponents) {
+		json public_state = PublicCompany(opponent.slot);
+		int64_t opponent_value = public_state.at("alive").get<bool>() ? public_state.at("company_value").get<int64_t>() : 0;
+		opponents.push_back({
+			{"company_value_difference", rl.at("company_value").get<int64_t>() - opponent_value},
+			{"name", opponent.name}, {"public_state", std::move(public_state)},
+		});
+	}
+	return {{"opponents", std::move(opponents)}, {"rl", std::move(rl)}};
+}
+
+static json RunInteraction(const Request &request, uint day, json &events)
+{
+	Require(!request.opponents.empty() && Company::IsValidID(request.rl_slot) && Company::IsValidID(request.opponents[0].slot),
+		"interaction probe lacks live companies");
+	CargoType cargo = GetCargoTypeByLabel(LabelFromText("PASS"));
+	Require(IsValidCargoType(cargo) && Town::GetNumItems() >= 2, "interaction subsidy prerequisites are absent");
+	{
+		AutoRestoreBackup current(_current_company, OWNER_DEITY);
+		Source source{TownID{0}.base(), SourceType::Town};
+		Source destination{TownID{1}.base(), SourceType::Town};
+		Require(Command<CMD_CREATE_SUBSIDY>::Do(DoCommandFlag::Execute, cargo, source, destination).Succeeded(),
+			"native subsidy creation failed");
+	}
+	Subsidy *subsidy = *Subsidy::Iterate().begin();
+	subsidy->AwardTo(request.rl_slot);
+	Require(subsidy->awarded == request.rl_slot, "native subsidy award state diverged");
+	CompanyID target = request.opponents[0].slot;
+	json target_before = PublicCompany(target);
+	const Vehicle *target_vehicle = nullptr;
+	for (const Vehicle *vehicle : Vehicle::Iterate()) {
+		if (vehicle->owner == target && vehicle->IsPrimaryVehicle()) {
+			target_vehicle = vehicle;
+			break;
+		}
+	}
+	Require(target_vehicle != nullptr, "interaction target has no native vehicle for ownership-collision probe");
+	_current_company = request.rl_slot;
+	SetLocalCompany(request.rl_slot);
+	Require(Command<CMD_START_STOP_VEHICLE>::Do({}, target_vehicle->index, false).Failed(),
+		"cross-company vehicle-control collision was not rejected");
+	events.push_back({{"day", day}, {"kind", "ownership_collision_rejected"}, {"owner", target.base()},
+		{"requester", request.rl_slot.base()}, {"vehicle", target_vehicle->index.base()}});
+	FundCompany(request.rl_slot, Money{100000000});
+	_current_company = request.rl_slot;
+	SetLocalCompany(request.rl_slot);
+	CommandCost takeover_test = Command<CMD_BUY_COMPANY>::Do({}, target, true);
+	Require(takeover_test.Succeeded(), "native hostile-takeover test rejected qualified target");
+	CommandCost takeover = Command<CMD_BUY_COMPANY>::Do(DoCommandFlag::Execute, target, true);
+	Require(takeover.Succeeded() && !Company::IsValidID(target) && Company::IsValidID(request.rl_slot),
+		"native hostile takeover did not merge target into RL company");
+	events.push_back({{"day", day}, {"kind", "subsidy_awarded"}, {"slot", request.rl_slot.base()}, {"subsidy", subsidy->index.base()}});
+	events.push_back({{"cost", takeover.GetCost().base()}, {"day", day}, {"kind", "company_acquired"},
+		{"purchaser", request.rl_slot.base()}, {"target", target.base()}});
+	return {{"collision_disposition", {{"crashed_vehicles_scored", true}, {"ownership_collision_rejected", true},
+			{"physical_plane_crashes_disabled", true}}}, {"subsidy_awarded", true}, {"takeover_cost", takeover.GetCost().base()},
+		{"target_before", std::move(target_before)}, {"target_removed", true}};
+}
+
+static json Run(const Request &request, const std::string &save_path)
+{
+	ResetWorld(request);
+	json events = json::array();
+	std::vector<bool> opponent_started(request.opponents.size(), false);
+	bool rl_started = false;
+	bool service_started = false;
+	bool fault_injected = false;
+	bool save_load_complete = false;
+	uint64_t save_bytes = 0;
+	json interaction = nullptr;
+	AirService service;
+	static constexpr uint CHECKPOINT_DAY = 700;
+	Require(std::filesystem::path(save_path).is_absolute() && !std::filesystem::exists(save_path), "save path is invalid or already exists");
+	uint64_t total_ticks = static_cast<uint64_t>(request.calendar_days) * Ticks::DAY_TICKS;
+	for (uint64_t tick = 0; tick < total_ticks;) {
+		uint day = static_cast<uint>(tick / Ticks::DAY_TICKS);
+		if (!rl_started && day >= request.rl_start_delay_days) {
+			StartRl(request, events);
+			rl_started = true;
+			service = StartAirService(request, events);
+			service_started = true;
+		}
+		for (size_t index = 0; index < request.opponents.size(); ++index) {
+			if (!opponent_started[index] && day >= request.opponents[index].start_delay_days) {
+				StartOpponent(request.opponents[index], day, events);
+				opponent_started[index] = true;
+			}
+		}
+		if (request.probe == "fault" && !fault_injected && day >= 10 && opponent_started[0]) {
+			CompanyID target = request.opponents[0].slot;
+			AutoRestoreBackup current(_current_company, OWNER_DEITY);
+			CommandCost removed = Command<CMD_COMPANY_CTRL>::Do(DoCommandFlag::Execute, CCA_DELETE, target, CRR_MANUAL, INVALID_CLIENT_ID);
+			Require(removed.Succeeded() && !Company::IsValidID(target), "opponent fault containment did not remove target company");
+			events.push_back({{"day", day}, {"kind", "opponent_failure_contained"}, {"slot", target.base()}});
+			fault_injected = true;
+		}
+		if (service_started) RlV2SetQualificationAcceptance(service.destination, service.cargo, true);
+		StateGameLoop();
+		if (_pause_mode.Any()) {
+			if (_pause_mode.Test(PauseMode::Normal) &&
+				(_pause_mode.base() == PauseModes{PauseMode::Normal}.base() ||
+					_pause_mode.base() == PauseModes{PauseMode::Normal, PauseMode::CommandDuringPause}.base())) {
+				Require(Command<CMD_PAUSE>::Do(DoCommandFlag::Execute, PauseMode::Normal, false).Succeeded(),
+					"failed to release a native headless competition pause");
+				events.push_back({{"day", day}, {"kind", "headless_pause_released"}});
+				continue;
+			}
+			Require(_pause_mode == PauseMode::LinkGraph,
+				fmt::format("unexpected pause during competition loop: mode={} day={} tick={}", _pause_mode.base(), day, tick));
+			continue;
+		}
+		if (const Aircraft *aircraft = Aircraft::GetIfValid(service.vehicle);
+				aircraft != nullptr && aircraft->vehstatus.Test(VehState::Crashed)) {
+			Fail(fmt::format("RL aircraft crashed at tick={} day={} state={} target={}", tick, day, aircraft->state,
+				aircraft->targetairport.base()));
+		}
+		if (service_started && Vehicle::IsValidID(service.vehicle) &&
+				(Aircraft::Get(service.vehicle)->GetNumOrders() != 2 || Aircraft::Get(service.vehicle)->GetNumManualOrders() != 2)) {
+			Fail(fmt::format("RL aircraft order list disappeared at tick={} day={} orders={} manual_orders={}", tick, day,
+				Aircraft::Get(service.vehicle)->GetNumOrders(), Aircraft::Get(service.vehicle)->GetNumManualOrders()));
+		}
+		if (service_started && (!Vehicle::IsValidID(service.vehicle) || Station::GetIfValid(service.source) == nullptr ||
+				Station::GetIfValid(service.destination) == nullptr)) {
+			const Company *company = Company::GetIfValid(request.rl_slot);
+			Fail(fmt::format("RL air-service assets disappeared at tick={} day={} company_alive={} money={} vehicle_valid={} source_valid={} destination_valid={}",
+				tick, day, company != nullptr, company == nullptr ? 0 : company->money.base(), Vehicle::IsValidID(service.vehicle),
+				Station::GetIfValid(service.source) != nullptr, Station::GetIfValid(service.destination) != nullptr));
+		}
+		bool all_started = rl_started && std::ranges::all_of(opponent_started, std::identity{});
+		bool any_started = rl_started || std::ranges::any_of(opponent_started, std::identity{});
+		if (!save_load_complete && any_started && day >= CHECKPOINT_DAY) {
+			if (request.probe == "interaction") {
+				Require(all_started, "interaction checkpoint lacks a participant");
+				interaction = RunInteraction(request, day, events);
+			}
+			CompanyID checkpoint_company = Company::IsValidID(request.rl_slot) ? request.rl_slot : request.opponents[0].slot;
+			SetLocalCompany(checkpoint_company);
+			_current_company = checkpoint_company;
+			json before_save = PublicSnapshot(request);
+			Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "shared native SAVE failed");
+			Money saved_money = Company::Get(checkpoint_company)->money;
+			Company::Get(checkpoint_company)->money += Money{12345};
+			Require(SaveOrLoad(save_path, SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "shared native LOAD failed");
+			if (_pause_mode.Test(PauseMode::SaveLoad)) {
+				Require(Command<CMD_PAUSE>::Do(DoCommandFlag::Execute, PauseMode::SaveLoad, false).Succeeded(),
+					"failed to release native save/load pause");
+			}
+			if (_pause_mode.Test(PauseMode::Normal)) {
+				Require(Command<CMD_PAUSE>::Do(DoCommandFlag::Execute, PauseMode::Normal, false).Succeeded(),
+					"failed to release native normal pause after load");
+			}
+			Require(_pause_mode.None() || _pause_mode == PauseMode::LinkGraph,
+				fmt::format("native load left an unsupported competition pause: mode={}", _pause_mode.base()));
+			SetLocalCompany(checkpoint_company);
+			_current_company = checkpoint_company;
+			json after_load = PublicSnapshot(request);
+			Require(Company::Get(checkpoint_company)->money == saved_money && before_save == after_load,
+				fmt::format("public shared-company state did not restore exactly across save/load: before={} after={}",
+					before_save.dump(), after_load.dump()));
+			save_bytes = std::filesystem::file_size(save_path);
+			save_load_complete = true;
+		}
+		++tick;
+	}
+	Require(rl_started && service_started && Company::IsValidID(request.rl_slot), "RL company did not survive the shared simulation");
+	Require(save_load_complete && save_bytes > 0, "shared save/load checkpoint did not complete");
+	const Company *rl = Company::Get(request.rl_slot);
+	const Aircraft *rl_aircraft = Aircraft::GetIfValid(service.vehicle);
+	const Station *rl_source = Station::GetIfValid(service.source);
+	const Station *rl_destination = Station::GetIfValid(service.destination);
+	const Order *first_order = rl_aircraft == nullptr ? nullptr : rl_aircraft->GetOrder(VehicleOrderID{0});
+	const Order *second_order = rl_aircraft == nullptr ? nullptr : rl_aircraft->GetOrder(VehicleOrderID{1});
+	Require(DeliveredTotal(rl) >= service.capacity && IncomeTotal(rl) > 0,
+		fmt::format("RL solo competence was not retained in shared simulation: delivered={} capacity={} income={} state={} cargo={} target={} stopped={} tick_counter={} running_ticks={} position={}/{} order_type={} order_destination={} real_index={} first_type={} first_destination={} second_type={} second_destination={} source_waiting={} destination_waiting={}",
+			DeliveredTotal(rl), service.capacity, IncomeTotal(rl).base(), rl_aircraft == nullptr ? 255 : rl_aircraft->state,
+			rl_aircraft == nullptr ? 0 : rl_aircraft->cargo.TotalCount(),
+			rl_aircraft == nullptr ? 255 : rl_aircraft->targetairport.base(),
+			rl_aircraft == nullptr || rl_aircraft->vehstatus.Test(VehState::Stopped),
+			rl_aircraft == nullptr ? 0 : rl_aircraft->tick_counter,
+			rl_aircraft == nullptr ? 0 : rl_aircraft->running_ticks,
+			rl_aircraft == nullptr ? 255 : rl_aircraft->previous_pos,
+			rl_aircraft == nullptr ? 255 : rl_aircraft->pos,
+			rl_aircraft == nullptr ? 255 : to_underlying(rl_aircraft->current_order.GetType()),
+			rl_aircraft == nullptr ? 65535 : rl_aircraft->current_order.GetDestination().base(),
+			rl_aircraft == nullptr ? 255 : rl_aircraft->cur_real_order_index,
+			first_order == nullptr ? 255 : to_underlying(first_order->GetType()),
+			first_order == nullptr ? 65535 : first_order->GetDestination().base(),
+			second_order == nullptr ? 255 : to_underlying(second_order->GetType()),
+			second_order == nullptr ? 65535 : second_order->GetDestination().base(),
+			rl_source == nullptr ? 0 : rl_source->goods[service.cargo].AvailableCount(),
+			rl_destination == nullptr ? 0 : rl_destination->goods[service.cargo].AvailableCount()));
+	if (request.probe == "fault") Require(fault_injected, "fault probe did not inject a participant failure");
+
+	json final_public = PublicSnapshot(request);
+	json policy_observation = {
+		{"public_companies", final_public.at("companies")}, {"public_events", events}, {"public_map", final_public.at("map")},
+		{"schema_version", "openttd-rl-v2-m20-public-observation-1"}, {"self_company_id", request.rl_slot.base()},
+	};
+	json result = {
+		{"events", std::move(events)}, {"fault_contained", request.probe != "fault" || fault_injected},
+		{"interaction", std::move(interaction)}, {"policy_input", std::move(policy_observation)},
+		{"policy_input_fields", {"public_map_state", "public_station_and_vehicle_state", "public_company_state", "own_company_private_state", "public_events"}},
+		{"privileged_inputs", json::array()}, {"save_bytes", save_bytes},
+		{"save_load_public_exact", true}, {"score", Score(request)}, {"ticks", total_ticks},
+	};
+	RlV2ClearQualificationAcceptance();
+	return result;
+}
+
+} // namespace
+
+void RunRlV2CompetitionQualification(const std::string &manifest_path, const std::string &report_path)
+{
+	Request request = Validate(ReadCanonicalJson(manifest_path));
+	try {
+		json result = Run(request, report_path + ".sav");
+		json opponents = json::array();
+		for (const OpponentRequest &opponent : request.opponents) {
+			opponents.push_back({{"name", opponent.name}, {"package_evidence_sha256", opponent.package_evidence_sha256},
+				{"runtime_evidence_sha256", opponent.runtime_evidence_sha256}, {"slot", opponent.slot.base()},
+				{"start_delay_days", opponent.start_delay_days}, {"version", opponent.version}});
+		}
+		json report = {
+			{"engine_source_tree", request.engine_source_tree}, {"executable_sha256", request.executable_sha256},
+			{"identity", {{"competition_manifest_sha256", request.competition_manifest_sha256},
+				{"content_manifest_sha256", request.content_manifest_sha256}, {"m20_contract_sha256", request.m20_contract_sha256},
+				{"map_manifest_sha256", request.map_manifest_sha256}, {"policy_package_sha256", request.policy_package_sha256},
+				{"settings_manifest_sha256", request.settings_manifest_sha256}}},
+			{"request", {{"calendar_days", request.calendar_days}, {"map_seed", request.map_seed}, {"opponents", std::move(opponents)},
+				{"probe", request.probe}, {"rl_slot", request.rl_slot.base()}, {"rl_start_delay_days", request.rl_start_delay_days},
+				{"run_id", request.run_id}, {"simulation_seed", request.simulation_seed}, {"split", request.split}}},
+			{"result", std::move(result)}, {"run_id", request.run_id}, {"schema_version", REPORT_SCHEMA}, {"status", "PASS"},
+		};
+		WriteCanonicalNew(report_path, report);
+	} catch (const std::exception &e) {
+		WriteCanonicalNew(report_path, {{"error", e.what()}, {"status", "FAIL"}});
+		throw;
+	}
+}
