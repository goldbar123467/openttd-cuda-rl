+static void FundCompany(CompanyID company, Money amount)
+{
+	AutoRestoreBackup current(_current_company, OWNER_DEITY);
+	CommandCost result = Command<CMD_CHANGE_BANK_BALANCE>::Do(DoCommandFlag::Execute, TileIndex{}, amount, company, EXPENSES_OTHER);
+	Require(result.Succeeded(), "deity qualification funding failed");
+}
+
+static Company *StartRl(const Request &request, json &events)
+{
+	Company *company = DoStartupNewCompany(false, request.rl_slot);
+	Require(company != nullptr && company->index == request.rl_slot && !company->is_ai, "failed to create RL company in requested slot");
+	SetLocalCompany(request.rl_slot);
+	_current_company = request.rl_slot;
+	FundCompany(request.rl_slot, Money{10000000});
+	events.push_back({{"day", request.rl_start_delay_days}, {"kind", "rl_started"}, {"slot", request.rl_slot.base()}});
+	return company;
+}
+
+static Company *StartOpponent(const OpponentRequest &opponent, uint day, json &events)
+{
+	AIConfig *config = AIConfig::GetConfig(opponent.slot, AIConfig::SSS_FORCE_GAME);
+	Require(config != nullptr, "AI config allocation failed");
+	config->Change(opponent.name, opponent.version, true);
+	Require(config->GetInfo() != nullptr && config->GetInfo()->GetName() == opponent.name && config->GetInfo()->GetVersion() == opponent.version,
+		fmt::format("exact AI package is unavailable: {} v{}", opponent.name, opponent.version));
+	Company *company = DoStartupNewCompany(true, opponent.slot);
+	Require(company != nullptr && company->index == opponent.slot && company->is_ai && company->ai_instance != nullptr,
+		fmt::format("failed to start opponent {}", opponent.name));
+	if (!Company::IsValidID(_local_company)) SetLocalCompany(opponent.slot);
+	events.push_back({{"day", day}, {"kind", "opponent_started"}, {"name", opponent.name}, {"slot", opponent.slot.base()}, {"version", opponent.version}});
+	return company;
+}
