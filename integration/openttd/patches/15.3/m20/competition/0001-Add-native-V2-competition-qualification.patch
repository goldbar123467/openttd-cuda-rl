+static void ResetWorld(const Request &request)
+{
+	Configure(request);
+	_random.SetSeed(request.map_seed);
+	_interactive_random.SetSeed(request.map_seed ^ 0x4d415021U);
+	_game_mode = GM_NORMAL;
+	_switch_mode = SM_NONE;
+	SetModalProgress(false);
+	GenerateWorld(GWM_NEWGAME, MAP_SIDE, MAP_SIDE, false);
+	_random.SetSeed(request.simulation_seed ^ 0x4d323043U);
+	_interactive_random.SetSeed(request.simulation_seed ^ 0x434f4d50U);
+	ScriptObject::InitializeRandomizers();
+	Require(Map::SizeX() == MAP_SIDE && Map::SizeY() == MAP_SIDE, "qualification map has wrong dimensions");
+	Require(Town::GetNumItems() >= 8 && Industry::GetNumItems() >= 4, "shared map lacks generated towns or industries");
+	Require(Company::GetNumItems() == 0, "shared map unexpectedly created companies");
+}
