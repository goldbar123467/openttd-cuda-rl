+static void ResetWorld(const Request &request)
+{
+	Configure(request);
+	_random.SetSeed(request.seed ^ 0x4d313643U);
+	_interactive_random.SetSeed(request.seed ^ 0x524c5632U);
+	_game_mode = GM_NORMAL;
+	_switch_mode = SM_NONE;
+	SetModalProgress(false);
+	GenerateWorld(GWM_EMPTY, MAP_SIDE, MAP_SIDE, false);
+	Require(Map::SizeX() == MAP_SIDE && Map::SizeY() == MAP_SIDE, "empty qualification map has wrong dimensions");
+	{
+		AutoRestoreBackup company(_current_company, OWNER_DEITY);
+		bool built = false;
+		for (uint y = 8; y <= 24 && !built; ++y) {
+			for (uint x = 8; x <= 56 && !built; ++x) {
+				auto [test_cost, test_required, test_id] = Command<CMD_FOUND_TOWN>::Do({}, TileXY(x, y), TSZ_SMALL,
+					false, TL_ORIGINAL, false, 0, std::string("M16 Oracle Town"));
+				(void)test_required; (void)test_id;
+				if (test_cost.Failed()) continue;
+				auto [cost, required_money, town_id] = Command<CMD_FOUND_TOWN>::Do(DoCommandFlag::Execute, TileXY(x, y), TSZ_SMALL,
+					false, TL_ORIGINAL, false, 0, std::string("M16 Oracle Town"));
+				(void)required_money;
+				built = cost.Succeeded() && Town::IsValidID(town_id);
+			}
+		}
+		Require(built, "failed to find any legal qualification-town site");
+	}
+	Company *company = DoStartupNewCompany(false, CompanyID::Begin());
+	Require(company != nullptr && company->index == CompanyID::Begin(), "failed to create qualification company");
+	SetLocalCompany(CompanyID::Begin());
+	_current_company = CompanyID::Begin();
+	CommandCost loan = Command<CMD_INCREASE_LOAN>::Do(DoCommandFlag::Execute, LoanCommand::Max, Money{0});
+	Require(loan.Succeeded(), "failed to fund qualification company");
+}
+
+static json CommandRecord(std::string_view command, const CommandCost &cost)
+{
+	return {{"command", command}, {"cost", cost.Succeeded() ? cost.GetCost().base() : 0},
+		{"error_message_id", static_cast<uint64_t>(cost.GetErrorMessage())}, {"status", cost.Succeeded() ? "SUCCESS" : "REJECTED"}};
+}
+
+static void BuildRoadTile(TileIndex tile, RoadBits bits, json &commands)
+{
+	CommandCost cost = Command<CMD_BUILD_ROAD>::Do(DoCommandFlag::Execute, tile, bits, ROADTYPE_ROAD, DRD_NONE, TownID::Invalid());
+	commands.push_back(CommandRecord("CMD_BUILD_ROAD", cost));
+	Require(cost.Succeeded(), fmt::format("failed to build road tile {}", tile.base()));
+}
+
+static StationID BuildStop(TileIndex tile, RoadStopType type, DiagDirection direction, StationID join, json &commands)
+{
+	std::vector<StationID> before;
+	for (const Station *station : Station::Iterate()) before.push_back(station->index);
+	CommandCost cost = Command<CMD_BUILD_ROAD_STOP>::Do(DoCommandFlag::Execute, tile, 1, 1, type, false, direction,
+		ROADTYPE_ROAD, ROADSTOP_CLASS_DFLT, 0, join, false);
+	commands.push_back(CommandRecord("CMD_BUILD_ROAD_STOP", cost));
+	Require(cost.Succeeded(), fmt::format("failed to build road stop at {}", tile.base()));
+	if (join != NEW_STATION) {
+		Require(Station::IsValidID(join), "joined road stop references an invalid station");
+		return join;
+	}
+	StationID found = StationID::Invalid();
+	for (const Station *station : Station::Iterate()) {
+		if (station->owner == CompanyID::Begin() && std::ranges::find(before, station->index) == before.end()) found = station->index;
+	}
+	Require(Station::IsValidID(found), "new road stop has no station identity");
+	return found;
+}
+
+static Route BuildRoute(RoadStopType type, bool with_middle, json &commands)
+{
+	for (uint x = 9; x <= 54; ++x) {
+		RoadBits bits = ROAD_X;
+		if (x == 20) bits |= ROAD_SE;
+		if (with_middle && x == 32) bits |= ROAD_NW;
+		BuildRoadTile(TileXY(x, 32), bits, commands);
+	}
+	StationID source = BuildStop(TileXY(8, 32), type, DIAGDIR_SW, NEW_STATION, commands);
+	StationID destination = BuildStop(TileXY(55, 32), type, DIAGDIR_NE, NEW_STATION, commands);
+	StationID middle = StationID::Invalid();
+	if (with_middle) middle = BuildStop(TileXY(32, 31), type, DIAGDIR_SE, NEW_STATION, commands);
+	TileIndex depot = TileXY(20, 33);
+	CommandCost depot_cost = Command<CMD_BUILD_ROAD_DEPOT>::Do(DoCommandFlag::Execute, depot, ROADTYPE_ROAD, DIAGDIR_NW);
+	commands.push_back(CommandRecord("CMD_BUILD_ROAD_DEPOT", depot_cost));
+	Require(depot_cost.Succeeded(), "failed to build road depot");
+	return {source, destination, middle, depot};
+}
+
+static Route BuildCoordinatedRoute(json &commands)
+{
+	for (uint x = 9; x <= 54; ++x) {
+		RoadBits bits = ROAD_X;
+		if (x == 9 || x == 54) bits |= ROAD_NW;
+		if (x == 32) bits |= ROAD_SE;
+		BuildRoadTile(TileXY(x, 32), bits, commands);
+	}
+	StationID source = BuildStop(TileXY(8, 32), RoadStopType::Bus, DIAGDIR_SW, NEW_STATION, commands);
+	StationID destination = BuildStop(TileXY(55, 32), RoadStopType::Bus, DIAGDIR_NE, NEW_STATION, commands);
+	Require(BuildStop(TileXY(9, 31), RoadStopType::Truck, DIAGDIR_SE, source, commands) == source, "source facilities did not join");
+	Require(BuildStop(TileXY(54, 31), RoadStopType::Truck, DIAGDIR_SE, destination, commands) == destination, "destination facilities did not join");
+	TileIndex depot = TileXY(32, 33);
+	CommandCost depot_cost = Command<CMD_BUILD_ROAD_DEPOT>::Do(DoCommandFlag::Execute, depot, ROADTYPE_ROAD, DIAGDIR_NW);
+	commands.push_back(CommandRecord("CMD_BUILD_ROAD_DEPOT", depot_cost));
+	Require(depot_cost.Succeeded(), "failed to build coordination depot");
+	return {source, destination, StationID::Invalid(), depot};
+}
+
+static EngineID FindAndBuildVehicle(TileIndex depot, CargoType cargo, json &commands, VehicleID &vehicle_id, uint16_t &refit_capacity)
+{
+	for (const Engine *engine : Engine::IterateType(VEH_ROAD)) {
+		if (!engine->company_avail.Test(CompanyID::Begin()) || !engine->CanCarryCargo()) continue;
+		if (!HasBit(GetUnionOfArticulatedRefitMasks(engine->index, true), cargo)) continue;
+		auto result = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, depot, engine->index, true, cargo, INVALID_CLIENT_ID);
+		commands.push_back(CommandRecord("CMD_BUILD_VEHICLE", std::get<0>(result)));
+		if (std::get<0>(result).Failed()) continue;
+		vehicle_id = std::get<1>(result);
+		refit_capacity = std::get<2>(result);
+		const Vehicle *vehicle = Vehicle::Get(vehicle_id);
+		Require(vehicle->cargo_type == cargo && vehicle->cargo_cap > 0, "built road vehicle has wrong cargo or zero capacity");
+		return engine->index;
+	}
+	Fail(fmt::format("no buildable road vehicle for cargo {}", CargoText(cargo)));
+}
+
+static void SetOrders(VehicleID vehicle, std::span<const StationID> stations, std::optional<size_t> transfer_ordinal, json &commands)
+{
+	for (size_t ordinal = 0; ordinal < stations.size(); ++ordinal) {
+		Order order;
+		order.MakeGoToStation(stations[ordinal]);
+		order.SetStopLocation(OrderStopLocation::FarEnd);
+		if (transfer_ordinal.has_value() && *transfer_ordinal == ordinal) {
+			order.SetUnloadType(OrderUnloadType::Transfer);
+			order.SetLoadType(OrderLoadType::NoLoad);
+		}
+		CommandCost cost = Command<CMD_INSERT_ORDER>::Do(DoCommandFlag::Execute, vehicle, VehicleOrderID{static_cast<uint8_t>(ordinal)}, order);
+		commands.push_back(CommandRecord("CMD_INSERT_ORDER", cost));
+		Require(cost.Succeeded(), "failed to insert road-vehicle order");
+	}
+}
+
+static void StartVehicle(VehicleID vehicle, json &commands)
+{
+	CommandCost cost = Command<CMD_START_STOP_VEHICLE>::Do(DoCommandFlag::Execute, vehicle, false);
+	commands.push_back(CommandRecord("CMD_START_STOP_VEHICLE", cost));
+	Require(cost.Succeeded(), "failed to start road vehicle");
+}
+
+static void InjectCargo(StationID station_id, CargoType cargo, uint amount, Source source)
+{
+	Require(CargoPacket::CanAllocateItem(), "cargo packet pool is full");
+	Station *station = Station::Get(station_id);
+	GoodsEntry &goods = station->goods[cargo];
+	goods.rating = 255;
+	goods.status.Set(GoodsEntry::State::Rating);
+	goods.GetOrCreateData().cargo.Append(new CargoPacket(station_id, static_cast<uint16_t>(amount), source), StationID::Invalid());
+}
+
+static void SetDestinationAcceptance(StationID station_id, CargoType cargo, bool town_sink)
+{
+	RlV2SetQualificationAcceptance(station_id, cargo, town_sink);
+	Station *station = Station::Get(station_id);
+	station->goods[cargo].status.Set(GoodsEntry::State::Acceptance);
+	if (town_sink) SetBit(station->always_accepted, cargo);
+}
+
+static std::optional<IndustryType> FindProducer(CargoType cargo, LandscapeType climate)
+{
+	for (IndustryType type = 0; type < NEW_INDUSTRYOFFSET; ++type) {
+		const IndustrySpec *spec = GetIndustrySpec(type);
+		if (!spec->enabled || !spec->climate_availability.Test(climate)) continue;
+		if (std::ranges::find(spec->produced_cargo, cargo) != spec->produced_cargo.end()) return type;
+	}
+	return std::nullopt;
+}
+
+static std::optional<IndustryType> FindConsumer(CargoType cargo, LandscapeType climate)
+{
+	for (IndustryType type = 0; type < NEW_INDUSTRYOFFSET; ++type) {
+		const IndustrySpec *spec = GetIndustrySpec(type);
+		if (!spec->enabled || !spec->climate_availability.Test(climate)) continue;
+		if (std::ranges::find(spec->accepts_cargo, cargo) != spec->accepts_cargo.end()) return type;
+	}
+	return std::nullopt;
+}
+
+static Industry *MakeIndustry(IndustryType type)
+{
+	Require(Industry::CanAllocateItem(), "industry pool is full");
+	Industry *industry = new Industry();
+	industry->type = type;
+	industry->town = Town::Get(TownID{0});
+	industry->owner = OWNER_NONE;
+	industry->prod_level = PRODLEVEL_DEFAULT;
+	industry->last_prod_year = TimerGameEconomy::year;
+	industry->ctlflags.Set({IndustryControlFlag::NoProductionDecrease, IndustryControlFlag::NoClosure, IndustryControlFlag::ExternalProdLevel});
+	const IndustrySpec *spec = GetIndustrySpec(type);
+	size_t accepted_count = 0;
+	for (size_t index = 0; index < spec->accepts_cargo.size(); ++index) if (IsValidCargoType(spec->accepts_cargo[index])) accepted_count = index + 1;
+	for (size_t index = 0; index < accepted_count; ++index) industry->accepted.push_back({spec->accepts_cargo[index]});
+	size_t produced_count = 0;
+	for (size_t index = 0; index < spec->produced_cargo.size(); ++index) if (IsValidCargoType(spec->produced_cargo[index])) produced_count = index + 1;
+	for (size_t index = 0; index < produced_count; ++index) industry->produced.push_back({spec->produced_cargo[index], 0, spec->production_rate[index], {}});
+	return industry;
+}
+
+static json PaymentEvents()
+{
+	json result = json::array();
+	for (const RlV2CargoPaymentEvent &event : RlV2GetCargoPaymentEvents()) {
+		result.push_back({{"base_income", event.base_income.base()}, {"cargo", CargoText(event.cargo)}, {"count", event.count},
+			{"distance", event.distance}, {"feeder_share", event.feeder_share.base()}, {"final_income", event.final_income.base()},
+			{"periods_in_transit", event.periods_in_transit}, {"station", event.station.base()}, {"transfer", event.transfer}});
+	}
+	return result;
+}
+
+static json RunSingleLeg(const Request &request, CargoType cargo, bool create_subsidy)
+{
+	json commands = json::array();
+	RoadStopType stop_type = IsCargoInClass(cargo, CargoClass::Passengers) ? RoadStopType::Bus : RoadStopType::Truck;
+	Route route = BuildRoute(stop_type, false, commands);
+	Station *destination_station = Station::Get(route.destination);
+	std::optional<IndustryType> producer = FindProducer(cargo, request.climate);
+	std::optional<IndustryType> consumer = FindConsumer(cargo, request.climate);
+	Industry *source_industry = producer.has_value() ? MakeIndustry(*producer) : nullptr;
+	Industry *destination_industry = consumer.has_value() ? MakeIndustry(*consumer) : nullptr;
+	Source source = source_industry != nullptr ? Source{source_industry->index, SourceType::Industry} : Source{Town::Get(TownID{0})->index, SourceType::Town};
+	if (destination_industry != nullptr) destination_station->industries_near.insert({0, destination_industry});
+	bool town_sink = destination_industry == nullptr;
+	Subsidy *subsidy = nullptr;
+	if (create_subsidy) {
+		Require(source_industry != nullptr && destination_industry != nullptr, "subsidy probe needs industry source and destination");
+		Require(Subsidy::CanAllocateItem(), "subsidy pool is full");
+		subsidy = new Subsidy(cargo, source, {destination_industry->index, SourceType::Industry}, SUBSIDY_OFFER_MONTHS);
+		RebuildSubsidisedSourceAndDestinationCache();
+	}
+	VehicleID vehicle_id = VehicleID::Invalid();
+	uint16_t refit_capacity = 0;
+	EngineID engine = FindAndBuildVehicle(route.depot, cargo, commands, vehicle_id, refit_capacity);
+	std::array<StationID, 2> orders{route.source, route.destination};
+	SetOrders(vehicle_id, orders, std::nullopt, commands);
+	InjectCargo(route.source, cargo, request.amount, source);
+	SetDestinationAcceptance(route.destination, cargo, town_sink);
+	Company *company = Company::Get(CompanyID::Begin());
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	Money income_before = company->cur_economy.income;
+	uint16_t accepted_before = destination_industry == nullptr ? 0 : destination_industry->GetCargoAccepted(cargo)->GetOrCreateHistory()[THIS_MONTH].accepted;
+	std::vector<uint16_t> produced_before;
+	if (destination_industry != nullptr) for (const auto &slot : destination_industry->produced) produced_before.push_back(slot.waiting);
+	RlV2ClearCargoPaymentEvents();
+	StartVehicle(vehicle_id, commands);
+	uint64_t ticks = 0;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(route.destination, cargo, town_sink);
+		StateGameLoop();
+		++ticks;
+	}
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	Money income = company->cur_economy.income - income_before;
+	Require(delivered > 0 && income > 0, fmt::format("native single-leg service did not deliver profitably: delivered={}, income={}, ticks={}, vehicle_tile={}, vehicle_status={}, vehicle_cargo={}, events={}",
+		delivered, income.base(), ticks, Vehicle::Get(vehicle_id)->tile.base(), Vehicle::Get(vehicle_id)->vehstatus.base(),
+		Vehicle::Get(vehicle_id)->cargo.StoredCount(), RlV2GetCargoPaymentEvents().size()));
+	Require(!RlV2GetCargoPaymentEvents().empty() && !RlV2GetCargoPaymentEvents().back().transfer, "single-leg delivery emitted no final payment event");
+	const auto &payment = RlV2GetCargoPaymentEvents().back();
+	Require(payment.final_income == income, "native payment event and company income diverged");
+	if (!create_subsidy) Require(payment.final_income == payment.base_income, "unsubsidized delivery changed base income");
+	if (create_subsidy) Require(subsidy != nullptr && subsidy->awarded == CompanyID::Begin() && payment.final_income == payment.base_income * 2,
+		"subsidy was not awarded with exact 2x native payment");
+	json production = json::array();
+	if (destination_industry != nullptr) {
+		for (size_t index = 0; index < destination_industry->produced.size(); ++index) {
+			production.push_back({{"after", destination_industry->produced[index].waiting}, {"before", produced_before[index]},
+				{"cargo", CargoText(destination_industry->produced[index].cargo)}});
+		}
+	}
+	const Vehicle *vehicle = Vehicle::Get(vehicle_id);
+	json result = {
+		{"accounting", {{"company_income_delta", income.base()}, {"delivered_delta", delivered}, {"payment_events", PaymentEvents()}}},
+		{"commands", std::move(commands)},
+		{"destination", {{"accepted_industry_delta", destination_industry == nullptr ? 0 : destination_industry->GetCargoAccepted(cargo)->GetOrCreateHistory()[THIS_MONTH].accepted - accepted_before},
+			{"industry", consumer.has_value() ? INDUSTRY_NAMES[*consumer] : "town-always-accepted"}, {"production", std::move(production)}, {"station", route.destination.base()}}},
+		{"source", {{"industry", producer.has_value() ? INDUSTRY_NAMES[*producer] : "town"}, {"station", route.source.base()}}},
+		{"ticks", ticks},
+		{"vehicle", {{"capacity", vehicle->cargo_cap}, {"cargo", CargoText(vehicle->cargo_type)}, {"engine", engine.base()},
+			{"id", vehicle_id.base()}, {"refit_capacity", refit_capacity}, {"running", !vehicle->vehstatus.Test(VehState::Stopped)}}},
+	};
+	if (destination_industry != nullptr) destination_station->industries_near.clear();
+	RlV2ClearQualificationAcceptance();
+	if (subsidy != nullptr) delete subsidy;
+	delete destination_industry;
+	delete source_industry;
+	return result;
+}
+
+static json RunCoordination(const Request &request)
+{
+	CargoType passengers = GetCargoTypeByLabel(LabelFromText("PASS"));
+	CargoType mail = GetCargoTypeByLabel(LabelFromText("MAIL"));
+	Require(IsValidCargoType(passengers) && IsValidCargoType(mail), "coordination cargos are unavailable");
+	json commands = json::array();
+	Route route = BuildCoordinatedRoute(commands);
+	VehicleID bus = VehicleID::Invalid(), mail_truck = VehicleID::Invalid();
+	uint16_t bus_refit = 0, mail_refit = 0;
+	EngineID bus_engine = FindAndBuildVehicle(route.depot, passengers, commands, bus, bus_refit);
+	EngineID mail_engine = FindAndBuildVehicle(route.depot, mail, commands, mail_truck, mail_refit);
+	std::array<StationID, 2> orders{route.source, route.destination};
+	SetOrders(bus, orders, std::nullopt, commands);
+	SetOrders(mail_truck, orders, std::nullopt, commands);
+	Source town_source{Town::Get(TownID{0})->index, SourceType::Town};
+	InjectCargo(route.source, passengers, request.amount, town_source);
+	InjectCargo(route.source, mail, request.amount, town_source);
+	Company *company = Company::Get(CompanyID::Begin());
+	uint32_t pax_before = company->cur_economy.delivered_cargo[passengers];
+	uint32_t mail_before = company->cur_economy.delivered_cargo[mail];
+	Money income_before = company->cur_economy.income;
+	RlV2ClearCargoPaymentEvents();
+	StartVehicle(bus, commands);
+	StartVehicle(mail_truck, commands);
+	uint64_t ticks = 0;
+	while ((company->cur_economy.delivered_cargo[passengers] == pax_before || company->cur_economy.delivered_cargo[mail] == mail_before || company->cur_economy.income <= income_before) && ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(route.destination, passengers, true);
+		SetDestinationAcceptance(route.destination, mail, true);
+		StateGameLoop();
+		++ticks;
+	}
+	Money expected_income{};
+	for (const auto &event : RlV2GetCargoPaymentEvents()) if (!event.transfer) expected_income += event.final_income;
+	while (company->cur_economy.income - income_before < expected_income && ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(route.destination, passengers, true);
+		SetDestinationAcceptance(route.destination, mail, true);
+		StateGameLoop();
+		++ticks;
+	}
+	uint32_t pax = company->cur_economy.delivered_cargo[passengers] - pax_before;
+	uint32_t delivered_mail = company->cur_economy.delivered_cargo[mail] - mail_before;
+	Money income = company->cur_economy.income - income_before;
+	Require(pax > 0 && delivered_mail > 0 && income > 0, "coordinated passenger/mail service was not profitable for both cargos");
+	Require(income == expected_income, "coordinated passenger/mail company income diverged from final-payment events");
+	Require(Station::Get(route.source)->facilities.All({StationFacility::BusStop, StationFacility::TruckStop}) &&
+		Station::Get(route.destination)->facilities.All({StationFacility::BusStop, StationFacility::TruckStop}), "coordination stations are not shared bus/truck stations");
+	json vehicles = json::array({
+		{{"cargo", "PASS"}, {"engine", bus_engine.base()}, {"id", bus.base()}, {"refit_capacity", bus_refit}},
+		{{"cargo", "MAIL"}, {"engine", mail_engine.base()}, {"id", mail_truck.base()}, {"refit_capacity", mail_refit}},
+	});
+	RlV2ClearQualificationAcceptance();
+	return {{"accounting", {{"company_income_delta", income.base()}, {"delivered_mail", delivered_mail}, {"delivered_passengers", pax},
+		{"payment_events", PaymentEvents()}}}, {"commands", std::move(commands)}, {"shared_stations", true}, {"ticks", ticks},
+		{"vehicles", std::move(vehicles)}};
+}
+
+static json RunTransfer(const Request &request, CargoType cargo)
+{
+	Require(!IsCargoInClass(cargo, CargoClass::Passengers), "transfer probe requires a non-passenger road cargo");
+	json commands = json::array();
+	Route route = BuildRoute(RoadStopType::Truck, true, commands);
+	VehicleID first = VehicleID::Invalid(), second = VehicleID::Invalid();
+	uint16_t first_refit = 0, second_refit = 0;
+	EngineID first_engine = FindAndBuildVehicle(route.depot, cargo, commands, first, first_refit);
+	EngineID second_engine = FindAndBuildVehicle(route.depot, cargo, commands, second, second_refit);
+	std::array<StationID, 2> first_orders{route.source, route.middle};
+	SetOrders(first, first_orders, 1, commands);
+	std::array<StationID, 2> second_orders{route.middle, route.destination};
+	SetOrders(second, second_orders, std::nullopt, commands);
+	Source source{Town::Get(TownID{0})->index, SourceType::Town};
+	InjectCargo(route.source, cargo, request.amount, source);
+	Company *company = Company::Get(CompanyID::Begin());
+	Money income_before = company->cur_economy.income;
+	uint32_t delivered_before = company->cur_economy.delivered_cargo[cargo];
+	RlV2ClearCargoPaymentEvents();
+	StartVehicle(first, commands);
+	uint64_t transfer_ticks = 0;
+	while ((std::ranges::none_of(RlV2GetCargoPaymentEvents(), [](const auto &event) { return event.transfer; }) ||
+			Station::Get(route.middle)->goods[cargo].AvailableCount() == 0) && transfer_ticks < TICK_LIMIT) {
+		StateGameLoop();
+		++transfer_ticks;
+	}
+	Require(std::ranges::any_of(RlV2GetCargoPaymentEvents(), [](const auto &event) { return event.transfer; }), "first leg emitted no transfer payment");
+	Require(company->cur_economy.income == income_before && company->cur_economy.delivered_cargo[cargo] == delivered_before,
+		"transfer changed company income or final-delivery count");
+	uint transfer_waiting = Station::Get(route.middle)->goods[cargo].AvailableCount();
+	Require(transfer_waiting > 0, "transferred cargo is not waiting at shared station");
+	StartVehicle(second, commands);
+	uint64_t final_ticks = 0;
+	while ((company->cur_economy.delivered_cargo[cargo] == delivered_before || company->cur_economy.income <= income_before) && final_ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(route.destination, cargo, true);
+		StateGameLoop();
+		++final_ticks;
+	}
+	Money expected_final_income{};
+	for (const auto &event : RlV2GetCargoPaymentEvents()) if (!event.transfer) expected_final_income += event.final_income;
+	while (company->cur_economy.income - income_before < expected_final_income && final_ticks < TICK_LIMIT) {
+		SetDestinationAcceptance(route.destination, cargo, true);
+		StateGameLoop();
+		++final_ticks;
+	}
+	Money final_income = company->cur_economy.income - income_before;
+	uint32_t delivered = company->cur_economy.delivered_cargo[cargo] - delivered_before;
+	Require(final_income > 0 && delivered > 0, "transferred cargo was not finally delivered profitably");
+	Require(final_income == expected_final_income, "transfer probe company income diverged from the final-payment event");
+	size_t final_count = std::ranges::count_if(RlV2GetCargoPaymentEvents(), [](const auto &event) { return !event.transfer; });
+	Require(final_count == 1, "transfer probe emitted duplicate final-payment events");
+	RlV2ClearQualificationAcceptance();
+	return {{"commands", std::move(commands)}, {"final", {{"company_income_delta", final_income.base()}, {"delivered_delta", delivered},
+		{"ticks", final_ticks}}}, {"first_leg", {{"company_income_delta", 0}, {"engine", first_engine.base()},
+		{"ticks", transfer_ticks}, {"transfer_waiting", transfer_waiting}}}, {"payment_events", PaymentEvents()},
+		{"second_engine", second_engine.base()}, {"single_final_payment", true}};
+}
+
+static json CargoCatalog()
+{
+	json cargos = json::array();
+	for (const CargoSpec *spec : CargoSpec::Iterate()) {
+		json classes = json::array();
+		for (size_t index = 0; index < CARGO_CLASS_NAMES.size(); ++index) {
+			if (spec->classes.Test(static_cast<CargoClass>(index))) classes.push_back(CARGO_CLASS_NAMES[index]);
+		}
+		cargos.push_back({{"bitnum", spec->bitnum}, {"classes", std::move(classes)}, {"freight", spec->is_freight},
+			{"initial_payment", spec->initial_payment}, {"label", LabelText(spec->label)}, {"slot", spec->Index()},
+			{"transit_periods", {spec->transit_periods[0], spec->transit_periods[1]}}, {"weight_sixteenth_ton", spec->weight}});
+	}
+	return cargos;
+}
+
+static json IndustryCatalogAndProduction(LandscapeType climate)
+{
+	json industries = json::array();
+	json transitions = json::array();
+	for (IndustryType type = 0; type < NEW_INDUSTRYOFFSET; ++type) {
+		const IndustrySpec *spec = GetIndustrySpec(type);
+		if (!spec->enabled || !spec->climate_availability.Test(climate)) continue;
+		json accepted = json::array(), produced = json::array();
+		size_t accepted_count = 0, produced_count = 0;
+		for (size_t index = 0; index < spec->accepts_cargo.size(); ++index) if (IsValidCargoType(spec->accepts_cargo[index])) accepted_count = index + 1;
+		for (size_t index = 0; index < spec->produced_cargo.size(); ++index) if (IsValidCargoType(spec->produced_cargo[index])) produced_count = index + 1;
+		for (size_t index = 0; index < accepted_count; ++index) accepted.push_back(CargoText(spec->accepts_cargo[index]));
+		for (size_t index = 0; index < produced_count; ++index) {
+			CargoType cargo = spec->produced_cargo[index];
+			produced.push_back({{"cargo", CargoText(cargo)}, {"rate", spec->production_rate[index]}});
+		}
+		for (size_t input = 0; input < accepted_count; ++input) {
+			if (!IsValidCargoType(spec->accepts_cargo[input])) continue;
+			for (size_t output = 0; output < produced_count; ++output) {
+				if (!IsValidCargoType(spec->produced_cargo[output])) continue;
+				uint16_t multiplier = spec->input_cargo_multiplier[input][output];
+				if (multiplier == 0) continue;
+				Industry oracle;
+				oracle.type = type;
+				for (size_t index = 0; index < accepted_count; ++index) oracle.accepted.push_back({spec->accepts_cargo[index]});
+				for (size_t index = 0; index < produced_count; ++index) oracle.produced.push_back({spec->produced_cargo[index]});
+				oracle.accepted[input].waiting = 256;
+				RlV2ProcessIndustryInputForQualification(&oracle);
+				Require(oracle.accepted[input].waiting == 0 && oracle.produced[output].waiting == multiplier,
+					"shared native industry-production core diverged from declared multiplier");
+				transitions.push_back({{"accepted", CargoText(spec->accepts_cargo[input])}, {"consumed", 256}, {"industry_id", type},
+					{"industry_name", INDUSTRY_NAMES[type]}, {"multiplier_256", multiplier}, {"produced", CargoText(spec->produced_cargo[output])},
+					{"produced_amount", oracle.produced[output].waiting}});
+			}
+		}
+		industries.push_back({{"accepted", std::move(accepted)}, {"behaviour_bits", spec->behaviour.base()},
+			{"industry_id", type}, {"life_type_bits", spec->life_type.base()}, {"name", INDUSTRY_NAMES[type]},
+			{"produced", std::move(produced)}});
+	}
+	return {{"industries", std::move(industries)}, {"production_transitions", std::move(transitions)}};
+}
+
+static json LifecycleAndEconomyOracle(LandscapeType climate)
+{
+	size_t before = Industry::GetNumItems();
+	IndustryType type = 0;
+	while (type < NEW_INDUSTRYOFFSET && !GetIndustrySpec(type)->climate_availability.Test(climate)) ++type;
+	Require(type < NEW_INDUSTRYOFFSET, "climate has no industry for closure oracle");
+	Require(Industry::CanAllocateItem(), "industry pool is full during closure oracle");
+	Industry *industry = new Industry();
+	industry->type = type;
+	size_t during = Industry::GetNumItems();
+	delete industry;
+	size_t after = Industry::GetNumItems();
+	Require(during == before + 1 && after == before, "industry pool allocation/closure lifecycle did not round-trip");
+	int16_t saved_fluct = _economy.fluct;
+	_economy.fluct = 100;
+	bool normal = !EconomyIsInRecession();
+	_economy.fluct = -1;
+	bool recession = EconomyIsInRecession();
+	_economy.fluct = saved_fluct;
+	Require(normal && recession, "native recession transition oracle failed");
+	DistributionType old_default = _settings_game.linkgraph.distribution_default;
+	_settings_game.linkgraph.distribution_default = DT_ASYMMETRIC;
+	bool asymmetric = _settings_game.linkgraph.distribution_default == DT_ASYMMETRIC;
+	_settings_game.linkgraph.distribution_default = DT_SYMMETRIC;
+	bool symmetric = _settings_game.linkgraph.distribution_default == DT_SYMMETRIC;
+	_settings_game.linkgraph.distribution_default = old_default;
+	Require(asymmetric && symmetric && old_default == DT_MANUAL, "cargo-distribution setting transition oracle failed");
+	return {{"cargo_distribution", {{"asymmetric_observed", asymmetric}, {"restored_manual", true}, {"symmetric_observed", symmetric}}},
+		{"economy", {{"normal_observed", normal}, {"recession_observed", recession}}},
+		{"industry_closure", {{"after", after}, {"before", before}, {"during", during}, {"exact_pool_roundtrip", true},
+			{"industry_id", type}, {"industry_name", INDUSTRY_NAMES[type]}}}};
+}
+
+} // namespace
+
+void RunRlV2CargoQualification(const std::string &manifest_path, const std::string &report_path)
+{
+	Request request = Validate(ReadCanonicalJson(manifest_path));
+	ResetWorld(request);
+	CargoType cargo = GetCargoTypeByLabel(LabelFromText(request.cargo_label));
+	if (request.probe != "coordination" && request.probe != "catalog") {
+		Require(IsValidCargoType(cargo), fmt::format("cargo {} is unavailable in {}", request.cargo_label, request.climate_name));
+	}
+	json catalog = CargoCatalog();
+	json industry = IndustryCatalogAndProduction(request.climate);
+	json probe;
+	if (request.probe == "catalog") probe = {{"status", "CATALOG_ONLY"}};
+	else if (request.probe == "single-leg") probe = RunSingleLeg(request, cargo, false);
+	else if (request.probe == "coordination") probe = RunCoordination(request);
+	else if (request.probe == "transfer") probe = RunTransfer(request, cargo);
+	else probe = RunSingleLeg(request, cargo, true);
+	json report = {
+		{"schema_version", REPORT_SCHEMA},
+		{"cargo_catalog", std::move(catalog)},
+		{"climate", request.climate_name},
+		{"executable_sha256", request.executable_sha256},
+		{"industry_graph", std::move(industry)},
+		{"lifecycle_and_economy", LifecycleAndEconomyOracle(request.climate)},
+		{"probe", std::move(probe)},
+		{"request", {{"amount", request.amount}, {"cargo_label", request.cargo_label}, {"probe", request.probe},
+			{"run_id", request.run_id}, {"seed", request.seed}}},
+		{"run_id", request.run_id},
+		{"status", "PASS"},
+	};
+	WriteCanonicalNew(report_path, report);
+}
