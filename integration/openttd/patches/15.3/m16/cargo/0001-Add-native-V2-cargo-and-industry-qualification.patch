+void RlV2SetQualificationAcceptance(StationID station, CargoType cargo, bool always_accepted)
+{
+	if (_rl_v2_acceptance_station != station) {
+		_rl_v2_acceptance_cargos = {};
+		_rl_v2_acceptance_always = {};
+	}
+	_rl_v2_acceptance_station = station;
+	SetBit(_rl_v2_acceptance_cargos, cargo);
+	if (always_accepted) SetBit(_rl_v2_acceptance_always, cargo);
+}
