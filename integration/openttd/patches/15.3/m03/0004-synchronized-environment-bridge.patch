+std::string BuildRlEnvironmentBridgeSnapshot()
+{
+	Require(bridge_spec != nullptr, "bridge snapshot requested before reset");
+	Require(Company::GetNumItems() == 1, "bridge snapshot company count is not one");
+	Require(Vehicle::GetNumItems() <= 1, "bridge snapshot vehicle count exceeds the M03 fixture bound");
+	Company *company = Company::Get(CompanyID::Begin());
+	CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+	Require(IsValidCargoType(passengers), "passenger cargo label is unavailable");
+
+	json vehicle = nullptr;
+	if (Vehicle::GetNumItems() == 1) {
+		const Vehicle *item = Vehicle::Get(VehicleID{0});
+		Require(item->type == VEH_ROAD, "M03 fixture vehicle is not a road vehicle");
+		vehicle = {
+			{"capacity", item->cargo_cap},
+			{"cargo_stored", item->cargo.StoredCount()},
+			{"crashed", item->vehstatus.Test(VehState::Crashed)},
+			{"engine_id", item->engine_type.base()},
+			{"id", item->index.base()},
+			{"last_station_id", item->last_station_visited.base()},
+			{"order_type", to_underlying(item->current_order.GetType())},
+			{"running", !item->vehstatus.Test(VehState::Stopped)},
+			{"tile", item->tile.base()},
+		};
+	}
+
+	return json({
+		{"company", {
+			{"balance", company->money.base()},
+			{"delivered_passengers", company->cur_economy.delivered_cargo[passengers]},
+			{"expenses", company->cur_economy.expenses.base()},
+			{"id", company->index.base()},
+			{"income", company->cur_economy.income.base()},
+		}},
+		{"pools", {
+			{"cargo_packets", CargoPacket::GetNumItems()},
+			{"companies", Company::GetNumItems()},
+			{"depots", Depot::GetNumItems()},
+			{"stations", Station::GetNumItems()},
+			{"towns", Town::GetNumItems()},
+			{"vehicles", Vehicle::GetNumItems()},
+		}},
+		{"scenario", {
+			{"interactive_rng", {_interactive_random.state[0], _interactive_random.state[1]}},
+			{"scenario_sha256", bridge_spec->scenario_sha256},
+			{"seed", bridge_spec->seed},
+			{"simulation_rng", {_random.state[0], _random.state[1]}},
+			{"split", bridge_spec->split},
+			{"template_id", bridge_spec->id},
+		}},
+		{"tick", TimerGameTick::counter},
+		{"vehicle", std::move(vehicle)},
+	}).dump();
+}
+
+void ApplyRlEnvironmentBridgeScriptedBusSetup()
+{
+	Require(bridge_spec != nullptr, "bridge scripted setup requested before reset");
+	Require(Vehicle::GetNumItems() == 0 && Station::GetNumItems() == 0 && Depot::GetNumItems() == 0,
+		"bridge scripted setup may execute exactly once");
+	json actions = json::array();
+	ApplyScriptedBusSetup(*bridge_spec, actions);
+	Require(actions.size() == 8, "bridge scripted setup did not execute exactly eight commands");
+}
