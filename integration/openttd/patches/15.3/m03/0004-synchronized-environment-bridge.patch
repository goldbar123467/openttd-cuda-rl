+std::string ResetRlEnvironmentBridgeScenario(const std::string &instance_path)
+{
+	json instance = ReadCanonicalInstance(instance_path);
+	const TemplateSpec &spec = ValidateInstance(instance);
+	try {
+		scenario_active = true;
+		SetModalProgress(false);
+		Materialize(spec);
+		scenario_active = false;
+		bridge_spec = &spec;
+		return json({
+			{"scenario_sha256", spec.scenario_sha256},
+			{"seed", spec.seed},
+			{"split", spec.split},
+			{"template_id", spec.id},
+		}).dump();
+	} catch (...) {
+		scenario_active = false;
+		bridge_spec = nullptr;
+		throw;
+	}
+}
