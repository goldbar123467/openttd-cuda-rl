+static json RunGameScript(const Request &request, const std::string &save_path)
+{
+	auto towns = ResetWorld(request);
+	Require(Game::GetInstance() != nullptr && Game::GetInfo() != nullptr, "pinned Game Script fixture is not running");
+	json commands = json::array();
+	GoalID goal;
+	StoryPageID page;
+	StoryPageElementID element;
+	LeagueTableID table;
+	LeagueTableElementID league_element;
+	{
+		AutoRestoreBackup deity(_current_company, OWNER_DEITY);
+		auto [goal_cost, goal_id] = Command<CMD_CREATE_GOAL>::Do(DoCommandFlag::Execute, CompanyID::Begin(), GT_TOWN,
+			towns[0].base(), RawText("M21 service goal"));
+		commands.push_back(CommandStatus("CMD_CREATE_GOAL", goal_cost));
+		Require(goal_cost.Succeeded(), "Game Script goal creation failed");
+		goal = goal_id;
+		CommandCost progress = Command<CMD_SET_GOAL_PROGRESS>::Do(DoCommandFlag::Execute, goal, RawText("1/2"));
+		CommandCost completed = Command<CMD_SET_GOAL_COMPLETED>::Do(DoCommandFlag::Execute, goal, true);
+		commands.push_back(CommandStatus("CMD_SET_GOAL_PROGRESS", progress));
+		commands.push_back(CommandStatus("CMD_SET_GOAL_COMPLETED", completed));
+		Require(progress.Succeeded() && completed.Succeeded(), "Game Script goal update failed");
+		CommandCost question = Command<CMD_GOAL_QUESTION>::Do(DoCommandFlag::Execute, 2101, CompanyID::Begin().base(), false,
+			1U << 0, GQT_QUESTION, RawText("Continue?"));
+		commands.push_back(CommandStatus("CMD_GOAL_QUESTION", question));
+		Require(question.Succeeded(), "Game Script question failed");
+
+		auto [page_cost, page_id] = Command<CMD_CREATE_STORY_PAGE>::Do(DoCommandFlag::Execute, CompanyID::Begin(),
+			RawText("M21 story"));
+		commands.push_back(CommandStatus("CMD_CREATE_STORY_PAGE", page_cost));
+		Require(page_cost.Succeeded(), "Game Script story page creation failed");
+		page = page_id;
+		StoryPageButtonData button_data{};
+		button_data.SetColour(COLOUR_BLUE);
+		button_data.SetFlags(SPBF_NONE);
+		auto [element_cost, element_id] = Command<CMD_CREATE_STORY_PAGE_ELEMENT>::Do(DoCommandFlag::Execute, TileIndex{0}, page,
+			SPET_BUTTON_PUSH, button_data.referenced_id, RawText("Acknowledge"));
+		commands.push_back(CommandStatus("CMD_CREATE_STORY_PAGE_ELEMENT", element_cost));
+		Require(element_cost.Succeeded(), fmt::format("Game Script story element creation failed: page={} valid={} error={}",
+			page.base(), StoryPage::IsValidID(page), static_cast<uint64_t>(element_cost.GetErrorMessage())));
+		element = element_id;
+		CommandCost title = Command<CMD_SET_STORY_PAGE_TITLE>::Do(DoCommandFlag::Execute, page, RawText("M21 story updated"));
+		CommandCost show = Command<CMD_SHOW_STORY_PAGE>::Do(DoCommandFlag::Execute, page);
+		commands.push_back(CommandStatus("CMD_SET_STORY_PAGE_TITLE", title));
+		commands.push_back(CommandStatus("CMD_SHOW_STORY_PAGE", show));
+		Require(title.Succeeded() && show.Succeeded(), "Game Script story update/show failed");
+
+		auto [table_cost, table_id] = Command<CMD_CREATE_LEAGUE_TABLE>::Do(DoCommandFlag::Execute,
+			RawText("M21 league"), RawText("header"), RawText("footer"));
+		commands.push_back(CommandStatus("CMD_CREATE_LEAGUE_TABLE", table_cost));
+		Require(table_cost.Succeeded(), "Game Script league creation failed");
+		table = table_id;
+		auto [league_cost, league_id] = Command<CMD_CREATE_LEAGUE_TABLE_ELEMENT>::Do(DoCommandFlag::Execute, table, 10,
+			CompanyID::Begin(), RawText("Company 0"), RawText("10"), LT_COMPANY,
+			CompanyID::Begin().base());
+		commands.push_back(CommandStatus("CMD_CREATE_LEAGUE_TABLE_ELEMENT", league_cost));
+		Require(league_cost.Succeeded(), "Game Script league element creation failed");
+		league_element = league_id;
+		CommandCost update = Command<CMD_UPDATE_LEAGUE_TABLE_ELEMENT_SCORE>::Do(DoCommandFlag::Execute, league_element, 20,
+			RawText("20"));
+		commands.push_back(CommandStatus("CMD_UPDATE_LEAGUE_TABLE_ELEMENT_SCORE", update));
+		Require(update.Succeeded(), "Game Script league update failed");
+	}
+	_current_company = CompanyID::Begin();
+	CommandCost answer = Command<CMD_GOAL_QUESTION_ANSWER>::Do(DoCommandFlag::Execute, 2101, 0);
+	CommandCost button = Command<CMD_STORY_PAGE_BUTTON>::Do(DoCommandFlag::Execute, TileIndex{0}, element, VehicleID::Invalid());
+	commands.push_back(CommandStatus("CMD_GOAL_QUESTION_ANSWER", answer));
+	commands.push_back(CommandStatus("CMD_STORY_PAGE_BUTTON", button));
+	Require(answer.Succeeded() && button.Succeeded(), fmt::format("company Game Script response failed: answer_error={} button_error={} element={} valid={}",
+		static_cast<uint64_t>(answer.GetErrorMessage()), static_cast<uint64_t>(button.GetErrorMessage()), element.base(),
+		StoryPageElement::IsValidID(element)));
+	for (uint i = 0; i < 4; ++i) Game::GameLoop();
+
+	json counts = {{"goals", Goal::GetNumItems()}, {"league_elements", LeagueTableElement::GetNumItems()},
+		{"league_tables", LeagueTable::GetNumItems()}, {"story_elements", StoryPageElement::GetNumItems()},
+		{"story_pages", StoryPage::GetNumItems()}};
+	Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "Game Script SAVE failed");
+	{
+		AutoRestoreBackup deity(_current_company, OWNER_DEITY);
+		Require(Command<CMD_REMOVE_GOAL>::Do(DoCommandFlag::Execute, goal).Succeeded(), "goal removal mutation failed");
+		Require(Command<CMD_REMOVE_STORY_PAGE>::Do(DoCommandFlag::Execute, page).Succeeded(), "story removal mutation failed");
+		Require(Command<CMD_REMOVE_LEAGUE_TABLE_ELEMENT>::Do(DoCommandFlag::Execute, league_element).Succeeded(), "league removal mutation failed");
+	}
+	Require(SaveOrLoad(save_path, SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "Game Script LOAD failed");
+	json restored = {{"goals", Goal::GetNumItems()}, {"league_elements", LeagueTableElement::GetNumItems()},
+		{"league_tables", LeagueTable::GetNumItems()}, {"story_elements", StoryPageElement::GetNumItems()},
+		{"story_pages", StoryPage::GetNumItems()}};
+	Require(counts == restored && Game::GetInstance() != nullptr, "Game Script state did not restore exactly");
+	return {{"commands", std::move(commands)}, {"fixture_name", Game::GetInfo()->GetName()}, {"observed", counts},
+		{"responses", {{"goal_question", true}, {"story_button", true}}}, {"save_load_exact", true}};
+}
+
+static json RunContent(const Request &request)
+{
+	ResetWorld(request);
+	uint engines[4]{};
+	for (VehicleType type : {VEH_TRAIN, VEH_ROAD, VEH_SHIP, VEH_AIRCRAFT}) {
+		for (const Engine *engine : Engine::IterateType(type)) if (engine->GetGRFID() != 0) ++engines[type];
+	}
+	uint industries = 0;
+	for (IndustryType type = 0; type < NUM_INDUSTRYTYPES; ++type) industries += GetIndustrySpec(type)->enabled;
+	uint objects = 0;
+	for (const ObjectSpec &object : ObjectSpec::Specs()) objects += object.IsEnabled();
+	RoadTypes roads = GetRoadTypes(false);
+	uint rail_types = _sorted_railtypes.size();
+	uint cargos = 0;
+	for ([[maybe_unused]] const CargoSpec *cargo : CargoSpec::Iterate()) ++cargos;
+	Require(request.expected_newgrfs.size() == 10 && request.expected_capabilities.size() == 14,
+		"content probe does not carry the complete finite compatibility pack");
+	Require(engines[VEH_TRAIN] > 0 && engines[VEH_ROAD] > 0 && engines[VEH_SHIP] > 0 && engines[VEH_AIRCRAFT] > 0 &&
+		industries > 0 && objects > 0 && roads.Count() >= 2 && rail_types >= 1 && cargos > 0,
+		fmt::format("loaded content capability projection is vacuous: trains={} roads={} ships={} aircraft={} industries={} objects={} road_types={} rail_types={} cargos={}",
+			engines[VEH_TRAIN], engines[VEH_ROAD], engines[VEH_SHIP], engines[VEH_AIRCRAFT], industries, objects,
+			roads.Count(), rail_types, cargos));
+	return {{"arbitrary_newgrf_universality", false}, {"assets", {{"aircraft_engines", engines[VEH_AIRCRAFT]},
+		{"cargos", cargos}, {"industries", industries}, {"objects", objects}, {"rail_types", rail_types},
+		{"road_engines", engines[VEH_ROAD]}, {"road_types", roads.Count()}, {"ship_engines", engines[VEH_SHIP]},
+		{"train_engines", engines[VEH_TRAIN]}}}, {"capabilities", request.expected_capabilities},
+		{"capability_schema_closed", true}, {"package_count", request.expected_newgrfs.size()}};
+}
+
+static json Run(const Request &request, const std::string &save_path)
+{
+	if (request.probe == "calendar") return RunCalendar(request, save_path);
+	if (request.probe == "authority_economy") return RunAuthorityEconomy(request, save_path);
+	if (request.probe == "events") return RunEvents(request, save_path);
+	if (request.probe == "gamescript") return RunGameScript(request, save_path);
+	if (request.probe == "content") return RunContent(request);
+	Fail("unreachable probe dispatch");
+}
