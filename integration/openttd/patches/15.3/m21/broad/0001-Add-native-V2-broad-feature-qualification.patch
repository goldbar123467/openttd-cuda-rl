+static void Configure(const Request &request)
+{
+	_settings_newgame.game_creation.generation_seed = request.seed;
+	_settings_newgame.game_creation.starting_year = TimerGameCalendar::Year{1950};
+	_settings_newgame.game_creation.map_x = 6;
+	_settings_newgame.game_creation.map_y = 6;
+	_settings_newgame.game_creation.landscape = request.landscape;
+	_settings_newgame.game_creation.se_flat_world_height = 1;
+	_settings_newgame.game_creation.water_borders = {};
+	_settings_newgame.construction.freeform_edges = true;
+	_settings_newgame.difficulty.max_no_competitors = 0;
+	_settings_newgame.difficulty.industry_density = 0;
+	_settings_newgame.difficulty.max_loan = 2000000;
+	_settings_newgame.difficulty.vehicle_costs = 0;
+	_settings_newgame.difficulty.construction_cost = 0;
+	_settings_newgame.difficulty.town_council_tolerance = TOWN_COUNCIL_PERMISSIVE;
+	_settings_newgame.difficulty.economy = true;
+	_settings_newgame.difficulty.disasters = false;
+	_settings_newgame.difficulty.vehicle_breakdowns = 2;
+	_settings_newgame.economy.exclusive_rights = true;
+	_settings_newgame.economy.inflation = true;
+	_settings_newgame.economy.town_growth_rate = 0;
+	_settings_newgame.economy.allow_town_roads = false;
+	_settings_newgame.economy.timekeeping_units = TKU_CALENDAR;
+	_settings_newgame.vehicle.never_expire_vehicles = false;
+	_settings_newgame.vehicle.max_roadveh = 32;
+	for (CompanyID id = CompanyID::Begin(); id < MAX_COMPANIES; ++id) _settings_newgame.script_config.ai[id].reset();
+	MakeNewgameSettingsLive();
+}
+
+static std::array<TownID, 2> ResetWorld(const Request &request, uint companies = 1)
+{
+	Configure(request);
+	ResetGRFConfig(true);
+	_random.SetSeed(request.seed ^ 0x4d323142U);
+	_interactive_random.SetSeed(request.seed ^ 0x42524f44U);
+	_game_mode = GM_NORMAL;
+	_switch_mode = SM_NONE;
+	SetModalProgress(false);
+	GenerateWorld(GWM_EMPTY, MAP_SIDE, MAP_SIDE, false);
+	Require(Map::SizeX() == MAP_SIDE && Map::SizeY() == MAP_SIDE, "empty qualification map has wrong dimensions");
+	std::array<TownID, 2> towns{};
+	{
+		AutoRestoreBackup company(_current_company, OWNER_DEITY);
+		for (uint i = 0; i < towns.size(); ++i) {
+			auto [cost, required_money, town] = Command<CMD_FOUND_TOWN>::Do(DoCommandFlag::Execute, TileXY(12 + i * 32, 12),
+				TSZ_SMALL, false, TL_ORIGINAL, false, 0, fmt::format("M21 Oracle Town {}", i));
+			(void)required_money;
+			Require(cost.Succeeded() && Town::IsValidID(town), "failed to create qualification town");
+			towns[i] = town;
+		}
+	}
+	for (uint i = 0; i < companies; ++i) {
+		Company *company = DoStartupNewCompany(false, CompanyID{static_cast<uint8_t>(i)});
+		Require(company != nullptr, "failed to create qualification company");
+		company->money = Money{100000000};
+	}
+	SetLocalCompany(CompanyID::Begin());
+	_current_company = CompanyID::Begin();
+	return towns;
+}
+
+static void SetCalendarYear(int year)
+{
+	TimerGameCalendar::SetDate(TimerGameCalendar::ConvertYMDToDate(TimerGameCalendar::Year{year}, 0, 1), 0);
+}
+
+static json EngineSnapshot(int year, bool update = true)
+{
+	if (update) {
+		SetCalendarYear(year);
+		StartupEngines();
+	}
+	Require(TimerGameCalendar::year == TimerGameCalendar::Year{year}, "calendar snapshot year differs");
+	json by_type = json::object();
+	for (VehicleType type : {VEH_TRAIN, VEH_ROAD, VEH_SHIP, VEH_AIRCRAFT}) {
+		uint total = 0;
+		uint available = 0;
+		uint expired = 0;
+		for (const Engine *engine : Engine::IterateType(type)) {
+			++total;
+			available += engine->company_avail.Test(CompanyID::Begin());
+			expired += engine->age != INT32_MAX && engine->company_avail.None() && TimerGameCalendar::date > engine->intro_date;
+		}
+		by_type[fmt::format("{}", static_cast<uint>(type))] = {{"available", available}, {"expired", expired}, {"total", total}};
+	}
+	uint airports_available = 0;
+	uint airports_total = 0;
+	for (uint8_t type = 0; type < NUM_AIRPORTS; ++type) {
+		const AirportSpec *spec = AirportSpec::Get(type);
+		if (!spec->enabled) continue;
+		++airports_total;
+		if (spec->min_year <= TimerGameCalendar::year && spec->max_year >= TimerGameCalendar::year) ++airports_available;
+	}
+	return {{"airport_available", airports_available}, {"airport_total", airports_total}, {"engines", std::move(by_type)}, {"year", year}};
+}
+
+static json RunCalendar(const Request &request, const std::string &save_path)
+{
+	ResetWorld(request);
+	json snapshots = json::array();
+	for (int year : {1900, 1930, 1950, 1980, 2000, 2050, 2100}) snapshots.push_back(EngineSnapshot(year));
+	SetCalendarYear(2050);
+	StartupEngines();
+	json before = EngineSnapshot(2050);
+	Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "calendar SAVE failed");
+	SetCalendarYear(2100);
+	Require(SaveOrLoad(save_path, SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "calendar LOAD failed");
+	json after = EngineSnapshot(2050, false);
+	Require(before == after && TimerGameCalendar::year == TimerGameCalendar::Year{2050}, "calendar projection did not restore exactly");
+	uint cargo_count = 0;
+	for ([[maybe_unused]] const CargoSpec *cargo : CargoSpec::Iterate()) ++cargo_count;
+	Require(cargo_count > 0 && snapshots.size() == 7, "calendar/climate catalogs are vacuous");
+	return {{"calendar_fixture", "explicit-native-date-boundary-shifts"}, {"cargo_count", cargo_count},
+		{"landscape", LandscapeName(request.landscape)}, {"save_load_exact", true}, {"snapshots", std::move(snapshots)},
+		{"span_years", 200}};
+}
+
+static void RunUntilEconomyMonthChanges(uint8_t month)
+{
+	for (uint ticks = 0; ticks < 10000 && TimerGameEconomy::month == month; ++ticks) StateGameLoop();
+	Require(TimerGameEconomy::month != month, "economy month did not advance within bound");
+}
+
+static json RunAuthorityEconomy(const Request &request, const std::string &save_path)
+{
+	auto towns = ResetWorld(request, 2);
+	Town *town = Town::Get(towns[0]);
+	json commands = json::array();
+	{
+		AutoRestoreBackup deity(_current_company, OWNER_DEITY);
+		CommandCost invalid = Command<CMD_TOWN_RATING>::Do({}, TownID::Invalid(), CompanyID::Begin(), 500);
+		commands.push_back({{"command", "CMD_TOWN_RATING_INVALID"}, {"status", invalid.Failed() ? "REJECTED" : "SUCCESS"}});
+		Require(invalid.Failed(), "invalid authority rating was accepted");
+		CommandCost rating = Command<CMD_TOWN_RATING>::Do(DoCommandFlag::Execute, towns[0], CompanyID::Begin(), 500);
+		commands.push_back({{"command", "CMD_TOWN_RATING"}, {"status", rating.Succeeded() ? "SUCCESS" : "REJECTED"}});
+		Require(rating.Succeeded() && town->ratings[CompanyID::Begin()] == 500, "authority rating did not execute exactly");
+	}
+	_current_company = CompanyID::Begin();
+	CommandCost rights_test = Command<CMD_DO_TOWN_ACTION>::Do({}, towns[0], TownAction::BuyRights);
+	CommandCost rights = Command<CMD_DO_TOWN_ACTION>::Do(DoCommandFlag::Execute, towns[0], TownAction::BuyRights);
+	commands.push_back({{"command", "CMD_DO_TOWN_ACTION_BUY_RIGHTS_TEST"}, {"cost", rights_test.GetCost().base()}, {"status", rights_test.Succeeded() ? "SUCCESS" : "REJECTED"}});
+	commands.push_back({{"command", "CMD_DO_TOWN_ACTION_BUY_RIGHTS"}, {"cost", rights.GetCost().base()}, {"status", rights.Succeeded() ? "SUCCESS" : "REJECTED"}});
+	Require(rights_test.Succeeded() && rights.Succeeded() && rights.GetCost() == rights_test.GetCost() && town->exclusivity == CompanyID::Begin(),
+		"exclusive-rights test/execute parity failed");
+	_current_company = CompanyID{1};
+	CommandCost competitor = Command<CMD_DO_TOWN_ACTION>::Do({}, towns[0], TownAction::BuyRights);
+	commands.push_back({{"command", "CMD_DO_TOWN_ACTION_COMPETITOR"}, {"status", competitor.Failed() ? "REJECTED" : "SUCCESS"}});
+	Require(competitor.Failed(), "competitor bypassed active exclusive rights");
+	town->exclusive_counter = 1;
+	uint8_t rights_month = TimerGameEconomy::month;
+	RunUntilEconomyMonthChanges(rights_month);
+	Require(town->exclusive_counter == 0 && town->exclusivity == CompanyID::Invalid(), "exclusive rights did not expire natively");
+
+	CargoType passengers = GetCargoTypeByLabel(CT_PASSENGERS);
+	Require(IsValidCargoType(passengers), "passenger cargo is unavailable");
+	{
+		AutoRestoreBackup deity(_current_company, OWNER_DEITY);
+		CommandCost subsidy = Command<CMD_CREATE_SUBSIDY>::Do(DoCommandFlag::Execute, passengers,
+			Source{towns[0], SourceType::Town}, Source{towns[1], SourceType::Town});
+		commands.push_back({{"command", "CMD_CREATE_SUBSIDY"}, {"status", subsidy.Succeeded() ? "SUCCESS" : "REJECTED"}});
+		Require(subsidy.Succeeded() && Subsidy::GetNumItems() == 1, "subsidy was not created");
+	}
+	Subsidy *subsidy = *Subsidy::Iterate().begin();
+	subsidy->AwardTo(CompanyID::Begin());
+	Require(subsidy->awarded == CompanyID::Begin(), "subsidy award did not persist");
+	uint16_t awarded_months = subsidy->remaining;
+
+	InitializeEconomy();
+	StartupEconomy();
+	Money price_before = _price[PR_BUILD_ROAD];
+	Money payment_before = GetTransportedGoodsIncome(100, 20, 10, passengers);
+	uint64_t inflation_before = _economy.inflation_prices;
+	Require(!AddInflation(false), "inflation unexpectedly saturated");
+	RecomputePrices();
+	Money price_after = _price[PR_BUILD_ROAD];
+	Money payment_after = GetTransportedGoodsIncome(100, 20, 10, passengers);
+	Require(_economy.inflation_prices > inflation_before && price_after >= price_before && payment_after >= payment_before,
+		"inflation did not propagate through native prices and payments");
+	_economy.fluct = 1;
+	uint8_t recession_month = TimerGameEconomy::month;
+	RunUntilEconomyMonthChanges(recession_month);
+	Require(EconomyIsInRecession(), "native economy did not enter recession");
+	int16_t recession_fluct = _economy.fluct;
+	_economy.fluct = -11;
+	uint8_t recovery_month = TimerGameEconomy::month;
+	RunUntilEconomyMonthChanges(recovery_month);
+	Require(!EconomyIsInRecession(), "native economy did not leave recession");
+	int16_t recovered_fluct = _economy.fluct;
+
+	json before_save = {{"awarded", subsidy->awarded.base()}, {"remaining", subsidy->remaining}, {"town_rating", town->ratings[CompanyID::Begin()]}};
+	Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "authority/economy SAVE failed");
+	town->ratings[CompanyID::Begin()] = -1000;
+	Require(SaveOrLoad(save_path, SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "authority/economy LOAD failed");
+	Subsidy *loaded_subsidy = *Subsidy::Iterate().begin();
+	json after_load = {{"awarded", loaded_subsidy->awarded.base()}, {"remaining", loaded_subsidy->remaining},
+		{"town_rating", Town::Get(towns[0])->ratings[CompanyID::Begin()]}};
+	Require(before_save == after_load, "authority/economy public state did not restore exactly");
+	return {{"commands", std::move(commands)}, {"economy", {{"inflation_after", _economy.inflation_prices},
+		{"inflation_before", inflation_before}, {"payment_after", payment_after.base()}, {"payment_before", payment_before.base()},
+		{"price_after", price_after.base()}, {"price_before", price_before.base()}, {"recession_fluct", recession_fluct},
+		{"recovered_fluct", recovered_fluct}}}, {"exclusive_rights_expired", true}, {"save_load_exact", true},
+		{"subsidy", {{"awarded_months", awarded_months}, {"company", CompanyID::Begin().base()}}}};
+}
+
+static uint DisasterCount()
+{
+	uint count = 0;
+	for ([[maybe_unused]] const DisasterVehicle *vehicle : DisasterVehicle::Iterate()) ++count;
+	return count;
+}
+
+static json RunEvents(const Request &request, const std::string &save_path)
+{
+	ResetWorld(request);
+	TileIndex depot = TileXY(20, 20);
+	CommandCost depot_cost = Command<CMD_BUILD_ROAD_DEPOT>::Do(DoCommandFlag::Execute, depot, ROADTYPE_ROAD, DIAGDIR_NW);
+	Require(depot_cost.Succeeded(), "failed to build event road depot");
+	const Engine *road_engine = nullptr;
+	for (const Engine *engine : Engine::IterateType(VEH_ROAD)) {
+		if (engine->company_avail.Test(CompanyID::Begin())) { road_engine = engine; break; }
+	}
+	Require(road_engine != nullptr, "no road engine available for breakdown probe");
+	auto built = Command<CMD_BUILD_VEHICLE>::Do(DoCommandFlag::Execute, depot, road_engine->index, true,
+		road_engine->GetDefaultCargoType(), INVALID_CLIENT_ID);
+	Require(std::get<0>(built).Succeeded(), "failed to build breakdown vehicle");
+	RoadVehicle *vehicle = RoadVehicle::Get(std::get<1>(built));
+	vehicle->vehstatus.Reset(VehState::Stopped);
+	vehicle->cur_speed = 10;
+	vehicle->reliability = 0;
+	vehicle->breakdown_chance = 255;
+	_settings_game.difficulty.vehicle_breakdowns = 0;
+	for (uint i = 0; i < 32; ++i) CheckVehicleBreakdown(vehicle);
+	Require(vehicle->breakdown_ctr == 0, "disabled breakdowns mutated vehicle state");
+	_settings_game.difficulty.vehicle_breakdowns = 2;
+	vehicle->breakdown_ctr = 2;
+	vehicle->breakdown_delay = 4;
+	bool observed_breakdown = false;
+	uint recovery_ticks = 0;
+	while (recovery_ticks < 32 && vehicle->breakdown_ctr != 0) {
+		observed_breakdown |= vehicle->HandleBreakdown();
+		vehicle->tick_counter++;
+		++recovery_ticks;
+	}
+	Require(observed_breakdown && vehicle->breakdown_ctr == 0 && vehicle->breakdowns_since_last_service == 1,
+		"forced native breakdown did not recover within bound");
+
+	_settings_game.difficulty.disasters = false;
+	Require(DisasterCount() == 0, "disabled disaster baseline is not empty");
+	_settings_game.difficulty.disasters = true;
+	for (uint y = 28; y < 36; ++y) for (uint x = 4; x < 20; ++x) MakeSea(TileXY(x, y));
+	DisasterVehicle *disaster = new DisasterVehicle(8 * TILE_SIZE + TILE_SIZE / 2, 30 * TILE_SIZE + TILE_SIZE / 2,
+		DIR_SE, ST_SMALL_SUBMARINE);
+	VehicleID disaster_id = disaster->index;
+	disaster->age = TimerGameCalendar::Date{8878};
+	uint disaster_ticks = 0;
+	while (Vehicle::IsValidID(disaster_id) && disaster_ticks < 8) {
+		DisasterVehicle::Get(disaster_id)->Tick();
+		++disaster_ticks;
+	}
+	Require(!Vehicle::IsValidID(disaster_id), "native disaster lifecycle did not terminate within bound");
+	json before = {{"breakdown_counter", vehicle->breakdown_ctr}, {"disasters", DisasterCount()},
+		{"vehicle_valid", Vehicle::IsValidID(vehicle->index)}};
+	Require(SaveOrLoad(save_path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "event SAVE failed");
+	vehicle->breakdown_ctr = 2;
+	Require(SaveOrLoad(save_path, SLO_LOAD, DFT_GAME_FILE, NO_DIRECTORY, false) == SL_OK, "event LOAD failed");
+	RoadVehicle *loaded = RoadVehicle::Get(std::get<1>(built));
+	json after = {{"breakdown_counter", loaded->breakdown_ctr}, {"disasters", DisasterCount()},
+		{"vehicle_valid", Vehicle::IsValidID(loaded->index)}};
+	Require(before == after, "event recovery state did not restore exactly");
+	return {{"breakdown", {{"disabled_no_event", true}, {"event_penalty", -1}, {"observed", observed_breakdown},
+		{"recovery_bonus", 1}, {"recovery_ticks", recovery_ticks}}}, {"disaster", {{"disabled_no_event", true},
+		{"enabled_fixture", "native-small-submarine"}, {"lifecycle_ticks", disaster_ticks}, {"terminated", true}}},
+		{"save_load_exact", true}};
+}
