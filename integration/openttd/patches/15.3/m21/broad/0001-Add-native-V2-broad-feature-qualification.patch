+static constexpr std::string_view MANIFEST_SCHEMA = "openttd-rl-v2-m21-broad-run-1";
+static constexpr std::string_view REPORT_SCHEMA = "openttd-rl-v2-m21-broad-report-1";
+static constexpr uint MAP_SIDE = 64;
+
+struct ExpectedGRF {
+	std::string id;
+	std::string md5;
+};
+
+struct Request {
+	std::string run_id;
+	std::string probe;
+	uint32_t seed;
+	LandscapeType landscape;
+	std::string engine_source_tree;
+	std::string executable_sha256;
+	std::string contract_sha256;
+	std::string content_lock_sha256;
+	std::vector<ExpectedGRF> expected_newgrfs;
+	std::vector<std::string> expected_capabilities;
+	bool require_gamescript;
+};
+
+[[noreturn]] static void Fail(std::string_view message)
+{
+	throw std::runtime_error(fmt::format("M21 broad-feature qualification: {}", message));
+}
+
+static void Require(bool condition, std::string_view message)
+{
+	if (!condition) Fail(message);
+}
+
+static bool IsSha256(std::string_view value)
+{
+	return value.size() == 64 && std::ranges::all_of(value, [](char c) {
+		return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+	});
+}
+
+static bool IsHex(std::string_view value, size_t size)
+{
+	return value.size() == size && std::ranges::all_of(value, [](char c) {
+		return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+	});
+}
+
+static bool SafeName(std::string_view value)
+{
+	return !value.empty() && value.size() <= 96 && std::ranges::all_of(value, [](char c) {
+		return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_';
+	});
+}
+
+static std::string Lower(std::string value)
+{
+	std::ranges::transform(value, value.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+	return value;
+}
+
+static EncodedString RawText(std::string_view value)
+{
+	return GetEncodedString(STR_JUST_RAW_STRING, std::string(value));
+}
+
+static json ReadCanonicalJson(const std::string &path)
+{
+	std::ifstream input(path, std::ios::binary);
+	if (!input) Fail(fmt::format("cannot open manifest '{}'", path));
+	std::string bytes((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+	Require(!bytes.empty() && bytes.back() == '\n', "manifest must end with one LF");
+	bytes.pop_back();
+	Require(!bytes.empty() && bytes.back() != '\n' && bytes.back() != '\r', "manifest has trailing whitespace");
+	json value;
+	try {
+		value = json::parse(bytes);
+	} catch (const json::exception &e) {
+		Fail(fmt::format("invalid manifest JSON: {}", e.what()));
+	}
+	Require(value.dump() == bytes, "manifest must be canonical compact JSON followed by LF");
+	return value;
+}
+
+static void WriteCanonicalNew(const std::string &path, const json &value)
+{
+	std::filesystem::path output(path);
+	Require(output.is_absolute() && !std::filesystem::exists(output), "report must be a new absolute path");
+	std::ofstream stream(output, std::ios::binary | std::ios::out | std::ios::trunc);
+	Require(stream.good(), fmt::format("cannot create report '{}'", path));
+	stream << value.dump() << '\n';
+	stream.flush();
+	Require(stream.good(), fmt::format("cannot write report '{}'", path));
+}
+
+static LandscapeType ParseLandscape(const std::string &value)
+{
+	if (value == "temperate") return LandscapeType::Temperate;
+	if (value == "arctic") return LandscapeType::Arctic;
+	if (value == "tropic") return LandscapeType::Tropic;
+	if (value == "toyland") return LandscapeType::Toyland;
+	Fail("unknown landscape");
+}
+
+static std::string LandscapeName(LandscapeType landscape)
+{
+	switch (landscape) {
+		case LandscapeType::Temperate: return "temperate";
+		case LandscapeType::Arctic: return "arctic";
+		case LandscapeType::Tropic: return "tropic";
+		case LandscapeType::Toyland: return "toyland";
+		default: Fail("invalid landscape enum");
+	}
+}
+
+static Request Validate(const json &manifest)
+{
+	Require(manifest.is_object() && manifest.size() == 12, "manifest must contain exactly twelve fields");
+	Require(manifest.at("schema_version") == MANIFEST_SCHEMA, "unsupported manifest schema_version");
+	Request request{
+		manifest.at("run_id").get<std::string>(), manifest.at("probe").get<std::string>(),
+		manifest.at("seed").get<uint32_t>(), ParseLandscape(manifest.at("landscape").get<std::string>()),
+		manifest.at("engine_source_tree").get<std::string>(), manifest.at("executable_sha256").get<std::string>(),
+		manifest.at("contract_sha256").get<std::string>(), manifest.at("content_lock_sha256").get<std::string>(),
+		{}, {}, manifest.at("require_gamescript").get<bool>(),
+	};
+	Require(SafeName(request.run_id), "invalid run_id");
+	Require(request.probe == "calendar" || request.probe == "authority_economy" || request.probe == "events" ||
+		request.probe == "gamescript" || request.probe == "content", "unknown broad-feature probe");
+	Require(IsHex(request.engine_source_tree, 40), "engine_source_tree must be a lowercase Git tree identity");
+	Require(IsSha256(request.executable_sha256) && IsSha256(request.contract_sha256) && IsSha256(request.content_lock_sha256),
+		"executable, contract, and content-lock identities must be SHA-256");
+	Require(manifest.at("expected_newgrfs").is_array() && manifest.at("expected_newgrfs").size() <= 16,
+		"expected_newgrfs must be a bounded array");
+	std::set<std::string> grf_ids;
+	for (const json &item : manifest.at("expected_newgrfs")) {
+		Require(item.is_object() && item.size() == 2, "expected NewGRF entry must contain id and md5");
+		ExpectedGRF expected{Lower(item.at("id").get<std::string>()), Lower(item.at("md5").get<std::string>())};
+		Require(IsHex(expected.id, 8) && IsHex(expected.md5, 32) && grf_ids.insert(expected.id).second,
+			"expected NewGRF identity is malformed or duplicated");
+		request.expected_newgrfs.push_back(std::move(expected));
+	}
+	static const std::set<std::string> known_capabilities{
+		"aircraft_vehicle", "airport", "cargo", "cargo_refit", "industry", "object", "rail_station", "rail_type",
+		"road_type", "road_vehicle", "ship_vehicle", "train_vehicle", "tram_type", "tram_vehicle",
+	};
+	Require(manifest.at("expected_capabilities").is_array(), "expected_capabilities must be an array");
+	std::set<std::string> capabilities;
+	for (const json &value : manifest.at("expected_capabilities")) {
+		std::string capability = value.get<std::string>();
+		Require(known_capabilities.contains(capability), fmt::format("unknown capability '{}'", capability));
+		Require(capabilities.insert(capability).second, "expected capability is duplicated");
+		request.expected_capabilities.push_back(std::move(capability));
+	}
+	Require(request.probe == "content" || request.expected_capabilities.empty(), "capabilities are only accepted by the content probe");
+	Require(request.require_gamescript == (request.probe == "gamescript"), "Game Script requirement must match the gamescript probe");
+	return request;
+}
+
+static json ActiveContent(const Request &request)
+{
+	json active = json::array();
+	std::set<std::pair<std::string, std::string>> identities;
+	const GRFConfigList &configured = _grfconfig.empty() ? _grfconfig_newgame : _grfconfig;
+	for (const auto &config : configured) {
+		std::string id = fmt::format("{:08x}", std::byteswap(config->ident.grfid));
+		std::string md5 = Lower(FormatArrayAsHex(config->ident.md5sum));
+		active.push_back({{"id", id}, {"md5", md5}, {"filename", config->filename}, {"version", config->version}});
+		identities.emplace(id, md5);
+	}
+	std::set<std::pair<std::string, std::string>> expected;
+	for (const ExpectedGRF &item : request.expected_newgrfs) expected.emplace(item.id, item.md5);
+	Require(identities == expected, fmt::format("active NewGRF identity set differs: expected={} active={}", expected.size(), identities.size()));
+	return active;
+}
