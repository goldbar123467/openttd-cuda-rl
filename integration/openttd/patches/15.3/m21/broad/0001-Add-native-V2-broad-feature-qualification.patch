+void RunRlV2BroadQualification(const std::string &manifest_path, const std::string &report_path)
+{
+	Request request = Validate(ReadCanonicalJson(manifest_path));
+	json active_content = ActiveContent(request);
+	try {
+		json result = Run(request, report_path + ".sav");
+		json report = {
+			{"active_content", std::move(active_content)}, {"engine_source_tree", request.engine_source_tree},
+			{"executable_sha256", request.executable_sha256}, {"identity", {{"content_lock_sha256", request.content_lock_sha256},
+				{"contract_sha256", request.contract_sha256}}}, {"request", {{"landscape", LandscapeName(request.landscape)},
+				{"probe", request.probe}, {"run_id", request.run_id}, {"seed", request.seed}}}, {"result", std::move(result)},
+			{"run_id", request.run_id}, {"schema_version", REPORT_SCHEMA}, {"status", "PASS"},
+		};
+		WriteCanonicalNew(report_path, report);
+	} catch (const std::exception &e) {
+		WriteCanonicalNew(report_path, {{"error", e.what()}, {"status", "FAIL"}});
+		throw;
+	}
+}
