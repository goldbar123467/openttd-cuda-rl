+/** @file rl_neural_agent_gui.cpp Native M11 inspection, pause, and agent-step window. */
+
+#include "stdafx.h"
+
+#include "rl_neural_agent.h"
+
+#include "debug.h"
+#include "gfx_func.h"
+#include "openttd.h"
+#include "strings_func.h"
+#include "window_func.h"
+#include "window_gui.h"
+
+#include "table/strings.h"
+
+#include "safeguards.h"
+
+namespace {
+
+enum RlNeuralAgentWidgets : WidgetID {
+	WID_RLNA_CAPTION,
+	WID_RLNA_INSPECTION,
+	WID_RLNA_AGENT_PAUSE,
+	WID_RLNA_AGENT_STEP,
+	WID_RLNA_GAME_PAUSE,
+};
+
+class RlNeuralAgentWindow : public Window {
+public:
+	RlNeuralAgentWindow(WindowDesc &desc, int window_number) : Window(desc)
+	{
+		this->InitNested(window_number);
+	}
+
+	void OnPaint() override
+	{
+		this->DrawWidgets();
+	}
+
+	std::string GetWidgetString(WidgetID widget, StringID stringid) const override
+	{
+		if (widget == WID_RLNA_CAPTION) return "OpenTTD-RL Neural Agent";
+		return this->Window::GetWidgetString(widget, stringid);
+	}
+
+	void DrawWidget(const Rect &rect, WidgetID widget) const override
+	{
+		const Rect inner = rect.Shrink(WidgetDimensions::scaled.frametext);
+		switch (widget) {
+			case WID_RLNA_INSPECTION: {
+				int y = inner.top;
+				for (const std::string &line : GetRlNeuralAgentInspectionLines()) {
+					DrawString(inner.left, inner.right, y, line, TC_BLACK, SA_LEFT | SA_FORCE);
+					y += GetCharacterHeight(FS_NORMAL);
+				}
+				break;
+			}
+			case WID_RLNA_AGENT_PAUSE:
+				DrawString(inner, IsRlNeuralAgentPaused() ? "Resume agent" : "Pause agent", IsRlNeuralAgentActive() ? TC_BLACK : TC_GREY, SA_CENTER);
+				break;
+			case WID_RLNA_AGENT_STEP:
+				DrawString(inner, "Step one agent action", IsRlNeuralAgentActive() && IsRlNeuralAgentPaused() && _pause_mode.None() ? TC_BLACK : TC_GREY, SA_CENTER);
+				break;
+			case WID_RLNA_GAME_PAUSE:
+				DrawString(inner, _pause_mode.Any() ? "Resume game" : "Pause game", TC_BLACK, SA_CENTER);
+				break;
+		}
+	}
+
+	void OnClick([[maybe_unused]] Point point, WidgetID widget, [[maybe_unused]] int click_count) override
+	{
+		try {
+			switch (widget) {
+				case WID_RLNA_AGENT_PAUSE:
+					ToggleRlNeuralAgentPause();
+					break;
+				case WID_RLNA_AGENT_STEP:
+					StepRlNeuralAgentOnce();
+					break;
+				case WID_RLNA_GAME_PAUSE:
+					ToggleRlNeuralAgentGamePause();
+					break;
+			}
+		} catch (const std::exception &e) {
+			Debug(misc, 0, "M11 control rejected: {}", e.what());
+		}
+		this->SetDirty();
+	}
+
+	void OnRealtimeTick([[maybe_unused]] uint delta_ms) override
+	{
+		this->SetDirty();
+	}
+};
+
+static constexpr std::initializer_list<NWidgetPart> _nested_rl_neural_agent_widgets = {
+	NWidget(NWID_HORIZONTAL),
+		NWidget(WWT_CLOSEBOX, COLOUR_DARK_BLUE),
+		NWidget(WWT_CAPTION, COLOUR_DARK_BLUE, WID_RLNA_CAPTION), SetStringTip(STR_JUST_RAW_STRING, STR_TOOLTIP_WINDOW_TITLE_DRAG_THIS),
+		NWidget(WWT_SHADEBOX, COLOUR_DARK_BLUE),
+		NWidget(WWT_STICKYBOX, COLOUR_DARK_BLUE),
+	EndContainer(),
+	NWidget(WWT_PANEL, COLOUR_GREY, WID_RLNA_INSPECTION), SetMinimalSize(620, 118), SetResize(1, 1), EndContainer(),
+	NWidget(NWID_HORIZONTAL),
+		NWidget(WWT_PANEL, COLOUR_GREY, WID_RLNA_AGENT_PAUSE), SetMinimalSize(130, 24), SetFill(1, 0), EndContainer(),
+		NWidget(WWT_PANEL, COLOUR_GREY, WID_RLNA_AGENT_STEP), SetMinimalSize(180, 24), SetFill(1, 0), EndContainer(),
+		NWidget(WWT_PANEL, COLOUR_GREY, WID_RLNA_GAME_PAUSE), SetMinimalSize(130, 24), SetFill(1, 0), EndContainer(),
+	EndContainer(),
+	NWidget(NWID_HORIZONTAL),
+		NWidget(WWT_RESIZEBOX, COLOUR_DARK_BLUE),
+	EndContainer(),
+};
+
+static WindowDesc _rl_neural_agent_desc(
+	WDP_AUTO, "rl_neural_agent", 620, 166,
+	WC_RL_NEURAL_AGENT, WC_NONE,
+	WindowDefaultFlag::Construction,
+	_nested_rl_neural_agent_widgets
+);
+
+} // namespace
+
+void ShowRlNeuralAgentWindow()
+{
+	AllocateWindowDescFront<RlNeuralAgentWindow>(_rl_neural_agent_desc, 0);
+}
