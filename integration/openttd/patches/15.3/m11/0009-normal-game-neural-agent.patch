diff --git a/src/rl_neural_agent.cpp b/src/rl_neural_agent.cpp
new file mode 100644
index 0000000..6b1be11
--- /dev/null
+++ b/src/rl_neural_agent.cpp
@@ -0,0 +1,453 @@
