{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/docs/project/schema/defect-ledger-v1.schema.json",
  "title": "OpenTTD RL project defect and divergence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "schema_sha256",
    "ledger_kind",
    "scope",
    "entries",
    "open_counts",
    "diagnostics"
  ],
  "properties": {
    "$schema": { "const": "schema/defect-ledger-v1.schema.json" },
    "schema_version": { "const": 1 },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "ledger_kind": { "const": "openttd-rl-project-defect-ledger" },
    "scope": { "const": "V1-and-sequential-post-V1-roadmap" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "open_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defects", "divergences", "release_blocking", "total_nonclosed"],
      "properties": {
        "defects": { "type": "integer", "minimum": 0 },
        "divergences": { "type": "integer", "minimum": 0 },
        "release_blocking": { "type": "integer", "minimum": 0 },
        "total_nonclosed": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_reviewed_date", "review_note"],
      "properties": {
        "last_reviewed_date": { "type": "string", "format": "date" },
        "review_note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^(SCOPE|LIFE|STACK|PPO|OBS|ACT|REW|AI|MODEL|RUN|MON|EVAL|REPRO|TEST|ARCH|DONE|EXP)-[0-9]{3}$"
    },
    "gate": {
      "type": "string",
      "enum": ["G00", "G01", "G02", "G03", "G04", "G05", "G06", "G07", "G08", "G09", "G10", "G11", "G12", "POST_V1"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "severity",
        "blocks_release",
        "status",
        "discovery_date",
        "discovered_by",
        "source_revision",
        "affected_requirement_ids",
        "affected_gates",
        "first_observed",
        "impact",
        "root_cause",
        "owner",
        "reproducer",
        "evidence",
        "fix_revision",
        "regression_test",
        "closure_evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^V1-(DEF|DIV)-[0-9]{4}$" },
        "kind": { "type": "string", "enum": ["DEFECT", "DIVERGENCE"] },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["BLOCKER", "CRITICAL", "MAJOR", "MINOR"] },
        "blocks_release": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["OPEN", "DIAGNOSED", "FIXED_PENDING_VERIFICATION", "CLOSED", "ACCEPTED_LIMITATION"]
        },
        "discovery_date": { "type": "string", "format": "date" },
        "discovered_by": { "type": "string", "minLength": 1 },
        "source_revision": { "oneOf": [{ "$ref": "#/$defs/git_commit" }, { "type": "null" }] },
        "affected_requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement_id" }
        },
        "affected_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gate" }
        },
        "first_observed": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "root_cause": { "type": ["string", "null"], "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "reproducer": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "fix_revision": { "oneOf": [{ "$ref": "#/$defs/git_commit" }, { "type": "null" }] },
        "regression_test": { "oneOf": [{ "$ref": "#/$defs/relative_path" }, { "type": "null" }] },
        "closure_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "DEFECT" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "pattern": "^V1-DEF-[0-9]{4}$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "DIVERGENCE" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "pattern": "^V1-DIV-[0-9]{4}$" } } }
        },
        {
          "if": { "properties": { "status": { "const": "CLOSED" } }, "required": ["status"] },
          "then": {
            "properties": {
              "root_cause": { "type": "string", "minLength": 1 },
              "fix_revision": { "$ref": "#/$defs/git_commit" },
              "regression_test": { "$ref": "#/$defs/relative_path" },
              "closure_evidence": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
