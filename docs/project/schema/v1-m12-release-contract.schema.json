{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.local/schema/v1-m12-release-contract.schema.json",
  "title": "OpenTTD-RL V1 M12 release reproduction contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "release_id", "semantic_version", "status", "supported_host", "source", "compatibility", "accepted_evidence", "campaigns", "release_manifest", "requirements", "identity"],
  "properties": {
    "$schema": {"const": "../../docs/project/schema/v1-m12-release-contract.schema.json"},
    "schema_version": {"const": "openttd-rl-v1-m12-release-contract-1"},
    "release_id": {"const": "openttd-rl-v1-release-1"},
    "semantic_version": {"const": 1},
    "status": {"const": "FROZEN"},
    "supported_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_id", "os_version", "architecture", "clean_repository", "clean_output_roots", "gpu"],
      "properties": {
        "os_id": {"const": "ubuntu"},
        "os_version": {"const": "24.04"},
        "architecture": {"const": "x86_64"},
        "clean_repository": {"const": "fresh-local-clone-at-accepted-commit"},
        "clean_output_roots": {"const": "all-build-test-and-playback-output-outside-repository"},
        "gpu": {"const": "NVIDIA-CUDA-13.0-sm120-release-path"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer_repository", "dirty_policy", "remote_policy", "openttd_upstream_commit", "m11_result_tree"],
      "properties": {
        "outer_repository": {"const": "current-clean-main-commit-recorded-by-gate"},
        "dirty_policy": {"const": "forbidden"},
        "remote_policy": {"const": "local-main-equals-origin-main-before-and-after-gate"},
        "openttd_upstream_commit": {"const": "29f808ef0022064e6d9a83c8476d1e0f4686af86"},
        "m11_result_tree": {"const": "e1151f41b131a41c1d450f741c8922da1a119e18"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "bridge", "observation", "action_and_mask", "reward_trajectory", "ppo", "architecture", "evaluation", "model_package", "playback"],
      "properties": {
        "scenario": {"const": "45ec1b3beb4d6d50696bf1de75094e1817c6aa7ef8e0d38fc6696999764e5b0f"},
        "bridge": {"const": "4701a21ae106f6fa120db1b89c3929d16c29afafb8e0198126173137ed2af2d6"},
        "observation": {"const": "7f8a46af1fe2a2c23e755c71b3bc2d04c9a0d057c573e901e5c9ed9178ca13eb"},
        "action_and_mask": {"const": "215c7d3ebeea97f1629debee4a2d10301838ccfd3085e4828685591677b58536"},
        "reward_trajectory": {"const": "9d8f9c2fc6074d899fa3b0047c55e3fb15cc5c17cddeaceaa1fd5389e53c8c9e"},
        "ppo": {"const": "8649da85cee2914d423a7ae8f1bcff0fa6a1c7d749bd04232976fbad6df518c0"},
        "architecture": {"const": "52c8b622b79d793e85ef749822e6886cd7cdda63194a471d38ab25da910e101d"},
        "evaluation": {"const": "c64c9876c1f6cf46dcc2642bd4628ed45f4659d1866a047d4e51def60dab9a5e"},
        "model_package": {"const": "e77edf9be1343970a55becbb05da96a6b9a17edbd8df2c7999701dd8fa1f33b6"},
        "playback": {"const": "3f331f7852b0174714de30b8ab6015178d7e01d4691832f8af2085d32bb01e42"}
      }
    },
    "accepted_evidence": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argument", "relative_file", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^m[0-9]{2}-[a-z0-9-]+$"},
          "argument": {"type": "string", "pattern": "^--[a-z0-9-]+$"},
          "relative_file": {"type": "string", "minLength": 5, "pattern": "^[^/]"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "campaigns": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"enum": ["clean-dual-build", "scenario-reset-reproduction", "cpu-cuda-training", "checkpoint-recovery", "independent-evaluation", "onnx-package-equivalence", "visible-playback", "long-run-soak", "quality-matrix", "clean-operator-documentation", "traceability-defect-closure", "fresh-root-release-repeat"]}
    },
    "release_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "schema_path", "schema_sha256", "canonical_encoding", "required_sections"],
      "properties": {
        "schema_version": {"const": "openttd-rl-v1-m12-release-manifest-1"},
        "schema_path": {"const": "docs/project/schema/v1-m12-release-manifest.schema.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_encoding": {"const": "compact-sorted-json-plus-one-LF"},
        "required_sections": {
          "const": ["source", "host", "builds", "dependencies", "contracts", "seeds", "counters", "artifacts", "campaigns", "quality", "traceability", "defects", "reproduction"]
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {"pattern": "^(REPRO-00[1-9]|TEST-016|DONE-00[1-8])$"}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_algorithm", "compatibility_sha256", "schema_path", "schema_sha256"],
      "properties": {
        "compatibility_algorithm": {"const": "sha256-canonical-json-v1"},
        "compatibility_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_path": {"const": "docs/project/schema/v1-m12-release-contract.schema.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
