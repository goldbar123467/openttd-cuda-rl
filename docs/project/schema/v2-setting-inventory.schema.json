{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/docs/project/schema/v2-setting-inventory.schema.json",
  "title": "OpenTTD RL V2 pinned source setting inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "schema_sha256", "snapshot_date", "engine_source", "source_root", "policy", "source_files", "definitions", "counts"],
  "properties": {
    "$schema": {"const": "../../docs/project/schema/v2-setting-inventory.schema.json"},
    "schema_version": {"const": "openttd-rl-v2-setting-inventory-1"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_date": {"type": "string", "format": "date"},
    "engine_source": {"type": "object", "additionalProperties": false, "required": ["release", "commit", "tree"], "properties": {"release": {"const": "15.3"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "source_root": {"const": "src/table/settings"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["definition_granularity", "duplicates_retained", "source_order_retained", "secret_values_forbidden", "scenario_and_competition_manifests_pin_applicable_values", "presentation_settings_never_enter_policy_input"],
      "properties": {
        "definition_granularity": {"const": "one-row-per-SD-section-at-pinned-commit"},
        "duplicates_retained": {"const": true},
        "source_order_retained": {"const": true},
        "secret_values_forbidden": {"const": true},
        "scenario_and_competition_manifests_pin_applicable_values": {"const": true},
        "presentation_settings_never_enter_policy_input": {"const": true}
      }
    },
    "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_file"}},
    "definitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/definition"}},
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["source_files", "definitions", "unique_setting_keys", "duplicate_key_definitions", "by_scope", "by_disposition"],
      "properties": {
        "source_files": {"type": "integer", "minimum": 1},
        "definitions": {"type": "integer", "minimum": 1},
        "unique_setting_keys": {"type": "integer", "minimum": 1},
        "duplicate_key_definitions": {"type": "integer", "minimum": 0},
        "by_scope": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_disposition": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "definition_count", "disposition", "rationale_code"],
      "properties": {
        "path": {"type": "string", "pattern": "^src/table/settings/[a-z0-9_]+_settings\\.ini$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "definition_count": {"type": "integer", "minimum": 1},
        "disposition": {"$ref": "#/$defs/disposition"},
        "rationale_code": {"$ref": "#/$defs/rationale"}
      }
    },
    "definition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_file", "source_ordinal", "kind", "scope", "setting_key", "storage_variable", "flags", "default_expression", "minimum_expression", "maximum_expression", "from_version", "to_version", "disposition", "rationale_code"],
      "properties": {
        "id": {"type": "string", "pattern": "^V2-SETTING-[0-9]{4}$"},
        "source_file": {"type": "string", "pattern": "^src/table/settings/[a-z0-9_]+_settings\\.ini$"},
        "source_ordinal": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "pattern": "^SD[A-Z0-9_]+$"},
        "scope": {"enum": ["GAME", "CLIENT", "GLOBAL"]},
        "setting_key": {"type": "string", "minLength": 1},
        "storage_variable": {"type": "string", "minLength": 1},
        "flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}},
        "default_expression": {"type": ["string", "null"]},
        "minimum_expression": {"type": ["string", "null"]},
        "maximum_expression": {"type": ["string", "null"]},
        "from_version": {"type": ["string", "null"]},
        "to_version": {"type": ["string", "null"]},
        "disposition": {"$ref": "#/$defs/disposition"},
        "rationale_code": {"$ref": "#/$defs/rationale"}
      }
    },
    "disposition": {"enum": ["SCENARIO_PIN", "COMPANY_PIN", "HARNESS_PIN", "PRESENTATION_ONLY", "SECRET_FORBIDDEN", "LEGACY_LOAD_ONLY"]},
    "rationale": {"enum": ["native-simulation", "per-company-behavior", "competition-runtime", "non-simulation-client-presentation", "credential-material", "historical-save-compatibility"]}
  }
}
