{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/docs/project/schema/v1-dependency-provenance-manifest.schema.json",
  "title": "OpenTTD RL V1 dependency provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inputs",
    "openttd_source",
    "toolchain_artifacts",
    "build_overlay_packages",
    "opengfx",
    "runtime_dependencies",
    "result",
    "provenance_identity_sha256"
  ],
  "properties": {
    "schema_version": { "const": "openttd-rl-v1-dependency-provenance-manifest-1" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_lock_sha256",
        "build_input_lock_sha256",
        "headless_build_identity_sha256",
        "playable_build_identity_sha256"
      ],
      "properties": {
        "dependency_lock_sha256": { "$ref": "#/$defs/sha256" },
        "build_input_lock_sha256": { "$ref": "#/$defs/sha256" },
        "headless_build_identity_sha256": { "$ref": "#/$defs/sha256" },
        "playable_build_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "openttd_source": { "$ref": "#/$defs/source_record" },
    "toolchain_artifacts": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/toolchain_record" }
    },
    "build_overlay_packages": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": { "$ref": "#/$defs/package_record" }
    },
    "opengfx": { "$ref": "#/$defs/package_record" },
    "runtime_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtime_record" }
    },
    "result": { "const": "PASS" },
    "provenance_identity_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "url": { "type": "string", "pattern": "^https?://\\S+$" },
    "license_declarations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "source_url", "license", "distribution_status"],
      "properties": {
        "id": { "const": "openttd" },
        "version": { "const": "15.3" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_url": { "$ref": "#/$defs/url" },
        "license": { "const": "GPL-2.0-only" },
        "distribution_status": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "version",
        "sha256",
        "source_url",
        "license",
        "license_evidence",
        "distribution_status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_url": { "$ref": "#/$defs/url" },
        "license": { "type": "string", "minLength": 1 },
        "license_evidence": { "type": "string", "minLength": 1 },
        "distribution_status": { "type": "string", "minLength": 1 }
      }
    },
    "package_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "source_package",
        "version",
        "architecture",
        "sha256",
        "source_url",
        "license_declarations",
        "license_evidence_sha256",
        "distribution_status"
      ],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "source_package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_url": { "$ref": "#/$defs/url" },
        "license_declarations": { "$ref": "#/$defs/license_declarations" },
        "license_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "distribution_status": { "type": "string", "minLength": 1 }
      }
    },
    "runtime_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soname",
        "providers",
        "origin",
        "package",
        "source_package",
        "version",
        "sha256",
        "source_url",
        "license_declarations",
        "license_evidence_sha256",
        "distribution_status"
      ],
      "properties": {
        "soname": { "type": "string", "minLength": 1 },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["headless", "playable"] }
        },
        "origin": { "enum": ["locked-build-overlay", "host-runtime"] },
        "package": { "type": "string", "minLength": 1 },
        "source_package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_url": { "$ref": "#/$defs/url" },
        "license_declarations": { "$ref": "#/$defs/license_declarations" },
        "license_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "distribution_status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
