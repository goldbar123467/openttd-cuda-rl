    "environment_boundary": {"type": "object"},
    "policy_interface": {"type": "object"},
    "architectures": {"type": "array", "minItems": 3, "maxItems": 3},
    "ppo": {"type": "object"},
    "seeds": {"type": "object"},
    "curriculum": {"type": "object"},
    "device": {"type": "object"},
    "checkpoint": {"type": "object"},
    "selection": {"type": "object"},
    "independent_evaluation": {"type": "object"},
    "acceptance": {"type": "object"}
  }
}
