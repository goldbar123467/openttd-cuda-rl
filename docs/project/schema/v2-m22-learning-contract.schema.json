    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_date": {"const": "2026-08-03"},
    "contract_id": {"const": "m22-generalist-learning-v2"},
    "semantic_version": {"const": 2},
    "status": {"const": "FROZEN"},
