{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.invalid/schema/v1-m07-live-cpu-run.schema.json",
  "title": "OpenTTD-RL V1 M07 live CPU PPO run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "compatibility", "configuration", "checkpoint", "elapsed_ns", "evaluation", "scenario_partitions", "repository_commit", "training", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "openttd-rl-v1-m07-live-cpu-run-1"},
    "status": {"enum": ["PASS", "READINESS_NOT_MET"]},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["m06_source_identity", "openttd_executable_sha256", "ppo", "trainer_executable_sha256"],
      "properties": {
        "m06_source_identity": {"$ref": "#/$defs/sha256"},
        "openttd_executable_sha256": {"$ref": "#/$defs/sha256"},
        "ppo": {"$ref": "#/$defs/sha256"},
        "trainer_executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_count", "evaluation_steps", "minibatch_size", "optimization_epochs", "rollout_length", "run_seed", "updates"],
      "properties": {
        "environment_count": {"const": 4},
        "evaluation_steps": {"type": "integer", "minimum": 1},
        "minibatch_size": {"const": 32},
        "optimization_epochs": {"const": 4},
        "rollout_length": {"const": 32},
        "run_seed": {"const": 2026080107},
        "updates": {"type": "integer", "minimum": 16}
      }
    },
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "elapsed_ns": {"type": "integer", "minimum": 1},
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["candidates", "improved_over_random", "random", "selected", "selected_update"],
      "properties": {
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
        "improved_over_random": {"type": "boolean"},
        "random": {"$ref": "#/$defs/evaluation"},
        "selected": {"$ref": "#/$defs/evaluation"},
        "selected_update": {"type": "integer", "minimum": 16}
      }
    },
    "scenario_partitions": {
      "type": "object", "additionalProperties": false,
      "required": ["development", "final_evaluation_accessed", "training"],
      "properties": {
        "development": {"const": ["m02-template-05", "m02-template-06"]},
        "final_evaluation_accessed": {"const": false},
        "training": {"const": ["m02-template-01", "m02-template-02", "m02-template-03", "m02-template-04"]}
      }
    },
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["completed_episodes", "summary", "updates"],
      "properties": {
        "completed_episodes": {"type": "array", "items": {"$ref": "#/$defs/training_episode"}},
        "summary": {"type": "object"},
        "updates": {"type": "array", "minItems": 16, "items": {"$ref": "#/$defs/update"}}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["id", "path"],
      "properties": {"id": {"$ref": "#/$defs/sha256"}, "path": {"type": "string", "pattern": "^checkpoints/[0-9a-f]{64}$"}}
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["delivered_passengers", "income", "length", "return", "routes", "template_id", "vehicles"],
      "properties": {
        "delivered_passengers": {"type": "integer", "minimum": 0}, "income": {"type": "integer"},
        "length": {"type": "integer", "minimum": 1}, "return": {"type": "number"},
        "routes": {"type": "integer", "minimum": 0}, "template_id": {"type": "string", "pattern": "^m02-template-[0-9]{2}$"},
        "vehicles": {"type": "integer", "minimum": 0}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["episodes", "mean_delivered_passengers", "mean_return", "service_successes"],
      "properties": {
        "episodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/episode"}},
        "mean_delivered_passengers": {"type": "number", "minimum": 0}, "mean_return": {"type": "number"},
        "service_successes": {"type": "integer", "minimum": 0}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["checkpoint", "eligible", "evaluation", "update"],
      "properties": {"checkpoint": {"$ref": "#/$defs/checkpoint"}, "eligible": {"type": "boolean"}, "evaluation": {"$ref": "#/$defs/evaluation"}, "update": {"type": "integer", "minimum": 16}}
    },
    "training_episode": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_id", "episode_index", "length", "reason", "return", "template_id"],
      "properties": {
        "environment_id": {"type": "integer", "minimum": 0, "maximum": 3}, "episode_index": {"type": "integer", "minimum": 0},
        "length": {"type": "integer", "minimum": 1}, "reason": {"type": "string"}, "return": {"type": "number"},
        "template_id": {"type": "string", "pattern": "^m02-template-0[1-4]$"}
      }
    },
    "update": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_loss", "value_loss", "entropy", "approximate_kl", "clip_fraction", "gradient_norm", "explained_variance", "learning_rate", "update", "samples", "mean_rollout_reward", "minimum_rollout_reward", "maximum_rollout_reward"],
      "properties": {
        "policy_loss": {"type": "number"}, "value_loss": {"type": "number"}, "entropy": {"type": "number"},
        "approximate_kl": {"type": "number"}, "clip_fraction": {"type": "number"}, "gradient_norm": {"type": "number"},
        "explained_variance": {"type": "number"}, "learning_rate": {"type": "number"}, "update": {"type": "integer", "minimum": 1},
        "samples": {"type": "integer", "minimum": 1}, "mean_rollout_reward": {"type": "number"},
        "minimum_rollout_reward": {"type": "number"}, "maximum_rollout_reward": {"type": "number"}
      }
    }
  }
}
