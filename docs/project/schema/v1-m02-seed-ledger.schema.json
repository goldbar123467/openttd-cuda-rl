{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/docs/project/schema/v1-m02-seed-ledger.schema.json",
  "title": "OpenTTD RL V1 M02 disjoint seed ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_compatibility_sha256",
    "corpus_sha256",
    "sets_must_be_disjoint",
    "entries",
    "identity"
  ],
  "properties": {
    "$schema": { "const": "../../docs/project/schema/v1-m02-seed-ledger.schema.json" },
    "schema_version": { "const": "openttd-rl-v1-m02-seed-ledger-1" },
    "contract_compatibility_sha256": { "$ref": "#/$defs/sha256" },
    "corpus_sha256": { "$ref": "#/$defs/sha256" },
    "sets_must_be_disjoint": { "const": true },
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seed", "split", "template_id", "trainer_visible"],
        "properties": {
          "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "split": {
            "type": "string",
            "enum": ["training", "development", "final-evaluation"]
          },
          "template_id": { "type": "string", "pattern": "^m02-template-0[1-8]$" },
          "trainer_visible": { "type": "boolean" }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "ledger_sha256", "schema_path", "schema_sha256"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json-v1" },
        "ledger_sha256": { "$ref": "#/$defs/sha256" },
        "schema_path": { "const": "docs/project/schema/v1-m02-seed-ledger.schema.json" },
        "schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
