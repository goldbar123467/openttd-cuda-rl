{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/docs/project/schema/v2-research-baseline.schema.json",
  "title": "OpenTTD RL V2 research, feature, command, map, and opponent baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "schema_sha256",
    "snapshot_date",
    "engine",
    "scope",
    "maps",
    "feature_domains",
    "command_dispositions",
    "command_sentinel",
    "opponents",
    "user_ai_name_resolution",
    "research_sources"
  ],
  "properties": {
    "$schema": {"const": "../../docs/project/schema/v2-research-baseline.schema.json"},
    "schema_version": {"const": "openttd-rl-v2-research-1"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_date": {"type": "string", "format": "date"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "commit", "tree", "object_repository", "command_source"],
      "properties": {
        "release": {"const": "15.3"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "object_repository": {"const": "openttd-upstream"},
        "command_source": {"const": "src/command_type.h"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1_regression_required", "base_game_gameplay_complete", "newgrf_policy", "non_gameplay_application_surfaces"],
      "properties": {
        "v1_regression_required": {"const": true},
        "base_game_gameplay_complete": {"const": true},
        "newgrf_policy": {"enum": ["pinned-compatibility-pack-plus-capability-discovery"]},
        "non_gameplay_application_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "maps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1_compatibility", "native_side_lengths", "native_rectangle_count", "curriculum", "generalization", "resource_boundary", "coverage_rule"],
      "properties": {
        "v1_compatibility": {"const": [[32, 32]]},
        "native_side_lengths": {"const": [64, 128, 256, 512, 1024, 2048, 4096]},
        "native_rectangle_count": {"const": 49},
        "curriculum": {"const": [[64, 64], [128, 128], [256, 256], [512, 512]]},
        "generalization": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dimensions"}
        },
        "resource_boundary": {"const": [[2048, 2048], [4096, 4096]]},
        "coverage_rule": {"type": "string", "minLength": 1}
      }
    },
    "feature_domains": {
      "type": "array",
      "minItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/feature_domain"}
    },
    "command_dispositions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/command_disposition"}
    },
    "command_sentinel": {"const": "CMD_END"},
    "opponents": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opponent"}
    },
    "user_ai_name_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "exact_catalog_match", "candidates", "policy"],
      "properties": {
        "query": {"const": "minimax 2 or minimax 3"},
        "exact_catalog_match": {"const": false},
        "candidates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "policy": {"type": "string", "minLength": 1}
      }
    },
    "research_sources": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimensions": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 32, "maximum": 4096}, {"type": "integer", "minimum": 32, "maximum": 4096}],
      "minItems": 2,
      "maxItems": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "url", "retrieved"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "kind": {"enum": ["official-manual", "official-api", "official-catalog", "primary-package", "research-reference"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "retrieved": {"type": "string", "format": "date"}
      }
    },
    "feature_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "gate", "status", "source_ids", "acceptance_families"],
      "properties": {
        "id": {"type": "string", "pattern": "^V2-FEAT-[0-9]{3}$"},
        "summary": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "pattern": "^G(?:1[4-9]|2[0-3])$"},
        "status": {"enum": ["RESEARCHED", "IN_PROGRESS", "PASS"]},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "acceptance_families": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["contract", "native-positive", "native-negative", "differential", "save-load", "determinism", "resource", "learning", "competition", "deployment", "v1-regression"]}
        }
      }
    },
    "command_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning", "commands"],
      "properties": {
        "id": {"enum": ["policy-required", "policy-optional", "benchmark-admin"]},
        "meaning": {"type": "string", "minLength": 1},
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CMD_[A-Z0-9_]+$"}
        }
      }
    },
    "opponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "name", "version", "license", "package_url", "project_url", "advertised_modes", "benchmark_roles", "snapshot_status", "limitations"],
      "properties": {
        "content_id": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "package_url": {"type": "string", "format": "uri", "pattern": "^https://bananas\\.openttd\\.org/package/ai/"},
        "project_url": {"type": "string", "format": "uri"},
        "advertised_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["none", "road", "tram", "rail", "ship", "air"]}
        },
        "benchmark_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "snapshot_status": {"const": "METADATA_ONLY_UNQUALIFIED"},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
