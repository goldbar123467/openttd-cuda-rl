{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.invalid/schema/v2-m15-episode-evidence.schema.json",
  "title": "OpenTTD RL V2 M15 stateful lifecycle and replay evidence",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "schema_sha256", "snapshot_date", "contract_sha256", "action_contract_sha256", "action_source_sha256", "episode_source_sha256", "program_schema_sha256", "trace_schema_sha256", "program_sha256", "executable", "artifact_base_hint", "artifact_root", "runs", "determinism", "policy", "summary"],
  "properties": {
    "$schema": {"const": "../../docs/project/schema/v2-m15-episode-evidence.schema.json"},
    "schema_version": {"const": "openttd-rl-v2-m15-episode-evidence-1"}, "schema_sha256": {"$ref": "#/$defs/sha256"}, "snapshot_date": {"const": "2026-08-02"},
    "contract_sha256": {"$ref": "#/$defs/sha256"}, "action_contract_sha256": {"$ref": "#/$defs/sha256"}, "action_source_sha256": {"$ref": "#/$defs/sha256"}, "episode_source_sha256": {"$ref": "#/$defs/sha256"}, "program_schema_sha256": {"$ref": "#/$defs/sha256"}, "trace_schema_sha256": {"$ref": "#/$defs/sha256"}, "program_sha256": {"$ref": "#/$defs/sha256"},
    "executable": {"type": "object", "additionalProperties": false, "required": ["sha256", "size"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1000000}}},
    "artifact_base_hint": {"type": "string"}, "artifact_root": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "runs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/run"}},
    "determinism": {"type": "object", "additionalProperties": false, "required": ["primary_artifact_dir", "repeat_artifact_dir", "trace_sha256", "byte_identical"], "properties": {"primary_artifact_dir": {"const": "run-a"}, "repeat_artifact_dir": {"const": "run-b"}, "trace_sha256": {"$ref": "#/$defs/sha256"}, "byte_identical": {"const": true}}},
    "policy": {"const": {"all_twelve_families_executed": true, "authoritative_native_commands": true, "exact_tick_advancement": true, "native_save_load": true, "state_save_observation_candidate_replay_exact": true, "full_program_repeat_exact": true, "g15_pass_claim": false}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["runs", "passed", "transitions_per_run", "action_steps_per_run", "native_commands_per_run", "maximum_rss_kib", "maximum_wall_seconds"], "properties": {"runs": {"const": 2}, "passed": {"const": 2}, "transitions_per_run": {"const": 16}, "action_steps_per_run": {"const": 16}, "native_commands_per_run": {"type": "integer", "minimum": 12}, "maximum_rss_kib": {"type": "integer", "minimum": 1}, "maximum_wall_seconds": {"type": "number", "exclusiveMinimum": 0}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["executions", "family_index", "name"], "properties": {"executions": {"type": "integer", "minimum": 1}, "family_index": {"type": "integer", "minimum": 0, "maximum": 11}, "name": {"type": "string"}}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["slot", "bytes", "save_sha256", "loads"], "properties": {"slot": {"const": "route-ready"}, "bytes": {"type": "integer", "minimum": 1}, "save_sha256": {"$ref": "#/$defs/sha256"}, "loads": {"const": 2}}},
    "replay": {"type": "object", "additionalProperties": false, "required": ["group", "captures", "state_sha256", "save_sha256", "observation_sha256", "candidate_sha256", "candidate_semantic_sha256", "status"], "properties": {"group": {"const": "save-load-suffix"}, "captures": {"const": 2}, "state_sha256": {"$ref": "#/$defs/sha256"}, "save_sha256": {"$ref": "#/$defs/sha256"}, "observation_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "candidate_semantic_sha256": {"$ref": "#/$defs/sha256"}, "status": {"const": "EXACT"}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["family", "injected_command", "native_commands", "rolled_back", "state_exact", "tick_delta"], "properties": {"family": {"const": "SET_ROUTE"}, "injected_command": {"const": "CMD_INSERT_ORDER"}, "native_commands": {"const": 6}, "rolled_back": {"const": true}, "state_exact": {"const": true}, "tick_delta": {"const": 0}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["artifact_dir", "outcome", "projection_sha256", "trace_sha256", "maximum_rss_kib", "wall_seconds", "transitions", "action_steps", "native_commands", "coverage", "rollback", "checkpoint", "replay", "initial_state_sha256", "final_state_sha256"], "properties": {"artifact_dir": {"enum": ["run-a", "run-b"]}, "outcome": {"const": "PASS"}, "projection_sha256": {"$ref": "#/$defs/sha256"}, "trace_sha256": {"$ref": "#/$defs/sha256"}, "maximum_rss_kib": {"type": "integer", "minimum": 1}, "wall_seconds": {"type": "number", "exclusiveMinimum": 0}, "transitions": {"const": 16}, "action_steps": {"const": 16}, "native_commands": {"type": "integer", "minimum": 18}, "coverage": {"$ref": "#/$defs/coverage"}, "rollback": {"$ref": "#/$defs/rollback"}, "checkpoint": {"$ref": "#/$defs/checkpoint"}, "replay": {"$ref": "#/$defs/replay"}, "initial_state_sha256": {"$ref": "#/$defs/sha256"}, "final_state_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
