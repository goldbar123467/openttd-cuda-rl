{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbar123467.github.io/openttd-cuda-rl/docs/project/schema/requirements-v2.schema.json",
  "title": "OpenTTD RL V2 atomic requirements and test traceability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "schema_sha256", "registry_kind", "scope", "source_authorities", "gate_order", "requirements", "tests", "pass_policy"],
  "properties": {
    "$schema": {"const": "schema/requirements-v2.schema.json"},
    "schema_version": {"const": 1},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "registry_kind": {"const": "openttd-rl-v2-project-requirements"},
    "scope": {"const": "V2-M14-through-M23"},
    "source_authorities": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    },
    "gate_order": {"const": ["G14", "G15", "G16", "G17", "G18", "G19", "G20", "G21", "G22", "G23"]},
    "requirements": {
      "type": "array",
      "minItems": 80,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "tests": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/test"}
    },
    "pass_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_requires_implementation", "pass_requires_test_pass", "pass_requires_evidence", "later_gate_cannot_weaken_earlier_gate", "v1_regression_mandatory"],
      "properties": {
        "pass_requires_implementation": {"const": true},
        "pass_requires_test_pass": {"const": true},
        "pass_requires_evidence": {"const": true},
        "later_gate_cannot_weaken_earlier_gate": {"const": true},
        "v1_regression_mandatory": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "requirement_id": {"type": "string", "pattern": "^V2-[A-Z]+-[0-9]{3}$"},
    "test_id": {"type": "string", "pattern": "^V2-TEST-[A-Z0-9][A-Z0-9-]*$"},
    "milestone": {"type": "string", "pattern": "^M(?:1[4-9]|2[0-3])$"},
    "gate": {"type": "string", "pattern": "^G(?:1[4-9]|2[0-3])$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "role"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "path": {"$ref": "#/$defs/relative_path"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mandatory", "milestone", "gate", "status", "summary", "acceptance", "source_refs", "depends_on", "implementation", "test_ids", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/requirement_id"},
        "mandatory": {"const": true},
        "milestone": {"$ref": "#/$defs/milestone"},
        "gate": {"$ref": "#/$defs/gate"},
        "status": {"enum": ["PLANNED", "IN_PROGRESS", "PASS", "BLOCKED"]},
        "summary": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "implementation": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relative_path"}},
        "test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/test_id"}},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relative_path"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {"properties": {"implementation": {"minItems": 1}, "evidence": {"minItems": 1}}}
        }
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gate", "status", "summary", "runner", "requirement_ids", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/test_id"},
        "gate": {"$ref": "#/$defs/gate"},
        "status": {"enum": ["PLANNED", "IMPLEMENTED", "PASS", "FAIL", "BLOCKED"]},
        "summary": {"type": "string", "minLength": 1},
        "runner": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement_id"}},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relative_path"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["IMPLEMENTED", "PASS"]}}, "required": ["status"]},
          "then": {"properties": {"runner": {"$ref": "#/$defs/relative_path"}}}
        },
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        }
      ]
    }
  }
}
