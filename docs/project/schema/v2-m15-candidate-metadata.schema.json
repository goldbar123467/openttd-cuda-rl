{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.invalid/schema/v2-m15-candidate-metadata.schema.json",
  "title": "OpenTTD RL V2 M15 native candidate metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_schema_id", "contract_sha256", "binary", "families", "observation_sha256", "records", "sections", "snapshot"],
  "properties": {
    "schema_version": {"const": "openttd-rl-v2-m15-candidate-metadata-1"},
    "action_schema_id": {"const": "v2-m15-hierarchical-action-v1"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "binary": {
      "type": "object", "additionalProperties": false, "required": ["bytes", "encoding", "file", "sha256"],
      "properties": {
        "bytes": {"const": 790528}, "encoding": {"const": "features-float32-le-then-parameters-uint32-le-then-mask-uint8"},
        "file": {"const": "candidate-metadata.bin"}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "families": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/family"}},
    "observation_sha256": {"$ref": "#/$defs/sha256"},
    "records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/record"}},
    "sections": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/section"}},
    "snapshot": {
      "type": "object", "additionalProperties": false, "required": ["episode", "map_seed", "session", "simulation_seed", "snapshot_token", "tick", "transition"],
      "properties": {
        "episode": {"const": 0}, "map_seed": {"$ref": "#/$defs/u32"}, "session": {"type": "string", "pattern": "^session-[0-9]+-[0-9]+$"},
        "simulation_seed": {"$ref": "#/$defs/u32"}, "snapshot_token": {"type": "string", "pattern": "^m15a1:[0-9a-f]{64}$"},
        "tick": {"type": "integer", "minimum": 0}, "transition": {"const": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["family_index", "name", "omitted_legal", "quota", "row_begin", "row_end", "selected_legal", "total_legal"],
      "properties": {
        "family_index": {"type": "integer", "minimum": 0, "maximum": 11}, "name": {"type": "string", "minLength": 1},
        "omitted_legal": {"type": "integer", "minimum": 0}, "quota": {"type": "integer", "minimum": 1},
        "row_begin": {"type": "integer", "minimum": 0, "maximum": 4095}, "row_end": {"type": "integer", "minimum": 1, "maximum": 4096},
        "selected_legal": {"type": "integer", "minimum": 0}, "total_legal": {"type": "integer", "minimum": 0}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false, "required": ["cost", "family_index", "parameters", "priority", "row", "stable_key"],
      "properties": {
        "cost": {"type": "integer"}, "family_index": {"type": "integer", "minimum": 0, "maximum": 11},
        "parameters": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/u32"}},
        "priority": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "row": {"type": "integer", "minimum": 0, "maximum": 4095},
        "stable_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false, "required": ["bytes", "dtype", "name", "offset", "shape"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1}, "dtype": {"enum": ["float32-le", "uint32-le", "uint8"]},
        "name": {"enum": ["features", "parameters", "mask"]}, "offset": {"type": "integer", "minimum": 0},
        "shape": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}
      }
    }
  }
}
