{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.invalid/schema/v1-toolchain-probe-manifest.schema.json",
  "title": "OpenTTD RL V1 reproducible toolchain probe manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_sha256",
    "profile_id",
    "inputs",
    "host",
    "tools",
    "dependencies",
    "cmake",
    "products",
    "tests",
    "result",
    "probe_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "openttd-rl-v1-toolchain-probe-manifest-1"
    },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "profile_id": {
      "const": "ubuntu-24.04-wsl2-x86_64-cuda13"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_lock_sha256",
        "dependency_schema_sha256",
        "probe_sources"
      ],
      "properties": {
        "dependency_lock_sha256": { "$ref": "#/$defs/sha256" },
        "dependency_schema_sha256": { "$ref": "#/$defs/sha256" },
        "probe_sources": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/hashed_file" }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "os", "cpu_model", "gpus"],
      "properties": {
        "architecture": { "const": "x86_64" },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version_id"],
          "properties": {
            "id": { "const": "ubuntu" },
            "version_id": { "const": "24.04" }
          }
        },
        "cpu_model": { "type": "string", "minLength": 1 },
        "gpus": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gpu" }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gcc",
        "gxx",
        "cmake",
        "ctest",
        "ninja",
        "nvcc",
        "cuobjdump",
        "python",
        "glibc"
      ],
      "properties": {
        "gcc": { "const": "13.3.0" },
        "gxx": { "const": "13.3.0" },
        "cmake": { "const": "3.28.3" },
        "ctest": { "const": "3.28.3" },
        "ninja": { "const": "1.11.1" },
        "nvcc": { "const": "13.0.88" },
        "cuobjdump": { "const": "13.0.85" },
        "python": { "type": "string", "pattern": "^3\\.12\\.[0-9]+$" },
        "glibc": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache", "libtorch", "onnxruntime", "nvidia_runtime", "exporter"],
      "properties": {
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_count", "extraction_count", "total_artifact_bytes", "result"],
          "properties": {
            "artifact_count": { "const": 25 },
            "extraction_count": { "const": 6 },
            "total_artifact_bytes": { "const": 1556894253 },
            "result": { "const": "PASS" }
          }
        },
        "libtorch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "cuda", "cxx11_abi", "result"],
          "properties": {
            "version": { "const": "2.13.0+cu130" },
            "cuda": { "const": "13.0" },
            "cxx11_abi": { "const": 1 },
            "result": { "const": "PASS" }
          }
        },
        "onnxruntime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "provider", "result"],
          "properties": {
            "version": { "const": "1.28.0" },
            "provider": { "const": "CPUExecutionProvider" },
            "result": { "const": "PASS" }
          }
        },
        "nvidia_runtime": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "exporter": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/distribution" }
        }
      }
    },
    "cmake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "build_type",
        "cxx_standard",
        "cuda_standard",
        "cuda_architectures",
        "required_components",
        "result"
      ],
      "properties": {
        "generator": { "const": "Ninja" },
        "build_type": { "const": "Release" },
        "cxx_standard": { "const": 20 },
        "cuda_standard": { "const": 20 },
        "cuda_architectures": {
          "const": ["120-real", "120-virtual"]
        },
        "required_components": {
          "const": [
            "CUDAToolkit::cudart",
            "LibTorch::Torch",
            "NVIDIA::cuDNN",
            "NVIDIA::cuSPARSELt",
            "NVIDIA::NCCL",
            "NVIDIA::NVSHMEM",
            "ONNXRuntime::CPU"
          ]
        },
        "result": { "const": "PASS" }
      }
    },
    "products": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onnx_model", "native_binaries", "cuda_images", "runtime_dependencies"],
      "properties": {
        "onnx_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opset", "operators", "sha256"],
          "properties": {
            "opset": { "const": 18 },
            "operators": { "const": ["Add", "MatMul", "Relu"] },
            "sha256": {
              "const": "2d1bbd70474ae0eae9b97b3349b1285d09b8bca577487a67c24823cdbdc6b31d"
            }
          }
        },
        "native_binaries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": {
                "enum": ["v1_cuda_probe", "v1_libtorch_probe", "v1_onnxruntime_probe"]
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "cuda_images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cubin_sm", "ptx_compute"],
          "properties": {
            "cubin_sm": { "const": ["120"] },
            "ptx_compute": { "const": ["120"] }
          }
        },
        "runtime_dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["v1_cuda_probe", "v1_libtorch_probe", "v1_onnxruntime_probe"],
          "properties": {
            "v1_cuda_probe": { "$ref": "#/$defs/sonames" },
            "v1_libtorch_probe": { "$ref": "#/$defs/sonames" },
            "v1_onnxruntime_probe": { "$ref": "#/$defs/sonames" }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": {
            "enum": [
              "v1-cuda-sm120-real-ptx",
              "v1-libtorch-cpu-cuda-abi",
              "v1-onnxruntime-cpu-abi",
              "v1-onnxruntime-opset18-graph"
            ]
          },
          "result": { "const": "PASS" }
        }
      }
    },
    "result": { "const": "PASS" },
    "probe_identity_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9+._/-]+$"
    },
    "hashed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "compute_capability", "memory_total_mib", "driver_version"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "compute_capability": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "memory_total_mib": { "type": "integer", "minimum": 1 },
        "driver_version": { "type": "string", "pattern": "^[0-9.]+$" }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "sonames": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
