{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.invalid/schema/v2-m22-native-corpus.schema.json",
  "title": "OpenTTD-RL V2 M22 native-qualified learning corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "schema_sha256", "snapshot_date", "corpus_id", "status", "sources", "programs", "reward", "entries", "summary"],
  "properties": {
    "$schema": {"const": "../../docs/project/schema/v2-m22-native-corpus.schema.json"},
    "schema_version": {"const": "openttd-rl-v2-m22-native-corpus-1"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_date": {"const": "2026-08-02"},
    "corpus_id": {"const": "m22-native-qualified-program-corpus-v1"},
    "status": {"const": "FROZEN"},
    "sources": {"type": "array", "minItems": 7, "maxItems": 7},
    "programs": {"type": "array", "minItems": 17, "maxItems": 17},
    "reward": {"type": "object"},
    "entries": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_id", "split", "sampler_seed", "program", "public_state", "legal_programs", "rewards", "native"],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^(training|development)-[a-z0-9-]+$"},
          "split": {"enum": ["training", "development"]},
          "sampler_seed": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "program": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "public_state": {"type": "object"},
          "legal_programs": {"type": "array", "minItems": 2, "maxItems": 2},
          "rewards": {"type": "object"},
          "native": {"type": "object"}
        }
      }
    },
    "summary": {"type": "object"}
  }
}
