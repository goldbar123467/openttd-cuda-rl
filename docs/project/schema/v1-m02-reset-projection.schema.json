{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.invalid/schema/v1-m02-reset-projection.schema.json",
  "title": "OpenTTD RL M02 native reset projection report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection",
    "same_process_byte_identical",
    "same_process_repetitions",
    "schema_version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "openttd-rl-v1-m02-reset-projection-1"
    },
    "status": {
      "const": "PASS"
    },
    "same_process_byte_identical": {
      "const": true
    },
    "same_process_repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companies",
        "compatibility",
        "content",
        "depots",
        "economy",
        "map",
        "orders",
        "pools",
        "rng-streams",
        "roads",
        "scenario",
        "settings",
        "stations",
        "time",
        "towns",
        "vehicles"
      ],
      "properties": {
        "companies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "object"}
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_sha256", "corpus_sha256", "ledger_sha256"],
          "properties": {
            "contract_sha256": {"$ref": "#/$defs/sha256"},
            "corpus_sha256": {"$ref": "#/$defs/sha256"},
            "ledger_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "content": {"type": "object"},
        "depots": {"type": "array", "maxItems": 0},
        "economy": {"type": "object"},
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["height", "terrain_height", "tile_type_counts", "tiles", "width"],
          "properties": {
            "height": {"const": 32},
            "terrain_height": {"const": 1},
            "tile_type_counts": {
              "type": "array",
              "minItems": 11,
              "maxItems": 11,
              "items": {"type": "integer", "minimum": 0, "maximum": 1024}
            },
            "tiles": {
              "type": "array",
              "minItems": 1024,
              "maxItems": 1024,
              "items": {"type": "object"}
            },
            "width": {"const": 32}
          }
        },
        "orders": {"type": "array", "maxItems": 0},
        "pools": {"type": "object"},
        "rng-streams": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interactive", "simulation"],
          "properties": {
            "interactive": {"$ref": "#/$defs/rng_state"},
            "simulation": {"$ref": "#/$defs/rng_state"}
          }
        },
        "roads": {"type": "array", "items": {"type": "object"}},
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planned_construction", "scenario_sha256", "seed", "split", "template_id"],
          "properties": {
            "planned_construction": {"type": "object"},
            "scenario_sha256": {"$ref": "#/$defs/sha256"},
            "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "split": {"enum": ["training", "development", "final-evaluation"]},
            "template_id": {"type": "string", "pattern": "^m02-template-[0-9]{2}$"}
          }
        },
        "settings": {"type": "object"},
        "stations": {"type": "array", "maxItems": 0},
        "time": {"type": "object"},
        "towns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "object"}
        },
        "vehicles": {"type": "array", "maxItems": 0}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rng_state": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    }
  }
}
