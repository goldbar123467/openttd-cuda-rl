{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenTTD-RL V2 M17 rail evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "artifact_root", "contract_sha256", "source_sha256", "executable_sha256", "execution", "baselines", "aggregate", "cases"],
  "properties": {
    "schema_version": {"const": "openttd-rl-v2-m17-rail-evidence-1"},
    "status": {"const": "PASS"},
    "artifact_root": {"type": "string"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "executable_sha256": {"$ref": "#/$defs/sha256"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "process_limits", "network_calls"],
      "properties": {
        "sandbox": {"enum": ["bubblewrap", "rlimit-only"]},
        "process_limits": {"const": true},
        "network_calls": {"const": "none"}
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialist_qualified", "specialist_name", "specialist_runtime_evidence_sha256", "choochoo_rejection_retained", "passenger_beats_zero_service", "freight_beats_zero_service"],
      "properties": {
        "specialist_qualified": {"const": true},
        "specialist_name": {"const": "AAAHogEx"},
        "specialist_runtime_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "choochoo_rejection_retained": {"const": true},
        "passenger_beats_zero_service": {"const": true},
        "freight_beats_zero_service": {"const": true}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "native_runs", "twin_exact_cases", "rail_types", "train_engine_entries", "track_orientations", "signal_variants", "construction_pass", "lifecycle_pass", "passenger_pass", "freight_pass", "stress_pass", "maximum_wall_seconds"],
      "properties": {
        "cases": {"const": 14},
        "native_runs": {"const": 28},
        "twin_exact_cases": {"const": 14},
        "rail_types": {"const": 4},
        "train_engine_entries": {"const": 116},
        "track_orientations": {"const": 6},
        "signal_variants": {"const": 12},
        "construction_pass": {"const": true},
        "lifecycle_pass": {"const": true},
        "passenger_pass": {"const": true},
        "freight_pass": {"const": true},
        "stress_pass": {"const": true},
        "maximum_wall_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "cargo", "probe", "seed", "metrics", "twin_exact", "twins"],
        "properties": {
          "case_id": {"type": "string"},
          "cargo": {"type": "string", "pattern": "^[A-Z0-9_]{4}$"},
          "probe": {"enum": ["catalog", "construction", "signals", "lifecycle", "passenger", "freight", "stress"]},
          "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "twin_exact": {"const": true},
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["income", "delivered", "ticks"],
            "properties": {
              "income": {"type": "integer", "minimum": 0},
              "delivered": {"type": "integer", "minimum": 0},
              "ticks": {"type": "integer", "minimum": 0}
            }
          },
          "twins": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "report_path", "report_sha256", "normalized_sha256", "wall_seconds"],
              "properties": {
                "name": {"enum": ["a", "b"]},
                "report_path": {"type": "string"},
                "report_sha256": {"$ref": "#/$defs/sha256"},
                "normalized_sha256": {"$ref": "#/$defs/sha256"},
                "wall_seconds": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
