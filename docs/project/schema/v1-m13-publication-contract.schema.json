{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-rl.local/schema/v1-m13-publication-contract.schema.json",
  "title": "OpenTTD-RL M13 V1 publication contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "milestone", "status", "release", "accepted_m12", "model_package", "archive", "repository_surface", "publication_review", "gates", "identity"],
  "properties": {
    "$schema": {"const": "../../docs/project/schema/v1-m13-publication-contract.schema.json"},
    "schema_version": {"const": "openttd-rl-v1-m13-publication-contract-1"},
    "milestone": {"const": "M13-publication-readiness"},
    "status": {"const": "FROZEN"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "name", "repository", "branch", "license", "artifact_name", "artifact_root"],
      "properties": {
        "tag": {"const": "v1.0.0"},
        "name": {"const": "OpenTTD RL V1"},
        "repository": {"const": "https://github.com/goldbar123467/openttd-cuda-rl"},
        "branch": {"const": "main"},
        "license": {"const": "GPL-2.0-only"},
        "artifact_name": {"const": "openttd-rl-v1.0.0-model-and-evidence.tar.gz"},
        "artifact_root": {"const": "openttd-rl-v1.0.0"}
      }
    },
    "accepted_m12": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "contract_sha256", "manifest_sha256", "manifest_file_sha256", "openttd_upstream_commit", "requirements_passed", "campaigns_passed", "nonclosed_defects"],
      "properties": {
        "source_commit": {"const": "f78843a7c911094243a56159bcc265bf22a5d0f7"},
        "contract_sha256": {"const": "e644f6e31163f9eb91008fe0bcb5d6830f3f3bb89104b229f3d974085b287879"},
        "manifest_sha256": {"const": "4593f177b21c92d0e789118896cc66f7534f1a516f2d73a125f52d0149374a6b"},
        "manifest_file_sha256": {"const": "bca6f399e246229dbe04f0570fa4d828611e95e107556d602b27e257f51e1ba4"},
        "openttd_upstream_commit": {"const": "29f808ef0022064e6d9a83c8476d1e0f4686af86"},
        "requirements_passed": {"const": 217},
        "campaigns_passed": {"const": 12},
        "nonclosed_defects": {"const": 0}
      }
    },
    "model_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "source_package_id", "source_model_sha256", "architecture", "license", "copyright", "sanitization", "runtime_equivalence", "files"],
      "properties": {
        "package_id": {"const": "e41f2016cdb0aaf8da03c6db0149c040e29e455a48adae34e5f77708f641aeb0"},
        "source_package_id": {"const": "0334e6a9da8d5b87d48ecdcd859dc3a5be6b1f7913511bf3336f8d3cf1feeeb9"},
        "source_model_sha256": {"const": "10df689ccc6d1cb7f2e98f05f0474f72577cd9328a4589e3b1c7167bcbf08b5b"},
        "architecture": {"const": "combined-cnn-mlp-v1"},
        "license": {"const": "GPL-2.0-only"},
        "copyright": {"const": "Copyright 2026 goldbar123467"},
        "sanitization": {"const": {"kind": "onnx-metadata-removal-only", "removed_fields": ["doc_string", "metadata_props"], "removed_field_values": 155, "graph_semantics": "unchanged", "byte_identical_repeats": 2}},
        "runtime_equivalence": {"const": {"standalone_cases": 12, "ingame_cases": 12, "outputs": "byte-exact"}},
        "files": {
          "const": {
            "INSTALL.md": "9d2f8e93d56623ed0e5172984b79add78972dd532af172c9cad7fa2a2cb2786d",
            "evaluation.json": "e7b4a8b863f8fd89d9880a385aaf5925eb015eee7c4d8583e63c08309d9793ac",
            "golden.jsonl": "5ec104e5268e1485f368f852071ef52f55da2bd28c57ce9b368de410038f1b51",
            "manifest.json": "76abb4f30a379ed921db564acb3b4f54284642c3eef85681afda185bf9279b70",
            "model.onnx": "1f43d430c7fe5c58f4d4e5c9688c4d8a92aef3c82cf999f6dc7c228c9c403d29"
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "canonicalization", "required_payload_files", "excluded_components"],
      "properties": {
        "format": {"const": "ustar-plus-gzip"},
        "canonicalization": {"const": "sorted-members-mtime-zero-uid-gid-zero-empty-owner-gzip-mtime-zero-no-filename"},
        "required_payload_files": {
          "const": ["LICENSE", "README.md", "THIRD_PARTY_NOTICES.md", "models/e41f2016cdb0aaf8da03c6db0149c040e29e455a48adae34e5f77708f641aeb0/INSTALL.md", "models/e41f2016cdb0aaf8da03c6db0149c040e29e455a48adae34e5f77708f641aeb0/evaluation.json", "models/e41f2016cdb0aaf8da03c6db0149c040e29e455a48adae34e5f77708f641aeb0/golden.jsonl", "models/e41f2016cdb0aaf8da03c6db0149c040e29e455a48adae34e5f77708f641aeb0/manifest.json", "models/e41f2016cdb0aaf8da03c6db0149c040e29e455a48adae34e5f77708f641aeb0/model.onnx"]
        },
        "excluded_components": {
          "const": ["openttd-binaries", "openttd-source", "opengfx", "onnxruntime", "libtorch", "cuda-runtime", "nvidia-wheels", "raw-trajectories-and-checkpoints", "private-experiment-state"]
        }
      }
    },
    "repository_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_paths", "description", "topics", "default_quick_check"],
      "properties": {
        "required_paths": {"const": ["LICENSE", "THIRD_PARTY_NOTICES.md", "README.md", "docs/assets/openttd-rl-v1-playback.png", "docs/project/V1_PUBLICATION.md", ".github/workflows/quality.yml", "scripts/v1/setup_and_verify.sh"]},
        "description": {"const": "Reproducible C++/CUDA PPO and in-game ONNX neural control for OpenTTD passenger buses."},
        "topics": {"const": ["openttd", "reinforcement-learning", "cuda", "ppo", "onnx"]},
        "default_quick_check": {"const": "bash scripts/v1/setup_and_verify.sh"}
      }
    },
    "publication_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rebuild_count", "require_clean_main", "require_origin_sync", "require_safe_paths", "require_no_symlinks", "require_credential_scan", "require_host_path_scan", "require_gitleaks", "forbidden_text"],
      "properties": {
        "rebuild_count": {"const": 2},
        "require_clean_main": {"const": true},
        "require_origin_sync": {"const": true},
        "require_safe_paths": {"const": true},
        "require_no_symlinks": {"const": true},
        "require_credential_scan": {"const": true},
        "require_host_path_scan": {"const": true},
        "require_gitleaks": {"const": true},
        "forbidden_text": {"const": ["/home/", "/Users/", "BEGIN PRIVATE KEY", "AWS_SECRET_ACCESS_KEY", "GITHUB_TOKEN=", "OPENAI_API_KEY="]}
      }
    },
    "gates": {
      "const": ["contract-and-foundation", "repository-surface", "license-and-provenance", "accepted-package-identity", "deterministic-archive-repeat", "archive-safety", "credential-and-host-path-scan", "clean-main-publication"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "compatibility_sha256", "schema_path", "schema_sha256", "manifest_schema_path", "manifest_schema_sha256"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-v1"},
        "compatibility_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_path": {"const": "docs/project/schema/v1-m13-publication-contract.schema.json"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_schema_path": {"const": "docs/project/schema/v1-m13-publication-manifest.schema.json"},
        "manifest_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
