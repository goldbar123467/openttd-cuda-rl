    "stochastic": {"split": "final-evaluation", "policy_mode": "explicitly-seeded-stochastic", "sampling_seeds": [2026090901, 2026090902], "starting_balance": 100000, "action_horizon": 128, "templates": ["m02-template-07", "m02-template-08"]},
    "robustness": {"split": "final-evaluation", "policy_mode": "greedy", "starting_balances": [75000, 125000], "action_horizons": [64, 256], "templates": ["m02-template-07", "m02-template-08"]},
    "layout_and_passenger_variation": "native-distinct-frozen-template-town-layouts-and-generated-passenger-populations",
