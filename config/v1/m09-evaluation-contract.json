  "baselines": [
    {"id": "seeded-random-legal-v1", "kind": "random", "version": "1", "source": "scripts/v1/run_m09_evaluation.py", "seed_policy": "explicit-mt19937-compatible-python-Random-seed-per-episode", "limitations": ["legal-action reference only", "not an economic heuristic"], "competitive_multiplayer": false},
    {"id": "wait-only-trivial-v1", "kind": "trivial-scripted", "version": "1", "source": "scripts/v1/run_m09_evaluation.py", "seed_policy": "deterministic-action-zero", "limitations": ["never constructs transport", "measures survival without useful service"], "competitive_multiplayer": false},
    {"id": "m05-scripted-bus-v1", "kind": "existing-scripted-agent", "version": "1", "source": "scripts/v1/run_m05_actions.py", "seed_policy": "deterministic-template-derived-action-sequence", "limitations": ["uses frozen template coordinates", "single bus and single route", "isolated company only"], "competitive_multiplayer": false}
  ],
  "metrics": [
    {"id": "survival", "availability": "direct", "definition": "episode ends without bankruptcy or integration failure", "unit": "boolean", "role": "primary"},
    {"id": "bankruptcy", "availability": "direct", "definition": "BANKRUPTCY terminal reason observed", "unit": "boolean", "role": "primary"},
    {"id": "final-balance", "availability": "direct", "definition": "final native company balance", "unit": "OpenTTD-money", "role": "primary"},
    {"id": "net-profit", "availability": "derived", "definition": "final balance minus evaluation starting balance", "unit": "OpenTTD-money", "role": "secondary"},
    {"id": "operating-profit", "availability": "derived", "definition": "native company income plus signed native company expenses", "unit": "OpenTTD-money", "role": "primary"},
    {"id": "passenger-deliveries", "availability": "direct", "definition": "native company delivered passenger total", "unit": "passengers", "role": "primary"},
    {"id": "route-profit", "availability": "proxy", "definition": "company operating profit because V1 permits exactly one route", "unit": "OpenTTD-money", "role": "secondary"},
    {"id": "profitable-vehicles", "availability": "proxy", "definition": "one when the sole V1 bus exists and route-profit is positive, otherwise zero", "unit": "vehicles", "role": "diagnostic"},
    {"id": "infrastructure-cost", "availability": "derived", "definition": "sum of native per-transition capital_spend reward source", "unit": "OpenTTD-money", "role": "secondary"},
    {"id": "roi", "availability": "derived", "definition": "operating-profit divided by infrastructure-cost when cost is positive", "unit": "ratio", "role": "secondary"},
    {"id": "station-rating", "availability": "unavailable", "definition": "not exposed by frozen M04/M06 state; no station-rating claim", "unit": "unavailable", "role": "disposition-only"},
    {"id": "coverage", "availability": "proxy", "definition": "fraction of M04 station-catchment spatial cells active at final observation", "unit": "ratio", "role": "diagnostic"},
    {"id": "invalid-actions", "availability": "direct", "definition": "native rejected action count", "unit": "actions", "role": "secondary"},
    {"id": "action-efficiency", "availability": "derived", "definition": "non-WAIT non-rejected actions divided by total actions", "unit": "ratio", "role": "secondary"},
    {"id": "seed-stability", "availability": "derived", "definition": "sample standard deviation and range across matched training-run seeds", "unit": "metric-native", "role": "primary"}
  ],
  "statistics": {
    "unit": "training-run-seed",
    "reported": ["raw-episode", "seed-mean", "mean", "sample-standard-deviation", "minimum", "maximum", "two-sided-confidence-interval"],
    "confidence_level": 0.95,
    "interval": "student-t-df-n-minus-one",
    "best_seed_claims": false
  },
  "selection": {
    "split": "development",
    "score": "mean-operating-profit-then-passenger-deliveries",
    "eligibility": "positive-profit-and-deliveries-on-both-development-templates",
    "tie_breakers": ["mean-final-balance", "lower-invalid-actions", "lower-run-seed"],
    "final_results_used": false
  },
  "success": {
    "superiority": ["mean-passenger-deliveries-greater-than-random-and-trivial", "mean-operating-profit-greater-than-random-and-trivial"],
    "reliable_profitability": ["all-primary-episodes-survive", "all-primary-episodes-positive-operating-profit", "all-primary-episodes-positive-passenger-deliveries", "all-primary-episodes-positive-final-balance"],
