{
  "schema_version": "openttd-rl-v1-m07-metric-sources-1",
  "event_schema": "docs/project/schema/v1-m07-metric-event.schema.json",
  "authority": "the terminal monitor renders only values present in the same validated MetricEvent written to JSONL",
  "fields": {
    "best_development_score": {"source": "development evaluator accepted-score state", "unit": "scalar return", "aggregation": "best accepted checkpoint", "unavailable": "null"},
    "checkpoint_id": {"source": "native checkpoint writer response", "unit": "sha256 identity", "aggregation": "latest completed checkpoint", "unavailable": "null"},
    "counters.accepted_samples": {"source": "PpoTrainer::counters after completed update", "unit": "samples", "aggregation": "lifetime", "unavailable": "forbidden"},
    "counters.completed_episodes": {"source": "typed environment completion events", "unit": "episodes", "aggregation": "lifetime", "unavailable": "forbidden"},
    "counters.completed_updates": {"source": "PpoTrainer completed-update boundary", "unit": "updates", "aggregation": "lifetime", "unavailable": "forbidden"},
    "counters.environment_steps": {"source": "accepted rollout transition count", "unit": "transitions", "aggregation": "lifetime", "unavailable": "forbidden"},
    "counters.simulation_ticks": {"source": "M03 post_tick minus pre_tick", "unit": "OpenTTD ticks", "aggregation": "lifetime", "unavailable": "forbidden"},
    "elapsed_ns": {"source": "steady clock minus run start", "unit": "nanoseconds", "aggregation": "lifetime", "unavailable": "forbidden"},
    "environment.company_profit": {"source": "M06 lifetime operating-profit projection", "unit": "OpenTTD base currency", "aggregation": "completed-episode window", "unavailable": "null"},
    "environment.invalid_actions": {"source": "M05 ILLEGAL_INPUT outcomes", "unit": "actions", "aggregation": "lifetime", "unavailable": "forbidden"},
    "environment.mask_violations": {"source": "trainer stored-action/mask validation", "unit": "violations", "aggregation": "lifetime", "unavailable": "forbidden"},
    "environment.mean_episode_length": {"source": "typed completed-episode lengths", "unit": "transitions", "aggregation": "completed-episode window", "unavailable": "null"},
    "environment.mean_episode_return": {"source": "M06 scalar reward left-fold per episode", "unit": "reward", "aggregation": "completed-episode window", "unavailable": "null"},
    "environment.passenger_deliveries": {"source": "M06 lifetime delivered-passenger projection", "unit": "passengers", "aggregation": "completed-episode window", "unavailable": "null"},
    "environment.resets": {"source": "successful M03 RESET responses", "unit": "resets", "aggregation": "lifetime", "unavailable": "forbidden"},
    "environment.routes": {"source": "M04 structured feature counts.routes", "unit": "routes", "aggregation": "latest boundary/window", "unavailable": "null"},
    "environment.vehicles": {"source": "M04 structured feature counts.buses", "unit": "buses", "aggregation": "latest boundary/window", "unavailable": "null"},
    "run.device": {"source": "trainer device contract", "unit": "device label", "aggregation": "run constant", "unavailable": "forbidden"},
    "run.environment_count": {"source": "validated PpoConfig", "unit": "workers", "aggregation": "run constant", "unavailable": "forbidden"},
    "run.environment_version": {"source": "M06 compatibility identity", "unit": "identity", "aggregation": "run constant", "unavailable": "forbidden"},
    "run.openttd_version": {"source": "prepared source profile", "unit": "version", "aggregation": "run constant", "unavailable": "forbidden"},
    "run.repository_commit": {"source": "git rev-parse at run freeze", "unit": "commit", "aggregation": "run constant", "unavailable": "forbidden"},
    "run.run_name": {"source": "validated run manifest", "unit": "name", "aggregation": "run constant", "unavailable": "forbidden"},
    "run.run_seed": {"source": "SeedLedger run seed", "unit": "uint64", "aggregation": "run constant", "unavailable": "forbidden"},
    "steps_per_second": {"source": "logged counters.environment_steps divided by logged elapsed_ns", "unit": "transitions/second", "aggregation": "lifetime", "unavailable": "null"},
    "system.cpu_utilization_percent": {"source": "times process CPU delta divided by steady-clock delta", "unit": "percent of one CPU", "aggregation": "sample interval", "unavailable": "null"},
    "system.gpu_available": {"source": "telemetry provider availability", "unit": "boolean", "aggregation": "sample", "unavailable": "forbidden"},
    "system.gpu_memory_bytes": {"source": "GPU telemetry provider", "unit": "bytes", "aggregation": "sample", "unavailable": "null"},
    "system.gpu_utilization_percent": {"source": "GPU telemetry provider", "unit": "percent", "aggregation": "sample interval", "unavailable": "null"},
    "system.process_memory_bytes": {"source": "/proc/self/statm resident pages times system page size", "unit": "bytes", "aggregation": "sample", "unavailable": "null"},
    "training.approximate_kl": {"source": "PPO update fixed ratio formula", "unit": "nats", "aggregation": "mean over update minibatches", "unavailable": "forbidden"},
    "training.clip_fraction": {"source": "PPO ratio outside clip interval", "unit": "fraction", "aggregation": "mean over update minibatches", "unavailable": "forbidden"},
    "training.entropy": {"source": "masked categorical entropy", "unit": "nats", "aggregation": "mean over update minibatches", "unavailable": "forbidden"},
    "training.explained_variance": {"source": "old values and typed GAE returns", "unit": "ratio", "aggregation": "rollout", "unavailable": "forbidden"},
    "training.gradient_norm": {"source": "global L2 norm immediately before clipping", "unit": "L2 norm", "aggregation": "mean over update minibatches", "unavailable": "forbidden"},
    "training.learning_rate": {"source": "validated Adam configuration", "unit": "optimizer step size", "aggregation": "update", "unavailable": "forbidden"},
    "training.policy_loss": {"source": "clipped PPO objective", "unit": "loss", "aggregation": "mean over update minibatches", "unavailable": "forbidden"},
    "training.samples": {"source": "PpoTrainer accepted_samples counter", "unit": "samples", "aggregation": "lifetime", "unavailable": "forbidden"},
    "training.update": {"source": "PpoTrainer completed_updates counter", "unit": "updates", "aggregation": "lifetime", "unavailable": "forbidden"},
    "training.value_loss": {"source": "plain MSE against typed GAE returns", "unit": "loss", "aggregation": "mean over update minibatches", "unavailable": "forbidden"},
    "warning_state": {"source": "validated run warning state", "unit": "state label", "aggregation": "latest", "unavailable": "forbidden"}
  }
}
